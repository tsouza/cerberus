-- query.traceql --
{ resource.service.name = "a" } && { duration > 1s }
-- sql --
SELECT * FROM `otel_traces` WHERE ((`ResourceAttributes`[?] = ?) OR (`Duration` > ?)) QUALIFY max((`ResourceAttributes`[?] = ?)) OVER (PARTITION BY `TraceId`) AND max((`Duration` > ?)) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`
-- args --
[0] string = "service.name"
[1] string = "a"
[2] int64 = 1000000000
[3] string = "service.name"
[4] string = "a"
[5] int64 = 1000000000
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    Duration UInt64,
    _svc String,
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', _svc)
) ENGINE = Memory;
INSERT INTO otel_traces (TraceId, SpanId, Duration, _svc) VALUES
    ('a0000000000000000000000000000001', '0000000000000001', 500000000,  'a'),
    ('a0000000000000000000000000000001', '0000000000000002', 2000000000, 'a'),
    ('a0000000000000000000000000000001', '0000000000000003', 3000000000, 'b'),
    ('a0000000000000000000000000000002', '0000000000000010', 5000000000, 'a');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "a"}, "1970-01-01T00:00:00Z", 500000000],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "a"}, "1970-01-01T00:00:00Z", 2000000000],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000003", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "b"}, "1970-01-01T00:00:00Z", 3000000000],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000010", "__cerberus_traceID": "a0000000000000000000000000000002", "service.name": "a"}, "1970-01-01T00:00:00Z", 5000000000]
]
-- chplan --
SetOperation op=&&
  Filter predicate=(ResourceAttributes["service.name"] = "a")
    Scan(otel_traces)
  Filter predicate=(Duration > 1000000000)
    Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "service.name"
[4] string = "a"
[5] int64 = 1000000000
[6] string = "service.name"
[7] string = "a"
[8] int64 = 1000000000
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ((`ResourceAttributes`[?] = ?) OR (`Duration` > ?)) QUALIFY max((`ResourceAttributes`[?] = ?)) OVER (PARTITION BY `TraceId`) AND max((`Duration` > ?)) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`)
