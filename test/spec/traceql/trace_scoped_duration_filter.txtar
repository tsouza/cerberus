-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "2024-01-01T00:00:00Z", 50000000],
  ["", {"__cerberus_parentSpanID": "0000000000000001", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "2024-01-01T00:00:00.12Z", 30000000]
]
-- args --
[0] int64 = 100000000
-- chplan --
Filter predicate=(TraceId IN {Project [TraceId] ; Filter predicate=(_cerb_trace_scoped_val > 100000000) ; Project [TraceId AS TraceId, (_cerb_trace_end_ns - _cerb_trace_start_ns) AS _cerb_trace_scoped_val] ; Aggregate groupBy=[TraceId AS TraceId] funcs=[min(toUnixTimestamp64Nano(Timestamp)) AS _cerb_trace_start_ns, max((toUnixTimestamp64Nano(Timestamp) + toInt64(Duration))) AS _cerb_trace_end_ns] ; Scan(otel_traces)})
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE `TraceId` IN (SELECT `TraceId` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, (`_cerb_trace_end_ns` - `_cerb_trace_start_ns`) AS `_cerb_trace_scoped_val` FROM (SELECT `TraceId` AS `TraceId`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `_cerb_trace_start_ns`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `_cerb_trace_end_ns` FROM (SELECT * FROM `otel_traces`) GROUP BY `TraceId`)) WHERE (`_cerb_trace_scoped_val` > ?)))
