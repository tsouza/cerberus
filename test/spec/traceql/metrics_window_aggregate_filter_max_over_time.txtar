# A `*_over_time` function after a spanset-aggregate filter reads the
# attribute of the spans of each passing spanset. Trace ...02 carries the
# longest span, 5s, but has one span, so `count() > 1` drops it.
#
#   trace ...01  2s at 00:00:30, 1s at 00:01:30  passes
#   trace ...02  5s at 00:00:40                  dropped
#   trace ...03  4s at 00:01:10, 1s at 00:01:20  passes
#
# max_over_time(duration) reads seconds: 2 in the first bucket, 4 in the
# second. Without the filter the first bucket would read 5.
-- query.traceql --
{ } | count() > 1 | max_over_time(duration)
-- metrics_window --
1704067260 1704067320 60
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = MergeTree ORDER BY (Timestamp, SpanId);
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, Timestamp, Duration, SpanName) VALUES
    ('a0000000000000000000000000000001', '0000000000000001', '', toDateTime64('2024-01-01 00:00:30', 9), 2000000000, 'a'),
    ('a0000000000000000000000000000001', '0000000000000002', '0000000000000001', toDateTime64('2024-01-01 00:01:30', 9), 1000000000, 'a'),
    ('a0000000000000000000000000000002', '0000000000000016', '', toDateTime64('2024-01-01 00:00:40', 9), 5000000000, 'b'),
    ('a0000000000000000000000000000003', '0000000000000032', '', toDateTime64('2024-01-01 00:01:10', 9), 4000000000, 'c'),
    ('a0000000000000000000000000000003', '0000000000000033', '0000000000000032', toDateTime64('2024-01-01 00:01:20', 9), 1000000000, 'c');
-- expected_rows --
[
  ["2024-01-01T00:01:00Z", 2],
  ["2024-01-01T00:02:00Z", 4]
]
-- parity_exempt --
reason: no-comparable-oracle
detail: `{ } | count() > 1 | max_over_time(duration)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
