-- query.traceql --
{ statusMessage = "internal server error" }
-- sql --
SELECT * FROM `otel_traces` WHERE (`StatusMessage` = ?)
-- args --
[0] string = "internal server error"
-- seed --
CREATE TABLE otel_traces (
    StatusMessage String,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (StatusMessage, TraceId, SpanId) VALUES
    ('', 'a0000000000000000000000000000001', '0000000000000001'),
    ('internal server error', 'a0000000000000000000000000000001', '0000000000000002'),
    ('timeout', 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(StatusMessage = "internal server error")
  Scan(otel_traces)

