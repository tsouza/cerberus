# The per-trace lookback is bounded: a search reads each trace's root from the
# request window, [00:00:00, 00:10:00], widened by the maximum trace duration
# (1h) on both sides, [23:00:00, 01:10:00], and no further. A trace whose root
# span starts more than the setting before the window is clipped: its root is
# not read, its rootName is empty, as for a trace with no root span.
#
#   trace ...01  root 'checkout' 2h before the window, outside the lookback
#     0001 root  'checkout' 22:00:00 +2h5m  outside the window
#     0002       'checkout' 00:02:00 +1s    matches ('checkout' != '')
#     0003       'pay'      00:03:00 +1s    matches
#   trace ...02  rootName 'api', root inside the window
#     0010 root  'api'      00:01:00 +2s    no match
#     0011       'db'       00:01:00 +1s    matches
#
# Matches 0002, 0003 and 0011. Reference /api/search reads the whole stored
# trace, resolves rootName 'checkout' for trace ...01, and does not match
# 0002: a trace longer than the setting is where the two answers part.
-- search_limit --
20
-- search_window --
1767225600 1767226200
-- query.traceql --
{ rootName != name }
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = MergeTree ORDER BY (Timestamp, SpanId);
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, Timestamp, Duration, SpanName) VALUES
    ('d0000000000000000000000000000001', '0000000000000001', '',                 toDateTime64('2025-12-31 22:00:00', 9), 7500000000000, 'checkout'),
    ('d0000000000000000000000000000001', '0000000000000002', '0000000000000001', toDateTime64('2026-01-01 00:02:00', 9), 1000000000,    'checkout'),
    ('d0000000000000000000000000000001', '0000000000000003', '0000000000000001', toDateTime64('2026-01-01 00:03:00', 9), 1000000000,    'pay'),
    ('d0000000000000000000000000000002', '0000000000000010', '',                 toDateTime64('2026-01-01 00:01:00', 9), 2000000000,    'api'),
    ('d0000000000000000000000000000002', '0000000000000011', '0000000000000010', toDateTime64('2026-01-01 00:01:00', 9), 1000000000,    'db');
-- expected_rows --
[
  ["checkout", {"__cerberus_parentSpanID": "0000000000000001", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "d0000000000000000000000000000001"}, "2026-01-01T00:02:00Z", 1000000000],
  ["db", {"__cerberus_parentSpanID": "0000000000000010", "__cerberus_spanID": "0000000000000011", "__cerberus_traceID": "d0000000000000000000000000000002"}, "2026-01-01T00:01:00Z", 1000000000],
  ["pay", {"__cerberus_parentSpanID": "0000000000000001", "__cerberus_spanID": "0000000000000003", "__cerberus_traceID": "d0000000000000000000000000000001"}, "2026-01-01T00:03:00Z", 1000000000]
]
-- parity_exempt --
reason: trace-longer-than-lookback
detail: `{ rootName != name }` reads a trace whose root span starts 2h before `search_window:`, beyond the 1h maximum trace duration cerberus widens each per-trace lookup by; cerberus clips the trace and reads an empty rootName where the reference, reading the whole stored trace, resolves `checkout`
