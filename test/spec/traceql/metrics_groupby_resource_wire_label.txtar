-- query.traceql --
{} | count_over_time() by (resource.service.name)
-- sql --
SELECT `ResourceAttributes`[?] AS `service.name`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `service.name`
-- args --
[0] string = "service.name"
[1] int64 = 1
[2] bool = true
-- seed --
CREATE TABLE otel_traces (
    ResourceAttributes Map(String, String),
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (ResourceAttributes, TraceId, SpanId) VALUES
    (map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000001'),
    (map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000002'),
    (map('service.name', 'backend'), 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["backend", 1],
  ["frontend", 2]
]
-- chplan --
MetricsAggregate op=count_over_time groupBy=[ResourceAttributes["service.name"] AS service.name|resource.service.name] valueAlias=Value
  Filter predicate=true
    Scan(otel_traces)
-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | count_over_time() by (resource.service.name)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
