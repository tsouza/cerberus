# Regex carries NO wildcards or anchors ("api") — a plain literal used as a
# regex. ClickHouse's match() is a substring search, so a naive lowering
# would match any service.name CONTAINING "api" as a substring —
# "apiserver" and "myapi" both would wrongly match. TraceQL attribute regex
# matchers are ALWAYS implicitly fully anchored (Tempo's own regex
# evaluator wraps labels.NewFastRegexMatcher), so
# `resource.service.name =~ "api"` must match ONLY a service.name exactly
# equal to "api" — never "apiserver" or "myapi". Regression fixture for
# issue #1741.

-- query.traceql --
{ resource.service.name =~ "api" }
-- sql --
SELECT * FROM `otel_traces` WHERE mapContains(`ResourceAttributes`, ?) AND match(`ResourceAttributes`[?], ?)
-- args --
[0] string = "service.name"
[1] string = "service.name"
[2] string = "^(?:api)$"
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', if(_idx = 0, 'api', if(_idx = 1, 'apiserver', if(_idx = 2, 'myapi', 'web')))),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002'),
    (2, 'a0000000000000000000000000000001', '0000000000000003'),
    (3, 'a0000000000000000000000000000001', '0000000000000004');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "api"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(FnMapContainsKey(ResourceAttributes, "service.name") AND (ResourceAttributes["service.name"] =~ "api"))
  Scan(otel_traces)

-- parity --
oracle: tempo
endpoint: /api/search
scope: full
