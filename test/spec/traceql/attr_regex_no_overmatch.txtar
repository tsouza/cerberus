# Regex carries NO wildcards or anchors ("api") — a plain literal used as a
# regex. ClickHouse's match() is a substring search, so a naive lowering
# would match any service.name CONTAINING "api" as a substring —
# "apiserver" and "myapi" both would wrongly match. TraceQL attribute regex
# matchers are ALWAYS implicitly fully anchored (Tempo's own regex
# evaluator wraps labels.NewFastRegexMatcher), so
# `resource.service.name =~ "api"` must match ONLY a service.name exactly
# equal to "api" — never "apiserver" or "myapi". Regression fixture for
# issue #1741.

-- query.traceql --
{ resource.service.name =~ "api" }
-- sql --
SELECT * FROM `otel_traces` WHERE match(`ResourceAttributes`[?], ?)
-- args --
[0] string = "service.name"
[1] string = "^(?:api)$"
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', if(_idx = 0, 'api', if(_idx = 1, 'apiserver', if(_idx = 2, 'myapi', 'web'))))
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx) VALUES (0), (1), (2), (3);
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "", "__cerberus_traceID": "", "service.name": "api"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(ResourceAttributes["service.name"] =~ "api")
  Scan(otel_traces)
