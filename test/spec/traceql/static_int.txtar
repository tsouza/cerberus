-- query.traceql --
{ .attempt = 1 }
-- sql --
SELECT * FROM `otel_traces` WHERE (if(mapContains(`SpanAttributes`, ?), toFloat64OrNull(`SpanAttributes`[?]), toFloat64OrNull(`ResourceAttributes`[?])) = ?)
-- args --
[0] string = "attempt"
[1] string = "attempt"
[2] string = "attempt"
[3] int64 = 1
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    SpanAttributes Map(String, String) MATERIALIZED map('attempt', if(_idx = 0, '1', '2')),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(FnIf(FnMapContainsKey(SpanAttributes, "attempt"), FnToFloat64OrNull(SpanAttributes["attempt"]), FnToFloat64OrNull(ResourceAttributes["attempt"])) = 1)
  Scan(otel_traces)
-- parity_exempt --
reason: oracle-untyped-attributes
detail: `{ .attempt = 1 }` compares an attribute against a non-string literal, and the oracle sees every attribute as a String static (#3259)
