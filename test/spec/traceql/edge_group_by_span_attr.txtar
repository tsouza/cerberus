-- query.traceql --
{} | by(span.http.method)
-- sql --
SELECT `TraceId` AS `TraceId`, `SpanAttributes`[?] AS `GroupKey`, any(`SpanId`) AS `SpanId`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `TraceId`, `GroupKey`
-- args --
[0] string = "http.method"
[1] int64 = 1
[2] bool = true
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    SpanName String,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String),
    SpanAttributes Map(String, String),
    Duration UInt64
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('a0000000000000000000000000000001', '0000000000000001', 'span', toDateTime64('2026-01-01 00:00:00', 9), map(), map('http.method', 'GET'), 1000000),
    ('a0000000000000000000000000000002', '0000000000000002', 'span', toDateTime64('2026-01-01 00:00:00', 9), map(), map('http.method', 'POST'), 1000000);
-- expected_rows --
[
  ["span", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "1000000", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": ""}, "2026-01-01T00:00:00Z", 1],
  ["span", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "1000000", "__cerberus_traceID": "a0000000000000000000000000000002", "service.name": ""}, "2026-01-01T00:00:00Z", 1]
]
-- chplan --
Aggregate groupBy=[TraceId AS TraceId, SpanAttributes["http.method"] AS GroupKey] funcs=[FnAny(SpanId) AS SpanId, FnCount(1) AS Value, FnAny(SpanName) AS MetricName, FnAny(ResourceAttributes) AS ResourceAttrs, FnAny(ParentSpanId) AS ParentSpanId, FnMin(Timestamp) AS TimeUnix, FnMin(FnToUnixNanos(Timestamp)) AS TraceStartNs, FnMax((FnToUnixNanos(Timestamp) + FnToInt64(Duration))) AS TraceEndNs]
  Filter predicate=true
    Scan(otel_traces)
-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | by(span.http.method)` groups the spanset: its rows carry __cerberus_traceID and no __cerberus_spanID because each is a group representative, not a span, so there is no span set for runTempoParity to compare
