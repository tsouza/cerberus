-- query.traceql --
{ !(kind = server) || kind = client }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanKind String,
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, SpanKind, TraceId) VALUES
    ('aaaa', 'Server', 'a0000000000000000000000000000001'),
    ('bbbb', 'Client', 'a0000000000000000000000000000001'),
    ('cccc', 'Internal', 'a0000000000000000000000000000001');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "bbbb", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "Client"
-- chplan --
Filter predicate=(SpanKind = "Client")
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE (`SpanKind` = ?)
-- parity_exempt --
reason: reference-fetch-layer
detail: `{ !(kind = server) || kind = client }` has a NOT operand of a logical OR, which reference /api/search silently drops in its fetch layer and internal/traceql/lower.go's lowerUnaryNot reproduces (#1712)
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "Client"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanKind`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`SpanKind` = ?))
