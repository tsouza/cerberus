[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "bbbb", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "Client"
-- chplan --
Filter predicate=(SpanKind = "Client")
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE (`SpanKind` = ?)
-- parity_exempt --
reason: reference-fetch-layer
detail: `{ !(kind = server) || kind = client }` has a NOT operand of a logical OR, which reference /api/search silently drops in its fetch layer and internal/traceql/lower.go's lowerUnaryNot reproduces (#1712)
