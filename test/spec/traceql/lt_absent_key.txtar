-- chplan --
Filter predicate=(FnMapContainsKey(SpanAttributes, "color") AND (SpanAttributes["color"] < "m"))
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE mapContains(`SpanAttributes`, ?) AND (`SpanAttributes`[?] < ?)
