-- query.traceql --
{} | max_over_time(duration) by (resource.service.name, span.http.method)
-- sql --
SELECT `ResourceAttributes`[?] AS `service.name`, `SpanAttributes`[?] AS `http.method`, max((`Duration` / toFloat64(?))) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `service.name`, `http.method`
-- args --
[0] string = "service.name"
[1] string = "http.method"
[2] float64 = 1e+09
[3] bool = true
-- seed --
CREATE TABLE otel_traces (
    ResourceAttributes Map(String, String),
    SpanAttributes Map(String, String),
    Duration UInt64,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (ResourceAttributes, SpanAttributes, Duration, TraceId, SpanId) VALUES
    (map('service.name', 'frontend'), map('http.method', 'GET'),  50000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (map('service.name', 'frontend'), map('http.method', 'GET'), 100000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (map('service.name', 'frontend'), map('http.method', 'GET'),  75000000, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["frontend", "GET", 0.1]
]
-- chplan --
MetricsAggregate op=max_over_time attr=(Duration / 1e+09) groupBy=[ResourceAttributes["service.name"] AS service.name|resource.service.name, SpanAttributes["http.method"] AS http.method|span.http.method] valueAlias=Value
  Filter predicate=true
    Scan(otel_traces)
-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | max_over_time(duration) by (resource.service.name, span.http.method)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
