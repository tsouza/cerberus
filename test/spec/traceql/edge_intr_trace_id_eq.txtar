-- query.traceql --
{ trace:id = "abc123" }
-- args --
[0] string = "abc123"
-- sql --
SELECT * FROM `otel_traces` WHERE (`TraceId` = ?)
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (TraceId, SpanId) VALUES
    ('0123456789abcdef', '0000000000000001'),
    ('abc123', '0000000000000002'),
    ('fedcba9876543210', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "abc123"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(TraceId = "abc123")
  Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "abc123"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
min_table_rows_to_use_projection_index=0
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`TraceId` = ?))
