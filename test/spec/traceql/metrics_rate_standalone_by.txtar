Bug 1: a standalone `| by(X)` grouping stage immediately before a metrics
aggregate must fold into the aggregate's by-clause, so `{} | by(X) | rate()`
lowers IDENTICALLY to the valid `{} | rate() by (X)` (see metrics_rate_by.txtar
— same seed, same expected SQL/args/rows). Pre-fix this shape lowered to a
standalone GROUP-BY Aggregate that stripped Timestamp; the metrics rate grid the
/api/metrics/query_range handler wraps over it then referenced a Timestamp the
inner aggregate had collapsed away — ClickHouse code 47 ("Unknown expression or
function identifier `Timestamp`"), surfaced to Grafana as a 502. The fold
(foldTrailingGroupByIntoMetrics) routes the grouping through the aggregate's
by-clause, keeping Timestamp in scope and emitting valid grid-able SQL.

-- query.traceql --

{} | by(resource.service.name) | rate()

-- sql --
SELECT `ResourceAttributes`[?] AS `service.name`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `service.name`
-- args --
[0] string = "service.name"
[1] int64 = 1
[2] bool = true
-- seed --
CREATE TABLE otel_traces ( ResourceAttributes Map(String, String),
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (ResourceAttributes, TraceId, SpanId) VALUES
    (map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000001'),
    (map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000002'),
    (map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --

[["frontend",3]]

-- chplan --
MetricsAggregate op=rate groupBy=[ResourceAttributes["service.name"] AS service.name|resource.service.name] valueAlias=Value
  Filter predicate=true
    Scan(otel_traces)
-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | by(resource.service.name) | rate()` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
-- args_optimized --
[0] string = "service.name"
[1] int64 = 1
[2] bool = true
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:node
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `ResourceAttributes`[?] AS `service.name`, toFloat64(count(?)) AS `Value` FROM (SELECT `ResourceAttributes` FROM `otel_traces` WHERE ?) GROUP BY `service.name`
