A standalone `| by(X)` grouping stage immediately before a metrics function is
invisible to the metric: reference Tempo's metrics evaluator observes every span
of every group the by() stage returns and labels a series only from the metrics
function's own by-clause. So `{} | by(resource.service.name) | rate()` answers
the one unlabelled series `{} | rate()` answers — here all four spans, over two
services — and lowers identically to it (dropGroupByBeforeMetrics). Lowered as
a stage instead, by() would collapse the spans to one row per group and leave
the metric no Timestamp to read (ClickHouse code 47, a 502).

-- query.traceql --

{} | by(resource.service.name) | rate()

-- sql --
SELECT toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?)
-- args --
[0] int64 = 1
[1] bool = true
-- seed --
CREATE TABLE otel_traces ( ResourceAttributes Map(String, String),
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (ResourceAttributes, TraceId, SpanId) VALUES
    (map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000001'),
    (map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000002'),
    (map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000003'),
    (map('service.name', 'backend'), 'a0000000000000000000000000000001', '0000000000000004');
-- expected_rows --
[
  [4]
]
-- chplan --
MetricsAggregate op=rate valueAlias=Value perTraceLookback=1h0m0s
  Filter predicate=true
    Scan(otel_traces)
-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | by(resource.service.name) | rate()` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
-- args_optimized --
[0] int64 = 1
[1] bool = true
