-- query.traceql --
{ name =~ "GET.*" }
-- args --
[0] string = "^(?:GET.*)$"
-- sql --
SELECT * FROM `otel_traces` WHERE match(`SpanName`, ?)
-- seed --
CREATE TABLE otel_traces (
    SpanName String,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (SpanName, TraceId, SpanId) VALUES
    ('GET /home', 'a0000000000000000000000000000001', '0000000000000001'),
    ('GET /api/users', 'a0000000000000000000000000000001', '0000000000000002'),
    ('POST /checkout', 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["GET /api/users", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["GET /home", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(SpanName =~ "GET.*")
  Scan(otel_traces)

-- parity --
oracle: tempo
endpoint: /api/search
scope: full
