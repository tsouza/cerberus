-- query.traceql --
{ name = "a" } &~ { name = "b" }
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String,
    Duration UInt64 DEFAULT 0,
    Timestamp UInt64 DEFAULT 0,
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = Memory;
-- The `&~` (sibling union) arm of the same duplicate-delivery shape
-- structural_union_child_dup_key_order documents:
--
--   s2 -> redelivered with the ResourceAttributes keys REVERSED (trigger)
--   s3 -> redelivered byte-identically (the control)
--
-- s2 is the L-arm span and s3 the R-arm span, so the divergence lands on
-- the projection a full-row UNION DISTINCT could not collapse.
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, SpanName, ResourceAttributes) VALUES
    ('t1', 's1', '',   'parent', map('job', 'api', 'dc', 'eu')),
    ('t1', 's2', 's1', 'a',      map('job', 'api', 'dc', 'eu')),
    ('t1', 's2', 's1', 'a',      map('dc', 'eu', 'job', 'api')),
    ('t1', 's3', 's1', 'b',      map('job', 'api', 'dc', 'eu')),
    ('t1', 's3', 's1', 'b',      map('job', 'api', 'dc', 'eu'));
-- expected_rows --
[
  ["a", {"__cerberus_parentSpanID": "s1", "__cerberus_spanID": "s2", "__cerberus_traceID": "t1", "dc": "eu", "job": "api"}, "1970-01-01T00:00:00Z", 0],
  ["b", {"__cerberus_parentSpanID": "s1", "__cerberus_spanID": "s3", "__cerberus_traceID": "t1", "dc": "eu", "job": "api"}, "1970-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "a"
[1] string = "b"
[2] string = "a"
[3] string = "b"
-- chplan --
StructuralJoin op=&~ maxDepth=128
  Filter predicate=(SpanName = "a")
    Scan(otel_traces)
  Filter predicate=(SpanName = "b")
    Scan(otel_traces)
-- sql --
SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM ((SELECT R.`TraceId` AS `TraceId`, R.`SpanId` AS `SpanId`, R.`ParentSpanId` AS `ParentSpanId`, R.`SpanName` AS `SpanName`, R.`Duration` AS `Duration`, R.`Timestamp` AS `Timestamp`, R.`ResourceAttributes` AS `ResourceAttributes`, R.`SpanAttributes` AS `SpanAttributes`, R.`StatusCode` AS `StatusCode`, R.`StatusMessage` AS `StatusMessage`, R.`SpanKind` AS `SpanKind`, R.`ScopeName` AS `ScopeName`, R.`ScopeVersion` AS `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS L INNER JOIN (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS R ON L.`TraceId` = R.`TraceId` AND L.`ParentSpanId` = R.`ParentSpanId` WHERE L.`SpanId` != R.`SpanId`) UNION ALL (SELECT L.`TraceId` AS `TraceId`, L.`SpanId` AS `SpanId`, L.`ParentSpanId` AS `ParentSpanId`, L.`SpanName` AS `SpanName`, L.`Duration` AS `Duration`, L.`Timestamp` AS `Timestamp`, L.`ResourceAttributes` AS `ResourceAttributes`, L.`SpanAttributes` AS `SpanAttributes`, L.`StatusCode` AS `StatusCode`, L.`StatusMessage` AS `StatusMessage`, L.`SpanKind` AS `SpanKind`, L.`ScopeName` AS `ScopeName`, L.`ScopeVersion` AS `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS L INNER JOIN (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS R ON L.`TraceId` = R.`TraceId` AND L.`ParentSpanId` = R.`ParentSpanId` WHERE L.`SpanId` != R.`SpanId`)) LIMIT 1 BY `TraceId`, `SpanId`
