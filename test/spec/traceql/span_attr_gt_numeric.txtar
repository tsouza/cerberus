Two bare attribute operands under an ORDERING comparison (`span.a > span.b`)
numeric-coerce BOTH sides via toFloat64OrNull. Before the fix this fell through
to a raw Map(String,String) compare — lexicographic, so `'10' > '5'` was false.
Equality (`=`/`!=`) deliberately stays a string compare; only ordering implies
numeric intent on two attributes.

-- query.traceql --
{ span.a > span.b }
-- sql --
SELECT * FROM `otel_traces` WHERE (toFloat64OrNull(`SpanAttributes`[?]) > toFloat64OrNull(`SpanAttributes`[?]))
-- chplan --
Filter predicate=(FnToFloat64OrNull(SpanAttributes["a"]) > FnToFloat64OrNull(SpanAttributes["b"]))
  Scan(otel_traces)
-- args --
[0] string = "a"
[1] string = "b"
-- parity_exempt --
reason: emitted-sql-only
detail: `{ span.a > span.b }` carries no `seed:` or `expected_rows:` — it pins the emitted SQL for this shape, and executes no answer for any oracle to compare
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "a"
[4] string = "b"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (toFloat64OrNull(`SpanAttributes`[?]) > toFloat64OrNull(`SpanAttributes`[?])))
