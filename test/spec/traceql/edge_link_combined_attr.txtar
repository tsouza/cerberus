-- query.traceql --
{ resource.service.name = "x" && link.environment = "staging" }
-- args --
[0] string = "service.name"
[1] string = "x"
[2] string = "environment"
[3] string = "staging"
-- sql --
SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?) AND arrayExists(x -> x[?] = ?, `Links`.`Attributes`)
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    ResourceAttributes Map(String, String) MATERIALIZED if(_idx = 0, map('service.name', 'x'), map('service.name', 'y')),
    `Links.Attributes` Array(Map(String, String)) MATERIALIZED if(_idx = 0, [map('environment', 'staging')], [map('environment', 'prod')]),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "x"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=((ResourceAttributes["service.name"] = "x") AND nestedArrayExists(Links.Attributes["environment"] = "staging"))
  Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "service.name"
[4] string = "x"
[5] string = "environment"
[6] string = "staging"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `Links`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?) AND arrayExists(x -> x[?] = ?, `Links`.`Attributes`))
