use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT * FROM ((SELECT * FROM ((SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?)) UNION ALL (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?))) LIMIT 1 BY `TraceId`, `SpanId`) UNION ALL (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?))) LIMIT 1 BY `TraceId`, `SpanId`)
