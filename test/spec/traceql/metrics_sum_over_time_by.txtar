-- query.traceql --
{} | sum_over_time(duration) by (resource.service.name)
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    ResourceAttributes Map(String, String),
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (Duration, ResourceAttributes, TraceId, SpanId) VALUES
    (50000000, map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000001'),
    (100000000, map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000002'),
    (200000000, map('service.name', 'backend'), 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["backend", 0.2],
  ["frontend", 0.15]
]
-- args --
[0] string = "service.name"
[1] float64 = 1e+09
[2] bool = true
-- chplan --
MetricsAggregate op=sum_over_time attr=(Duration / 1e+09) groupBy=[ResourceAttributes["service.name"] AS service.name|resource.service.name] valueAlias=Value
  Filter predicate=true
    Scan(otel_traces)
-- sql --
SELECT `ResourceAttributes`[?] AS `service.name`, sum((`Duration` / toFloat64(?))) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `service.name`
-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | sum_over_time(duration) by (resource.service.name)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
