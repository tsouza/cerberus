-- query.traceql --
{} | histogram_over_time(duration)
-- sql --
SELECT pow(2, ceil(log2(toFloat64(`Duration`)))) / 1000000000 AS `__bucket`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?) WHERE `Duration` >= 2 GROUP BY `__bucket`
-- args --
[0] int64 = 1
[1] bool = true
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (1024, 'a0000000000000000000000000000001', '0000000000000001'),
    (1024, 'a0000000000000000000000000000001', '0000000000000002'),
    (1024, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  [0.000001024, 3]
]
-- chplan --
MetricsHistogramOverTime attr=Duration duration=true bucketAlias=__bucket valueAlias=Value
  Filter predicate=true
    Scan(otel_traces)

-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | histogram_over_time(duration)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
