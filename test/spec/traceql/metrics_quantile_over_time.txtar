-- query.traceql --
{} | quantile_over_time(duration, 0.95)
-- sql --
SELECT quantileExactInclusive(toFloat64(?))((`Duration` / toFloat64(?))) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?)
-- args --
[0] float64 = 0.95
[1] float64 = 1e+09
[2] bool = true
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (100000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (100000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (100000000, 'a0000000000000000000000000000001', '0000000000000003'),
    (100000000, 'a0000000000000000000000000000001', '0000000000000004'),
    (100000000, 'a0000000000000000000000000000001', '0000000000000005');
-- expected_rows --
[
  [0.1]
]
-- chplan --
MetricsAggregate op=quantile_over_time attr=(Duration / 1e+09) quantiles=[0.95] duration=true valueAlias=Value
  Filter predicate=true
    Scan(otel_traces)
-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | quantile_over_time(duration, 0.95)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
