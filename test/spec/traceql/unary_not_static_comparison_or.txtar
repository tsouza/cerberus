A unary `!` over a true-making static comparison, as an OR operand.
`!("a" = "b")` is true, so every span matches; dropping the NOT operand as
the OR identity element would match only the Server span.

-- query.traceql --
{ kind = server || !("a" = "b") }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanKind String,
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, SpanKind, TraceId) VALUES
    ('aaaa', 'Server', 'a0000000000000000000000000000001'),
    ('bbbb', 'Client', 'a0000000000000000000000000000001'),
    ('cccc', 'Client', 'a0000000000000000000000000000002');
-- expected_rows --
[]
