A unary `!` over a true-making static comparison, as an operand of the
filter's top-level OR beside a span-referencing operand. Reference Tempo
folds `!("a" = "b")` to a Static, which hands its fetch layer no condition,
so only the spans the sibling's condition fetches are evaluated: the answer
is the Server span alone. The evaluate-only parity oracle skips that fetch
layer and would answer every span.

-- query.traceql --
{ kind = server || !("a" = "b") }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanKind String,
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, SpanKind, TraceId) VALUES
    ('aaaa', 'Server', 'a0000000000000000000000000000001'),
    ('bbbb', 'Client', 'a0000000000000000000000000000001'),
    ('cccc', 'Client', 'a0000000000000000000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "aaaa", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "Server"
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "Server"
-- chplan --
Filter predicate=(SpanKind = "Server")
  Scan(otel_traces)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,classic_bucket_layout_two_level,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT * FROM `otel_traces` WHERE (`SpanKind` = ?)
-- parity_exempt --
reason: reference-fetch-layer
detail: `{ kind = server || !("a" = "b") }` has a span-free operand of the filter's top-level OR, which reference /api/search folds to a Static that fetches no span; internal/traceql/lower.go's lowerTopLevelOr drops it
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanKind`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`SpanKind` = ?))
