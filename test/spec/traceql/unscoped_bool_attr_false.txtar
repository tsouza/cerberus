[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args --
[0] string = "cache.hit"
[1] string = "cache.hit"
[2] string = "cache.hit"
[3] string = "false"
-- chplan --
Filter predicate=(FnIf(FnMapContainsKey(SpanAttributes, "cache.hit"), SpanAttributes["cache.hit"], ResourceAttributes["cache.hit"]) = "false")
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE (if(mapContains(`SpanAttributes`, ?), `SpanAttributes`[?], `ResourceAttributes`[?]) = ?)
