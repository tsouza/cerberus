-- chplan --
Filter predicate=(FnIf(FnMapContainsKey(SpanAttributes, "cache.hit"), SpanAttributes["cache.hit"], ResourceAttributes["cache.hit"]) = "false")
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE (if(mapContains(`SpanAttributes`, ?), `SpanAttributes`[?], `ResourceAttributes`[?]) = ?)
