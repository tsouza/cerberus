-- query.traceql --
{ .cache.hit = false }
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    _hit Bool,
    SpanAttributes Map(String, String) MATERIALIZED if(SpanId IN ('0000000000000003', '0000000000000004'), map(), map('cache.hit', if(_hit, 'true', 'false'))),
    ResourceAttributes Map(String, String) MATERIALIZED if(SpanId = '0000000000000003', map('cache.hit', 'true'), map())
) ENGINE = Memory;
INSERT INTO otel_traces (TraceId, SpanId, _hit) VALUES
    ('a0000000000000000000000000000001', '0000000000000001', true),
    ('a0000000000000000000000000000001', '0000000000000002', false),
    ('a0000000000000000000000000000003', '0000000000000003', false),
    ('a0000000000000000000000000000004', '0000000000000004', false);
