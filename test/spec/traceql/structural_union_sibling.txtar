[
  ["a", {"__cerberus_parentSpanID": "s1", "__cerberus_spanID": "s2", "__cerberus_traceID": "t1"}, "1970-01-01T00:00:00Z", 0],
  ["b", {"__cerberus_parentSpanID": "s1", "__cerberus_spanID": "s3", "__cerberus_traceID": "t1"}, "1970-01-01T00:00:00Z", 0]
]
