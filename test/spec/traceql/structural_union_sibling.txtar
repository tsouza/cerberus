essage`, L.`SpanKind` AS `SpanKind`, L.`ScopeName` AS `ScopeName`, L.`ScopeVersion` AS `ScopeVersion` FROM (SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS _rooted_l WHERE (`TraceId`, `SpanId`) GLOBAL IN (WITH RECURSIVE _struct_rooted_1 AS (SELECT DISTINCT `TraceId`, `SpanId`, `ParentSpanId`, 0 AS _depth FROM `otel_traces` WHERE `ParentSpanId` = '' AND `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?))) UNION ALL SELECT DISTINCT t.`TraceId`, t.`SpanId`, t.`ParentSpanId`, c._depth + 1 FROM `otel_traces` AS t INNER JOIN _struct_rooted_1 AS c ON t.`TraceId` = c.`TraceId` AND t.`ParentSpanId` = c.`SpanId` WHERE c._depth < 128) SELECT DISTINCT `TraceId`, `SpanId` FROM _struct_rooted_1)) AS L INNER JOIN (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS R ON L.`TraceId` = R.`TraceId` AND L.`ParentSpanId` = R.`ParentSpanId` WHERE L.`SpanId` != R.`SpanId`)) LIMIT 1 BY `TraceId`, `SpanId`)
