-- chplan --
StructuralJoin op=&~
  Filter predicate=(SpanName = "a")
    Scan(otel_traces)
  Filter predicate=(SpanName = "b")
    Scan(otel_traces)
-- sql --
SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM ((SELECT R.`TraceId` AS `TraceId`, R.`SpanId` AS `SpanId`, R.`ParentSpanId` AS `ParentSpanId`, R.`SpanName` AS `SpanName`, R.`Duration` AS `Duration`, R.`Timestamp` AS `Timestamp`, R.`ResourceAttributes` AS `ResourceAttributes`, R.`SpanAttributes` AS `SpanAttributes`, R.`StatusCode` AS `StatusCode`, R.`StatusMessage` AS `StatusMessage`, R.`SpanKind` AS `SpanKind`, R.`ScopeName` AS `ScopeName`, R.`ScopeVersion` AS `ScopeVersion` FROM (SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS _rooted_l WHERE (`TraceId`, `SpanId`) GLOBAL IN (WITH RECURSIVE _struct_rooted_1 AS (SELECT DISTINCT `TraceId`, `SpanId`, `ParentSpanId`, 0 AS _depth FROM `otel_traces` WHERE `ParentSpanId` = '' AND `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?))) UNION ALL SELECT DISTINCT t.`TraceId`, t.`SpanId`, t.`ParentSpanId`, c._depth + 1 FROM `otel_traces` AS t INNER JOIN _struct_rooted_1 AS c ON t.`TraceId` = c.`TraceId` AND t.`ParentSpanId` = c.`SpanId` WHERE c._depth < 128) SELECT DISTINCT `TraceId`, `SpanId` FROM _struct_rooted_1)) AS L INNER JOIN (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS R ON L.`TraceId` = R.`TraceId` AND L.`ParentSpanId` = R.`ParentSpanId` WHERE L.`SpanId` != R.`SpanId`) UNION ALL (SELECT L.`TraceId` AS `TraceId`, L.`SpanId` AS `SpanId`, L.`ParentSpanId` AS `ParentSpanId`, L.`SpanName` AS `SpanName`, L.`Duration` AS `Duration`, L.`Timestamp` AS `Timestamp`, L.`ResourceAttributes` AS `ResourceAttributes`, L.`SpanAttributes` AS `SpanAttributes`, L.`StatusCode` AS `StatusCode`, L.`StatusMessage` AS `StatusMessage`, L.`SpanKind` AS `SpanKind`, L.`ScopeName` AS `ScopeName`, L.`ScopeVersion` AS `ScopeVersion` FROM (SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS _rooted_l WHERE (`TraceId`, `SpanId`) GLOBAL IN (WITH RECURSIVE _struct_rooted_1 AS (SELECT DISTINCT `TraceId`, `SpanId`, `ParentSpanId`, 0 AS _depth FROM `otel_traces` WHERE `ParentSpanId` = '' AND `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?))) UNION ALL SELECT DISTINCT t.`TraceId`, t.`SpanId`, t.`ParentSpanId`, c._depth + 1 FROM `otel_traces` AS t INNER JOIN _struct_rooted_1 AS c ON t.`TraceId` = c.`TraceId` AND t.`ParentSpanId` = c.`SpanId` WHERE c._depth < 128) SELECT DISTINCT `TraceId`, `SpanId` FROM _struct_rooted_1)) AS L INNER JOIN (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS R ON L.`TraceId` = R.`TraceId` AND L.`ParentSpanId` = R.`ParentSpanId` WHERE L.`SpanId` != R.`SpanId`)) LIMIT 1 BY `TraceId`, `SpanId`
