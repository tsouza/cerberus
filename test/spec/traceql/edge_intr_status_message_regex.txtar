-- query.traceql --
{ statusMessage =~ "timeout.*" }
-- args --
[0] string = "^(?:timeout.*)$"
-- sql --
SELECT * FROM `otel_traces` WHERE match(`StatusMessage`, ?)
-- seed --
CREATE TABLE otel_traces (
    StatusMessage String,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (StatusMessage, TraceId, SpanId) VALUES
    ('ok', 'a0000000000000000000000000000001', '0000000000000001'),
    ('timeout reached', 'a0000000000000000000000000000001', '0000000000000002'),
    ('timeout occurred', 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000003", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(StatusMessage =~ "timeout.*")
  Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
