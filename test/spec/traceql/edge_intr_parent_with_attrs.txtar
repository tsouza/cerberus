-- query.traceql --
{ parent && resource.service.name = "api" }
-- args --
[0] string = ""
[1] string = "service.name"
[2] string = "api"
-- sql --
SELECT * FROM `otel_traces` PREWHERE (`ParentSpanId` != ?) WHERE (`ResourceAttributes`[?] = ?)
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    ParentSpanId String MATERIALIZED if(_idx = 0, '', '0000000000000001'),
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', if(_idx = 2, 'frontend', 'api'))
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx) VALUES (0), (1), (2);
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "0000000000000001", "__cerberus_spanID": "", "__cerberus_traceID": "", "service.name": "api"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=((ParentSpanId != "") AND (ResourceAttributes["service.name"] = "api"))
  Scan(otel_traces)
-- parity_exempt --
reason: reference-intrinsic-unsupported
detail: `{ parent && resource.service.name = "api" }` reads the `parent` intrinsic, which upstream's own evaluator rejects with "intrinsic (parent) not yet supported"
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = ""
[4] string = "service.name"
[5] string = "api"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` PREWHERE (`ParentSpanId` != ?) WHERE (`ResourceAttributes`[?] = ?))
