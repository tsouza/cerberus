# `rootName` is a TRACE-scoped intrinsic: it resolves to the name of the
# trace's ROOT span, and a span is the root only when its ParentSpanId is
# EMPTY — upstream's Span.IsRoot() is `len(ParentSpanID) == 0`, and a
# trace with no such span has an empty RootSpanName that matches nothing.
# The fixture is built so a lowering that resolved root identity from an
# arbitrary span (the `any(SpanName)` shape, rather than argMinIf keyed
# on the root-span condition) would be caught, and so would one that read
# a parent naming a row that is not in the data as rootness:
#
#   trace ...0001  root  'GET /api/checkout'  (ParentSpanId = '')     -> MATCHES
#                  child 'charge'
#   trace ...0002  root  'POST /api/orders'                           -> must NOT match
#                  child 'GET /api/checkout'   <- the over-match trap:
#                        the needle name IS present in this trace, but
#                        not on its root span.
#   trace ...0003  span  'GET /api/checkout'  (ParentSpanId = all-zero hex,
#                        a value NO row in the trace carries)          -> must NOT match
#                  child 'charge'              <- the second trap: an absent
#                        parent row is not rootness. This trace has no root
#                        at all, so its rootName is '' (issue #1990).
#
# A matching trace contributes ALL of its spans (the filter selects
# traces, and /api/search returns the trace's spans), so the expected
# row set is trace 1 in full and nothing from traces 2 or 3.
-- query.traceql --
{ rootName = "GET /api/checkout" }
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = Memory;
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, Timestamp, SpanName) VALUES
    ('a0000000000000000000000000000001', '0000000000000001', '',                 toDateTime64('2024-01-01 00:00:00', 9), 'GET /api/checkout'),
    ('a0000000000000000000000000000001', '0000000000000002', '0000000000000001', toDateTime64('2024-01-01 00:00:01', 9), 'charge'),
    ('a0000000000000000000000000000002', '0000000000000010', '',                 toDateTime64('2024-01-01 00:00:00', 9), 'POST /api/orders'),
    ('a0000000000000000000000000000002', '0000000000000011', '0000000000000010', toDateTime64('2024-01-01 00:00:01', 9), 'GET /api/checkout'),
    ('a0000000000000000000000000000003', '0000000000000020', '0000000000000000', toDateTime64('2024-01-01 00:00:00', 9), 'GET /api/checkout'),
    ('a0000000000000000000000000000003', '0000000000000021', '0000000000000020', toDateTime64('2024-01-01 00:00:01', 9), 'charge');
-- expected_rows --
[
  ["GET /api/checkout", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "2024-01-01T00:00:00Z", 0],
  ["charge", {"__cerberus_parentSpanID": "0000000000000001", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "2024-01-01T00:00:01Z", 0]
]
-- args --
[0] string = ""
[1] string = "GET /api/checkout"
-- chplan --
Filter predicate=(TraceId IN {Project [TraceId] ; Filter predicate=(_cerb_trace_scoped_val = "GET /api/checkout") ; Aggregate groupBy=[TraceId AS TraceId] funcs=[FnArgMinIf(SpanName, Timestamp, (ParentSpanId = "")) AS _cerb_trace_scoped_val] ; Scan(otel_traces)})
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, argMinIf(`SpanName`, `Timestamp`, (`ParentSpanId` = ?)) AS `_cerb_trace_scoped_val` FROM (SELECT * FROM `otel_traces`) GROUP BY `TraceId`) WHERE (`_cerb_trace_scoped_val` = ?)))
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = ""
[4] string = "GET /api/checkout"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
min_table_rows_to_use_projection_index=0
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, argMinIf(`SpanName`, `Timestamp`, (`ParentSpanId` = ?)) AS `_cerb_trace_scoped_val` FROM (SELECT * FROM `otel_traces`) GROUP BY `TraceId`) WHERE (`_cerb_trace_scoped_val` = ?))))
