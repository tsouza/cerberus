-- query.traceql --
{ name = "left" } && { name = "right" }
-- args --
[0] string = "left"
[1] string = "right"
-- sql --
SELECT * EXCEPT (`_setand_side`) FROM ((SELECT *, 0 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)))) UNION ALL (SELECT *, 1 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?))))) QUALIFY max(`_setand_side` = 0) OVER (PARTITION BY `TraceId`) AND max(`_setand_side` = 1) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    SpanName String
) ENGINE = Memory;
INSERT INTO otel_traces (TraceId, SpanId, SpanName) VALUES
    ('trace-both', 'span-left', 'left'),
    ('trace-both', 'span-right', 'right'),
    ('trace-left-only', 'span-left-only', 'left'),
    ('trace-right-only', 'span-right-only', 'right');
-- expected_rows --
[
  ["left", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "span-left", "__cerberus_traceID": "trace-both"}, "1970-01-01T00:00:00Z", 0],
  ["right", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "span-right", "__cerberus_traceID": "trace-both"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
SetOperation op=&&
  Project [TraceId, SpanId, ParentSpanId, SpanName, Duration, Timestamp, ResourceAttributes, SpanAttributes, StatusCode, StatusMessage, SpanKind, ScopeName, ScopeVersion]
    Filter predicate=(SpanName = "left")
      Scan(otel_traces)
  Project [TraceId, SpanId, ParentSpanId, SpanName, Duration, Timestamp, ResourceAttributes, SpanAttributes, StatusCode, StatusMessage, SpanKind, ScopeName, ScopeVersion]
    Filter predicate=(SpanName = "right")
      Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "left"
[4] string = "right"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT * EXCEPT (`_setand_side`) FROM ((SELECT *, 0 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `ScopeName`, `ScopeVersion`, `SpanAttributes`, `SpanId`, `SpanKind`, `SpanName`, `StatusCode`, `StatusMessage`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`SpanName` = ?)))) UNION ALL (SELECT *, 1 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `ScopeName`, `ScopeVersion`, `SpanAttributes`, `SpanId`, `SpanKind`, `SpanName`, `StatusCode`, `StatusMessage`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`SpanName` = ?))))) QUALIFY max(`_setand_side` = 0) OVER (PARTITION BY `TraceId`) AND max(`_setand_side` = 1) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`)
