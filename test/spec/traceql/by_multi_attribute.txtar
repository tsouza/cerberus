-- query.traceql --
{} | count_over_time() by (resource.service.name, span.http.status_code)
-- sql --
SELECT `ResourceAttributes`[?] AS `service.name`, `SpanAttributes`[?] AS `http.status_code`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `service.name`, `http.status_code`
-- args --
[0] string = "service.name"
[1] string = "http.status_code"
[2] int64 = 1
[3] bool = true
-- seed --
CREATE TABLE otel_traces (
    ResourceAttributes Map(String, String),
    SpanAttributes Map(String, String),
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (ResourceAttributes, SpanAttributes, TraceId, SpanId) VALUES
    (map('service.name', 'frontend'), map('http.status_code', '200'), 'a0000000000000000000000000000001', '0000000000000001'),
    (map('service.name', 'frontend'), map('http.status_code', '200'), 'a0000000000000000000000000000001', '0000000000000002'),
    (map('service.name', 'frontend'), map('http.status_code', '200'), 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["frontend", "200", 3]
]
-- chplan --
MetricsAggregate op=count_over_time groupBy=[ResourceAttributes["service.name"] AS service.name|resource.service.name, SpanAttributes["http.status_code"] AS http.status_code|span.http.status_code] valueAlias=Value
  Filter predicate=true
    Scan(otel_traces)

-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | count_over_time() by (resource.service.name, span.http.status_code)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
