-- query.traceql --
{} | coalesce()
-- sql --
SELECT `TraceId` AS `TraceId`, `SpanId` AS `SpanId`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `TraceId`, `SpanId`
-- args --
[0] int64 = 1
[1] bool = true
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    SpanName String,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String),
    Duration UInt64
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('a0000000000000000000000000000001', '0000000000000001', 'span', toDateTime64('2026-01-01 00:00:00', 9), map('service.name', 'x'), 1000000),
    ('a0000000000000000000000000000001', '0000000000000001', 'span', toDateTime64('2026-01-01 00:00:05', 9), map('service.name', 'x'), 2000000);
-- expected_rows --
[
  ["span", {"__cerberus_parentSpanID": "", "__cerberus_traceDurationNs": "5002000000", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "x"}, "2026-01-01T00:00:00Z", 2]
]
-- chplan --
Aggregate groupBy=[TraceId AS TraceId, SpanId AS SpanId] funcs=[FnCount(1) AS Value, FnAny(SpanName) AS MetricName, FnAny(ResourceAttributes) AS ResourceAttrs, FnAny(ParentSpanId) AS ParentSpanId, FnMin(Timestamp) AS TimeUnix, FnMin(FnToUnixNanos(Timestamp)) AS TraceStartNs, FnMax((FnToUnixNanos(Timestamp) + FnToInt64(Duration))) AS TraceEndNs]
  Filter predicate=true
    Scan(otel_traces)
-- parity_exempt --
reason: duplicate-span-seed
detail: seed delivers the same (TraceId, SpanId) on more than one row on purpose, and span identity is the comparison key, so `{} | coalesce()` cannot be matched against a SET of matched spans
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_traceDurationNs"
[3] int64 = 1
[4] bool = true
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;agg=2
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `MetricName` AS `MetricName`, mapConcat(`ResourceAttrs`, map(?, `TraceId`, ?, `ParentSpanId`, ?, toString((`TraceEndNs` - `TraceStartNs`)))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, toFloat64(`Value`) AS `Value` FROM (SELECT `TraceId` AS `TraceId`, `SpanId` AS `SpanId`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE ?) GROUP BY `TraceId`, `SpanId`)
