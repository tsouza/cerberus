# A pipeline may open with `by(...)`. Reference Tempo hands it every span of
# every trace, as `{ }` would, so `by(resource.service.name)` answers what
# `{ } | by(resource.service.name)` answers: one group per (trace, service)
# — frontend and backend on trace ...01, checkout on ...02, orders on ...03 —
# which the search summary folds into one row per trace, counting its spans.
-- query.traceql --
by(resource.service.name)
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String),
    Duration UInt64
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('a0000000000000000000000000000001', '0000000000000001', '', 'GET /a', toDateTime64('2026-01-01 00:00:00', 9), map('service.name', 'frontend'), 10000000),
    ('a0000000000000000000000000000001', '0000000000000002', '0000000000000001', 'db.query', toDateTime64('2026-01-01 00:00:01', 9), map('service.name', 'backend'), 20000000),
    ('a0000000000000000000000000000001', '0000000000000003', '0000000000000001', 'db.query', toDateTime64('2026-01-01 00:00:02', 9), map('service.name', 'backend'), 30000000),
    ('a0000000000000000000000000000002', '0000000000000004', '', 'GET /b', toDateTime64('2026-01-01 00:00:03', 9), map('service.name', 'checkout'), 10000000),
    ('a0000000000000000000000000000002', '0000000000000005', '0000000000000004', 'cache.get', toDateTime64('2026-01-01 00:00:04', 9), map('service.name', 'checkout'), 20000000),
    ('a0000000000000000000000000000003', '0000000000000006', '', 'POST /c', toDateTime64('2026-01-01 00:00:05', 9), map('service.name', 'orders'), 10000000);
-- expected_rows --
[
  ["GET /a", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "2030000000", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "frontend"}, "2026-01-01T00:00:00Z", 3],
  ["GET /b", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "1020000000", "__cerberus_traceID": "a0000000000000000000000000000002", "service.name": "checkout"}, "2026-01-01T00:00:03Z", 2],
  ["POST /c", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "10000000", "__cerberus_traceID": "a0000000000000000000000000000003", "service.name": "orders"}, "2026-01-01T00:00:05Z", 1]
]
-- parity_exempt --
reason: no-comparable-oracle
detail: `by(resource.service.name)` groups the spanset: its rows carry __cerberus_traceID and no __cerberus_spanID because each is a group representative, not a span, so there is no span set for runTempoParity to compare
-- args --
[0] string = "service.name"
[1] int64 = 1
[2] bool = true
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_rootMatched"
[2] string = "__cerberus_traceDurationNs"
[3] string = "service.name"
[4] int64 = 1
[5] string = ""
[6] string = "0"
[7] string = "0000000000000000"
[8] string = ""
[9] string = "0"
[10] string = "0000000000000000"
[11] string = "service.name"
[12] string = ""
[13] string = "0"
[14] string = "0000000000000000"
[15] bool = true
-- chplan --
Aggregate groupBy=[TraceId AS TraceId, ResourceAttributes["service.name"] AS GroupKey] funcs=[FnAny(SpanId) AS SpanId, FnCount(1) AS Value, FnAny(SpanName) AS MetricName, FnAny(ResourceAttributes) AS ResourceAttrs, FnAny(ParentSpanId) AS ParentSpanId, FnMin(Timestamp) AS TimeUnix, FnMin(FnToUnixNanos(Timestamp)) AS TraceStartNs, FnMax((FnToUnixNanos(Timestamp) + FnToInt64(Duration))) AS TraceEndNs]
  Filter predicate=true
    Scan(otel_traces)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,classic_bucket_layout_two_level,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;agg=1
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT `TraceId` AS `TraceId`, `ResourceAttributes`[?] AS `GroupKey`, any(`SpanId`) AS `SpanId`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `TraceId`, `GroupKey`
-- sql_optimized --
SELECT `RootName` AS `MetricName`, map(?, `TraceId`, ?, toString(`RootMatched`), ?, toString((`TraceEndNs` - `TraceStartNs`)), ?, toString(`RootService`)) AS `Attributes`, `TimeUnix` AS `TimeUnix`, toFloat64(`Value`) AS `Value` FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs`, max((`ParentSpanId` IN (?, ?, ?))) AS `RootMatched`, argMax(`SpanName`, (`ParentSpanId` IN (?, ?, ?))) AS `RootName`, argMax(`ResourceAttributes`[?], (`ParentSpanId` IN (?, ?, ?))) AS `RootService` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE ?) GROUP BY `TraceId`)
