-- query.traceql --
{ status != ok }
-- sql --
SELECT * FROM `otel_traces` WHERE (`StatusCode` != ?)
-- args --
[0] string = "Ok"
-- seed --
CREATE TABLE otel_traces (
    StatusCode String,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (StatusCode, TraceId, SpanId) VALUES
    ('Ok', 'a0000000000000000000000000000001', '0000000000000001'),
    ('Error', 'a0000000000000000000000000000001', '0000000000000002'),
    ('Unset', 'a0000000000000000000000000000001', '0000000000000003');
