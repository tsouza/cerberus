-- query.traceql --
{ status = error && kind = server }
-- sql --
SELECT * FROM `otel_traces` PREWHERE (`StatusCode` = ?) WHERE (`SpanKind` = ?)
-- args --
[0] string = "Error"
[1] string = "Server"
-- seed --
CREATE TABLE otel_traces (
    StatusCode String,
    SpanKind String MATERIALIZED if(StatusCode = 'Error', 'Server', 'Client'),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY StatusCode;
INSERT INTO otel_traces (StatusCode, TraceId, SpanId) VALUES
    ('Error', 'a0000000000000000000000000000001', '0000000000000001'),
    ('Ok', 'a0000000000000000000000000000001', '0000000000000002'),
    ('Unset', 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=((StatusCode = "Error") AND (SpanKind = "Server"))
  Scan(otel_traces)

-- parity --
oracle: tempo
endpoint: /api/search
scope: full
