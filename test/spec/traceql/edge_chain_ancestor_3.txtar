    ('a0000000000000000000000000000002', '0000000000000010', '',                 'leaf'),
    ('a0000000000000000000000000000002', '0000000000000011', '',                 'root'),
    ('a0000000000000000000000000000003', '0000000000000020', '',                 'root'),
    ('a0000000000000000000000000000003', '0000000000000021', '0000000000000020', 'leaf');
