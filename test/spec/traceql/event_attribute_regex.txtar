-- query.traceql --
{ event.exception.message =~ ".*timeout.*" }
-- sql --
SELECT * FROM `otel_traces` WHERE arrayExists(x -> match(x[?], ?), `Events`.`Attributes`)
-- args --
[0] string = "exception.message"
[1] string = "^(?:.*timeout.*)$"
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    `Events.Attributes` Array(Map(String, String)) MATERIALIZED if(_idx = 0, [map('exception.message', 'db timeout after 5s')], [map('exception.message', 'connection refused')]),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=nestedArrayExists(Events.Attributes["exception.message"] =~ ".*timeout.*")
  Scan(otel_traces)

-- parity --
oracle: tempo
endpoint: /api/search
scope: full
