-- query.traceql --
{ span:id = "0123456789abcdef" }
-- sql --
SELECT * FROM `otel_traces` WHERE (`SpanId` = ?)
-- args --
[0] string = "0123456789abcdef"
-- seed --
CREATE TABLE otel_traces (
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('0000000000000001'),
    ('0123456789abcdef'),
    ('fedcba9876543210');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0123456789abcdef", "__cerberus_traceID": ""}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(SpanId = "0123456789abcdef")
  Scan(otel_traces)
