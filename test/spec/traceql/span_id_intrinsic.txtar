-- query.traceql --
{ span:id = "0123456789abcdef" }
-- sql --
SELECT * FROM `otel_traces` WHERE (`SpanId` = ?)
-- args --
[0] string = "0123456789abcdef"
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    TraceId String
) ENGINE = Memory;
INSERT INTO otel_traces (SpanId, TraceId) VALUES
    ('0000000000000001', 'a0000000000000000000000000000001'),
    ('0123456789abcdef', 'a0000000000000000000000000000001'),
    ('fedcba9876543210', 'a0000000000000000000000000000001');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0123456789abcdef", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(SpanId = "0123456789abcdef")
  Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "0123456789abcdef"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`SpanId` = ?))
