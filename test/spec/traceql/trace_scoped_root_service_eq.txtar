-- chplan --
Filter predicate=(TraceId IN {Project [TraceId] ; Filter predicate=(_cerb_trace_scoped_val = "checkout") ; Aggregate groupBy=[TraceId AS TraceId] funcs=[argMinIf(ServiceName, Timestamp, (ParentSpanId IN ("", "0000000000000000"))) AS _cerb_trace_scoped_val] ; Scan(otel_traces)})
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE `TraceId` IN (SELECT `TraceId` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, argMinIf(`ServiceName`, `Timestamp`, (`ParentSpanId` IN (?, ?))) AS `_cerb_trace_scoped_val` FROM (SELECT * FROM `otel_traces`) GROUP BY `TraceId`) WHERE (`_cerb_trace_scoped_val` = ?)))
