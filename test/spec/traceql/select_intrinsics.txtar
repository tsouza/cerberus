-- query.traceql --
{ status = error } | select(name, status, kind, span:id)
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    Timestamp DateTime64(9),
    SpanName String,
    StatusCode String,
    SpanKind String
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('a0000000000000000000000000000001', '0000000000000001', toDateTime64('2026-01-01 00:00:00', 9), 'checkout', 'Error', 'Server'),
    ('a0000000000000000000000000000002', '0000000000000002', toDateTime64('2026-01-01 00:00:01', 9), 'healthz', 'Ok', 'Client');
-- expected_rows --
[
  ["checkout", {"__cerberus_parentSpanID": "", "__cerberus_sel_name": "checkout", "__cerberus_sel_str_kind": "server", "__cerberus_sel_str_status": "error", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "2026-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "Error"
-- chplan --
Project [TraceId, SpanId, Timestamp, SpanName AS name, StatusCode AS status, SpanKind AS kind, SpanId AS span:id]
  Filter predicate=(StatusCode = "Error")
    Scan(otel_traces)
-- sql --
SELECT `TraceId`, `SpanId`, `Timestamp`, `SpanName` AS `name`, `StatusCode` AS `status`, `SpanKind` AS `kind`, `SpanId` AS `span:id` FROM (SELECT * FROM `otel_traces` WHERE (`StatusCode` = ?))
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "__cerberus_sel_name"
[4] string = "__cerberus_sel_str_status"
[5] string = "__cerberus_sel_str_kind"
[6] string = "Error"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`, ?, toString(`SpanName`), ?, toString(lower(`StatusCode`)), ?, toString(lower(`SpanKind`)))) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanKind`, `SpanName`, `StatusCode`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`StatusCode` = ?))
