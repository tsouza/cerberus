-- query.traceql --
{ resource.service.name = "frontend" } | select(span.http.method)
-- sql --
SELECT `TraceId`, `SpanId`, `Timestamp`, `SpanAttributes`[?] AS `http.method` FROM (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?))
-- args --
[0] string = "http.method"
[1] string = "service.name"
[2] string = "frontend"
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    Timestamp DateTime64(9),
    SpanAttributes Map(String, String),
    ResourceAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('0123456789abcdef0123456789abcdef', '0000000000000001', toDateTime64('2026-01-01 00:00:00', 9), map('http.method', 'GET'), map('service.name', 'frontend')),
    ('fedcba9876543210fedcba9876543210', '0000000000000002', toDateTime64('2026-01-01 00:00:01', 9), map('http.method', 'POST'), map('service.name', 'frontend')),
    ('aabbccddeeff00112233445566778899', '0000000000000003', toDateTime64('2026-01-01 00:00:02', 9), map('http.method', 'GET'), map('service.name', 'backend'));
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_sel_str_http.method": "GET", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "0123456789abcdef0123456789abcdef", "service.name": "frontend"}, "2026-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_sel_str_http.method": "POST", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "fedcba9876543210fedcba9876543210", "service.name": "frontend"}, "2026-01-01T00:00:01Z", 0]
]
-- chplan --
Project [TraceId, SpanId, Timestamp, SpanAttributes["http.method"] AS http.method]
  Filter predicate=(ResourceAttributes["service.name"] = "frontend")
    Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "__cerberus_sel_str_http.method"
[4] string = "http.method"
[5] string = "service.name"
[6] string = "frontend"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`, ?, `SpanAttributes`[?])) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?))
