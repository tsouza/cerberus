-- query.traceql --
{ .ratio = 0.95 }
-- sql --
SELECT * FROM `otel_traces` WHERE (if(mapContains(`SpanAttributes`, ?), toFloat64OrNull(`SpanAttributes`[?]), toFloat64OrNull(`ResourceAttributes`[?])) = toFloat64(?))
-- args --
[0] string = "ratio"
[1] string = "ratio"
[2] string = "ratio"
[3] float64 = 0.95
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    SpanAttributes Map(String, String) MATERIALIZED map('ratio', if(_idx = 0, '0.95', '0.5')),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(FnIf(FnMapContainsKey(SpanAttributes, "ratio"), FnToFloat64OrNull(SpanAttributes["ratio"]), FnToFloat64OrNull(ResourceAttributes["ratio"])) = 0.95)
  Scan(otel_traces)
-- parity_exempt --
reason: oracle-untyped-attributes
detail: `{ .ratio = 0.95 }` compares an attribute against a non-string literal, and the oracle sees every attribute as a String static (#3259)
