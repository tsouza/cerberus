-- query.traceql --
{ status = error } | rate() by (resource.service.name)
-- seed --
CREATE TABLE otel_traces (
    StatusCode String,
    ResourceAttributes Map(String, String),
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (StatusCode, ResourceAttributes, TraceId, SpanId) VALUES
    ('Error', map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000001'),
    ('Error', map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000002'),
    ('Ok', map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000003'),
    ('Error', map('service.name', 'backend'), 'a0000000000000000000000000000001', '0000000000000004');
-- expected_rows --
[
  ["backend", 1],
  ["frontend", 2]
]
-- args --
[0] string = "service.name"
[1] int64 = 1
[2] string = "Error"
-- chplan --
MetricsAggregate op=rate groupBy=[ResourceAttributes["service.name"] AS service.name|resource.service.name] valueAlias=Value
  Filter predicate=(StatusCode = "Error")
    Scan(otel_traces)
-- sql --
SELECT `ResourceAttributes`[?] AS `service.name`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE (`StatusCode` = ?)) GROUP BY `service.name`
-- parity_exempt --
reason: no-comparable-oracle
detail: `{ status = error } | rate() by (resource.service.name)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
