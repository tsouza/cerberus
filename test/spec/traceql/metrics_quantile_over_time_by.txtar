-- query.traceql --
{} | quantile_over_time(duration, 0.95) by (resource.service.name)
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    ResourceAttributes Map(String, String),
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (Duration, ResourceAttributes, TraceId, SpanId) VALUES
    (100000000, map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000001'),
    (100000000, map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000002'),
    (100000000, map('service.name', 'frontend'), 'a0000000000000000000000000000001', '0000000000000003'),
    (200000000, map('service.name', 'backend'), 'a0000000000000000000000000000001', '0000000000000004'),
    (200000000, map('service.name', 'backend'), 'a0000000000000000000000000000001', '0000000000000005');
-- expected_rows --
[
  ["backend", 0.2],
  ["frontend", 0.1]
]
-- args --
[0] string = "service.name"
[1] float64 = 0.95
[2] float64 = 1e+09
[3] bool = true
-- chplan --
MetricsAggregate op=quantile_over_time attr=(Duration / 1e+09) groupBy=[ResourceAttributes["service.name"] AS service.name|resource.service.name] quantiles=[0.95] duration=true valueAlias=Value
  Filter predicate=true
    Scan(otel_traces)
-- sql --
SELECT `ResourceAttributes`[?] AS `service.name`, quantileExactInclusive(toFloat64(?))((`Duration` / toFloat64(?))) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `service.name`

-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | quantile_over_time(duration, 0.95) by (resource.service.name)` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
