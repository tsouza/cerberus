-- query.traceql --
{ event:name = "exception" }
-- sql --
SELECT * FROM `otel_traces` WHERE arrayExists(x -> x = ?, `Events`.`Name`)
-- args --
[0] string = "exception"
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    `Events.Name` Array(LowCardinality(String)) MATERIALIZED if(_idx = 0, ['exception'], ['heartbeat']),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=nestedArrayExists(Events.Name = "exception")
  Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
