A unary `!` over a static comparison as the whole spanset filter.
`!("a" = "b")` is true, so every span matches; the top-level rule for a NOT
over an attribute comparison (#1712, no span matches) does not apply to a
span-free operand.

-- query.traceql --
{ !("a" = "b") }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanKind String,
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, SpanKind, TraceId) VALUES
    ('aaaa', 'Server', 'a0000000000000000000000000000001'),
    ('bbbb', 'Client', 'a0000000000000000000000000000001'),
    ('cccc', 'Client', 'a0000000000000000000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "aaaa", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "bbbb", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "cccc", "__cerberus_traceID": "a0000000000000000000000000000002"}, "1970-01-01T00:00:00Z", 0]
]
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args --
[0] string = "a"
[1] string = "b"
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "a"
[4] string = "b"
-- chplan --
Filter predicate=FnNot(("a" = "b"))
  Scan(otel_traces)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT * FROM `otel_traces` WHERE not((? = ?))
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE not((? = ?)))
