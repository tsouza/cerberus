-- query.traceql --
{ resource.service.name = "frontend" } | select(resource.service.namespace, resource.k8s.cluster.name)
-- sql --
SELECT `TraceId`, `SpanId`, `Timestamp`, `ResourceAttributes`[?] AS `service.namespace`, `ResourceAttributes`[?] AS `k8s.cluster.name` FROM (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?))
-- args --
[0] string = "service.namespace"
[1] string = "k8s.cluster.name"
[2] string = "service.name"
[3] string = "frontend"
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('a0000000000000000000000000000001', '0000000000000001', toDateTime64('2026-01-01 00:00:00', 9), map('service.name', 'frontend', 'service.namespace', 'web', 'k8s.cluster.name', 'prod')),
    ('a0000000000000000000000000000002', '0000000000000002', toDateTime64('2026-01-01 00:00:01', 9), map('service.name', 'backend',  'service.namespace', 'api', 'k8s.cluster.name', 'stg'));
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_sel_str_k8s.cluster.name": "prod", "__cerberus_sel_str_service.namespace": "web", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001", "k8s.cluster.name": "prod", "service.name": "frontend", "service.namespace": "web"}, "2026-01-01T00:00:00Z", 0]
]
-- chplan --
Project [TraceId, SpanId, Timestamp, ResourceAttributes["service.namespace"] AS service.namespace, ResourceAttributes["k8s.cluster.name"] AS k8s.cluster.name]
  Filter predicate=(ResourceAttributes["service.name"] = "frontend")
    Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "__cerberus_sel_str_service.namespace"
[4] string = "service.namespace"
[5] string = "__cerberus_sel_str_k8s.cluster.name"
[6] string = "k8s.cluster.name"
[7] string = "service.name"
[8] string = "frontend"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`, ?, `ResourceAttributes`[?], ?, `ResourceAttributes`[?])) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?))
