# A metrics function after by() and a spanset-aggregate filter observes the
# spans of each group the filter passes. by() splits each trace's spans by
# name, so count() > 1 counts the spans of one (trace, name) group, as
# reference Tempo's Aggregate counts the spans of one input spanset.
#
#   trace ...01  a 00:00:30, a 00:00:31, b 00:01:30
#   trace ...02  a 00:00:40
#   trace ...03  c 00:01:10, c 00:01:20, d 00:01:40, c 00:01:50
#
# The groups with more than one span are ...01/a (00:00:30, 00:00:31) and
# ...03/c (00:01:10, 00:01:20, 00:01:50). ...01/b, ...02/a and ...03/d hold one
# span each. ...02/a stays apart from ...01/a because by() groups the spans
# of one trace at a time; joined to it, the first bucket would hold 3.
#
# Buckets (anchor - 60s, anchor]: 00:01:00 holds 2 spans (rate 2/60),
# 00:02:00 holds 3 spans (rate 3/60). Counting per trace instead would also
# keep ...01/b and ...03/d, putting 5 spans in the second bucket.
-- query.traceql --
{ } | by(name) | count() > 1 | rate()
-- metrics_window --
1704067260 1704067320 60
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = MergeTree ORDER BY (Timestamp, SpanId);
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, Timestamp, Duration, SpanName) VALUES
    ('a0000000000000000000000000000001', '0000000000000001', '', toDateTime64('2024-01-01 00:00:30', 9), 1000000000, 'a'),
    ('a0000000000000000000000000000001', '0000000000000002', '0000000000000001', toDateTime64('2024-01-01 00:00:31', 9), 1000000000, 'a'),
    ('a0000000000000000000000000000001', '0000000000000003', '0000000000000001', toDateTime64('2024-01-01 00:01:30', 9), 1000000000, 'b'),
    ('a0000000000000000000000000000002', '0000000000000016', '', toDateTime64('2024-01-01 00:00:40', 9), 1000000000, 'a'),
    ('a0000000000000000000000000000003', '0000000000000032', '', toDateTime64('2024-01-01 00:01:10', 9), 1000000000, 'c'),
    ('a0000000000000000000000000000003', '0000000000000033', '0000000000000032', toDateTime64('2024-01-01 00:01:20', 9), 1000000000, 'c'),
    ('a0000000000000000000000000000003', '0000000000000034', '0000000000000032', toDateTime64('2024-01-01 00:01:40', 9), 1000000000, 'd'),
    ('a0000000000000000000000000000003', '0000000000000035', '0000000000000032', toDateTime64('2024-01-01 00:01:50', 9), 1000000000, 'c');
-- expected_rows --
[
  ["2024-01-01T00:01:00Z", 0.03333333333333333],
  ["2024-01-01T00:02:00Z", 0.05]
]
-- parity_exempt --
reason: no-comparable-oracle
detail: `{ } | by(name) | count() > 1 | rate()` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
