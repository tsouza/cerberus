-- query.traceql --
{ name = "checkout" || name = "orders" }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanName String,
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, SpanName, TraceId) VALUES
    ('aaaa', 'checkout', 'a0000000000000000000000000000001'),
    ('bbbb', 'orders', 'a0000000000000000000000000000001'),
    ('cccc', 'payment', 'a0000000000000000000000000000001');
-- args --
[0] string = "checkout"
[1] string = "orders"
-- chplan --
Filter predicate=(SpanName IN ("checkout", "orders"))
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE (`SpanName` IN (?, ?))
-- expected_rows --
[
  ["checkout", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "aaaa", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["orders", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "bbbb", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]

-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "checkout"
[4] string = "orders"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`SpanName` IN (?, ?)))
