-- query.traceql --
{ span.http.status_code >= 500 }
-- sql --
SELECT * FROM `otel_traces` WHERE (toFloat64OrNull(`SpanAttributes`[?]) >= ?)
-- args --
[0] string = "http.status_code"
[1] int64 = 500
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    SpanAttributes Map(String, String) MATERIALIZED map('http.status_code', if(_idx = 0, '500', if(_idx = 1, '503', '200'))),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002'),
    (2, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(FnToFloat64OrNull(SpanAttributes["http.status_code"]) >= 500)
  Scan(otel_traces)
-- parity_exempt --
reason: oracle-untyped-attributes
detail: `{ span.http.status_code >= 500 }` compares an attribute against a non-string literal, and the oracle sees every attribute as a String static (#3259)
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "http.status_code"
[4] int64 = 500
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (toFloat64OrNull(`SpanAttributes`[?]) >= ?))
