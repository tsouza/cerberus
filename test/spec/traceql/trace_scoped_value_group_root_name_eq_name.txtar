# A by() key comparing a trace-scoped intrinsic with a span operand is
# evaluated per span: each span compares its OWN trace's root name with its
# OWN name. The rootless trace compares '' with each span's name.
#
#   trace ...01  rootName 'm', rootServiceName 'frontend', traceDuration 3s
#     0001 root  'm' frontend  server    0s +3s
#     0002       'm' backend   client    1s +1s
#     0003       'a' frontend  internal  1s +2s
#     0004       'z' db        client    2s +0.5s
#   trace ...02  NO root span (0010's parent is a span no row carries):
#                rootName '', rootServiceName '', traceDuration 2s
#     0010       'b' svc-b     internal  0s +2s
#     0011       ''  ''        server    1s +1s
#   trace ...03  rootName 'n', rootServiceName 'api', traceDuration 1s
#     0020 root  'n' api       server    0s +1s
#     0021       'c' api       client    0s +1s
#   trace ...04  rootName 'q', rootServiceName 'edge', traceDuration 3s,
#                which no single span covers (the longest span is 1s)
#     0030 root  'q' edge      server    0s +1s
#     0031       'w' edge      client    2s +1s
#
# by() groups within each trace. Groups: trace 01 true (0001, 0002) and
# false (0003, 0004); trace 02 true (0011) and false (0010); trace 03 true
# (0020) and false (0021); trace 04 true (0030) and false (0031).
# The search response folds each trace's groups into one summary row, so
# -- expected_rows -- holds one row per trace and the group key itself is
# pinned by the -- sql -- / -- chplan -- sections.
-- query.traceql --
{ } | by(rootName = name)
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = Memory;
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, Timestamp, Duration, SpanName, ServiceName, SpanKind, ResourceAttributes, SpanAttributes) VALUES
    ('a0000000000000000000000000000001', '0000000000000001', '',                 toDateTime64('2024-01-01 00:00:00', 9), 3000000000, 'm', 'frontend', 'Server',   map('service.name', 'frontend'), map()),
    ('a0000000000000000000000000000001', '0000000000000002', '0000000000000001', toDateTime64('2024-01-01 00:00:01', 9), 1000000000, 'm', 'backend',  'Client',   map('service.name', 'backend'),  map('peer', 'm')),
    ('a0000000000000000000000000000001', '0000000000000003', '0000000000000001', toDateTime64('2024-01-01 00:00:01', 9), 2000000000, 'a', 'frontend', 'Internal', map('service.name', 'frontend'), map()),
    ('a0000000000000000000000000000001', '0000000000000004', '0000000000000001', toDateTime64('2024-01-01 00:00:02', 9), 500000000,  'z', 'db',       'Client',   map('service.name', 'db'),       map('peer', 'x')),
    ('a0000000000000000000000000000002', '0000000000000010', '0000000000000000', toDateTime64('2024-01-01 00:00:00', 9), 2000000000, 'b', 'svc-b',    'Internal', map('service.name', 'svc-b'),    map()),
    ('a0000000000000000000000000000002', '0000000000000011', '0000000000000010', toDateTime64('2024-01-01 00:00:01', 9), 1000000000, '',  '',         'Server',   map('service.name', ''),         map()),
    ('a0000000000000000000000000000003', '0000000000000020', '',                 toDateTime64('2024-01-01 00:00:00', 9), 1000000000, 'n', 'api',      'Server',   map('service.name', 'api'),      map()),
    ('a0000000000000000000000000000003', '0000000000000021', '0000000000000020', toDateTime64('2024-01-01 00:00:00', 9), 1000000000, 'c', 'api',      'Client',   map('service.name', 'api'),      map('peer', 'n')),
    ('a0000000000000000000000000000004', '0000000000000030', '',                 toDateTime64('2024-01-01 00:00:00', 9), 1000000000, 'q', 'edge',     'Server',   map('service.name', 'edge'),     map()),
    ('a0000000000000000000000000000004', '0000000000000031', '0000000000000030', toDateTime64('2024-01-01 00:00:02', 9), 1000000000, 'w', 'edge',     'Client',   map('service.name', 'edge'),     map('peer', 'q'));
-- expected_rows --
[
  ["b", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "2000000000", "__cerberus_traceID": "a0000000000000000000000000000002", "service.name": "svc-b"}, "2024-01-01T00:00:00Z", 2],
  ["m", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "3000000000", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "frontend"}, "2024-01-01T00:00:00Z", 4],
  ["n", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "1000000000", "__cerberus_traceID": "a0000000000000000000000000000003", "service.name": "api"}, "2024-01-01T00:00:00Z", 2],
  ["q", {"__cerberus_rootMatched": "1", "__cerberus_traceDurationNs": "3000000000", "__cerberus_traceID": "a0000000000000000000000000000004", "service.name": "edge"}, "2024-01-01T00:00:00Z", 2]
]
-- parity_exempt --
reason: no-comparable-oracle
detail: `{ } | by(rootName = name)` groups the spanset: its rows carry __cerberus_traceID and no __cerberus_spanID because each is a group representative, not a span, so there is no span set for runTempoParity to compare
-- args --
[0] string = ""
[1] int64 = 1
[2] bool = true
[3] string = ""
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_rootMatched"
[2] string = "__cerberus_traceDurationNs"
[3] string = "service.name"
[4] int64 = 1
[5] string = ""
[6] string = "0"
[7] string = "0000000000000000"
[8] string = ""
[9] string = "0"
[10] string = "0000000000000000"
[11] string = "service.name"
[12] string = ""
[13] string = "0"
[14] string = "0000000000000000"
[15] bool = true
[16] string = ""
-- chplan --
Aggregate groupBy=[TraceId AS TraceId, (FnIfNull(_cerb_root_name, "") = SpanName) AS GroupKey] funcs=[FnAny(SpanId) AS SpanId, FnCount(1) AS Value, FnAny(SpanName) AS MetricName, FnAny(ResourceAttributes) AS ResourceAttrs, FnAny(ParentSpanId) AS ParentSpanId, FnMin(Timestamp) AS TimeUnix, FnMin(FnToUnixNanos(Timestamp)) AS TraceStartNs, FnMax((FnToUnixNanos(Timestamp) + FnToInt64(Duration))) AS TraceEndNs]
  TraceLookupFilter lookups=1 predicate=<nil> exposeLookups
    Filter predicate=true
      Scan(otel_traces)
    Aggregate groupBy=[TraceId AS _cerb_lookup_trace_id] funcs=[FnArgMin(SpanName, Timestamp) AS _cerb_root_name]
      Filter predicate=(ParentSpanId = "")
        Scan(otel_traces)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,classic_bucket_layout_two_level,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;agg=1;join
max_bytes_before_external_group_by=536870912
max_bytes_before_external_join=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT `TraceId` AS `TraceId`, (ifNull(`_cerb_root_name`, ?) = `SpanName`) AS `GroupKey`, any(`SpanId`) AS `SpanId`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT `m`.*, `l0`.`_cerb_root_name` AS `_cerb_root_name` FROM (SELECT * FROM `otel_traces` WHERE ?) AS m LEFT JOIN (SELECT `TraceId` AS `_cerb_lookup_trace_id`, argMin(`SpanName`, `Timestamp`) AS `_cerb_root_name` FROM (SELECT * FROM `otel_traces` WHERE (`ParentSpanId` = ?)) GROUP BY `_cerb_lookup_trace_id`) AS l0 ON m.`TraceId` = l0.`_cerb_lookup_trace_id`) GROUP BY `TraceId`, `GroupKey`
-- sql_optimized --
SELECT `RootName` AS `MetricName`, map(?, `TraceId`, ?, toString(`RootMatched`), ?, toString((`TraceEndNs` - `TraceStartNs`)), ?, toString(`RootService`)) AS `Attributes`, `TimeUnix` AS `TimeUnix`, toFloat64(`Value`) AS `Value` FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs`, max((`ParentSpanId` IN (?, ?, ?))) AS `RootMatched`, argMax(`SpanName`, (`ParentSpanId` IN (?, ?, ?))) AS `RootName`, argMax(`ResourceAttributes`[?], (`ParentSpanId` IN (?, ?, ?))) AS `RootService` FROM (SELECT `m`.*, `l0`.`_cerb_root_name` AS `_cerb_root_name` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE ?) AS m LEFT JOIN (SELECT `TraceId` AS `_cerb_lookup_trace_id`, argMin(`SpanName`, `Timestamp`) AS `_cerb_root_name` FROM (SELECT `ParentSpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`ParentSpanId` = ?)) GROUP BY `_cerb_lookup_trace_id`) AS l0 ON m.`TraceId` = l0.`_cerb_lookup_trace_id`) GROUP BY `TraceId`)
