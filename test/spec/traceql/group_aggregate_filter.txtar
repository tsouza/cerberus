# A spanset-aggregate filter after by() evaluates once per group: count() > 1
# counts the spans of one (trace, name) group, as reference Tempo's Aggregate
# counts the spans of one input spanset, and passes the groups with more than
# one span. Every span is a root, so each group's envelope picks are
# deterministic.
#
#   trace ...01  a, a, b   passes ...01/a (2 spans)
#   trace ...02  a         dropped
#   trace ...03  c, c, d, c passes ...03/c (3 spans)
#   trace ...04  e, f      dropped: two groups of one span each
#
# Counting the groups of each trace instead would pass ...01, ...03 and
# ...04, each with a count of 2.
-- query.traceql --
{ } | by(name) | count() > 1
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = MergeTree ORDER BY (Timestamp, SpanId);
