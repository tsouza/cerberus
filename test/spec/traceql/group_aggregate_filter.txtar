    ('a0000000000000000000000000000001', '0000000000000003', '', toDateTime64('2024-01-01 00:01:30', 9), 1000000000, 'b'),
    ('a0000000000000000000000000000002', '0000000000000016', '', toDateTime64('2024-01-01 00:00:40', 9), 1000000000, 'a'),
    ('a0000000000000000000000000000003', '0000000000000032', '', toDateTime64('2024-01-01 00:01:10', 9), 1000000000, 'c'),
    ('a0000000000000000000000000000003', '0000000000000033', '', toDateTime64('2024-01-01 00:01:20', 9), 1000000000, 'c'),
    ('a0000000000000000000000000000003', '0000000000000034', '', toDateTime64('2024-01-01 00:01:40', 9), 1000000000, 'd'),
    ('a0000000000000000000000000000003', '0000000000000035', '', toDateTime64('2024-01-01 00:01:50', 9), 1000000000, 'c'),
    ('a0000000000000000000000000000004', '0000000000000048', '', toDateTime64('2024-01-01 00:00:50', 9), 1000000000, 'e'),
    ('a0000000000000000000000000000004', '0000000000000049', '', toDateTime64('2024-01-01 00:00:55', 9), 1000000000, 'f');
-- expected_rows --
[
  ["a", {"__cerberus_parentSpanID": "", "__cerberus_traceDurationNs": "2000000000", "__cerberus_traceID": "a0000000000000000000000000000001"}, "2024-01-01T00:00:30Z", 2],
  ["c", {"__cerberus_parentSpanID": "", "__cerberus_traceDurationNs": "41000000000", "__cerberus_traceID": "a0000000000000000000000000000003"}, "2024-01-01T00:01:10Z", 3]
]
-- parity_exempt --
reason: no-comparable-oracle
detail: `{ } | by(name) | count() > 1` reduces each group to one representative row carrying __cerberus_traceID and no __cerberus_spanID, so the answer is an aggregate rather than the span set runTempoParity compares
-- args --
[0] int64 = 1
[1] bool = true
[2] int64 = 1
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_traceDurationNs"
[3] int64 = 1
[4] bool = true
[5] int64 = 1
-- chplan --
Filter predicate=(Value > 1)
  Aggregate groupBy=[TraceId AS TraceId, SpanName AS GroupKey] funcs=[FnCount(1) AS Value, FnAny(SpanName) AS MetricName, FnAny(ResourceAttributes) AS ResourceAttrs, FnAny(ParentSpanId) AS ParentSpanId, FnMin(Timestamp) AS TimeUnix, FnMin(FnToUnixNanos(Timestamp)) AS TraceStartNs, FnMax((FnToUnixNanos(Timestamp) + FnToInt64(Duration))) AS TraceEndNs]
    Filter predicate=true
      Scan(otel_traces)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;agg=1
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT * FROM (SELECT `TraceId` AS `TraceId`, `SpanName` AS `GroupKey`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT * FROM `otel_traces` WHERE ?) GROUP BY `TraceId`, `GroupKey`) WHERE (`Value` > ?)
-- sql_optimized --
SELECT `MetricName` AS `MetricName`, mapConcat(`ResourceAttrs`, map(?, `TraceId`, ?, `ParentSpanId`, ?, toString((`TraceEndNs` - `TraceStartNs`)))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, toFloat64(`Value`) AS `Value` FROM (SELECT `TraceId` AS `TraceId`, sum(`Value`) AS `Value`, any(`MetricName`) AS `MetricName`, any(`ResourceAttrs`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`TimeUnix`) AS `TimeUnix`, min(`TraceStartNs`) AS `TraceStartNs`, max(`TraceEndNs`) AS `TraceEndNs` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, `SpanName` AS `GroupKey`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE ?) GROUP BY `TraceId`, `GroupKey`) WHERE (`Value` > ?)) GROUP BY `TraceId`)
