-- query.traceql --
{ resource.service.name = "checkout" } | rate() | topk(5)
-- sql --
SELECT * FROM (SELECT toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?))) ORDER BY `Value` DESC LIMIT 5
-- args --
