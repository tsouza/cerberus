-- query.traceql --
{ span.http.method != "GET" && span.http.method != "POST" }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanAttributes Map(String, String) MATERIALIZED if(SpanId = 'aaaa', map('http.method', 'GET'), if(SpanId = 'bbbb', map('http.method', 'POST'), if(SpanId = 'cccc', map('http.method', 'DELETE'), map('http.method', 'PUT')))),
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, TraceId) VALUES
    ('aaaa', 'a0000000000000000000000000000001'),
    ('bbbb', 'a0000000000000000000000000000001'),
    ('cccc', 'a0000000000000000000000000000001'),
    ('dddd', 'a0000000000000000000000000000001');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "cccc", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "dddd", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "http.method"
[1] string = "http.method"
[2] string = "GET"
[3] string = "POST"
-- chplan --
Filter predicate=(FnMapContainsKey(SpanAttributes, "http.method") AND FnNot((SpanAttributes["http.method"] IN ("GET", "POST"))))
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE mapContains(`SpanAttributes`, ?) AND not((`SpanAttributes`[?] IN (?, ?)))
