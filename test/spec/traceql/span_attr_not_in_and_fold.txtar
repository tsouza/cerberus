-- query.traceql --
{ span.http.method != "GET" && span.http.method != "POST" }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanAttributes Map(String, String) MATERIALIZED if(SpanId = 'aaaa', map('http.method', 'GET'), if(SpanId = 'bbbb', map('http.method', 'POST'), if(SpanId = 'cccc', map('http.method', 'DELETE'), map('http.method', 'PUT')))),
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, TraceId) VALUES
    ('aaaa', 'a0000000000000000000000000000001'),
    ('bbbb', 'a0000000000000000000000000000001'),
    ('cccc', 'a0000000000000000000000000000001'),
    ('dddd', 'a0000000000000000000000000000001');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "cccc", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "dddd", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "http.method"
[1] string = "http.method"
[2] string = "GET"
[3] string = "POST"
-- chplan --
Filter predicate=(FnMapContainsKey(SpanAttributes, "http.method") AND FnNot((SpanAttributes["http.method"] IN ("GET", "POST"))))
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE mapContains(`SpanAttributes`, ?) AND not((`SpanAttributes`[?] IN (?, ?)))
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "http.method"
[4] string = "http.method"
[5] string = "GET"
[6] string = "POST"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE mapContains(`SpanAttributes`, ?) AND not((`SpanAttributes`[?] IN (?, ?))))
