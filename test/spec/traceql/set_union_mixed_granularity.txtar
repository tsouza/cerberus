Spanset union (`||`) whose arms mix granularities: a parenthesised
sub-pipeline ending in a spanset aggregate on the left, a plain span
selector on the right. Reference Tempo keeps every span of a spanset
through `Aggregate.evaluate` / `ScalarFilter.evaluate` and then unions
SPANS (`uniqueSpans`), so the aggregate arm contributes the spans its
selector matched, restricted to the traces whose count passed — not one
row per trace. Lowering therefore un-collapses the GROUP BY into a
`TraceId IN (<cohort>)` semi-join over the same span rows, which also
gives both arms the identical `SELECT *` column list ClickHouse's
positional UNION requires (a count mismatch is CH error 258).

Seed: t1 has two `region=us` spans (count 2 > 1 — both survive), t2 has
one (count 1 — dropped), t3's span is `tier=gold` and enters via the
right arm alone. The cohort keeps only the aggregate function its HAVING
reads, so none of lowerAggregate's /api/search envelope columns are
referenced and the seed needs just the four the assertion prints, with
the attribute map MATERIALIZED off two of them.

-- query.traceql --
({ span.region = "us" } | count() > 1) || ({ span.tier = "gold" })
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    Region String,
    Tier String,
    SpanAttributes Map(String, String) MATERIALIZED map('region', Region, 'tier', Tier)
) ENGINE = MergeTree ORDER BY (TraceId, SpanId);
INSERT INTO otel_traces (TraceId, SpanId, Region, Tier) VALUES
    ('t1', 's1', 'us', 'silver'),
    ('t1', 's2', 'us', 'silver'),
    ('t2', 's3', 'us', 'silver'),
    ('t3', 's4', 'eu', 'gold');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "s1", "__cerberus_traceID": "t1"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "s2", "__cerberus_traceID": "t1"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "s4", "__cerberus_traceID": "t3"}, "1970-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "region"
[1] string = "us"
[2] int64 = 1
[3] string = "region"
[4] string = "us"
[5] int64 = 1
[6] string = "tier"
[7] string = "gold"
-- chplan --
SetOperation op=||
  Filter predicate=(TraceId IN {Project [TraceId] ; Filter predicate=(Value > 1) ; Aggregate groupBy=[TraceId AS TraceId] funcs=[FnCount(1) AS Value] ; Filter predicate=(SpanAttributes["region"] = "us") ; Scan(otel_traces)})
    Filter predicate=(SpanAttributes["region"] = "us")
      Scan(otel_traces)
  Filter predicate=(SpanAttributes["tier"] = "gold")
    Scan(otel_traces)
-- sql --
SELECT * FROM ((SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?)) WHERE `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?)) GROUP BY `TraceId`) WHERE (`Value` > ?)))) UNION ALL (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?))) LIMIT 1 BY `TraceId`, `SpanId`
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "region"
[4] string = "us"
[5] int64 = 1
[6] string = "region"
[7] string = "us"
[8] int64 = 1
[9] string = "tier"
[10] string = "gold"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
min_table_rows_to_use_projection_index=0
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT * FROM ((SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?) AND `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?)) GROUP BY `TraceId`) WHERE (`Value` > ?)))) UNION ALL (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?))) LIMIT 1 BY `TraceId`, `SpanId`)
