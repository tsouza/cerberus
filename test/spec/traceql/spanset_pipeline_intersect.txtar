Spanset set operation (&&) whose operands are full sub-pipelines, not
bare selectors: `({} | count() > 1) && ({} | count() > 1)`. Reference
Tempo accepts a parenthesised pipeline as a spanset-operation operand;
cerberus lowers each via the shared pipeline folder and intersects on
(TraceId, SpanId).

Both operands end in a spanset aggregate, so both un-collapse to the
span rows the aggregate consumed under a `TraceId IN (<cohort>)`
semi-join (see internal/traceql/spanset_operand.go) — the join key the
intersect emitter needs (`L.SpanId`) exists only at span granularity.
Each cohort keeps only the aggregate function its HAVING reads, so none
of lowerAggregate's /api/search envelope columns are referenced and the
seed needs just the four the assertion prints, with the attribute map
MATERIALIZED off two of them. `a1/s1` is the only span matching both
selectors.

-- query.traceql --
({ span.region = "us" } | count() > 0) && ({ span.tier = "gold" } | count() > 0)
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    SpanName String,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String),
    SpanAttributes Map(String, String),
    Duration UInt64
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('a1', 's1', 'span', toDateTime64('2024-01-01 00:00:00', 9), map('service.name', 'frontend'), map('region', 'us', 'tier', 'gold'),    10000000),
    ('a2', 's2', 'span', toDateTime64('2024-01-01 00:00:01', 9), map('service.name', 'frontend'), map('region', 'eu', 'tier', 'gold'),    20000000),
    ('a3', 's3', 'span', toDateTime64('2024-01-01 00:00:02', 9), map('service.name', 'backend'),  map('region', 'us', 'tier', 'silver'),  30000000);
-- expected_rows --
[
  ["a1", "s1", "span", "2024-01-01T00:00:00Z", {"service.name": "frontend"}, {"region": "us", "tier": "gold"}, 10000000]
]
-- args --
[0] string = "region"
[1] string = "us"
[2] int64 = 1
[3] string = "region"
[4] string = "us"
[5] int64 = 0
[6] string = "tier"
[7] string = "gold"
[8] int64 = 1
[9] string = "tier"
[10] string = "gold"
[11] int64 = 0
-- chplan --
SetOperation op=&&
  Filter predicate=(TraceId IN {Project [TraceId] ; Filter predicate=(Value > 0) ; Aggregate groupBy=[TraceId AS TraceId] funcs=[count(1) AS Value] ; Filter predicate=(SpanAttributes["region"] = "us") ; Scan(otel_traces)})
    Filter predicate=(SpanAttributes["region"] = "us")
      Scan(otel_traces)
  Filter predicate=(TraceId IN {Project [TraceId] ; Filter predicate=(Value > 0) ; Aggregate groupBy=[TraceId AS TraceId] funcs=[count(1) AS Value] ; Filter predicate=(SpanAttributes["tier"] = "gold") ; Scan(otel_traces)})
    Filter predicate=(SpanAttributes["tier"] = "gold")
      Scan(otel_traces)
-- sql --
SELECT L.* FROM (SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?)) WHERE `TraceId` IN (SELECT `TraceId` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?)) GROUP BY `TraceId`) WHERE (`Value` > ?)))) AS `L` INNER JOIN (SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?)) WHERE `TraceId` IN (SELECT `TraceId` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?)) GROUP BY `TraceId`) WHERE (`Value` > ?)))) AS `R` ON `L`.`TraceId` = `R`.`TraceId` AND `L`.`SpanId` = `R`.`SpanId`
