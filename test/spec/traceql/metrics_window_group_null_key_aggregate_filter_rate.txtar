-- chplan --
RangeWindow func= range=1m0s step=1m0s ts=Timestamp start=2024-01-01T00:01:00Z end=2024-01-01T00:02:00Z
  MetricsAggregate op=rate valueAlias=Value perTraceLookback=1h0m0s
    Filter predicate=(FnTuple(TraceId, FnTuple((FnToFloat64OrNull(SpanAttributes["zz"]) + 1))) IN {Project [TraceId, FnTuple(GroupKey)] ; Filter predicate=(Value > 2) ; Aggregate groupBy=[TraceId AS TraceId, (FnToFloat64OrNull(SpanAttributes["zz"]) + 1) AS GroupKey] funcs=[FnCount(1) AS Value] ; Filter predicate=true ; Scan(otel_traces)})
      Filter predicate=true
        Scan(otel_traces)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:rw;rw
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
query_cache_nondeterministic_function_handling=ignore
query_cache_ttl=300
use_query_cache=1
use_query_condition_cache=1
-- sql --
SELECT `anchor_ts`, toFloat64(sum(in_window)) / 60 AS `Value` FROM ((SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2024-01-01 00:02:00.000000000Z', 9) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `Timestamp`, parseDateTime64BestEffort('2024-01-01 00:02:00.000000000Z', 9)) - 60000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `Timestamp`, parseDateTime64BestEffort('2024-01-01 00:02:00.000000000Z', 9)) - 60000000000, toInt64(60000000000)) < 0) + 1), least(2, intDiv(dateDiff('nanosecond', `Timestamp`, parseDateTime64BestEffort('2024-01-01 00:02:00.000000000Z', 9)), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `Timestamp`, parseDateTime64BestEffort('2024-01-01 00:02:00.000000000Z', 9)), toInt64(60000000000)) < 0) + 1)))) AS `anchor_ts`, 1 AS `in_window` FROM (SELECT * FROM (SELECT * FROM `otel_traces` PREWHERE ? WHERE (`Timestamp` > fromUnixTimestamp64Nano(?)) AND (`Timestamp` <= fromUnixTimestamp64Nano(?))) WHERE tuple(`TraceId`, tuple((toFloat64OrNull(`SpanAttributes`[?]) + ?))) GLOBAL IN (SELECT `TraceId`, tuple(`GroupKey`) FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, (toFloat64OrNull(`SpanAttributes`[?]) + ?) AS `GroupKey`, toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` PREWHERE ? WHERE (`Timestamp` > fromUnixTimestamp64Nano(?)) AND (`Timestamp` <= fromUnixTimestamp64Nano(?))) GROUP BY `TraceId`, `GroupKey`) WHERE (`Value` > ?)))) WHERE `Timestamp` > parseDateTime64BestEffort('2024-01-01 00:01:00.000000000Z', 9) - toIntervalNanosecond(60000000000) AND `Timestamp` <= parseDateTime64BestEffort('2024-01-01 00:02:00.000000000Z', 9)) UNION ALL (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2024-01-01 00:02:00.000000000Z', 9) - toIntervalNanosecond(i * 60000000000), range(0, 2))) AS `anchor_ts`, 0 AS `in_window` FROM (SELECT 1 FROM `system`.`one`))) GROUP BY `anchor_ts`
