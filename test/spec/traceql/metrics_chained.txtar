-- query.traceql --
{} | rate() | topk(5) > 1
-- sql --
SELECT * FROM (SELECT * FROM (SELECT toFloat64(count(?)) AS `Value` FROM (SELECT * FROM `otel_traces` WHERE ?)) ORDER BY `Value` DESC LIMIT 5) WHERE (`Value` > toFloat64(?))
-- args --
[0] int64 = 1
[1] bool = true
[2] float64 = 1
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (10000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (20000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (30000000, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  [3]
]
-- chplan --
MetricsSecondStage op=threshold threshold=(> 1) valueAlias=Value
  MetricsSecondStage op=topk k=5 valueAlias=Value
    MetricsAggregate op=rate valueAlias=Value
      Filter predicate=true
        Scan(otel_traces)
-- parity_exempt --
reason: no-comparable-oracle
detail: `{} | rate() | topk(5) > 1` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
