-- query.traceql --
{ resource.service.name =~ ".+" } | count() > 0
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanName String,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String),
    Duration UInt64
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('t1', 'GET /a',    toDateTime64('2024-01-01 00:00:00', 9), map('service.name', 'frontend'), 10000000),
    ('t1', 'GET /a',    toDateTime64('2024-01-01 00:00:01', 9), map('service.name', 'frontend'), 20000000),
    ('t1', 'db.query',  toDateTime64('2024-01-01 00:00:02', 9), map('service.name', 'backend'),  30000000),
    ('t2', 'GET /b',    toDateTime64('2024-01-01 00:00:03', 9), map('service.name', 'checkout'), 10000000),
    ('t2', 'cache.get', toDateTime64('2024-01-01 00:00:04', 9), map('service.name', 'cache'),    20000000),
    ('t3', 'POST /c',   toDateTime64('2024-01-01 00:00:05', 9), map('service.name', 'orders'),   10000000);
-- args --
[0] int64 = 1
[1] string = "service.name"
[2] string = "service.name"
[3] string = "^(?:.+)$"
[4] int64 = 0
-- chplan --
Filter predicate=(Value > 0)
  Aggregate groupBy=[TraceId AS TraceId] funcs=[FnCount(1) AS Value, FnAny(SpanName) AS MetricName, FnAny(ResourceAttributes) AS ResourceAttrs, FnAny(ParentSpanId) AS ParentSpanId, FnMin(Timestamp) AS TimeUnix, FnMin(FnToUnixNanos(Timestamp)) AS TraceStartNs, FnMax((FnToUnixNanos(Timestamp) + FnToInt64(Duration))) AS TraceEndNs]
    Filter predicate=(FnMapContainsKey(ResourceAttributes, "service.name") AND (ResourceAttributes["service.name"] =~ ".+"))
      Scan(otel_traces)
-- sql --
SELECT * FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT * FROM `otel_traces` WHERE mapContains(`ResourceAttributes`, ?) AND match(`ResourceAttributes`[?], ?)) GROUP BY `TraceId`) WHERE (`Value` > ?)
-- expected_rows --
[
  ["GET /a", {"__cerberus_parentSpanID": "", "__cerberus_traceDurationNs": "2030000000", "__cerberus_traceID": "t1", "service.name": "frontend"}, "2024-01-01T00:00:00Z", 3],
  ["GET /b", {"__cerberus_parentSpanID": "", "__cerberus_traceDurationNs": "1020000000", "__cerberus_traceID": "t2", "service.name": "checkout"}, "2024-01-01T00:00:03Z", 2],
  ["POST /c", {"__cerberus_parentSpanID": "", "__cerberus_traceDurationNs": "10000000", "__cerberus_traceID": "t3", "service.name": "orders"}, "2024-01-01T00:00:05Z", 1]
]
-- parity_exempt --
reason: no-comparable-oracle
detail: `{ resource.service.name =~ ".+" } | count() > 0` reduces the spanset to one per-trace row carrying __cerberus_traceID and no __cerberus_spanID, so the answer is an aggregate rather than the span set runTempoParity compares
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_traceDurationNs"
[3] int64 = 1
[4] string = "service.name"
[5] string = "service.name"
[6] string = "^(?:.+)$"
[7] int64 = 0
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;agg=1
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `MetricName` AS `MetricName`, mapConcat(`ResourceAttrs`, map(?, `TraceId`, ?, `ParentSpanId`, ?, toString((`TraceEndNs` - `TraceStartNs`)))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, toFloat64(`Value`) AS `Value` FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE mapContains(`ResourceAttributes`, ?) AND match(`ResourceAttributes`[?], ?)) GROUP BY `TraceId`) WHERE (`Value` > ?))
