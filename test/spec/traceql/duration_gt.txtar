-- query.traceql --
{ duration > 100ms }
-- sql --
SELECT * FROM `otel_traces` WHERE (`Duration` > ?)
-- args --
[0] int64 = 100000000
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    TraceId String,
    SpanId String
) ENGINE = Memory;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (50000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (100000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (150000000, 'a0000000000000000000000000000001', '0000000000000003'),
    (250000000, 'a0000000000000000000000000000001', '0000000000000004');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000003", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 150000000],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000004", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 250000000]
]
-- chplan --
Filter predicate=(Duration > 100000000)
  Scan(otel_traces)

