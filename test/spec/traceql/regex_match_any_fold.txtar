-- query.traceql --
{ span.flavor =~ "van.*" || span.flavor =~ "man.*" }
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    Timestamp DateTime64(9),
    SpanAttributes Map(String, String),
    ResourceAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('a0000000000000000000000000000001', '0000000000000001', toDateTime64('2026-01-01 00:00:00', 9), map('flavor', 'vanilla'), map('service.name', 'frontend')),
    ('a0000000000000000000000000000002', '0000000000000002', toDateTime64('2026-01-01 00:00:01', 9), map('flavor', 'mango'), map('service.name', 'frontend')),
    ('a0000000000000000000000000000003', '0000000000000003', toDateTime64('2026-01-01 00:00:02', 9), map('flavor', 'cocoa'), map('service.name', 'frontend')),
    ('a0000000000000000000000000000004', '0000000000000004', toDateTime64('2026-01-01 00:00:03', 9), map('shape', 'square'), map('service.name', 'frontend'));
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "frontend"}, "2026-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000002", "service.name": "frontend"}, "2026-01-01T00:00:01Z", 0]
]
-- args --
[0] string = "flavor"
[1] string = "flavor"
[2] string = "^(?:van.*)$"
[3] string = "flavor"
[4] string = "^(?:man.*)$"
-- chplan --
Filter predicate=(FnMapContainsKey(SpanAttributes, "flavor") AND ((SpanAttributes["flavor"] =~ "van.*") OR (SpanAttributes["flavor"] =~ "man.*")))
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE mapContains(`SpanAttributes`, ?) AND (match(`SpanAttributes`[?], ?) OR match(`SpanAttributes`[?], ?))
