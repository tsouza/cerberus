-- query.traceql --
{ .a + .b > 10 }
-- sql --
SELECT * FROM `otel_traces` WHERE ((if(mapContains(`SpanAttributes`, ?), toFloat64OrNull(`SpanAttributes`[?]), toFloat64OrNull(`ResourceAttributes`[?])) + if(mapContains(`SpanAttributes`, ?), toFloat64OrNull(`SpanAttributes`[?]), toFloat64OrNull(`ResourceAttributes`[?]))) > ?)
-- args --
[0] string = "a"
[1] string = "a"
[2] string = "a"
[3] string = "b"
[4] string = "b"
[5] string = "b"
[6] int64 = 10
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    SpanAttributes Map(String, String) MATERIALIZED map('a', if(_idx = 0, '7', '3'), 'b', if(_idx = 0, '8', '4'))
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx) VALUES (0), (1);
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "", "__cerberus_traceID": ""}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=((FnIf(FnMapContainsKey(SpanAttributes, "a"), FnToFloat64OrNull(SpanAttributes["a"]), FnToFloat64OrNull(ResourceAttributes["a"])) + FnIf(FnMapContainsKey(SpanAttributes, "b"), FnToFloat64OrNull(SpanAttributes["b"]), FnToFloat64OrNull(ResourceAttributes["b"]))) > 10)
  Scan(otel_traces)
