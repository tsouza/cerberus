-- query.traceql --
{ .a + .b > 10 }
-- sql --
SELECT * FROM `otel_traces` WHERE ((if(mapContains(`SpanAttributes`, ?), toFloat64OrNull(`SpanAttributes`[?]), toFloat64OrNull(`ResourceAttributes`[?])) + if(mapContains(`SpanAttributes`, ?), toFloat64OrNull(`SpanAttributes`[?]), toFloat64OrNull(`ResourceAttributes`[?]))) > ?)
-- args --
[0] string = "a"
[1] string = "a"
[2] string = "a"
[3] string = "b"
[4] string = "b"
[5] string = "b"
[6] int64 = 10
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    SpanAttributes Map(String, String) MATERIALIZED map('a', if(_idx = 0, '7', '3'), 'b', if(_idx = 0, '8', '4')),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=((FnIf(FnMapContainsKey(SpanAttributes, "a"), FnToFloat64OrNull(SpanAttributes["a"]), FnToFloat64OrNull(ResourceAttributes["a"])) + FnIf(FnMapContainsKey(SpanAttributes, "b"), FnToFloat64OrNull(SpanAttributes["b"]), FnToFloat64OrNull(ResourceAttributes["b"]))) > 10)
  Scan(otel_traces)

-- parity_exempt --
reason: oracle-untyped-attributes
detail: `{ .a + .b > 10 }` compares an attribute against a non-string literal, and the oracle sees every attribute as a String static (#3259)
