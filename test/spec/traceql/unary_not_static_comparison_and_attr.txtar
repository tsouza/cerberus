A unary `!` over a false-making static comparison, beside an attribute
condition in an AND. `!("a" = "a")` is false, so no span matches; dropping
the NOT operand would match the Client spans.

-- query.traceql --
{ kind = client && !("a" = "a") }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanKind String,
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, SpanKind, TraceId) VALUES
    ('aaaa', 'Server', 'a0000000000000000000000000000001'),
    ('bbbb', 'Client', 'a0000000000000000000000000000001'),
    ('cccc', 'Client', 'a0000000000000000000000000000002');
