-- sql --
SELECT * FROM `otel_traces` WHERE (`ParentSpanId` != ?)
-- args --
[0] string = ""
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    ParentSpanId String
) ENGINE = Memory;
