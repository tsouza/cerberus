-- query.traceql --
{ event.name = "exception" }
-- args --
[0] string = "name"
[1] string = "exception"
-- sql --
SELECT * FROM `otel_traces` WHERE arrayExists(x -> x[?] = ?, `Events`.`Attributes`)
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    `Events.Attributes` Array(Map(String, String)) MATERIALIZED if(_idx = 0, [map('name', 'exception')], if(_idx = 1, [map('name', 'log'), map('name', 'exception')], [map('name', 'heartbeat')])),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002'),
    (2, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=nestedArrayExists(Events.Attributes["name"] = "exception")
  Scan(otel_traces)
-- parity_exempt --
reason: reference-fetch-layer
detail: `{ event.name = "exception" }` runs over a span carrying two events, which vparquet4 decodes into one flat `event.` scope where the second event's value for a repeated key is unreachable
