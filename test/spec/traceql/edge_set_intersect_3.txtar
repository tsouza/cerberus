-- query.traceql --
{ resource.service.name = "a" } && { duration > 1s } && { status = error }
-- args --
[0] string = "service.name"
[1] string = "a"
[2] int64 = 1000000000
[3] string = "Error"
-- sql --
SELECT * EXCEPT (`_setand_side`) FROM ((SELECT *, 0 AS `_setand_side` FROM (SELECT * EXCEPT (`_setand_side`) FROM ((SELECT *, 0 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?)))) UNION ALL (SELECT *, 1 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`Duration` > ?))))) QUALIFY max(`_setand_side` = 0) OVER (PARTITION BY `TraceId`) AND max(`_setand_side` = 1) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`)) UNION ALL (SELECT *, 1 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`StatusCode` = ?))))) QUALIFY max(`_setand_side` = 0) OVER (PARTITION BY `TraceId`) AND max(`_setand_side` = 1) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    Duration UInt64,
    StatusCode String,
    _svc String,
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', _svc)
) ENGINE = MergeTree ORDER BY TraceId;
INSERT INTO otel_traces (TraceId, SpanId, Duration, StatusCode, _svc) VALUES
    ('t1', 's1', 2000000000, 'Error', 'a'),
    ('t2', 's2', 500000000, 'Ok', 'b'),
    ('t3', 's3', 3000000000, 'Error', 'c');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "s1", "__cerberus_traceID": "t1", "service.name": "a"}, "1970-01-01T00:00:00Z", 2000000000]
]
-- chplan --
SetOperation op=&&
  SetOperation op=&&
    Project [TraceId, SpanId, ParentSpanId, SpanName, Duration, Timestamp, ResourceAttributes, SpanAttributes, StatusCode, StatusMessage, SpanKind, ScopeName, ScopeVersion]
      Filter predicate=(ResourceAttributes["service.name"] = "a")
        Scan(otel_traces)
    Project [TraceId, SpanId, ParentSpanId, SpanName, Duration, Timestamp, ResourceAttributes, SpanAttributes, StatusCode, StatusMessage, SpanKind, ScopeName, ScopeVersion]
      Filter predicate=(Duration > 1000000000)
        Scan(otel_traces)
  Project [TraceId, SpanId, ParentSpanId, SpanName, Duration, Timestamp, ResourceAttributes, SpanAttributes, StatusCode, StatusMessage, SpanKind, ScopeName, ScopeVersion]
    Filter predicate=(StatusCode = "Error")
      Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "service.name"
[4] string = "a"
[5] int64 = 1000000000
[6] string = "Error"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT * EXCEPT (`_setand_side`) FROM ((SELECT *, 0 AS `_setand_side` FROM (SELECT * EXCEPT (`_setand_side`) FROM ((SELECT *, 0 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `ScopeName`, `ScopeVersion`, `SpanAttributes`, `SpanId`, `SpanKind`, `SpanName`, `StatusCode`, `StatusMessage`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?)))) UNION ALL (SELECT *, 1 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `ScopeName`, `ScopeVersion`, `SpanAttributes`, `SpanId`, `SpanKind`, `SpanName`, `StatusCode`, `StatusMessage`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`Duration` > ?))))) QUALIFY max(`_setand_side` = 0) OVER (PARTITION BY `TraceId`) AND max(`_setand_side` = 1) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`)) UNION ALL (SELECT *, 1 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `ScopeName`, `ScopeVersion`, `SpanAttributes`, `SpanId`, `SpanKind`, `SpanName`, `StatusCode`, `StatusMessage`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE (`StatusCode` = ?))))) QUALIFY max(`_setand_side` = 0) OVER (PARTITION BY `TraceId`) AND max(`_setand_side` = 1) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`)
