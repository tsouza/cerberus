-- sql_optimized --
SELECT `RootName` AS `MetricName`, map(?, `TraceId`, ?, toString(`RootMatched`), ?, toString((`TraceEndNs` - `TraceStartNs`)), ?, toString(`RootService`)) AS `Attributes`, `TimeUnix` AS `TimeUnix`, toFloat64(`Value`) AS `Value` FROM (SELECT `TraceId` AS `TraceId`, toFloat64(count(?)) AS `Value`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs`, max((`ParentSpanId` IN (?, ?, ?))) AS `RootMatched`, argMax(`SpanName`, (`ParentSpanId` IN (?, ?, ?))) AS `RootName`, argMax(`ResourceAttributes`[?], (`ParentSpanId` IN (?, ?, ?))) AS `RootService` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE ?) GROUP BY `TraceId`)
