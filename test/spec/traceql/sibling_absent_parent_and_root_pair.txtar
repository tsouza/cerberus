# `~` is answered upstream from the nested-set numbering, not from the raw
# ParentSpanId column: SiblingOf is
# `a.nestedSetParent == b.nestedSetParent && a.nestedSetParent != 0 &&
# b.nestedSetParent != 0`, and the numbering only ever starts at a span
# whose ParentSpanId is EMPTY. This fixture pins the two ends of that rule
# that a raw-column join gets wrong in opposite directions (issue #1990):
#
#   trace t1  s1 (x) and s2 (y), BOTH roots (ParentSpanId = '')
#             -> siblings. A root's nestedSetParent is the -1 sentinel,
#                not 0, so upstream DOES pair two roots of one trace. A
#                gate that only asked "does a row with SpanId = the
#                shared ParentSpanId exist" would drop this pair, because
#                no row ever carries SpanId ''.
#   trace t2  p1 (root) with children s3 (x) and s4 (y)
#             -> siblings, the ordinary shape.
#   trace t3  q1 names absent parent 'absent', then s5 (x) and s6 (y)
#             are children of q1
#             -> NOT siblings. The shared parent row exists, but its whole
#                subtree is unreachable from a root, so every row keeps
#                nestedSetParent = 0 (issue #2128's depth-2 boundary).
#
# `~` projects the right-hand side, so the answer is s2 and s4.
-- query.traceql --
{ resource.service.name = "x" } ~ { resource.service.name = "y" }
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp UInt64 DEFAULT 0,
    _svc String DEFAULT '',
    ResourceAttributes Map(String, String) DEFAULT map('service.name', _svc),
    SpanAttributes Map(String, String) DEFAULT map(),
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = Memory;
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, SpanName, _svc) VALUES
    ('t1', 's1', '',       'root-a',  'x'),
    ('t1', 's2', '',       'root-b',  'y'),
    ('t2', 'p1', '',       'root',    'p'),
    ('t2', 's3', 'p1',     'child-a', 'x'),
    ('t2', 's4', 'p1',     'child-b', 'y'),
    ('t3', 'q1', 'absent', 'orphan-parent', 'p'),
    ('t3', 's5', 'q1',     'orphan-a', 'x'),
    ('t3', 's6', 'q1',     'orphan-b', 'y');
-- expected_rows --
[
  ["child-b", {"__cerberus_parentSpanID": "p1", "__cerberus_spanID": "s4", "__cerberus_traceID": "t2", "service.name": "y"}, "1970-01-01T00:00:00Z", 0],
  ["root-b", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "s2", "__cerberus_traceID": "t1", "service.name": "y"}, "1970-01-01T00:00:00Z", 0]
]
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args --
[0] string = "service.name"
[1] string = "x"
[2] string = "service.name"
[3] string = "x"
[4] string = "service.name"
[5] string = "y"
-- chplan --
StructuralJoin op=~ maxDepth=128
  Filter predicate=(ResourceAttributes["service.name"] = "x")
    Scan(otel_traces)
  Filter predicate=(ResourceAttributes["service.name"] = "y")
    Scan(otel_traces)
-- sql --
SELECT R.`TraceId` AS `TraceId`, R.`SpanId` AS `SpanId`, R.`ParentSpanId` AS `ParentSpanId`, R.`SpanName` AS `SpanName`, R.`Duration` AS `Duration`, R.`Timestamp` AS `Timestamp`, R.`ResourceAttributes` AS `ResourceAttributes`, R.`SpanAttributes` AS `SpanAttributes`, R.`StatusCode` AS `StatusCode`, R.`StatusMessage` AS `StatusMessage`, R.`SpanKind` AS `SpanKind`, R.`ScopeName` AS `ScopeName`, R.`ScopeVersion` AS `ScopeVersion` FROM (SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?)) AS _rooted_l WHERE (`TraceId`, `SpanId`) IN (WITH RECURSIVE _struct_rooted_1 AS (SELECT DISTINCT `TraceId`, `SpanId`, `ParentSpanId`, 0 AS _depth FROM `otel_traces` WHERE `ParentSpanId` = '' AND `TraceId` IN (SELECT `TraceId` FROM (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?))) UNION ALL SELECT DISTINCT t.`TraceId`, t.`SpanId`, t.`ParentSpanId`, c._depth + 1 FROM `otel_traces` AS t INNER JOIN _struct_rooted_1 AS c ON t.`TraceId` = c.`TraceId` AND t.`ParentSpanId` = c.`SpanId` WHERE c._depth < 128) SELECT DISTINCT `TraceId`, `SpanId` FROM _struct_rooted_1)) AS L INNER JOIN (SELECT * FROM `otel_traces` WHERE (`ResourceAttributes`[?] = ?)) AS R ON L.`TraceId` = R.`TraceId` AND L.`ParentSpanId` = R.`ParentSpanId` WHERE L.`SpanId` != R.`SpanId`
