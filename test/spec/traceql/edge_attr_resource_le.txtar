-- query.traceql --
{ resource.replicas <= 5 }
-- args --
[0] string = "replicas"
[1] int64 = 5
-- sql --
SELECT * FROM `otel_traces` WHERE (toFloat64OrNull(`ResourceAttributes`[?]) <= ?)
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    ResourceAttributes Map(String, String) MATERIALIZED if(Duration = 10000000, map('replicas', '3'), if(Duration = 20000000, map('replicas', '5'), map('replicas', '10'))),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY Duration;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (10000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (20000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (30000000, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001", "replicas": "3"}, "1970-01-01T00:00:00Z", 10000000],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001", "replicas": "5"}, "1970-01-01T00:00:00Z", 20000000]
]
-- chplan --
Filter predicate=(FnToFloat64OrNull(ResourceAttributes["replicas"]) <= 5)
  Scan(otel_traces)
-- parity_exempt --
reason: oracle-untyped-attributes
detail: `{ resource.replicas <= 5 }` compares an attribute against a non-string literal, and the oracle sees every attribute as a String static (#3259)
