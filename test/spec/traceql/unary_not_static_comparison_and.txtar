A unary `!` over a comparison between two statics, as an AND operand.
Reference Tempo folds a span-free expression at parse time, so
`("test" = "test") && !("test" = "test")` is `true && false`: no span
matches. Dropping the NOT operand as the AND identity element (the
attribute-comparison rule of #1712) would match every span.

-- query.traceql --
{ ("test" = "test") && !("test" = "test") }
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    SpanKind String,
    TraceId String
) ENGINE = MergeTree ORDER BY SpanId;
INSERT INTO otel_traces (SpanId, SpanKind, TraceId) VALUES
    ('aaaa', 'Server', 'a0000000000000000000000000000001'),
    ('bbbb', 'Client', 'a0000000000000000000000000000001'),
    ('cccc', 'Client', 'a0000000000000000000000000000002');
-- expected_rows --
[]
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args --
[0] string = "test"
[1] string = "test"
[2] string = "test"
[3] string = "test"
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "test"
[4] string = "test"
[5] string = "test"
[6] string = "test"
-- chplan --
Filter predicate=(("test" = "test") AND FnNot(("test" = "test")))
  Scan(otel_traces)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
