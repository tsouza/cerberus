-- query.traceql --
{ duration > span.budget_ns }
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    SpanAttributes Map(String, String) MATERIALIZED if(Duration = 10000000, map('budget_ns', '20000000'), if(Duration = 20000000, map('budget_ns', '5000000'), map('budget_ns', 'unbounded'))),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY Duration;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (10000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (20000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (30000000, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 20000000]
]
-- args --
[0] string = "budget_ns"
-- chplan --
Filter predicate=(Duration > FnToFloat64OrNull(SpanAttributes["budget_ns"]))
  Scan(otel_traces)
-- sql --
SELECT * FROM `otel_traces` WHERE (`Duration` > toFloat64OrNull(`SpanAttributes`[?]))
-- parity_exempt --
reason: oracle-untyped-attributes
detail: `{ duration > span.budget_ns }` compares an attribute against a non-string literal, and the oracle sees every attribute as a String static (#3259)
