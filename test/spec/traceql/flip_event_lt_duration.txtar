-- query.traceql --
{ 100ms < event.duration }
-- sql --
SELECT * FROM `otel_traces` WHERE arrayExists(x -> x[?] > ?, `Events`.`Attributes`)
-- args --
[0] string = "duration"
[1] int64 = 100000000
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    `Events.Attributes` Array(Map(String, Int64)) MATERIALIZED if(_idx = 0, [map('duration', toInt64(200000000))], [map('duration', toInt64(50000000))]),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx, TraceId, SpanId) VALUES
    (0, 'a0000000000000000000000000000001', '0000000000000001'),
    (1, 'a0000000000000000000000000000001', '0000000000000002');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=nestedArrayExists(Events.Attributes["duration"] > 100000000)
  Scan(otel_traces)
-- parity_exempt --
reason: oracle-untyped-attributes
detail: `{ 100ms < event.duration }` compares an attribute against a non-string literal, and the oracle sees every attribute as a String static (#3259)
