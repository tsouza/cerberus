-- query.traceql --
{ name = "a" } &> { name = "b" }
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String,
    Duration UInt64 DEFAULT 0,
    Timestamp UInt64 DEFAULT 0,
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = Memory;
-- Both s1 and s2 are delivered TWICE. otel_traces is a plain MergeTree
-- and the OTel-CH exporter writes OTLP attributes in wire order without
-- sorting, so an at-least-once redelivery can land a second physical row
-- carrying the SAME attribute set under a DIFFERENT Map key order.
--
--   s1 -> redelivered with the keys REVERSED (the bug's trigger)
--   s2 -> redelivered byte-identically (the control)
--
-- A ClickHouse Map compares positionally over its (keys, values) arrays,
-- so the old full-row UNION DISTINCT collapsed the s2 pair and kept BOTH
-- s1 rows: the same span returned twice, indistinguishable on the wire.
-- Identity dedup (LIMIT 1 BY TraceId, SpanId) treats the two alike.
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, SpanName, ResourceAttributes) VALUES
    ('t1', 's1', '',   'a', map('job', 'api', 'dc', 'eu')),
    ('t1', 's1', '',   'a', map('dc', 'eu', 'job', 'api')),
    ('t1', 's2', 's1', 'b', map('job', 'api', 'dc', 'eu')),
    ('t1', 's2', 's1', 'b', map('job', 'api', 'dc', 'eu'));
-- expected_rows --
[
  ["a", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "s1", "__cerberus_traceID": "t1", "dc": "eu", "job": "api"}, "1970-01-01T00:00:00Z", 0],
  ["b", {"__cerberus_parentSpanID": "s1", "__cerberus_spanID": "s2", "__cerberus_traceID": "t1", "dc": "eu", "job": "api"}, "1970-01-01T00:00:00Z", 0]
]
-- args --
[0] string = "a"
[1] string = "a"
[2] string = "b"
[3] string = "a"
[4] string = "a"
[5] string = "b"
-- chplan --
StructuralJoin op=&>
  Filter predicate=(SpanName = "a")
    Scan(otel_traces)
  Filter predicate=(SpanName = "b")
    Scan(otel_traces)
-- sql --
SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM ((SELECT R.`TraceId` AS `TraceId`, R.`SpanId` AS `SpanId`, R.`ParentSpanId` AS `ParentSpanId`, R.`SpanName` AS `SpanName`, R.`Duration` AS `Duration`, R.`Timestamp` AS `Timestamp`, R.`ResourceAttributes` AS `ResourceAttributes`, R.`SpanAttributes` AS `SpanAttributes`, R.`StatusCode` AS `StatusCode`, R.`StatusMessage` AS `StatusMessage`, R.`SpanKind` AS `SpanKind`, R.`ScopeName` AS `ScopeName`, R.`ScopeVersion` AS `ScopeVersion` FROM (SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS _rooted_l WHERE (`TraceId`, `SpanId`) GLOBAL IN (WITH RECURSIVE _struct_rooted_1 AS (SELECT DISTINCT `TraceId`, `SpanId`, `ParentSpanId`, 0 AS _depth FROM `otel_traces` WHERE `ParentSpanId` = '' AND `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?))) UNION ALL SELECT DISTINCT t.`TraceId`, t.`SpanId`, t.`ParentSpanId`, c._depth + 1 FROM `otel_traces` AS t INNER JOIN _struct_rooted_1 AS c ON t.`TraceId` = c.`TraceId` AND t.`ParentSpanId` = c.`SpanId` WHERE c._depth < 128) SELECT DISTINCT `TraceId`, `SpanId` FROM _struct_rooted_1)) AS L INNER JOIN (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS R ON L.`TraceId` = R.`TraceId` AND L.`SpanId` = R.`ParentSpanId`) UNION ALL (SELECT L.`TraceId` AS `TraceId`, L.`SpanId` AS `SpanId`, L.`ParentSpanId` AS `ParentSpanId`, L.`SpanName` AS `SpanName`, L.`Duration` AS `Duration`, L.`Timestamp` AS `Timestamp`, L.`ResourceAttributes` AS `ResourceAttributes`, L.`SpanAttributes` AS `SpanAttributes`, L.`StatusCode` AS `StatusCode`, L.`StatusMessage` AS `StatusMessage`, L.`SpanKind` AS `SpanKind`, L.`ScopeName` AS `ScopeName`, L.`ScopeVersion` AS `ScopeVersion` FROM (SELECT * FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS _rooted_l WHERE (`TraceId`, `SpanId`) GLOBAL IN (WITH RECURSIVE _struct_rooted_1 AS (SELECT DISTINCT `TraceId`, `SpanId`, `ParentSpanId`, 0 AS _depth FROM `otel_traces` WHERE `ParentSpanId` = '' AND `TraceId` GLOBAL IN (SELECT `TraceId` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?))) UNION ALL SELECT DISTINCT t.`TraceId`, t.`SpanId`, t.`ParentSpanId`, c._depth + 1 FROM `otel_traces` AS t INNER JOIN _struct_rooted_1 AS c ON t.`TraceId` = c.`TraceId` AND t.`ParentSpanId` = c.`SpanId` WHERE c._depth < 128) SELECT DISTINCT `TraceId`, `SpanId` FROM _struct_rooted_1)) AS L INNER JOIN (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) AS R ON L.`TraceId` = R.`TraceId` AND L.`SpanId` = R.`ParentSpanId`)) LIMIT 1 BY `TraceId`, `SpanId`
-- parity_exempt --
reason: duplicate-span-seed
detail: seed delivers the same (TraceId, SpanId) on more than one row on purpose, and span identity is the comparison key, so `{ name = "a" } &> { name = "b" }` cannot be matched against a SET of matched spans
