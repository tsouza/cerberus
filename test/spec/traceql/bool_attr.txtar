-- query.traceql --
{ span.cache.hit = true }
-- sql --
SELECT * FROM `otel_traces` WHERE (`SpanAttributes`[?] = ?)
-- args --
[0] string = "cache.hit"
[1] string = "true"
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    _hit Bool,
    SpanAttributes Map(String, String) MATERIALIZED map('cache.hit', if(_hit, 'true', 'false'))
) ENGINE = Memory;
INSERT INTO otel_traces (TraceId, SpanId, _hit) VALUES
    ('a0000000000000000000000000000001', '0000000000000001', true),
    ('a0000000000000000000000000000001', '0000000000000002', false),
    ('a0000000000000000000000000000002', '0000000000000010', true);
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000010", "__cerberus_traceID": "a0000000000000000000000000000002"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(SpanAttributes["cache.hit"] = "true")
  Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "cache.hit"
[4] string = "true"
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
