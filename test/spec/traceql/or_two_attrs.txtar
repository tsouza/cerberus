-- query.traceql --
{ resource.service.name = "frontend" || duration > 100ms }
-- sql --
SELECT * FROM `otel_traces` WHERE ((`ResourceAttributes`[?] = ?) OR (`Duration` > ?))
-- args --
[0] string = "service.name"
[1] string = "frontend"
[2] int64 = 100000000
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', if(Duration = 50000000, 'frontend', 'backend')),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY Duration;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (50000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (80000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (150000000, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000001", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "frontend"}, "1970-01-01T00:00:00Z", 50000000],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000003", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "backend"}, "1970-01-01T00:00:00Z", 150000000]
]
-- chplan --
Filter predicate=((ResourceAttributes["service.name"] = "frontend") OR (Duration > 100000000))
  Scan(otel_traces)
-- parity --
oracle: tempo
endpoint: /api/search
scope: full
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] string = "service.name"
[4] string = "frontend"
[5] int64 = 100000000
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` WHERE ((`ResourceAttributes`[?] = ?) OR (`Duration` > ?)))
