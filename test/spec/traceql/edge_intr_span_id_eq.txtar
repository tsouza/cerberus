-- query.traceql --
{ span:id = "deadbeef" }
-- args --
[0] string = "deadbeef"
-- sql --
SELECT * FROM `otel_traces` WHERE (`SpanId` = ?)
-- seed --
CREATE TABLE otel_traces (
    SpanId String,
    TraceId String
) ENGINE = Memory;
INSERT INTO otel_traces (SpanId, TraceId) VALUES
    ('0000000000000001', 'a0000000000000000000000000000001'),
    ('deadbeef', 'a0000000000000000000000000000001'),
    ('fedcba9876543210', 'a0000000000000000000000000000001');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "deadbeef", "__cerberus_traceID": "a0000000000000000000000000000001"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(SpanId = "deadbeef")
  Scan(otel_traces)

