GAP-3 (#1109): a compound `&&` search gets the /api/search request window
folded into BOTH leaf scans, so it scans only [start, end] instead of full
retention. Before the fold, stampSearchTraceLimit skipped this non-plain shape
and no Timestamp predicate was emitted at all.

-- search_limit --
20
-- search_window --
1782571392 1782573192
-- query.traceql --
{ resource.service.name = "a" } && { span.http.status_code = 500 }
-- sql --
SELECT * FROM `otel_traces` WHERE (`Timestamp` >= fromUnixTimestamp64Nano(?)) AND (`Timestamp` <= fromUnixTimestamp64Nano(?)) AND ((`ResourceAttributes`[?] = ?) OR (toFloat64OrNull(`SpanAttributes`[?]) = ?)) QUALIFY max((`ResourceAttributes`[?] = ?)) OVER (PARTITION BY `TraceId`) AND max((toFloat64OrNull(`SpanAttributes`[?]) = ?)) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`
-- args --
[0] int64 = 1782571392000000000
[1] int64 = 1782573192000000000
[2] string = "service.name"
[3] string = "a"
[4] string = "http.status_code"
[5] int64 = 500
[6] string = "service.name"
[7] string = "a"
[8] string = "http.status_code"
[9] int64 = 500
-- chplan --
SetOperation op=&&
  Filter predicate=((ResourceAttributes["service.name"] = "a") AND ((Timestamp >= FnFromUnixNanos(1782571392000000000)) AND (Timestamp <= FnFromUnixNanos(1782573192000000000))))
    Scan(otel_traces)
  Filter predicate=((FnToFloat64OrNull(SpanAttributes["http.status_code"]) = 500) AND ((Timestamp >= FnFromUnixNanos(1782571392000000000)) AND (Timestamp <= FnFromUnixNanos(1782573192000000000))))
    Scan(otel_traces)
