GAP-3 (#1109): a compound `&&` search gets the /api/search request window
folded into BOTH leaf scans, so it scans only [start, end] instead of full
retention. Before the fold, stampSearchTraceLimit skipped this non-plain shape
and no Timestamp predicate was emitted at all.

-- search_limit --
20
-- search_window --
1782571392 1782573192
-- query.traceql --
{ resource.service.name = "a" } && { span.http.status_code = 500 }
-- sql --
SELECT * EXCEPT (`_setand_side`) FROM ((SELECT *, 0 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`Timestamp` >= fromUnixTimestamp64Nano(?)) AND (`Timestamp` <= fromUnixTimestamp64Nano(?)) AND (`ResourceAttributes`[?] = ?)))) UNION ALL (SELECT *, 1 AS `_setand_side` FROM (SELECT `TraceId`, `SpanId`, `ParentSpanId`, `SpanName`, `Duration`, `Timestamp`, `ResourceAttributes`, `SpanAttributes`, `StatusCode`, `StatusMessage`, `SpanKind`, `ScopeName`, `ScopeVersion` FROM (SELECT * FROM `otel_traces` WHERE (`Timestamp` >= fromUnixTimestamp64Nano(?)) AND (`Timestamp` <= fromUnixTimestamp64Nano(?)) AND (toFloat64OrNull(`SpanAttributes`[?]) = ?))))) QUALIFY max(`_setand_side` = 0) OVER (PARTITION BY `TraceId`) AND max(`_setand_side` = 1) OVER (PARTITION BY `TraceId`) LIMIT 1 BY `TraceId`, `SpanId`
