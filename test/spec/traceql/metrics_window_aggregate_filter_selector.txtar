# The spans a metrics function observes after a spanset-aggregate filter
# are the spans the selector matched, in the traces whose aggregate passed:
# both the aggregate and the metric read the matched spans only.
#
#   trace ...01  q 00:00:30, q 00:00:40, x 00:00:50  2 matched  passes
#   trace ...02  q 00:01:10, x 00:01:20, x 00:01:30  1 matched  dropped
#   trace ...03  q 00:01:40, q 00:01:50              2 matched  passes
#
# Two spans in each bucket. Counting a trace's every span would pass trace
# ...02 (three spans); observing every span of a passing trace would count
# three in the first bucket.
-- query.traceql --
{ name = "q" } | count() > 1 | count_over_time()
-- metrics_window --
1704067260 1704067320 60
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = MergeTree ORDER BY (Timestamp, SpanId);
INSERT INTO otel_traces (TraceId, SpanId, ParentSpanId, Timestamp, Duration, SpanName) VALUES
    ('a0000000000000000000000000000001', '0000000000000001', '', toDateTime64('2024-01-01 00:00:30', 9), 1000000000, 'q'),
    ('a0000000000000000000000000000001', '0000000000000002', '0000000000000001', toDateTime64('2024-01-01 00:00:40', 9), 1000000000, 'q'),
    ('a0000000000000000000000000000001', '0000000000000003', '0000000000000001', toDateTime64('2024-01-01 00:00:50', 9), 1000000000, 'x'),
    ('a0000000000000000000000000000002', '0000000000000016', '', toDateTime64('2024-01-01 00:01:10', 9), 1000000000, 'q'),
    ('a0000000000000000000000000000002', '0000000000000017', '0000000000000016', toDateTime64('2024-01-01 00:01:20', 9), 1000000000, 'x'),
    ('a0000000000000000000000000000002', '0000000000000018', '0000000000000016', toDateTime64('2024-01-01 00:01:30', 9), 1000000000, 'x'),
    ('a0000000000000000000000000000003', '0000000000000032', '', toDateTime64('2024-01-01 00:01:40', 9), 1000000000, 'q'),
    ('a0000000000000000000000000000003', '0000000000000033', '0000000000000032', toDateTime64('2024-01-01 00:01:50', 9), 1000000000, 'q');
-- expected_rows --
[
  ["2024-01-01T00:01:00Z", 2],
  ["2024-01-01T00:02:00Z", 2]
]
-- parity_exempt --
reason: no-comparable-oracle
detail: `{ name = "q" } | count() > 1 | count_over_time()` answers with a time series rather than with a span set, so runTempoParity has no set of matched spans to compare
