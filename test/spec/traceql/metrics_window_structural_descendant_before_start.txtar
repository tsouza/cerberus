# A metrics pipeline over a structural descendant relation reads the spans
# its RangeWindow reads: the window is start 00:01:00, end 00:02:00, step
# 60s, so the RangeWindow, and with it every anchor and step arm of the
# recursive closure, reads (00:00:00, 00:02:00].
#
#   trace ...01  root 0001 00:00:20, child 0002 00:00:30  (both before start)
#   trace ...02  root 0010 00:01:20, child 0011 00:01:30
#   trace ...03  root 0020 00:00:50 (before start), child 0021 00:01:30
#   trace ...04  root 0030 00:00:00 (on the exclusive lower bound), child 0031 00:00:10
#
# The first bucket counts 0002, a descendant whose ancestor precedes start;
# the second counts 0011 and 0021, whose ancestor 0020 also precedes start.
# Read over [start, end] alone, the closure would see neither 0001 nor 0020
# and the buckets would read 0 and 1.
#
# Root 0030 sits on the span's exclusive lower bound, so the closure does not
# read it and its child 0031 is not counted. A bound that included 00:00:00
# would count 0031, and the first bucket would read 2.
-- query.traceql --
{ } >> { } | count_over_time()
-- metrics_window --
1704067260 1704067320 60
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = MergeTree ORDER BY (Timestamp, SpanId);
