-- query.traceql --
{ resource.service.name != "backend" }
-- sql --
SELECT * FROM `otel_traces` WHERE mapContains(`ResourceAttributes`, ?) AND (`ResourceAttributes`[?] != ?)
-- args --
[0] string = "service.name"
[1] string = "service.name"
[2] string = "backend"
-- seed --
CREATE TABLE otel_traces (
    _idx UInt64,
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', if(_idx = 0, 'frontend', if(_idx = 1, 'backend', 'db')))
) ENGINE = MergeTree ORDER BY _idx;
INSERT INTO otel_traces (_idx) VALUES (0), (1), (2);
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "", "__cerberus_traceID": "", "service.name": "db"}, "1970-01-01T00:00:00Z", 0],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "", "__cerberus_traceID": "", "service.name": "frontend"}, "1970-01-01T00:00:00Z", 0]
]
-- chplan --
Filter predicate=(FnMapContainsKey(ResourceAttributes, "service.name") AND (ResourceAttributes["service.name"] != "backend"))
  Scan(otel_traces)
