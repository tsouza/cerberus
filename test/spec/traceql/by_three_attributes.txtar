-- sql_optimized --
SELECT `ResourceAttributes`[?] AS `service.name`, `SpanAttributes`[?] AS `kind`, `SpanAttributes`[?] AS `http.method`, toFloat64(count(?)) AS `Value` FROM (SELECT `ResourceAttributes`, `SpanAttributes` FROM `otel_traces` WHERE ?) GROUP BY `service.name`, `kind`, `http.method`
