# A metrics pipeline over a trace-scoped intrinsic reads each trace's value
# from the spans inside the window the metric reads: the RangeWindow input
# span (start - step, end], here (00:00:00, 00:02:00]. The per-trace lookup
# and the span rows it is joined onto both carry that bound, so a trace that
# straddles either edge is measured from its in-window spans alone, as
# /api/search measures it inside its request window.
#
#   trace ...01  inside the window, traceDuration 2s
#     0001 root  00:00:30 +2s
#     0002       00:00:31 +0.5s   matches (0.5s < 2s)
#   trace ...02  straddles the lower edge; in-window traceDuration 1s
#     0010       23:59:50 +1s     outside the window
#     0011       00:00:40 +1s     no match (1s = 1s)
#   trace ...03  straddles the upper edge; in-window traceDuration 1s
#     0020       00:01:50 +1s     no match (1s = 1s)
#     0021       00:02:30 +1s     outside the window
#
# One match, in the (00:00:00, 00:01:00] bucket. Read across full retention,
# traces ...02 and ...03 would last 51s and 41s, and 0011 and 0020 would match
# too.
-- query.traceql --
{ traceDuration > duration } | count_over_time()
-- metrics_window --
1704067260 1704067320 60
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanId String,
    ParentSpanId String,
    SpanName String DEFAULT '',
    Duration UInt64 DEFAULT 0,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String) DEFAULT map(),
    SpanAttributes Map(String, String) DEFAULT map(),
    ServiceName String DEFAULT '',
    StatusCode String DEFAULT '',
    StatusMessage String DEFAULT '',
    SpanKind String DEFAULT '',
    ScopeName String DEFAULT '',
    ScopeVersion String DEFAULT ''
) ENGINE = Memory;
