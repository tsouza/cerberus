-- query.traceql --
{ span.http.status_code >= 400 } | sum(span.http.status_code) > 0
-- seed --
CREATE TABLE otel_traces (
    TraceId String,
    SpanName String,
    Timestamp DateTime64(9),
    ResourceAttributes Map(String, String),
    SpanAttributes Map(String, String),
    Duration UInt64
) ENGINE = Memory;
INSERT INTO otel_traces VALUES
    ('t1', 'span', toDateTime64('2024-01-01 00:00:00', 9), map(), map('http.status_code', '500'), 10000000),
    ('t1', 'span', toDateTime64('2024-01-01 00:00:01', 9), map(), map('http.status_code', '404'), 20000000),
    ('t2', 'span', toDateTime64('2024-01-01 00:00:02', 9), map(), map('http.status_code', '200'), 30000000);
-- args --
[0] string = "http.status_code"
[1] string = "http.status_code"
[2] int64 = 400
[3] int64 = 0
-- chplan --
Filter predicate=(Value > 0)
  Filter predicate=FnIsNotNull(Value)
    Aggregate groupBy=[TraceId AS TraceId] funcs=[FnSum(FnToFloat64OrNull(SpanAttributes["http.status_code"])) AS Value, FnAny(SpanName) AS MetricName, FnAny(ResourceAttributes) AS ResourceAttrs, FnAny(ParentSpanId) AS ParentSpanId, FnMin(Timestamp) AS TimeUnix, FnMin(FnToUnixNanos(Timestamp)) AS TraceStartNs, FnMax((FnToUnixNanos(Timestamp) + FnToInt64(Duration))) AS TraceEndNs]
      Filter predicate=(FnToFloat64OrNull(SpanAttributes["http.status_code"]) >= 400)
        Scan(otel_traces)
-- sql --
SELECT * FROM (SELECT * FROM (SELECT `TraceId` AS `TraceId`, sum(toFloat64OrNull(`SpanAttributes`[?])) AS `Value`, any(`SpanName`) AS `MetricName`, any(`ResourceAttributes`) AS `ResourceAttrs`, any(`ParentSpanId`) AS `ParentSpanId`, min(`Timestamp`) AS `TimeUnix`, min(toUnixTimestamp64Nano(`Timestamp`)) AS `TraceStartNs`, max((toUnixTimestamp64Nano(`Timestamp`) + toInt64(`Duration`))) AS `TraceEndNs` FROM (SELECT * FROM `otel_traces` WHERE (toFloat64OrNull(`SpanAttributes`[?]) >= ?)) GROUP BY `TraceId`) WHERE isNotNull(`Value`)) WHERE (`Value` > ?)
-- expected_rows --
[
  ["span", {"__cerberus_parentSpanID": "", "__cerberus_traceDurationNs": "1020000000", "__cerberus_traceID": "t1"}, "2024-01-01T00:00:00Z", 904]
]
-- parity_exempt --
reason: no-comparable-oracle
detail: `{ span.http.status_code >= 400 } | sum(span.http.status_code) > 0` reduces the spanset to one per-trace row carrying __cerberus_traceID and no __cerberus_spanID, so the answer is an aggregate rather than the span set runTempoParity compares
