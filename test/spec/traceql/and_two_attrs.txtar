-- query.traceql --
{ resource.service.name = "frontend" && duration > 100ms }
-- sql --
SELECT * FROM `otel_traces` PREWHERE (`Duration` > ?) WHERE (`ResourceAttributes`[?] = ?)
-- args --
[0] int64 = 100000000
[1] string = "service.name"
[2] string = "frontend"
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', 'frontend'),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY Duration;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (50000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (120000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (150000000, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "frontend"}, "1970-01-01T00:00:00Z", 120000000],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000003", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "frontend"}, "1970-01-01T00:00:00Z", 150000000]
]
-- chplan --
Filter predicate=((ResourceAttributes["service.name"] = "frontend") AND (Duration > 100000000))
  Scan(otel_traces)
