-- query.traceql --
{ resource.service.name = "frontend" && span.http.status_code = 500 && duration > 100ms }
-- sql --
SELECT * FROM `otel_traces` PREWHERE (`Duration` > ?) WHERE (`ResourceAttributes`[?] = ?) AND (toFloat64OrNull(`SpanAttributes`[?]) = ?)
-- args --
[0] int64 = 100000000
[1] string = "service.name"
[2] string = "frontend"
[3] string = "http.status_code"
[4] int64 = 500
-- seed --
CREATE TABLE otel_traces (
    Duration UInt64,
    ResourceAttributes Map(String, String) MATERIALIZED map('service.name', 'frontend'),
    SpanAttributes Map(String, String) MATERIALIZED map('http.status_code', if(Duration > 100000000, '500', '200')),
    TraceId String,
    SpanId String
) ENGINE = MergeTree ORDER BY Duration;
INSERT INTO otel_traces (Duration, TraceId, SpanId) VALUES
    (50000000, 'a0000000000000000000000000000001', '0000000000000001'),
    (150000000, 'a0000000000000000000000000000001', '0000000000000002'),
    (250000000, 'a0000000000000000000000000000001', '0000000000000003');
-- expected_rows --
[
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000002", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "frontend"}, "1970-01-01T00:00:00Z", 150000000],
  ["", {"__cerberus_parentSpanID": "", "__cerberus_spanID": "0000000000000003", "__cerberus_traceID": "a0000000000000000000000000000001", "service.name": "frontend"}, "1970-01-01T00:00:00Z", 250000000]
]
-- chplan --
Filter predicate=(((ResourceAttributes["service.name"] = "frontend") AND (FnToFloat64OrNull(SpanAttributes["http.status_code"]) = 500)) AND (Duration > 100000000))
  Scan(otel_traces)
-- parity_exempt --
reason: oracle-untyped-attributes
detail: `{ resource.service.name = "frontend" && span.http.status_code = 500 && duration > 100ms }` compares an attribute against a non-string literal, and the oracle sees every attribute as a String static (#3259)
-- args_optimized --
[0] string = "__cerberus_traceID"
[1] string = "__cerberus_parentSpanID"
[2] string = "__cerberus_spanID"
[3] int64 = 100000000
[4] string = "service.name"
[5] string = "frontend"
[6] string = "http.status_code"
[7] int64 = 500
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql_optimized --
SELECT `SpanName` AS `MetricName`, mapConcat(`ResourceAttributes`, map(?, `TraceId`, ?, `ParentSpanId`, ?, `SpanId`)) AS `Attributes`, `Timestamp` AS `TimeUnix`, toFloat64(`Duration`) AS `Value` FROM (SELECT `Duration`, `ParentSpanId`, `ResourceAttributes`, `SpanAttributes`, `SpanId`, `SpanName`, `Timestamp`, `TraceId` FROM `otel_traces` PREWHERE (`Duration` > ?) WHERE (`ResourceAttributes`[?] = ?) AND (toFloat64OrNull(`SpanAttributes`[?]) = ?))
