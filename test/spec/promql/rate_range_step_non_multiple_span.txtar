    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:30', 9), 70.0),
    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 80.0),
    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:30', 9), 90.0),
    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 100.0),
    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:30', 9), 110.0),
    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 120.0),
    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:30', 9), 130.0),
    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 140.0),
    (2, 'http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:30', 9), 150.0),
