# query_range grid whose span is NOT a multiple of its step: the harness
# window [00:00, 00:05] over a 2m step names the anchors 00:00, 00:02 and
# 00:04 (Prometheus's Start-anchored `start + i*step <= end` grid), never
# 00:05, 00:03 and 00:01. Every fan-out emitter walks its grid backward
# from one "newest anchor" base, so this pins that the base is the
# Start-anchored 00:04 rather than the raw End. The counter grows by 10
# every 30s, so each full [2m] window reads a steady 1/3 per second.
-- query.promql --
rate(http_requests_total[2m])
-- range_step --
2m
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
