# The range counterpart of histogram_quantile_classic_rankwalk_collapsed_ladder.txtar
# over a `sum by (le)` ladder scaled by a binary operation, under
# promql.NativeQuantileRankWalkLowerer: the +Inf rung is dropped, the float le
# pipeline collapses every step's ladder to empty BucketCounts with two finite
# ExplicitBounds, and every step answers Prometheus's NaN.

-- query.promql --
histogram_quantile(0.5, sum by (le) (rate(reqs{le!="+Inf"}[5m])) * 1)
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- experimental_quantile_prom_histogram --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
