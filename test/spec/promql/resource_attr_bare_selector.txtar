# rc.5 (task #123) — a bare selector must surface OTel ResourceAttributes
# map keys as Prometheus labels, dot->underscore sanitized. The seed rows
# carry `k8s.namespace.name` ONLY in the ResourceAttributes map (no
# Attributes entry); the read-path projection merges
# mapUpdate(sanitize(ResourceAttributes), Attributes) so the wire label
# `k8s_namespace_name` appears alongside the per-datapoint `route` label.
#
# Precedence: a key present in BOTH maps resolves to the Attributes
# (metric-level) value — `region` is `us-east` in Attributes and
# `us-west` in ResourceAttributes, and the merged output keeps `us-east`.

-- query.promql --
http_requests_total
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    ResourceAttributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('http_requests_total', map('route', '/api', 'region', 'us-east'), map('k8s.namespace.name', 'prod', 'region', 'us-west'), toDateTime64('2026-01-01 00:00:00', 9), 5.0);
-- expected_rows --
[
  ["http_requests_total", {"route": "/api", "region": "us-east", "k8s_namespace_name": "prod"}, "2026-01-01T00:00:00Z", 5.0]
]
-- args --
[0] string = "service_name"
[1] string = "service.name"
[2] string = "service_name"
[3] string = "service.name"
[4] string = "service_name"
[5] string = ""
[6] string = "service_name"
[7] string = "http_requests_total"
[8] string = "http.requests.total"
[9] string = "http.requests/total"
[10] string = "http.requests_total"
[11] string = "http/requests/total"
[12] string = "http/requests_total"
[13] string = "http_requests.total"
[14] string = "2026-01-01 00:00:01.000000000"
[15] int64 = 9
[16] string = "2026-01-01 00:00:01.000000000"
[17] int64 = 9
[18] int64 = 300000000000
-- chplan --
Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
  Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnMax(TimeUnix) AS lwr_ts, FnArgMax(Value, TimeUnix) AS lwr_value]
    Filter predicate=((TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9)) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
      Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
        Filter predicate=(MetricName IN ("http_requests_total", "http.requests.total", "http.requests/total", "http.requests_total", "http/requests/total", "http/requests_total", "http_requests.total"))
          Scan(otel_metrics_sum)
-- sql --
SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `lwr_ts` AS `TimeUnix`, `lwr_value` AS `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, max(`TimeUnix`) AS `lwr_ts`, argMax(`Value`, `TimeUnix`) AS `lwr_value` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM `otel_metrics_sum` WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?)))) WHERE ((`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?))))) GROUP BY `MetricName`, `Attributes`)
