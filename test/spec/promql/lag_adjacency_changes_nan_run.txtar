# lagInFrame annotation shape (cerberus issue #2759) for changes() in RANGE
# mode, exercising the #1489 both-NaN carve-out — chsql's
# emitLagAdjacencyChangesResets. The `experimental_lag_adjacency_changes`
# section opts the fixture into RangeLowerers.Changes =
# LagAdjacencyChangesLowerer (WITHOUT native ts_grid_changes layered on top
# — that feature is permanently AutoSelect=false, #1721 — so this pins the
# lagInFrame SQL shape itself).
#
# job 'nan': every sample in the window is NaN — every adjacent pair is a
# both-NaN pair, so the carve-out suppresses all of them: changes() = 0, not
# the window's sample count. job 'nan-mixed': NaN and finite samples
# alternate, including a genuine value change (3.0 -> nan is a change: NaN
# is not both-sides, `!=` already evaluates true; nan -> 8.0 likewise;
# 8.0 -> 2.0 is a change; 2.0 -> nan is a change; nan -> 5.0 is a change) —
# 5 changes across 5 adjacent pairs, none suppressed (no adjacent pair is
# both-NaN).
-- query.promql --
sum by(job) (changes(http_requests_total[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_lag_adjacency_changes --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('http_requests_total', map('job', 'nan'), toDateTime64('2026-01-01 00:00:00', 9), nan),
    ('http_requests_total', map('job', 'nan'), toDateTime64('2026-01-01 00:01:00', 9), nan),
    ('http_requests_total', map('job', 'nan'), toDateTime64('2026-01-01 00:02:00', 9), nan),
    ('http_requests_total', map('job', 'nan'), toDateTime64('2026-01-01 00:03:00', 9), nan),
    ('http_requests_total', map('job', 'nan'), toDateTime64('2026-01-01 00:04:00', 9), nan),
    ('http_requests_total', map('job', 'nan'), toDateTime64('2026-01-01 00:05:00', 9), nan),
    ('http_requests_total', map('job', 'nan-mixed'), toDateTime64('2026-01-01 00:00:00', 9), 3.0),
    ('http_requests_total', map('job', 'nan-mixed'), toDateTime64('2026-01-01 00:01:00', 9), nan),
    ('http_requests_total', map('job', 'nan-mixed'), toDateTime64('2026-01-01 00:02:00', 9), 8.0),
    ('http_requests_total', map('job', 'nan-mixed'), toDateTime64('2026-01-01 00:03:00', 9), 2.0),
    ('http_requests_total', map('job', 'nan-mixed'), toDateTime64('2026-01-01 00:04:00', 9), nan),
    ('http_requests_total', map('job', 'nan-mixed'), toDateTime64('2026-01-01 00:05:00', 9), 5.0);
