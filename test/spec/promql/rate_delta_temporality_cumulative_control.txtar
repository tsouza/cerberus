# The CUMULATIVE-temporality control for rate_delta_temporality.txtar: same
# metric name shape, same timestamps, same raw values (10, 40) — only
# AggregationTemporality flips from 1 (DELTA) to 2 (CUMULATIVE) explicitly
# (not merely unset/defaulted, so this fixture pins the CUMULATIVE arm of
# the runtime branch on purpose, not by omission). Prometheus's
# counter-reset rule now applies: counter_delta = 40 - 10 = 30, a plain
# non-reset diff.
#
# The result must equal exactly 3/4 of rate_delta_temporality's answer
# (counter-reset-diff 30 vs raw-sum-minus-first 40), since the two fixtures
# share identical timestamps and therefore an identical extrapolation
# factor.
-- query.promql --
rate(http_requests_cumulative_total[1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2025-12-31 23:59:02', 9), 10.0),
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 40.0);
-- expected_rows --
[
  [{"job": "api"}, 0.5172413793103449]
]
