                Filter predicate=((TimeUnix <= FnParseDateTime64BestEffort("1970-01-01 00:08:20.000000000Z", 9)) AND (TimeUnix > (FnParseDateTime64BestEffort("1970-01-01 00:08:20.000000000Z", 9) - FnToIntervalNanosecond(300000000000))))
