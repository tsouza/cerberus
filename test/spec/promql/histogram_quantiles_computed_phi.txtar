# histogram_quantiles with a computed phi (#1765). The guard demanded a
# literal so the `q` label could be folded at lowering time; reference
# Prometheus type-checks the phi arguments as scalar-valued and reads
# phi[0].F per step, so `scalar(m)` is an ordinary query there.
#
# The label value is now rendered at query time with OpenMetrics float
# formatting (the multiIf/arrayMap in the emitted SQL), not folded — which
# is why the expected label reads "0.5" rather than a Float64 round-trip
# artefact of it.
-- query.promql --
histogram_quantiles(http_server_request_duration_bucket, "q", scalar(phi_k))
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [1, 2, 3], [0.1, 0.5, 1.0]);
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('phi_k', map(), toDateTime64('2026-01-01 00:00:00', 9), 0.5);
