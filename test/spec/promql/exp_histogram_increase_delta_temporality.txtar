# A DELTA-temporality native histogram stores one interval's observations per
# row. increase() excludes the earliest row, so its numerator is the second
# row's Count, Sum, ZeroCount, and bucket values rather than their cumulative
# counter difference.
-- query.promql --
increase(delta_latency_exp_hist[1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    (1, 'delta_latency_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:59:02', 9), 10, 5.0, 0, 2, 0, [6, 2], 0, []),
    (1, 'delta_latency_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 40, 20.0, 0, 8, 0, [8, 24], 0, []);
