# A three-argument range function as a subquery inner (#1785). The
# subquery lowering accepted only one-argument calls, so the two scalar
# factors made this shape unreachable even though the matrix argument sits
# in the same position it always does. Reference Prometheus answers
# `max_over_time(double_exponential_smoothing(m[5m], 0.5, 0.5)[10m:1m])`.
#
# The sibling fixture (subquery_double_exponential_smoothing_computed_factors)
# puts the smoothing OUTSIDE the brackets; this one puts it inside, which
# is the arity path subqueryInnerRangeFnShape resolves.
#
# The seed zig-zags so the smoothing has something to smooth: a flat series
# would return its own value from every anchor and the fixture would pass
# whatever the recurrence did.
-- query.promql --
max_over_time(double_exponential_smoothing(temperature[5m], 0.5, 0.5)[30m:5m])
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:32:00', 9), 10.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:34:00', 9), 20.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:36:00', 9), 15.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:38:00', 9), 30.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:40:00', 9), 25.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:42:00', 9), 40.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:44:00', 9), 35.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:46:00', 9), 50.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:48:00', 9), 45.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:50:00', 9), 60.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:52:00', 9), 55.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:54:00', 9), 70.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:56:00', 9), 65.0),
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:58:00', 9), 80.0),
    ('temperature', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 75.0);
-- expected_rows --
[
  [{"host": "a"}, 85]
]
-- args --
[0] string = "service.name"
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = ""
[5] string = "service_name"
[6] string = "temperature"
-- chplan --
RangeWindow func=max_over_time range=30m0s step=0s ts=anchor_ts value=Value groupBy=[Attributes] start=0001-01-01T00:00:00Z end=2026-01-01T00:00:01Z
  RangeWindow func=holt_winters range=5m0s step=5m0s outerRange=30m0s ts=TimeUnix value=Value groupBy=[Attributes] scalars=[0.5, 0.5] start=2025-12-31T23:30:01Z end=2026-01-01T00:00:01Z
    Project [MetricName AS MetricName, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
      Filter predicate=(MetricName = "temperature")
        Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- sql --
SELECT `Attributes`, max(`Value`) AS `Value` FROM (SELECT `Attributes`, `anchor_ts`, anchor_ts AS `TimeUnix`, if(length(window_vals) > 1, tupleElement(arrayFold((acc, x) -> (0.5 * x + 0.5 * (tupleElement(acc, 1) + tupleElement(acc, 2)), 0.5 * (0.5 * x + 0.5 * (tupleElement(acc, 1) + tupleElement(acc, 2)) - tupleElement(acc, 1)) + 0.5 * tupleElement(acc, 2)), arraySlice(window_vals, 3), (window_vals[2], window_vals[2] - window_vals[1])), 1), nan) AS `Value` FROM (SELECT `Attributes`, `anchor_ts`, arrayMap(p -> tupleElement(p, 2), window_pairs) AS `window_vals`, arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), window_pairs)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), window_pairs)))) AS `counter_delta` FROM (SELECT `Attributes`, `anchor_ts`, arraySort(groupArray((`TimeUnix`, `Value`))) AS `window_pairs` FROM (SELECT `Attributes`, `TimeUnix`, `Value`, arrayJoin(arrayMap(i -> fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:00:01.000000000', 9)), 300000000000) * 300000000000) - toIntervalNanosecond(i * 300000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:00:01.000000000', 9)), 300000000000) * 300000000000)) - 300000000000, toInt64(300000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:00:01.000000000', 9)), 300000000000) * 300000000000)) - 300000000000, toInt64(300000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `TimeUnix`, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:00:01.000000000', 9)), 300000000000) * 300000000000)), toInt64(300000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:00:01.000000000', 9)), 300000000000) * 300000000000)), toInt64(300000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') PREWHERE (`MetricName` = ?))) WHERE `TimeUnix` > toDateTime64('2025-12-31 23:30:01.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:00:01.000000000', 9)) GROUP BY `Attributes`, `anchor_ts`)) WHERE length(`window_vals`) >= 2) WHERE `anchor_ts` > toDateTime64('2026-01-01 00:00:01.000000000', 9) - toIntervalNanosecond(1800000000000) AND `anchor_ts` <= toDateTime64('2026-01-01 00:00:01.000000000', 9) GROUP BY `Attributes`
