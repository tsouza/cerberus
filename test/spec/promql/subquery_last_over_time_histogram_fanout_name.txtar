# `last_over_time` over a SUBQUERY whose leaf is the HISTOGRAM fan-out.
#
# A classic histogram is one storage row that a selector fans out into
# three PromQL series — `<base>_sum`, `<base>_count`, `<base>_bucket` —
# via the union arms' `concat(MetricName, '_sum')` / `'_count'`
# projections. The `_sum` and `_count` arms carry an IDENTICAL attribute
# map (only `_bucket` gains an `le` label), so `MetricName` is the ONLY
# thing that distinguishes them.
#
# That makes this the shape where the spine's grouping key is
# load-bearing for CARDINALITY, not just for labels. On a spine grouped
# by `Attributes` alone the `_sum` and `_count` samples of one histogram
# land in the same window and merge into a single row whose value is
# whichever of the two sorted last. Widening the key to carry
# `MetricName` splits them back into the two series upstream reports —
# each with its own `__name__`, its own value, at its own timestamp.
#
# The seed below is deliberately arithmetic-legible: Sum and Count differ
# (12.5 vs 3), so a merged row is not merely mislabelled but numerically
# wrong, and the expected rows pin BOTH the series count and the values.
-- query.promql --
last_over_time({__name__=~"http_req_duration.*"}[10m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_req_duration', map('host', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 1, 4.5, [1, 0], [0.5]),
    ('http_req_duration', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 3, 12.5, [2, 1], [0.5]);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- expected_rows --
[
  ["http_req_duration_bucket", {"host": "a", "le": "+Inf"}, "2025-12-31T23:59:56Z", 3],
  ["http_req_duration_bucket", {"host": "a", "le": "0.5"}, "2025-12-31T23:59:56Z", 2],
  ["http_req_duration_count", {"host": "a"}, "2025-12-31T23:59:56Z", 3],
  ["http_req_duration_sum", {"host": "a"}, "2025-12-31T23:59:56Z", 12.5]
]
