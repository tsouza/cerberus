[
  ["up", {"instance": "i1", "job": "api", "version": "1.2.3"}, "2026-01-01T00:00:00Z", 1],
  ["up", {"instance": "i2", "job": "db", "version": "4.5.6"}, "2026-01-01T00:00:00Z", 0]
]
