-- query.promql --
info(up, {__name__="latency_exp_hist"})
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- cerberus issue #2574: info(v, {label matchers})'s SECOND argument names
-- an exponential-histogram metric via its __name__ matcher, unlike issue
-- #2509 (a histogram-valued BASE vector, arg[0]). Reference Prometheus's
-- info() (promql/info.go) only ever reads the info-metric series' LABELS
-- for the identity-label join — the info side's value type is
-- irrelevant — so a base float vector still enriches normally even
-- though the info metric it names is stored as a native histogram row,
-- not a plain Gauge/Sum sample.
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job', 'api', 'instance', 'i1'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('up', map('job', 'db',  'instance', 'i2'), toDateTime64('2026-01-01 00:00:00', 9), 0.0);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('job', 'api', 'instance', 'i1', 'version', '1.2.3'), toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 0, 0, [1, 2, 3], 0, []),
    ('latency_exp_hist', map('job', 'db',  'instance', 'i2', 'version', '4.5.6'), toDateTime64('2026-01-01 00:00:00', 9), 4, 10.0, 0, 0, 0, [7],        0, []);
