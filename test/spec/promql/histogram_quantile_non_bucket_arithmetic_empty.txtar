Arithmetic over a series that is not a histogram bucket may still carry an
`le` label, so histogram_quantile reads every sample's `le`: here job=a
carries none and job=b carries one that does not parse as a bound.
Prometheus skips both samples and answers an empty vector; so does the
float-domain ladder reassembly, which admits only parseable bounds.

-- query.promql --
histogram_quantile(0.8, queue_depth * 2)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String, Attributes Map(String, String), ResourceAttributes Map(String, String),
    TimeUnix DateTime64(9), Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('queue_depth', map('job','a'), map(), toDateTime64('2026-01-01 00:00:00', 9), 3.0),
    ('queue_depth', map('job','b','le','not-a-bound'), map(), toDateTime64('2026-01-01 00:00:00', 9), 5.0);
-- expected_rows --
[]
