# Negative/scope-boundary counterpart of
# native_rate_vector_agg_temporality_union.txtar (cerberus issue #2852):
# avg() is EXCLUDED from [nativeGridVectorAggUnionFns] — re-applying `avg`
# at the combining Aggregate would average the native arm's single
# already-averaged row as one bare observation among the raw DELTA arm's
# rows, silently under-weighting the CUMULATIVE side whenever it summarizes
# more than one series (see that var's own doc, and the avg/count follow-up,
# cerberus issue #2884). This fixture pins that
# [rateIncreaseTemporalityUnionArms] still recognizes the union shape but
# [buildTemporalityUnionVectorAgg] is never invoked for avg: the `-- chplan
# --` golden below shows the ORDINARY exploded-then-grouped Aggregate over
# the full Project(UnionAll{...}) input, byte-identical to what this query
# would lower to with ts_grid_vector_agg disabled entirely — proving the new
# branch is inert for avg rather than emitting something subtly wrong.

-- query.promql --
avg by(host) (rate(cerberus_requests_total[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_ts_grid_range --
-- experimental_ts_grid_vector_agg --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64,
    AggregationTemporality Int32
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
