    ('cerberus_requests_total', map('host', 'a', 'worker', 'x'), toDateTime64('2026-01-01 00:05:00', 9), 300.0, 0),
    ('cerberus_requests_total', map('host', 'a', 'worker', 'y'), toDateTime64('2026-01-01 00:00:00', 9), 0.0, 1),
    ('cerberus_requests_total', map('host', 'a', 'worker', 'y'), toDateTime64('2026-01-01 00:01:00', 9), 10.0, 1),
    ('cerberus_requests_total', map('host', 'a', 'worker', 'y'), toDateTime64('2026-01-01 00:02:00', 9), 10.0, 1),
    ('cerberus_requests_total', map('host', 'a', 'worker', 'y'), toDateTime64('2026-01-01 00:03:00', 9), 10.0, 1),
    ('cerberus_requests_total', map('host', 'a', 'worker', 'y'), toDateTime64('2026-01-01 00:04:00', 9), 10.0, 1),
    ('cerberus_requests_total', map('host', 'a', 'worker', 'y'), toDateTime64('2026-01-01 00:05:00', 9), 10.0, 1);
