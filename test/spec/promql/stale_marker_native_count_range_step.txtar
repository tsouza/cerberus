-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, FnToFloat64(Count) AS Value]
  Filter predicate=FnNot((FnBitAnd(stale_latest_flags, 1) != 0))
    RangeBucketFanout step=30s lookback=5m0s groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnArgMax(Count, TimeUnix) AS Count, FnArgMax(Sum, TimeUnix) AS Sum, FnArgMax(Scale, TimeUnix) AS Scale, FnArgMax(ZeroCount, TimeUnix) AS ZeroCount, FnArgMax(PositiveOffset, TimeUnix) AS PositiveOffset, FnArgMax(PositiveBucketCounts, TimeUnix) AS PositiveBucketCounts, FnArgMax(NegativeOffset, TimeUnix) AS NegativeOffset, FnArgMax(NegativeBucketCounts, TimeUnix) AS NegativeBucketCounts, FnArgMax(Flags, TimeUnix) AS stale_latest_flags] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
      Project [TimeUnix AS TimeUnix, ResourceAttributes AS ResourceAttributes, FnMapSort(Attributes) AS Attributes, ServiceName AS ServiceName, Count AS Count, Sum AS Sum, Scale AS Scale, ZeroCount AS ZeroCount, PositiveOffset AS PositiveOffset, PositiveBucketCounts AS PositiveBucketCounts, NegativeOffset AS NegativeOffset, NegativeBucketCounts AS NegativeBucketCounts, Flags AS Flags]
        Filter predicate=(MetricName IN ("stale_exp_hist", "stale.exp.hist", "stale.exp/hist", "stale.exp_hist", "stale/exp/hist", "stale/exp_hist", "stale_exp.hist"))
          Scan(otel_metrics_exponential_histogram)
-- settings --
enable_analyzer=0
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
group_by_two_level_threshold_bytes=1
log_comment=cerb:project;rbf
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
