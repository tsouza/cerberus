# Companion to histogram_quantile_classic_negative_lowest_bound: the SAME
# non-positive-bounded ladder with a rank that lands ABOVE the first bucket.
# The non-positive-first-bucket short-circuit must not fire here — the guard
# is `b == 0`, not "the histogram has a non-positive bound" — so ordinary
# linear interpolation still runs.
#
# bounds [-10, 0, 5], counts [4, 1, 1, 1] → ladder [4, 5, 6, 7], total 7.
# phi=0.8 → rank 5.6, first covered by rung 3 (6), so the answer interpolates
# across (0, 5] : 0 + (5-0) * (5.6-5)/(6-5) = 3.
-- query.promql --
histogram_quantile(0.8, http_server_request_duration_bucket)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [4, 1, 1, 1], [-10.0, 0.0, 5.0]);
-- expected_rows --
[
  ["", {"job": "api"}, "2026-01-01T00:00:01Z", 3.0000000000000027]
]
-- args --
[0] string = ""
