-- chplan --
AbsentOverTime range=1m0s step=30s ts=TimeUnix value=Value name=MetricName attrs=Attributes synth=[job="a"] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
  Project [TimeUnix AS TimeUnix]
    Filter predicate=(((FnCoalesce(FnNullIf(Attributes["job"], ""), FnNullIf(ResourceAttributes["job"], ""), "") = "a") AND (MetricName IN ("stale_exp_hist", "stale.exp.hist", "stale.exp/hist", "stale.exp_hist", "stale/exp/hist", "stale/exp_hist", "stale_exp.hist"))) AND FnNot((FnBitAnd(Flags, 1) != 0)))
      Scan(otel_metrics_exponential_histogram)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:aot;aot
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT ? AS `MetricName`, map(?, ?) AS `Attributes`, anchor_ts AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT anchor_ts FROM (SELECT arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:00:00.000000000', 9) + toIntervalNanosecond(i * 30000000000), range(0, 11))) AS `anchor_ts` FROM (SELECT 1)) WHERE anchor_ts GLOBAL NOT IN ((SELECT arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:00:00.000000000', 9) + toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', toDateTime64('2026-01-01 00:00:00.000000000', 9), `TimeUnix`) - 1, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', toDateTime64('2026-01-01 00:00:00.000000000', 9), `TimeUnix`) - 1, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', toDateTime64('2026-01-01 00:00:00.000000000', 9), `TimeUnix`) + 59999999999, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', toDateTime64('2026-01-01 00:00:00.000000000', 9), `TimeUnix`) + 59999999999, toInt64(30000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT `TimeUnix` AS `TimeUnix` FROM (SELECT * FROM `otel_metrics_exponential_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?)) WHERE (coalesce(nullIf(`Attributes`[?], ?), nullIf(`ResourceAttributes`[?], ?), ?) = ?) AND not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(60000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9))))
-- sql_optimized --
SELECT ? AS `MetricName`, map(?, ?) AS `Attributes`, anchor_ts AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT anchor_ts FROM (SELECT arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:00:00.000000000', 9) + toIntervalNanosecond(i * 30000000000), range(0, 11))) AS `anchor_ts` FROM (SELECT 1)) WHERE anchor_ts GLOBAL NOT IN ((SELECT arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:00:00.000000000', 9) + toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', toDateTime64('2026-01-01 00:00:00.000000000', 9), `TimeUnix`) - 1, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', toDateTime64('2026-01-01 00:00:00.000000000', 9), `TimeUnix`) - 1, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', toDateTime64('2026-01-01 00:00:00.000000000', 9), `TimeUnix`) + 59999999999, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', toDateTime64('2026-01-01 00:00:00.000000000', 9), `TimeUnix`) + 59999999999, toInt64(30000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT `TimeUnix` AS `TimeUnix` FROM (SELECT `Attributes`, `Flags`, `MetricName`, `ResourceAttributes`, `TimeUnix` FROM `otel_metrics_exponential_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?)) WHERE (coalesce(nullIf(`Attributes`[?], ?), nullIf(`ResourceAttributes`[?], ?), ?) = ?) AND not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(60000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9))))
