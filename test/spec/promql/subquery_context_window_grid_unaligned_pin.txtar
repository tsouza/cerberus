 map(?, toString(`ServiceName`))))) AS `_typed_9dd667188fe2e4e7`), toTypeName(`_typed_9dd667188fe2e4e7`)) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') PREWHERE (`MetricName` = ?) WHERE not((bitAnd(`Flags`, ?) != ?))))) WHERE `_src_ts` > parseDateTime64BestEffort('2025-12-31 22:53:45.000000000Z', 9) - toIntervalNanosecond(30000000000) AND `_src_ts` <= parseDateTime64BestEffort('2025-12-31 22:58:45.000000000Z', 9)) GROUP BY `Attributes`, `anchor_ts`)) WHERE `anchor_ts` > parseDateTime64BestEffort('2025-12-31 22:58:45.000000000Z', 9) - toIntervalNanosecond(300000000000) AND `anchor_ts` <= parseDateTime64BestEffort('2025-12-31 22:58:45.000000000Z', 9) GROUP BY `Attributes`
