SELECT ? AS `MetricName`, `Attributes`, `TimeUnix`, toFloat64((((intDiv(modulo(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?) + ?) + (((modulo(intDiv(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?) = ?) AND ((intDiv(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?) != ?) OR (modulo(intDiv(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?), ?) = ?))) AND (intDiv(modulo(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?) < ?))) - (? * (intDiv(modulo(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?) >= ?)))) AS `Value` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `lwr_ts` AS `TimeUnix`, `lwr_value` AS `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, max(`TimeUnix`) AS `lwr_ts`, argMax(`Value`, `TimeUnix`) AS `lwr_value` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, if((bitAnd(`Flags`, ?) != ?), reinterpretAsFloat64(?), `Value`) AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?)))) WHERE ((`TimeUnix` <= parseDateTime64BestEffort(?, ?)) AND (`TimeUnix` > (parseDateTime64BestEffort(?, ?) - toIntervalNanosecond(?))))) GROUP BY `MetricName`, `Attributes`)) WHERE (reinterpretAsUInt64(`Value`) != ?))
