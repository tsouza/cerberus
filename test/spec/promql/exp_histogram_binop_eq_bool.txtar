-- query.promql --
http_server_duration_exp_hist == bool http_client_duration_exp_hist
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- `==` with the `bool` modifier between two DIFFERENT exp-histogram
-- metrics (cerberus issue #2273, gap 2). Reference's VectorBinop
-- overrides the histogram result to nil and the value to 1.0/0.0 for
-- EVERY matched pair regardless of `keep`
-- (lowerExpHistogramHistogramCompareBoolBinop, histogram_native_binop_eq.go)
-- — a FLOAT-valued result, unlike the histogram-valued structural filter
-- the same operator answers without `bool` (exp_histogram_binop_eq.txtar).
--
--   `same`: server and client publish IDENTICAL rows — `Equals` is true,
--   kept with Value=1.
--
--   `diff`: server and client disagree on every field — `Equals` is
--   false, but the `bool` modifier keeps the row anyway, with Value=0.
--
--   `server_only` exists on ONE side only — PromQL's default one-to-one
--   V-V matching drops a series absent from either operand BEFORE the
--   `bool` override applies (reference's `doBinOp` never runs for an
--   unmatched signature), so it never reaches the output regardless of
--   `bool`.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('series', 'same'),        toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 1, 0, [1, 2, 3], 0, []),
    ('http_client_duration_exp_hist', map('series', 'same'),        toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 1, 0, [1, 2, 3], 0, []),
    ('http_server_duration_exp_hist', map('series', 'diff'),        toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 1, 0, [1, 2, 3], 0, []),
    ('http_client_duration_exp_hist', map('series', 'diff'),        toDateTime64('2026-01-01 00:00:00', 9), 9, 10.5, 1, 2, 0, [9, 9],    0, []),
    ('http_server_duration_exp_hist', map('series', 'server_only'), toDateTime64('2026-01-01 00:00:00', 9), 4, 0.4,  0, 0, 0, [7],       0, []);
-- expected_rows --
[
  [{"series": "diff"}, "2026-01-01T00:00:01Z", "", 0],
  [{"series": "same"}, "2026-01-01T00:00:01Z", "", 1]
]
