# Deferred label shaping (ts_grid_recollapse) on the native
# timeSeriesRateToGrid lowering: the SQL-shape floor.
#
# Same query, same `range_step`, same seed, same grid as
# native_rate_range_step.txtar — the ONLY difference is the
# `experimental_ts_grid_recollapse` section. Diffing the two fixtures
# therefore isolates exactly what the hoist changes, and the shared
# `expected_rows` pins that it changes nothing observable.
#
# The rewrite defers the label-shaping tower
# (mapSort(mapConcat(mapUpdate(mapFromArrays(...))))) from BELOW the
# aggregate to ABOVE it, so it runs once per raw SERIES instead of once
# per raw ROW. Three levels replace the usual two:
#
#   state : GROUP BY the RAW shaping inputs -> timeSeriesRateToGridState
#   merge : shaping tower AS shaped_key_0  -> timeSeriesRateToGridMerge
#   outer : shaped_key_0 AS Attributes     -> ARRAY JOIN grid, grid_ts
#
# Two properties of the `-- sql --` golden are load-bearing and must be
# read, not skimmed, on any regeneration:
#
#  1. The state level's `GROUP BY` lists the RAW columns
#     (`Attributes`, `ResourceAttributes`, `ServiceName`) and contains NO
#     mapSort. Grouping the state level on the SHAPED map instead would
#     return correct rows at the OLD cost — an inert rewrite no assertion
#     on the result can see.
#  2. The shaped map is aliased `shaped_key_0` at the merge level and
#     renamed to `Attributes` only at the OUTER level. Aliasing it back to
#     `Attributes` at the level that carries GROUP BY re-binds the grouping
#     key to the shaped column, which is failure mode 1 by another route.

-- query.promql --
sum by(cerberus_ql) (rate(cerberus_queries_total[5m]))
-- range_step --
30s
-- experimental_ts_grid_range --
-- experimental_ts_grid_recollapse --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
