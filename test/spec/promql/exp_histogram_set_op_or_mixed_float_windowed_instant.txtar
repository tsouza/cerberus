-- query.promql --
rate(http_requests_a_total[5m]) or latency_exp_hist
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64,
    AggregationTemporality UInt8
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- Cerberus issue #2333: the float side of a MIXED `or` is now allowed to
-- be a windowed / derived shape, not just the plain canonical quartet
-- (MetricName, Attributes, TimeUnix, Value) that issue #2330's fix
-- covered. `rate(...)` reduces its input to ONE row per series with no
-- per-row timestamp — chplan.ReducedWindowRowShape — which
-- lowerMixedExpHistogramSetOp previously rejected outright with "'or'
-- between a float-valued and a histogram-valued operand only supports a
-- plain (non-windowed) float side today". The two metrics' label sets
-- are disjoint (`job=api` vs `service=web`), so — exactly like the
-- #2330 fixtures — every LHS row survives (as always) AND every RHS row
-- survives too (its signature is absent from the LHS): the mixed union
-- carries one float sample and one native-histogram sample at once.
INSERT INTO otel_metrics_sum VALUES
    ('http_requests_a_total', map('job', 'api'), toDateTime64('2025-12-31 23:59:31', 9), 10.0, 1),
    ('http_requests_a_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 40.0, 1);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('service', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 3, 3.0, 0, 0, 0, [9], 0, []);
