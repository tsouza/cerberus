[
  ["", {"job": "api"}, "2025-12-31T23:59:56Z", 0.17126436781609194, 0, 0, 0, 0, 0, 0, [], 0, [], 0],
  ["latency_exp_hist", {"service": "web"}, "2026-01-01T00:00:01Z", 0, 3, 3, 0, 0, 0, 0, [9], 0, [], 1]
]
