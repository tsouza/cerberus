-- query.promql --
(histogram_quantile(0.5, mvv_pow_a_base_exp_hist) or mvv_pow_a_hist_exp_hist) ^ (histogram_quantile(0.5, mvv_pow_b_base_exp_hist) or mvv_pow_b_hist_exp_hist)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- `(<A quantile> or <A hist>) ^ (<B quantile> or <B hist>)` — cerberus
-- issue #2449's `^`/`%`/`atan2` wrapper family, vector-vector arithmetic
-- over TWO independently mixed float/histogram `or` operands. Reference
-- Prometheus's vectorElemBinop drops EVERY histogram-involving
-- combination for `^`/`%`/`atan2` — unlike `+`/`-` (float,float AND
-- histogram,histogram keep) and `*`//` (three of four combinations keep)
-- — so ONLY float,float ever survives
-- (histogram_native_mixed_or_vector_arithmetic.go's own header has the
-- full accounting; `%`/`atan2` share this same lowering and are pinned
-- separately by histogram_native_mixed_or_vector_arithmetic_chdb_test.go):
--   - series "api": BOTH operands resolve float (the A/B quantile arms)
--     -> kept, `pow(l, r)`.
--   - series "web": the LHS operand resolves histogram (mvv_pow_a_hist),
--     the RHS resolves float (the B quantile arm) -> DROPPED, matching
--     reference's own drop for a histogram,float pair under `^`.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('mvv_pow_a_base_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 10, 10.0, 0, 0, 0, [1, 2, 3, 4], 0, []),
    ('mvv_pow_b_base_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 10, 10.0, 0, 0, 0, [1, 2, 3, 4], 0, []),
    ('mvv_pow_a_hist_exp_hist', map('service', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 2, 4.0,  0, 0, 0, [6],           0, []),
    ('mvv_pow_b_base_exp_hist', map('service', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 10, 10.0, 0, 0, 0, [1, 2, 3, 4], 0, []);
