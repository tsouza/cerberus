Project ["" AS MetricName, _mvj_L_Attributes AS Attributes, _mvj_L_TimeUnix AS TimeUnix, (_mvj_L_Value ^ _mvj_R_Value) AS Value, _mvj_L_HistogramCount AS HistogramCount, _mvj_L_HistogramSum AS HistogramSum, _mvj_L_HistogramZeroCount AS HistogramZeroCount, _mvj_L_HistogramScale AS HistogramScale, _mvj_L_HistogramZeroThreshold AS HistogramZeroThreshold, _mvj_L_HistogramPositiveOffset AS HistogramPositiveOffset, _mvj_L_HistogramPositiveBucketCounts AS HistogramPositiveBucketCounts, _mvj_L_HistogramNegativeOffset AS HistogramNegativeOffset, _mvj_L_HistogramNegativeBucketCounts AS HistogramNegativeBucketCounts, _mvj_L__setop_is_histogram AS _setop_is_histogram]
  Filter predicate=((_mvj_L__setop_is_histogram = 0) AND (_mvj_R__setop_is_histogram = 0))
    MixedVectorJoin match=default card=one-to-one
      VectorSetOp op=or match=default mixed
        Project ["" AS MetricName, Attributes AS Attributes, FnNow64(9) AS TimeUnix, Value AS Value]
          HistogramQuantileNative phi=0.5 groupBy=[Attributes AS Attributes]
            Aggregate groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnArgMax(Count, TimeUnix) AS Count, FnArgMax(Sum, TimeUnix) AS Sum, FnArgMax(Scale, TimeUnix) AS Scale, FnArgMax(ZeroCount, TimeUnix) AS ZeroCount, FnArgMax(PositiveOffset, TimeUnix) AS PositiveOffset, FnArgMax(PositiveBucketCounts, TimeUnix) AS PositiveBucketCounts, FnArgMax(NegativeOffset, TimeUnix) AS NegativeOffset, FnArgMax(NegativeBucketCounts, TimeUnix) AS NegativeBucketCounts] having=FnNot((FnBitAnd(FnArgMax(Flags, TimeUnix), 1) != 0)) dropEmptyOnNoGroup
              Filter predicate=(((MetricName IN ("mvv_pow_a_base_exp_hist", "mvv.pow.a.base.exp.hist", "mvv.pow.a.base.exp/hist", "mvv.pow.a.base.exp_hist", "mvv.pow.a.base/exp/hist", "mvv.pow.a.base/exp_hist", "mvv.pow.a.base_exp.hist", "mvv.pow.a.base_exp_hist", "mvv.pow.a/base/exp/hist", "mvv.pow.a/base/exp_hist", "mvv.pow.a/base_exp_hist", "mvv.pow.a_base.exp.hist", "mvv.pow.a_base.exp_hist", "mvv.pow.a_base_exp.hist", "mvv.pow.a_base_exp_hist", "mvv.pow/a/base/exp/hist", "mvv.pow/a/base/exp_hist", "mvv.pow/a/base_exp_hist", "mvv.pow/a_base_exp_hist", "mvv.pow_a.base.exp.hist", "mvv.pow_a.base.exp_hist", "mvv.pow_a.base_exp.hist", "mvv.pow_a.base_exp_hist", "mvv.pow_a_base.exp.hist", "mvv.pow_a_base.exp_hist", "mvv.pow_a_base_exp.hist", "mvv.pow_a_base_exp_hist", "mvv/pow/a/base/exp/hist", "mvv/pow/a/base/exp_hist", "mvv/pow/a/base_exp_hist", "mvv/pow/a_base_exp_hist", "mvv/pow_a_base_exp_hist", "mvv_pow.a.base.exp.hist", "mvv_pow.a.base.exp_hist", "mvv_pow.a.base_exp.hist", "mvv_pow.a.base_exp_hist", "mvv_pow.a_base.exp.hist", "mvv_pow.a_base.exp_hist", "mvv_pow.a_base_exp.hist", "mvv_pow.a_base_exp_hist", "mvv_pow_a.base.exp.hist", "mvv_pow_a.base.exp_hist", "mvv_pow_a.base_exp.hist", "mvv_pow_a.base_exp_hist", "mvv_pow_a_base.exp.hist", "mvv_pow_a_base.exp_hist", "mvv_pow_a_base_exp.hist")) AND (TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9))) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
                Scan(otel_metrics_exponential_histogram)
