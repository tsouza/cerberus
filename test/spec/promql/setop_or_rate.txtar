-- query.promql --
rate(http_requests_a_total[5m]) or rate(http_requests_b_total[5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('http_requests_a_total', map('job', 'api'),   toDateTime64('2025-12-31 23:59:31', 9), 10.0),
    ('http_requests_a_total', map('job', 'api'),   toDateTime64('2026-01-01 00:00:00', 9), 40.0),
    ('http_requests_b_total', map('job', 'web'),   toDateTime64('2025-12-31 23:59:31', 9), 5.0),
    ('http_requests_b_total', map('job', 'web'),   toDateTime64('2026-01-01 00:00:00', 9), 20.0);
