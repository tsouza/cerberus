# Multi-argument range function as a subquery's inner expression
# (#1785). The subquery lowering previously admitted only single-argument
# matrix-selector calls, so `quantile_over_time(phi, m[r])[range:step]`
# was rejected while reference Prometheus answers it. The matrix argument
# is at index 1 here, which is why the shape table is keyed by function
# rather than assuming argument 0.
-- query.promql --
max_over_time(quantile_over_time(0.9, http_requests_total[5m])[30m:5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:32:00', 9), 1.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:37:00', 9), 3.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:42:00', 9), 7.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:47:00', 9), 2.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:52:00', 9), 9.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:57:00', 9), 4.0);
