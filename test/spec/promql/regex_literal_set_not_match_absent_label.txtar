# A negated literal-set matcher renders as NOT IN over the set. An absent
# label reads as '', which is not in the set, so `job!~"api|web"` keeps
# the series with no job label, as Prometheus does.

-- query.promql --
up{job!~"api|web"}
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('up', map('job', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 2.0),
    ('up', map('job', 'database'), toDateTime64('2026-01-01 00:00:00', 9), 3.0),
    ('up', map('instance', 'i-1'), toDateTime64('2026-01-01 00:00:00', 9), 4.0);
