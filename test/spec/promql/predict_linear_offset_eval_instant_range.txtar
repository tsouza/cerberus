# `predict_linear(m[10m] offset 2m, 60)` over query_range. Each step reads
# (step - 12m, step - 2m] and forecasts 60s past the step itself. The steps
# 00:00 to 00:03 hold both samples on the line value = seconds since
# 23:52:00 and answer the line at step + 60s; from 00:04 the left-open window
# has lost the 23:52:00 sample and holds one, so the series drops.

-- query.promql --
predict_linear(machine_load[10m] offset 2m, 60)
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- Two samples on the line value = seconds since 23:52:00, then one far off it.
INSERT INTO otel_metrics_gauge VALUES
    ('machine_load', map('job', 'api'), toDateTime64('2025-12-31 23:52:00', 9), 0.0),
    ('machine_load', map('job', 'api'), toDateTime64('2025-12-31 23:56:16', 9), 256.0),
    ('machine_load', map('job', 'api'), toDateTime64('2026-01-01 00:03:30', 9), 9000.0);
-- expected_rows --
[
  [{"job": "api"}, "2025-12-31T23:58:00Z", "2026-01-01T00:00:00Z", 540],
  [{"job": "api"}, "2025-12-31T23:59:00Z", "2026-01-01T00:01:00Z", 600],
  [{"job": "api"}, "2026-01-01T00:00:00Z", "2026-01-01T00:02:00Z", 660],
  [{"job": "api"}, "2026-01-01T00:01:00Z", "2026-01-01T00:03:00Z", 720]
]
-- args --
[0] float64 = 180
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = "service.name"
[5] string = "service_name"
[6] string = ""
[7] string = "service_name"
[8] string = "machine_load"
[9] string = "machine.load"
[10] string = "machine/load"
[11] int64 = 1
[12] int64 = 0
-- args_optimized --
[0] float64 = 180
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = "service.name"
[5] string = "service_name"
[6] string = ""
[7] string = "service_name"
[8] string = "machine_load"
[9] string = "machine.load"
[10] string = "machine/load"
[11] int64 = 1
[12] int64 = 0
-- chplan --
RangeWindow func=predict_linear range=10m0s step=1m0s outerRange=5m0s offset=2m0s ts=TimeUnix value=Value groupBy=[Attributes] scalars=[180] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z distinctSampleRows
  Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
    Filter predicate=((MetricName IN ("machine_load", "machine.load", "machine/load")) AND FnNot((FnBitAnd(Flags, 1) != 0)))
      Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:rw;rw;union
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT `Attributes`, `anchor_ts`, (anchor_ts + toIntervalNanosecond(120000000000)) AS `TimeUnix`, if(length(window_pairs) > 1, tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', anchor_ts, tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 2) + tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', anchor_ts, tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 1) * ?, nan) AS Value FROM (SELECT `Attributes`, `anchor_ts`, arrayCompact(arraySort(groupArray((`TimeUnix`, `Value`)))) AS window_pairs FROM (SELECT `Attributes`, `TimeUnix`, `Value`, arrayJoin(arrayMap(i -> (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000)) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))) - 600000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))) - 600000000000, toInt64(60000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `TimeUnix`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))), toInt64(60000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') PREWHERE (`MetricName` IN (?, ?, ?)) WHERE not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > (parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(120000000000)) - toIntervalNanosecond(600000000000) AND `TimeUnix` <= (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))) GROUP BY `Attributes`, `anchor_ts`) WHERE length(`window_pairs`) >= 2
-- sql_optimized --
SELECT `Attributes`, `anchor_ts`, (anchor_ts + toIntervalNanosecond(120000000000)) AS `TimeUnix`, if(length(window_pairs) > 1, tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', anchor_ts, tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 2) + tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', anchor_ts, tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 1) * ?, nan) AS Value FROM (SELECT `Attributes`, `anchor_ts`, arrayCompact(arraySort(groupArray((`TimeUnix`, `Value`)))) AS window_pairs FROM (SELECT `Attributes`, `TimeUnix`, `Value`, arrayJoin(arrayMap(i -> (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000)) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))) - 600000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))) - 600000000000, toInt64(60000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `TimeUnix`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))), toInt64(60000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes`, `Flags`, `MetricName`, `ResourceAttributes`, `ServiceName`, `TimeUnix`, `Value` FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') PREWHERE (`MetricName` IN (?, ?, ?)) WHERE not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > (parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(120000000000)) - toIntervalNanosecond(600000000000) AND `TimeUnix` <= (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(120000000000))) GROUP BY `Attributes`, `anchor_ts`) WHERE length(`window_pairs`) >= 2
