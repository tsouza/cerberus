# Computed K on the subquery-over-aggregation path (lowerSubqueryOverTopK).
# K is read once per evaluation as a one-row relation, exactly as in
# instant position, and the rank filter runs per anchor inside the
# subquery.
#
# Hand-derived. metric_k resolves to 2.0 at the eval anchor, so each of
# the 1m anchors in (23:55:01, 00:00:01] keeps the two largest
# `temperature` series — host=b (2.0) and host=c (3.0); host=a (1.0) is
# dropped everywhere. max_over_time of each survivor's anchor grid is its
# constant value, and max_over_time drops __name__.

-- query.promql --
max_over_time(topk(scalar(metric_k), temperature)[5m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('temperature', map('host', 'a'), toDateTime64('2025-12-31 23:58:00', 9), 1.0),
    ('temperature', map('host', 'b'), toDateTime64('2025-12-31 23:58:00', 9), 2.0),
    ('temperature', map('host', 'c'), toDateTime64('2025-12-31 23:58:00', 9), 3.0),
    ('metric_k', map(), toDateTime64('2025-12-31 23:55:00', 9), 2.0),
    ('metric_k', map(), toDateTime64('2026-01-01 00:00:00', 9), 2.0);
-- expected_rows --
[
  [{"host": "b"}, 2],
  [{"host": "c"}, 3]
]
