# A pinned selector below a subquery reads its pin at every step of the
# subquery's grid: the latest sample at or before 23:59:00.

-- query.promql --
max_over_time((m @ 1767225540)[5m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
