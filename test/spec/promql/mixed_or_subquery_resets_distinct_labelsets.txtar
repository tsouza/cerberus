-- query.promql --
resets((latency_exp_hist or on(pod) latency_float)[3m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- `resets` over a subquery whose inner is a mixed float/histogram `or`
-- reduces through lowerMixedOrSubqueryResetsOrChangesInput, and this is
-- the corpus's only fixture for it. It is enrolled against the reference
-- engine because the whole point is that BOTH series come back with
-- their own per-series pair count -- the shape cerberus issue #3232
-- found was being merged whenever the two arms collide on one label set.
--
-- Here they do NOT collide: `or on(pod)` keys the shadow on `pod`, and
-- the two arms carry different values for it, so nothing is shadowed and
-- each series folds over its own full three-anchor window. That is the
-- boundary the name-drop collision guard must NOT fire on -- it counts
-- the distinct `__name__` values feeding ONE group, and here they land in
-- two.
--
-- The float arm's readings step 5, 5, 2 across the anchors, so exactly
-- one consecutive pair decreases; the histogram arm's observation count
-- only ever rises, so its own pair count is zero. Two DIFFERENT answers
-- rather than two copies of one, so a reduction that merged the arms
-- could not produce this pair by accident.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('x', '1', 'pod', 'h1'), toDateTime64('2025-12-31 23:57:30', 9), 10, 20.0, 0, 0, 0, [1, 2, 3, 4], 0, []),
    ('latency_exp_hist', map('x', '1', 'pod', 'h1'), toDateTime64('2025-12-31 23:59:30', 9), 12, 24.0, 0, 0, 0, [1, 2, 3, 4], 0, []);
INSERT INTO otel_metrics_gauge VALUES
    ('latency_float', map('x', '1', 'pod', 'f1'), toDateTime64('2025-12-31 23:57:30', 9), 5.0),
    ('latency_float', map('x', '1', 'pod', 'f1'), toDateTime64('2025-12-31 23:59:45', 9), 2.0);
-- expected_rows --
[
  ["", {"pod": "f1", "x": "1"}, "2026-01-01T00:00:01Z", 1],
  ["", {"pod": "h1", "x": "1"}, "2026-01-01T00:00:01Z", 0]
]
