# `day_of_month()` — the zero-arg form. PromQL spec:
# `day_of_month()` ≡ `day_of_month(vector(time()))`. cerberus lowers
# it to a OneRow source projecting Value=toFloat64(toDayOfMonth(now())).
# The `toFloat64` wrap forces CH's UInt8 `toDayOfMonth` return into
# Float64 so the cursor decode into `*float64` doesn't error with
# `converting UInt8 to *float64 is unsupported`.

-- query.promql --
day_of_month()
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 1]
]
-- args --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] int64 = 5
[4] int64 = 4
[5] int64 = 4
[6] string = "2026-01-01 00:00:01.000000000Z"
[7] int64 = 9
[8] int64 = 1000000000
[9] int64 = 9223372028741760000
[10] int64 = 86400
[11] int64 = 3
[12] int64 = 146097
[13] int64 = 4
[14] int64 = 3
[15] int64 = 1461
[16] int64 = 4
[17] int64 = 461
[18] int64 = 153
[19] int64 = 5
[20] int64 = 1
-- chplan --
Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, FnToFloat64((FnIntDiv(FnModulo(((5 * FnIntDiv(FnModulo(((4 * FnIntDiv(FnModulo(((4 * FnIntDiv((FnReinterpretAsUInt64(FnIntDiv(FnToUnixNanos(FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9)), 1000000000)) + FnToUInt64(9223372028741760000)), 86400)) + 3), 146097), 4)) + 3), 1461), 4)) + 461), 153), 5) + 1)) AS Value]
  OneRow
-- sql --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64((intDiv(modulo(((? * intDiv(modulo(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(intDiv(toUnixTimestamp64Nano(parseDateTime64BestEffort(?, ?)), ?)) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?)) + ?), ?), ?) + ?)) AS `Value` FROM (SELECT 1)
