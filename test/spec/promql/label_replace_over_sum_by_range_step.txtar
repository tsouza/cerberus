# Regression: `label_replace(...)` wrapping an outer `sum by (...)`
# aggregation, evaluated as a range query, used to throw `vector cannot
# contain metrics with the same labelset` (HTTP 422) for any window with
# more than one non-empty step — even though the identical expression is
# completely legitimate and succeeds as an instant query.
#
# Root cause: in range mode, `lowerAggregate` (internal/promql/lower.go)
# injects a per-step group column into its own Aggregate under the
# INTERNAL alias `bucket_ts` (now the package-level [rangeBucketAlias]
# const) — the rename to the canonical TimeUnix column happens one layer
# up, in the wrapping Project `wrapAggregateForSample` builds. The
# duplicate-labelset guard's `guardKeysOnTimestamp`
# (internal/promql/duplicate_labelset_guard.go) walks straight through
# that wrapping Project (by design — Project/Filter only ever re-shape or
# re-alias columns) and then asks the underlying Aggregate whether its OWN
# `GroupByAliases` names the canonical timestamp column. For this shape it
# never does — the Aggregate's own alias is `bucket_ts`, not `TimeUnix` —
# so the guard wrongly concluded "not per-step" and omitted the per-step
# column from ITS OWN group key, collapsing every step of a >1-step window
# into one HAVING group and firing `count() > 1` on legitimate multi-step
# output.
#
# The fix teaches `guardKeysOnTimestamp` to also recognize `bucket_ts` as
# a timestamp alias on a raw Aggregate, alongside the canonical column
# name, via the shared [rangeBucketAlias] const both files reference.
#
# The seed and grid mirror sum_by_rate_range_step.txtar (a passing fixture
# for the SAME sum-by-rate shape without the label_replace wrapper) so the
# two can be compared by eye; this fixture adds the label_replace layer on
# top and proves it round-trips real row values through chDB, not just
# that lowering no longer errors.

-- query.promql --
label_replace(sum by(cerberus_ql) (rate(cerberus_queries_total[5m])), "engine", "$1", "cerberus_ql", "(.+)")
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
