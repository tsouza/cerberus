# `last_over_time` over an `@`-PINNED subquery, in range mode — the exact
# shape #1602 reported.
#
# An `@` modifier freezes the subquery's evaluation instant, so the range
# lowering evaluates the window ONCE and broadcasts the single result
# across the step grid (`Project[CrossJoin[StepGrid, RangeWindow]]`). That
# broadcast arm used to hardcode an EMPTY metric-name literal, which
# stripped `__name__` from a function that must preserve it.
#
# The two metrics share an identical attribute set, so a name that failed
# to ride the spine would also collapse them into a single series.
-- query.promql --
last_over_time({__name__=~"cpu_temp|gpu_temp"}[10m:1m] @ 1767225600)
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 40.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 41.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 42.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 70.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 71.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 72.0);
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
