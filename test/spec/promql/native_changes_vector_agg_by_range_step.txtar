# Experimental: ts_grid_vector_agg (cerberus issue #2763) with a NON-EMPTY
# outer `by (dc)` clause — the primary real-world shape the issue's own
# `sum by (job) (rate(m[5m]))` example describes, exercising the vecAgg
# level's GROUP BY with actual keys (native_changes_vector_agg_range_step.txtar
# covers the degenerate empty-GroupBy `sum(...)` case instead).
#
# Four raw series (host a/b/c/d) collapse into two output series (dc=x holds
# a+c, dc=y holds b+d) — the row-count-reduction claim in miniature: the
# pre-explode GROUP BY runs over 4 rows here instead of 2 (dc has fewer
# distinct values than host), so the anchors x hosts (4 x 11 = 44 potential
# cells) that would explode under the old Aggregate-over-exploded-rows shape
# collapse to anchors x dcs (2 x 11 = 22) BEFORE the query's only ARRAY JOIN.

-- query.promql --
sum by(dc) (changes(load_state[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_ts_grid_changes --
-- experimental_ts_grid_vector_agg --
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
