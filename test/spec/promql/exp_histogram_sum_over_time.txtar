-- query.promql --
sum_over_time(http_server_duration_exp_hist[5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- The api series crosses schemas inside its window. The scale-1 sample's
-- [1,2,3,4] ladder downscales to [3,7] at scale 0, then adds to [5,10],
-- yielding [8,17]. Count and Sum add independently to 25 and 3.
--
-- The solo series has exactly one in-window sample. Prometheus emits that
-- sample unchanged: unlike rate/increase, sum_over_time has a one-sample
-- floor. Keeping it in this fixture pins the floor and the per-series fold.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'),  toDateTime64('2025-12-31 23:59:01', 9), 10, 1.0, 1, 0, 0, [1, 2, 3, 4], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'),  toDateTime64('2026-01-01 00:00:01', 9), 15, 2.0, 0, 0, 0, [5, 10],      0, []),
    ('http_server_duration_exp_hist', map('service', 'solo'), toDateTime64('2026-01-01 00:00:01', 9),  6, 3.0, 0, 0, 0, [2, 4],       0, []);
-- expected_rows --
[
  ["", {"service": "api"}, "2026-01-01T00:00:01Z", 0, 25, 3, 0, 0, 0, 0, [8,17], 0, []],
  ["", {"service": "solo"}, "2026-01-01T00:00:01Z", 0, 6, 3, 0, 0, 0, 0, [2,4], 0, []]
]
