  Project [Attributes AS Attributes, FnArraySum(_hq_merge_counts) AS HistogramCount, FnArraySum(_hq_merge_sums) AS HistogramSum, _hq_merged_scale AS HistogramScale, FnArraySum(_hq_merge_zero_counts) AS HistogramZeroCount, HistogramZeroThreshold AS HistogramZeroThreshold, FnArrayMin(FnArrayMap((s, off) -> FnBitShiftRight(off, (s - _hq_merged_scale)), _hq_scales, _hq_pos_offsets)) AS HistogramPositiveOffset, FnArrayMap(mst -> FnArrayMap(t -> FnArraySum(FnArrayMap((s, off, arr) -> FnArraySum(FnArraySlice(arr, FnLeast(FnGreatest(((FnGreatest(off, ((mst + t) * bitShiftLeft(1, (s - _hq_merged_scale)))) - off) + 1), 1), (FnLength(arr) + 1)), FnGreatest(0, ((FnLeast(((off + FnLength(arr)) - 1), ((((mst + t) + 1) * bitShiftLeft(1, (s - _hq_merged_scale))) - 1)) - FnGreatest(off, ((mst + t) * bitShiftLeft(1, (s - _hq_merged_scale))))) + 1)))), _hq_scales, _hq_pos_offsets, _hq_pos_buckets)), FnRange(FnToUInt64(FnGreatest(0, ((FnArrayMax(FnArrayMap((sm, om, am) -> FnBitShiftRight((om + (FnLength(am) - 1)), (sm - _hq_merged_scale)), _hq_scales, _hq_pos_offsets, _hq_pos_buckets)) - mst) + 1))))), FnArray(FnArrayMin(FnArrayMap((sm, om) -> FnBitShiftRight(om, (sm - _hq_merged_scale)), _hq_scales, _hq_pos_offsets))))[1] AS HistogramPositiveBucketCounts, FnArrayMin(FnArrayMap((s, off) -> FnBitShiftRight(off, (s - _hq_merged_scale)), _hq_scales, _hq_neg_offsets)) AS HistogramNegativeOffset, FnArrayMap(mst -> FnArrayMap(t -> FnArraySum(FnArrayMap((s, off, arr) -> FnArraySum(FnArraySlice(arr, FnLeast(FnGreatest(((FnGreatest(off, ((mst + t) * bitShiftLeft(1, (s - _hq_merged_scale)))) - off) + 1), 1), (FnLength(arr) + 1)), FnGreatest(0, ((FnLeast(((off + FnLength(arr)) - 1), ((((mst + t) + 1) * bitShiftLeft(1, (s - _hq_merged_scale))) - 1)) - FnGreatest(off, ((mst + t) * bitShiftLeft(1, (s - _hq_merged_scale))))) + 1)))), _hq_scales, _hq_neg_offsets, _hq_neg_buckets)), FnRange(FnToUInt64(FnGreatest(0, ((FnArrayMax(FnArrayMap((sm, om, am) -> FnBitShiftRight((om + (FnLength(am) - 1)), (sm - _hq_merged_scale)), _hq_scales, _hq_neg_offsets, _hq_neg_buckets)) - mst) + 1))))), FnArray(FnArrayMin(FnArrayMap((sm, om) -> FnBitShiftRight(om, (sm - _hq_merged_scale)), _hq_scales, _hq_neg_offsets))))[1] AS HistogramNegativeBucketCounts]
    Project [FnMapMerge(_hq_L_Attributes, FnMapFilter((k, v) -> (k IN ("region")), _hq_R_Attributes)) AS Attributes, FnArray(_hq_L_HistogramCount, _hq_R_HistogramCount) AS _hq_merge_counts, FnArray(_hq_L_HistogramSum, _hq_R_HistogramSum) AS _hq_merge_sums, FnLeast(_hq_L_HistogramScale, _hq_R_HistogramScale) AS _hq_merged_scale, FnArray(_hq_L_HistogramZeroCount, _hq_R_HistogramZeroCount) AS _hq_merge_zero_counts, FnGreatest(_hq_L_HistogramZeroThreshold, _hq_R_HistogramZeroThreshold) AS HistogramZeroThreshold, FnArray(_hq_L_HistogramScale, _hq_R_HistogramScale) AS _hq_scales, FnArray(_hq_L_HistogramPositiveOffset, _hq_R_HistogramPositiveOffset) AS _hq_pos_offsets, FnArray(_hq_L_HistogramPositiveBucketCounts, _hq_R_HistogramPositiveBucketCounts) AS _hq_pos_buckets, FnArray(_hq_L_HistogramNegativeOffset, _hq_R_HistogramNegativeOffset) AS _hq_neg_offsets, FnArray(_hq_L_HistogramNegativeBucketCounts, _hq_R_HistogramNegativeBucketCounts) AS _hq_neg_buckets]
