-- chplan --
HistogramProjection project=[MetricName AS MetricName, Attributes AS Attributes, TimeUnix AS TimeUnix, 0 AS Value]
  Filter predicate=((((MetricName IN ("stale_exp_hist", "stale.exp.hist", "stale.exp/hist", "stale.exp_hist", "stale/exp/hist", "stale/exp_hist", "stale_exp.hist")) AND (TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9))) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000)))) AND FnNot((FnBitAnd(Flags, 1) != 0)))
    Scan(otel_metrics_exponential_histogram, columns=[MetricName, Attributes, TimeUnix, Count, Sum, Scale, ZeroCount, PositiveOffset, PositiveBucketCounts, NegativeOffset, NegativeBucketCounts, AggregationTemporality])
-- settings --
enable_analyzer=0
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:node
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
-- sql --
SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `TimeUnix` AS `TimeUnix`, toFloat64(?) AS `Value`, toFloat64(`Count`) AS `HistogramCount`, toFloat64(`Sum`) AS `HistogramSum`, toInt32(`Scale`) AS `HistogramScale`, toFloat64(0.) AS `HistogramZeroThreshold`, toFloat64(`ZeroCount`) AS `HistogramZeroCount`, toInt32(`PositiveOffset`) AS `HistogramPositiveOffset`, arrayMap(x -> toFloat64(x), `PositiveBucketCounts`) AS `HistogramPositiveBucketCounts`, toInt32(`NegativeOffset`) AS `HistogramNegativeOffset`, arrayMap(x -> toFloat64(x), `NegativeBucketCounts`) AS `HistogramNegativeBucketCounts` FROM (SELECT `_cerb_histogram_input`.1 AS `MetricName`, `_cerb_histogram_input`.2 AS `Attributes`, `_cerb_histogram_input`.3 AS `TimeUnix`, `_cerb_histogram_input`.4 AS `Count`, `_cerb_histogram_input`.5 AS `Sum`, `_cerb_histogram_input`.6 AS `Scale`, `_cerb_histogram_input`.7 AS `ZeroCount`, `_cerb_histogram_input`.8 AS `PositiveOffset`, `_cerb_histogram_input`.9 AS `PositiveBucketCounts`, `_cerb_histogram_input`.10 AS `NegativeOffset`, `_cerb_histogram_input`.11 AS `NegativeBucketCounts`, `_cerb_histogram_input`.12 AS `AggregationTemporality` FROM (SELECT arrayJoin([(`MetricName`, `Attributes`, `TimeUnix`, `Count`, `Sum`, `Scale`, `ZeroCount`, `PositiveOffset`, `PositiveBucketCounts`, `NegativeOffset`, `NegativeBucketCounts`, `AggregationTemporality`)]) AS `_cerb_histogram_input` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Count`, `Sum`, `Scale`, `ZeroCount`, `PositiveOffset`, `PositiveBucketCounts`, `NegativeOffset`, `NegativeBucketCounts`, `AggregationTemporality` FROM `otel_metrics_exponential_histogram` WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?)) AND (`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?))) AND not((bitAnd(`Flags`, ?) != ?)))))
