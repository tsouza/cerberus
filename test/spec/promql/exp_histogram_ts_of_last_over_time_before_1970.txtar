-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, (toFloat64(greatest(toUnixTimestamp64Milli(`ts_of_exp_hist_sample_ts`), ?)) / toFloat64(?)) AS `Value` FROM (SELECT CAST((mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `_typed_9dd667188fe2e4e7`), toTypeName(`_typed_9dd667188fe2e4e7`)) AS `Attributes`, max(`TimeUnix`) AS `ts_of_exp_hist_sample_ts` FROM (SELECT * FROM `otel_metrics_exponential_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)) WHERE (`TimeUnix` <= parseDateTime64BestEffort(?, ?)) AND (`TimeUnix` > (parseDateTime64BestEffort(?, ?) - toIntervalNanosecond(?))) AND not((bitAnd(`Flags`, ?) != ?))) GROUP BY `Attributes` HAVING not((bitAnd(argMax(`Flags`, `TimeUnix`), ?) != ?)))
