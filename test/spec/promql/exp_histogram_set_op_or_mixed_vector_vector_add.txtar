SELECT ? AS `MetricName`, `_mvj_L_Attributes` AS `Attributes`, `_mvj_L_TimeUnix` AS `TimeUnix`, (`_mvj_L_Value` + `_mvj_R_Value`) AS `Value` FROM (SELECT * FROM (SELECT L.`MetricName` AS `_mvj_L_MetricName`, R.`MetricName` AS `_mvj_R_MetricName`, L.`Attributes` AS `_mvj_L_Attributes`, R.`Attributes` AS `_mvj_R_Attributes`, L.`TimeUnix` AS `_mvj_L_TimeUnix`, R.`TimeUnix` AS `_mvj_R_TimeUnix`, L.`Value` AS `_mvj_L_Value`, R.`Value` AS `_mvj_R_Value`, L.`HistogramCount` AS `_mvj_L_HistogramCount`, R.`HistogramCount` AS `_mvj_R_HistogramCount`, L.`HistogramSum` AS `_mvj_L_HistogramSum`, R.`HistogramSum` AS `_mvj_R_HistogramSum`, L.`HistogramScale` AS `_mvj_L_HistogramScale`, R.`HistogramScale` AS `_mvj_R_HistogramScale`, L.`HistogramZeroThreshold` AS `_mvj_L_HistogramZeroThreshold`, R.`HistogramZeroThreshold` AS `_mvj_R_HistogramZeroThreshold`, L.`HistogramZeroCount` AS `_mvj_L_HistogramZeroCount`, R.`HistogramZeroCount` AS `_mvj_R_HistogramZeroCount`, L.`HistogramPositiveOffset` AS `_mvj_L_HistogramPositiveOffset`, R.`HistogramPositiveOffset` AS `_mvj_R_HistogramPositiveOffset`, L.`HistogramPositiveBucketCounts` AS `_mvj_L_HistogramPositiveBucketCounts`, R.`HistogramPositiveBucketCounts` AS `_mvj_R_HistogramPositiveBucketCounts`, L.`HistogramNegativeOffset` AS `_mvj_L_HistogramNegativeOffset`, R.`HistogramNegativeOffset` AS `_mvj_R_HistogramNegativeOffset`, L.`HistogramNegativeBucketCounts` AS `_mvj_L_HistogramNegativeBucketCounts`, R.`HistogramNegativeBucketCounts` AS `_mvj_R_HistogramNegativeBucketCounts`, L.`_setop_is_histogram` AS `_mvj_L__setop_is_histogram`, R.`_setop_is_histogram` AS `_mvj_R__setop_is_histogram` FROM (SELECT `_join_MetricName` AS `MetricName`, `_join_Attributes` AS `Attributes`, `_join_TimeUnix` AS `TimeUnix`, `_join_Value` AS `Value`, `_join_HistogramCount` AS `HistogramCount`, `_join_HistogramSum` AS `HistogramSum`, `_join_HistogramScale` AS `HistogramScale`, `_join_HistogramZeroThreshold` AS `HistogramZeroThreshold`, `_join_HistogramZeroCount