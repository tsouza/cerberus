-- chplan --
Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, Value AS Value]
  Aggregate groupBy=[] funcs=[FnSum(Value) AS Value] dropEmptyOnNoGroup
    Project ["" AS MetricName, Attributes AS Attributes, FnNow64(9) AS TimeUnix, (FnToFloat64(FnGreatest(FnToUnixMillis(ts_of_exp_hist_sample_ts), 0)) / 1000) AS Value]
      Aggregate groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnMax(TimeUnix) AS ts_of_exp_hist_sample_ts] having=FnNot((FnBitAnd(FnArgMax(Flags, TimeUnix), 1) != 0)) dropEmptyOnNoGroup
        Filter predicate=((((MetricName IN ("request_latency_exp_hist", "request.latency.exp.hist", "request.latency.exp/hist", "request.latency.exp_hist", "request.latency/exp/hist", "request.latency/exp_hist", "request.latency_exp.hist", "request.latency_exp_hist", "request/latency/exp/hist", "request/latency/exp_hist", "request/latency_exp_hist", "request_latency.exp.hist", "request_latency.exp_hist", "request_latency_exp.hist")) AND (TimeUnix <= FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9))) AND (TimeUnix > (FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9) - FnToIntervalNanosecond(300000000000)))) AND FnNot((FnBitAnd(Flags, 1) != 0)))
          Scan(otel_metrics_exponential_histogram)
-- sql --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Value` FROM (SELECT sum(`Value`) AS `Value`, count() AS `_cerb_n` FROM (SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, (toFloat64(greatest(toUnixTimestamp64Milli(`ts_of_exp_hist_sample_ts`), ?)) / toFloat64(?)) AS `Value` FROM (SELECT mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, max(`TimeUnix`) AS `ts_of_exp_hist_sample_ts` FROM (SELECT * FROM `otel_metrics_exponential_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)) WHERE (`TimeUnix` <= parseDateTime64BestEffort(?, ?)) AND (`TimeUnix` > (parseDateTime64BestEffort(?, ?) - toIntervalNanosecond(?))) AND not((bitAnd(`Flags`, ?) != ?))) GROUP BY `Attributes` HAVING not((bitAnd(argMax(`Flags`, `TimeUnix`), ?) != ?))))) WHERE `_cerb_n` > 0)
