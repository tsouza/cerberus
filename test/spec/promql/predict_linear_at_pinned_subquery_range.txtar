# Reference Prometheus wraps only an `@`-pinned subquery's inner expression in
# a StepInvariantExpr, never the subquery itself, so predict_linear still finds
# the subquery among its arguments. It fits the five points of the pinned
# window and forecasts from the evaluation instant, at every evaluation
# instant.

-- query.promql --
predict_linear(vector(time())[5m:1m] @ 1767225600, 60)
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('machine_load', map('job', 'api'), toDateTime64('2025-12-31 23:59:00', 9), 1.0);
-- expected_rows --
[
  [{}, "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z", 1767225660],
  [{}, "2026-01-01T00:01:00Z", "2026-01-01T00:01:00Z", 1767225720],
  [{}, "2026-01-01T00:02:00Z", "2026-01-01T00:02:00Z", 1767225780],
  [{}, "2026-01-01T00:03:00Z", "2026-01-01T00:03:00Z", 1767225840],
  [{}, "2026-01-01T00:04:00Z", "2026-01-01T00:04:00Z", 1767225900],
  [{}, "2026-01-01T00:05:00Z", "2026-01-01T00:05:00Z", 1767225960]
]
-- args --
[0] string = "nanosecond"
[1] string = "2026-01-01 00:00:00.000000000Z"
[2] int64 = 9
[3] float64 = 1e+09
[4] float64 = 60
[5] string = ""
[6] string = "Map(String,String)"
[7] float64 = 1000
-- args_optimized --
[0] string = "nanosecond"
[1] string = "2026-01-01 00:00:00.000000000Z"
[2] int64 = 9
[3] float64 = 1e+09
[4] float64 = 60
[5] string = ""
[6] string = "Map(String,String)"
[7] float64 = 1000
-- chplan --
Project [Attributes AS Attributes, anchor_ts AS anchor_ts, anchor_ts AS TimeUnix, (Value + (predict_slope * (FnToFloat64(FnDateDiff("nanosecond", FnParseDateTime64BestEffort("2026-01-01 00:00:00.000000000Z", 9), anchor_ts)) / 1e+09))) AS Value]
  CrossJoin
    StepGrid start=2026-01-01T00:00:00.000000000Z end=2026-01-01T00:05:00.000000000Z step=1m0s
    RangeWindow func=predict_linear range=5m0s step=0s ts=anchor_ts value=Value predictSlope=predict_slope groupBy=[Attributes] scalars=[60] start=0001-01-01T00:00:00Z end=2026-01-01T00:00:00Z distinctSampleRows
      Project [Attributes AS Attributes, anchor_ts AS anchor_ts, TimeUnix AS TimeUnix, Value AS Value]
        Project [Attributes AS Attributes, TimeUnix AS anchor_ts, TimeUnix AS TimeUnix, Value AS Value] subqueryGrid
          Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, anchor_ts AS TimeUnix, (FnToFloat64(FnToUnixMillis(anchor_ts)) / 1000) AS Value]
            StepGrid start=2025-12-31T23:56:00.000000000Z end=2026-01-01T00:00:00.000000000Z step=1m0s
-- settings --
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;rw;sg;join
max_bytes_before_external_group_by=536870912
max_bytes_before_external_join=536870912
max_bytes_before_external_sort=536870912
-- sql --
SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `anchor_ts` AS `TimeUnix`, (`Value` + (`predict_slope` * (toFloat64(dateDiff(?, parseDateTime64BestEffort(?, ?), `anchor_ts`)) / toFloat64(?)))) AS `Value` FROM (SELECT * FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) + toIntervalNanosecond(i * 60000000000), range(0, 6))) AS `anchor_ts`) AS L CROSS JOIN (SELECT `Attributes`, if(length(window_pairs) > 1, tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 2) + tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 1) * ?, nan) AS Value, tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 1) AS predict_slope FROM (SELECT `Attributes`, arrayFilter(p -> tupleElement(p, 1) > parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(300000000000) AND tupleElement(p, 1) <= parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9), series_array) AS window_pairs FROM (SELECT `Attributes`, arrayCompact(arraySort(groupArray((`anchor_ts`, `Value`)))) AS series_array FROM (SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, `anchor_ts` AS `TimeUnix`, (toFloat64(toUnixTimestamp64Milli(`anchor_ts`)) / toFloat64(?)) AS `Value` FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2025-12-31 23:56:00.000000000Z', 9) + toIntervalNanosecond(i * 60000000000), range(0, 5))) AS `anchor_ts`)))) WHERE `anchor_ts` > parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(300000000000) AND `anchor_ts` <= parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) GROUP BY `Attributes`)) WHERE length(`window_pairs`) >= 2) AS R)
-- sql_optimized --
SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `anchor_ts` AS `TimeUnix`, (`Value` + (`predict_slope` * (toFloat64(dateDiff(?, parseDateTime64BestEffort(?, ?), `anchor_ts`)) / toFloat64(?)))) AS `Value` FROM (SELECT * FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) + toIntervalNanosecond(i * 60000000000), range(0, 6))) AS `anchor_ts`) AS L CROSS JOIN (SELECT `Attributes`, if(length(window_pairs) > 1, tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 2) + tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 1) * ?, nan) AS Value, tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 1) AS predict_slope FROM (SELECT `Attributes`, arrayFilter(p -> tupleElement(p, 1) > parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(300000000000) AND tupleElement(p, 1) <= parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9), series_array) AS window_pairs FROM (SELECT `Attributes`, arrayCompact(arraySort(groupArray((`anchor_ts`, `Value`)))) AS series_array FROM (SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, `anchor_ts` AS `TimeUnix`, (toFloat64(toUnixTimestamp64Milli(`anchor_ts`)) / toFloat64(?)) AS `Value` FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2025-12-31 23:56:00.000000000Z', 9) + toIntervalNanosecond(i * 60000000000), range(0, 5))) AS `anchor_ts`)))) WHERE `anchor_ts` > parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(300000000000) AND `anchor_ts` <= parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) GROUP BY `Attributes`)) WHERE length(`window_pairs`) >= 2) AS R)
