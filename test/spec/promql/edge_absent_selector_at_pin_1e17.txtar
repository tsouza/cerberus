-- chplan --
Project ["" AS MetricName, FnMap("job", "a") AS Attributes, FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9) AS TimeUnix, 1 AS Value]
  Filter predicate=(_cerb_n = 0)
    Aggregate groupBy=[] funcs=[FnCount() AS _cerb_n]
      Filter predicate=(Value < -1)
        Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, 0 AS Value]
          OneRow
-- settings --
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;agg=0
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
-- sql --
SELECT ? AS `MetricName`, map(?, ?) AS `Attributes`, parseDateTime64BestEffort(?, ?) AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT * FROM (SELECT toFloat64(count()) AS `_cerb_n` FROM (SELECT * FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT 1)) WHERE (`Value` < toFloat64(?)))) WHERE (`_cerb_n` = ?))
