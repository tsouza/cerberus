`topk by(le)` is a series SELECTOR, not a per-group reducer, so it has no
per-`le` rung fold. The lowering evaluates it in the float domain instead —
the bucket arrays fan out into `le`-labelled samples, topk picks the top k
at each bound independently, and the ladder is reassembled per surviving
series.

The seed is built so the answer can only be right if the k-selection is
real: at every bound a DIFFERENT pair of the three series survives, so each
output series carries a partial, differently-shaped ladder.

Cumulative counts per series, at le = 1 / 2 / 4 / +Inf:

    a: 10  10  10  10
    b:  0  20  20  60
    c:  5   5  30  30

top-2 at each bound: (a, c) at 1, (b, a) at 2, (c, b) at 4, (b, c) at +Inf.

Reassembled ladders and the reference answers at phi = 0.5:

  - a keeps {1: 10, 2: 10}. Its highest rung is not the +Inf overflow, so
    Prometheus's bucketQuantile refuses to interpolate: NaN.
  - b keeps {2: 20, 4: 20, +Inf: 60}. Rank 30 lands in the overflow
    bucket, which answers with the highest finite bound: 4.
  - c keeps {1: 5, 4: 30, +Inf: 30}. Rank 15 lands between the rungs at 1
    and 4: 1 + (4 - 1) * (15 - 5) / (30 - 5) = 2.2.

-- query.promql --
histogram_quantile(0.5, topk by(le) (2, sum_over_time(http_server_request_duration_bucket[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
5m
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'a'), toDateTime64('2026-01-01 00:00:00', 9), [10, 0, 0, 0], [1.0, 2.0, 4.0]),
    ('http_server_request_duration', map('service', 'b'), toDateTime64('2026-01-01 00:00:00', 9), [0, 20, 0, 40], [1.0, 2.0, 4.0]),
    ('http_server_request_duration', map('service', 'c'), toDateTime64('2026-01-01 00:00:00', 9), [5, 0, 25, 0], [1.0, 2.0, 4.0]);
-- expected_rows --
[
  ["", {"service": "a"}, "2026-01-01T00:00:00Z", "NaN"],
  ["", {"service": "b"}, "2026-01-01T00:00:00Z", 4.0],
  ["", {"service": "c"}, "2026-01-01T00:00:00Z", 2.2]
]
-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.5 cumulative groupBy=[Attributes AS Attributes, TimeUnix AS TimeUnix]
    Project [gkey_0 AS Attributes, _hq_ts AS TimeUnix, FnArrayFilter(b -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_le_sorted, 1, -1)) AS ExplicitBounds, FnIf((FnArrayExists(b -> (FnIsInfinite(b) AND (b > 0)), _hq_le_sorted) AND (FnLength(FnArrayConcat(FnArrayFilter((c, b) -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_cum_sorted, 1, -1), FnArraySlice(_hq_le_sorted, 1, -1)), FnArraySlice(_hq_cum_sorted, -1))) >= 2)), FnArrayMap(i -> FnArrayMax(FnArraySlice(FnArrayConcat(FnArrayFilter((c, b) -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_cum_sorted, 1, -1), FnArraySlice(_hq_le_sorted, 1, -1)), FnArraySlice(_hq_cum_sorted, -1)), 1, i)), FnArrayEnumerate(FnArrayConcat(FnArrayFilter((c, b) -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_cum_sorted, 1, -1), FnArraySlice(_hq_le_sorted, 1, -1)), FnArraySlice(_hq_cum_sorted, -1)))), FnArraySlice(FnArrayConcat(FnArrayFilter((c, b) -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_cum_sorted, 1, -1), FnArraySlice(_hq_le_sorted, 1, -1)), FnArraySlice(_hq_cum_sorted, -1)), 1, 0)) AS BucketCounts]
      Project [gkey_0 AS gkey_0, _hq_ts AS _hq_ts, FnArraySort(_hq_le_list) AS _hq_le_sorted, FnArraySort((c, b) -> b, _hq_cum_list, _hq_le_list) AS _hq_cum_sorted]
        Aggregate groupBy=[mapWithout(Attributes, [le]) AS gkey_0, TimeUnix AS _hq_ts] funcs=[FnGroupArray(FnAssumeNotNull(FnToFloat64OrNull(Attributes["le"]))) AS _hq_le_list, FnGroupArray(Value) AS _hq_cum_list]
          Filter predicate=FnIsNotNull(FnToFloat64OrNull(Attributes["le"]))
            TopK k=2 sort=Value DESC by=[Attributes["le"], TimeUnix]
              RangeWindow func=sum_over_time range=5m0s step=5m0s outerRange=5m0s ts=TimeUnix value=Value groupBy=[Attributes] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
                Project ["http_server_request_duration_bucket" AS MetricName, FnMapMerge(Attributes, FnMap("le", FnIf((le_idx > FnLength(ExplicitBounds)), "+Inf", FnToString(ExplicitBounds[le_idx])))) AS Attributes, TimeUnix AS TimeUnix, FnToFloat64(FnArraySum(FnArraySlice(BucketCounts, 1, le_idx))) AS Value]
                  Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, ExplicitBounds AS ExplicitBounds, BucketCounts AS BucketCounts, FnArrayJoin(FnArrayEnumerate(BucketCounts)) AS le_idx]
                    Filter predicate=(MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration"))
                      Scan(otel_metrics_histogram)
