# `quantile by(le)` over classic buckets — the one PARAMETERISED aggregation
# that is a genuine per-group reducer, so it folds an `le` rung exactly as
# min / max / stddev do (#1590). Before the fold table learned it, the shape
# was rejected for carrying a Param and the plan degenerated to an empty
# result where Prometheus returns a row.
#
# Two series over identical bounds [1, 2, 3], each seeded with a zero
# baseline ahead of the real sample so the aggregated `rate` path's
# per-series window delta equals the real reading directly (`rate` needs
# two in-window samples to span a delta; the baseline supplies the second):
#   host=a  counts [2, 0, 0, 0]  cumulative per `le`: 2, 2, 2  (+Inf 2)
#   host=b  counts [0, 0, 4, 0]  cumulative per `le`: 0, 0, 4  (+Inf 4)
#
# Prometheus aggregates classic buckets in the cumulative domain, one float
# sample per `le`, so `quantile(0.5, ...)` interpolates between the two
# order statistics at each rung (promql/quantile.go: rank = phi*(n-1), here
# n=2 so rank=0.5, i.e. the midpoint):
#   le=1    quantile(0.5, [2, 0]) = 1
#   le=2    quantile(0.5, [2, 0]) = 1
#   le=3    quantile(0.5, [2, 4]) = 3
#   le=+Inf quantile(0.5, [2, 4]) = 3
#
# Ladder [1, 1, 3, 3] over bounds [1, 2, 3] — already monotonic, so the
# repair is a no-op here. histogram_quantile(0.5) then reads
# total = 3, rank = 0.5 * 3 = 1.5; the first rung >= 1.5 is le=3, whose
# bucket spans (2, 3] and holds 3 - 1 = 2 observations with 1.5 - 1 = 0.5
# of the rank falling inside it:
#   2 + (3 - 2) * (0.5 / 2) = 2.25
#
# A `sum by(le)` fold would give ladder [2, 2, 6, 6] and 2.1666…, and a
# `max by(le)` fold [2, 2, 4, 4] and 1 (histogram_quantile_max_by_le), so
# this value discriminates the quantile fold from its neighbours rather
# than merely proving the plan is non-empty.

-- query.promql --
histogram_quantile(0.5, quantile by(le) (0.5, rate(http_server_request_duration_bucket[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), [0, 0, 0, 0], [1.0, 2.0, 3.0]),
    ('http_server_request_duration', map('host', 'b'), toDateTime64('2025-12-31 23:59:00', 9), [0, 0, 0, 0], [1.0, 2.0, 3.0]),
    ('http_server_request_duration', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), [2, 0, 0, 0], [1.0, 2.0, 3.0]),
    ('http_server_request_duration', map('host', 'b'), toDateTime64('2026-01-01 00:00:00', 9), [0, 0, 4, 0], [1.0, 2.0, 3.0]);

