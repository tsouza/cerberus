raySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list)))) AS ExplicitBounds]
