# A CUMULATIVE counter must use the native timeSeriesRateToGrid arm even when
# the schema exposes AggregationTemporality. The seed mirrors the established
# native rate grid and executes the split's native arm through chDB.
-- query.promql --
sum by(temporality) (rate(cerberus_queries_total[5m]))
-- range_step --
30s
-- experimental_ts_grid_range --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64,
    AggregationTemporality Int32
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('cerberus_queries_total', map('temporality', 'cumulative'), toDateTime64('2026-01-01 00:00:00', 9), 0.0, 2),
    ('cerberus_queries_total', map('temporality', 'cumulative'), toDateTime64('2026-01-01 00:01:00', 9), 12.0, 2),
    ('cerberus_queries_total', map('temporality', 'cumulative'), toDateTime64('2026-01-01 00:02:00', 9), 24.0, 2),
    ('cerberus_queries_total', map('temporality', 'cumulative'), toDateTime64('2026-01-01 00:03:00', 9), 36.0, 2),
    ('cerberus_queries_total', map('temporality', 'cumulative'), toDateTime64('2026-01-01 00:04:00', 9), 48.0, 2),
    ('cerberus_queries_total', map('temporality', 'cumulative'), toDateTime64('2026-01-01 00:05:00', 9), 60.0, 2);
