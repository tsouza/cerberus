-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.5 cumulative groupBy=[anchor_ts AS anchor_ts, Attributes AS Attributes]
    Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(kpl -> FnArrayMap(kpr -> FnArrayMap(kpm -> FnArrayFill((kpv, kpk) -> kpk, kpl, FnArrayMap((kpa, kpb) -> ((kpa > 0) AND (kpa = kpb)), kpr, kpm)), FnArray(FnArrayMap((kpa, kpb) -> (kpa + kpb), kpr, FnArrayCumSumNonNegative(FnArrayMap(kpd -> (0 - kpd), FnArrayDifference(kpr))))))[1], FnArray(FnArrayMap((kpa, kpv) -> FnIf(FnIsNaN(kpv), 0, FnToInt64(kpa)), FnArraySort((kpk, kpp) -> kpp, FnArrayEnumerate(kpl), FnArraySort((kpi, kpv) -> FnTuple(kpv, (0 - kpi)), FnArrayEnumerate(kpl), kpl)), kpl)))[1], FnArray(FnTupleElement(_hq_merged, 2)))[1] AS BucketCounts, FnTupleElement(_hq_merged, 1) AS ExplicitBounds]
      Project [anchor_ts AS anchor_ts, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnArrayMap(kme -> FnArrayMap(kmeb -> FnArrayMap(kmev -> FnArrayMap(kmb -> FnArrayMap(kms -> FnArrayMap(kmu -> FnTuple(kmu, FnArrayConcat(FnArrayMap(kmr -> FnArraySum(kmr), FnArraySplit((kmx, kmf) -> kmf, FnArraySort((kmx, kmk, kmi) -> FnTuple(kmk, kmi), kmev, kmeb, FnArrayEnumerate(kmeb)), kms)), FnArray(FnArraySum(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list))))), FnArray(FnArrayFilter((kmx, kmf) -> kmf, kmb, kms)))[1], FnArray(FnArrayMap((kmd, kmi) -> ((kmi = 1) OR (kmd != 0)), FnArrayDifference(kmb), FnArrayEnumerate(kmb))))[1], FnArray(FnArraySort((kmx, kmk, kmi) -> FnTuple(kmk, kmi), kmeb, kmeb, FnArrayEnumerate(kmeb))))[1], FnArray(FnArrayFlatten(FnArrayMap(kmx -> FnTupleElement(kmx, 2), kme))))[1], FnArray(FnArrayFlatten(FnArrayMap(kmx -> FnTupleElement(kmx, 1), kme))))[1], FnArray(FnArrayMap((bs, cs) -> FnArrayMap(kreb -> FnArrayMap(krev -> FnArrayMap(krb -> FnArrayMap(krs -> FnArrayMap(kru -> FnTuple(kru, FnArrayCumSum(FnArrayMap(krr -> FnArraySum(krr), FnArraySplit((krx, krf) -> krf, FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), krev, kreb, FnArrayEnumerate(kreb)), krs)))), FnArray(FnArrayFilter((krx, krf) -> krf, krb, krs)))[1], FnArray(FnArrayMap((krd, kri) -> ((kri = 1) OR (krd != 0)), FnArrayDifference(krb), FnArrayEnumerate(krb))))[1], FnArray(FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), kreb, kreb, FnArrayEnumerate(kreb))))[1], FnArray(FnArrayFilter((krrc, krrb) -> FnNot((FnIsNaN(krrb) OR FnIsInfinite(krrb))), FnArrayMap(krrc -> FnToFloat64(krrc), FnArraySlice(cs, 1, FnLength(bs))), bs)))[1], FnArray(FnArrayFilter(krx -> FnNot((FnIsNaN(krx) OR FnIsInfinite(krx))), bs)))[1], _hq_bounds_list, _hq_counts_list)))[1] AS _hq_merged]
        Aggregate groupBy=[anchor_ts AS anchor_ts] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list] dropEmptyOnNoGroup
          Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayConcat(FnArraySlice(FnTupleElement(_hq_window_ladder, 2), 1, 1), FnArrayPopFront(FnArrayDifference(FnTupleElement(_hq_window_ladder, 2)))) AS BucketCounts, FnTupleElement(_hq_window_ladder, 1) AS ExplicitBounds]
            Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(kwe -> FnArrayMap(kweb -> FnArrayMap(kwev -> FnArrayMap(kwet -> FnArrayMap(kwb -> FnArrayMap(kws -> FnArrayMap(kwu -> FnTuple(kwu, FnArrayConcat(FnArrayMap((kwr, kwo) -> FnArrayAvg(kwr), FnArraySplit((kwx, kwf) -> kwf, FnArraySort((kwx, kwk, kwi) -> FnTuple(kwk, kwi), kwev, kweb, FnArrayEnumerate(kweb)), kws), FnArraySplit((kwx, kwf) -> kwf, FnArraySort((kwx, kwk, kwi) -> FnTuple(kwk, kwi), kwet, kweb, FnArrayEnumerate(kweb)), kws)), FnArray(FnArrayAvg(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list))))), FnArray(FnArrayFilter((kwx, kwf) -> kwf, kwb, kws)))[1], FnArray(FnArrayMap((kwd, kwi) -> ((kwi = 1) OR (kwd != 0)), FnArrayDifference(kwb), FnArrayEnumerate(kwb))))[1], FnArray(FnArraySort((kwx, kwk, kwi) -> FnTuple(kwk, kwi), kweb, kweb, FnArrayEnumerate(kweb))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 3), kwe))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 2), kwe))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 1), kwe))))[1], FnArray(FnArrayMap((bs, cs, kwrt) -> FnArrayMap(kreb -> FnArrayMap(krev -> FnArrayMap(krb -> FnArrayMap(krs -> FnArrayMap(kru -> FnTuple(kru, FnArrayCumSum(FnArrayMap(krr -> FnArraySum(krr), FnArraySplit((krx, krf) -> krf, FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), krev, kreb, FnArrayEnumerate(kreb)), krs))), FnArrayWithConstant(FnLength(kru), kwrt)), FnArray(FnArrayFilter((krx, krf) -> krf, krb, krs)))[1], FnArray(FnArrayMap((krd, kri) -> ((kri = 1) OR (krd != 0)), FnArrayDifference(krb), FnArrayEnumerate(krb))))[1], FnArray(FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), kreb, kreb, FnArrayEnumerate(kreb))))[1], FnArray(FnArrayFilter((krrc, krrb) -> FnNot((FnIsNaN(krrb) OR FnIsInfinite(krrb))), FnArrayMap(krrc -> FnToFloat64(krrc), FnArraySlice(cs, 1, FnLength(bs))), bs)))[1], FnArray(FnArrayFilter(krx -> FnNot((FnIsNaN(krx) OR FnIsInfinite(krx))), bs)))[1], _hq_bounds_list, _hq_counts_list, _hq_ts_list)))[1] AS _hq_window_ladder]
              RangeBucketFanout step=1m0s lookback=5m0s groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list, FnGroupArray(TimeUnix) AS _hq_ts_list] peakIndependentOfGrid start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
                Project [TimeUnix AS TimeUnix, ResourceAttributes AS ResourceAttributes, FnMapSort(Attributes) AS Attributes, ServiceName AS ServiceName, ExplicitBounds AS ExplicitBounds, BucketCounts AS BucketCounts]
                  Filter predicate=((MetricName IN ("request_latency", "request.latency", "request/latency")) AND FnNot((FnBitAnd(Flags, 1) != 0)))
                    Scan(otel_metrics_histogram)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;agg=1;rbf
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, `anchor_ts` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `_cerb_histogram_output`.1 AS `anchor_ts`, `_cerb_histogram_output`.2 AS `Attributes`, `_cerb_histogram_output`.3 AS `Value` FROM (SELECT arrayJoin([(`anchor_ts`, `Attributes`, `Value`)]) AS `_cerb_histogram_output` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, if(0.5 < 0, -inf, if(0.5 > 1, inf, if(`_cerb_hqc_idx` = length(`_cerb_hqc_cum`) AND length(`_cerb_hqc_buckets`) != length(`ExplicitBounds`), if(length(`ExplicitBounds`) = 0, nan, `_cerb_hqc_bounds`[length(`_cerb_hqc_bounds`)]), if(`_cerb_hqc_idx` = 1 AND `_cerb_hqc_bounds`[1] <= 0, `_cerb_hqc_bounds`[1], (if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1]) + (`_cerb_hqc_bounds`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1])) * (((0.5 * `_cerb_hqc_observations`) - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])) / (`_cerb_hqc_cum`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])))))))) * if(`_cerb_hqc_observations` = 0, nan, 1) AS `Value` FROM (SELECT *, arrayFirstIndex(c -> c >= (0.5 * `_cerb_hqc_observations`), `_cerb_hqc_cum`) AS `_cerb_hqc_idx` FROM (SELECT *, `_cerb_hqc_cum`[length(`_cerb_hqc_cum`)] AS `_cerb_hqc_observations` FROM (SELECT *, arrayFilter((b, k) -> k, `ExplicitBounds`, `_cerb_hqc_kept_mask`) AS `_cerb_hqc_bounds`, arrayFilter((c, k) -> k, arrayResize(`_cerb_hqc_buckets`, greatest(length(`_cerb_hqc_buckets`), length(`ExplicitBounds`))), arrayConcat(`_cerb_hqc_kept_mask`, arrayWithConstant(greatest(length(`_cerb_hqc_buckets`) - length(`ExplicitBounds`), 0), 1))) AS `_cerb_hqc_cum` FROM (SELECT *, arrayMap((b, p) -> b != p, `ExplicitBounds`, arraySlice(arrayPushFront(`ExplicitBounds`, nan), 1, length(`ExplicitBounds`))) AS `_cerb_hqc_kept_mask`, arrayMap(x -> toFloat64(x), `BucketCounts`) AS `_cerb_hqc_buckets` FROM (SELECT `_cerb_histogram_