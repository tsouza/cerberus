-- sql --
SELECT `Attributes`, `anchor_ts`, (anchor_ts + toIntervalNanosecond(3600000000000)) AS `TimeUnix`, max(`Value`) AS `Value` FROM (SELECT `Attributes`, `_src_ts`, `Value`, arrayJoin(arrayMap(i -> (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(3600000000000)) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `_src_ts`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(3600000000000))) - 180000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(3600000000000))) - 180000000000, toInt64(60000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `_src_ts`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(3600000000000))), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(3600000000000))), toInt64(60000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT *, `anchor_ts` AS _src_ts FROM (SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes`, `anchor_ts`, anchor_ts AS `TimeUnix`, max(`Value`) AS `Value` FROM (SELECT `Attributes`, `_src_ts`, `Value`, arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2025-12-31 23:05:00.000000000Z', 9) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `_src_ts`, parseDateTime64BestEffort('2025-12-31 23:05:00.000000000Z', 9)) - 300000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, parseDateTime64BestEffort('2025-12-31 23:05:00.000000000Z', 9)) - 300000000000, toInt64(60000000000)) < 0) + 1), least(8, intDiv(dateDiff('nanosecond', `_src_ts`, parseDateTime64BestEffort('2025-12-31 23:05:00.000000000Z', 9)), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, parseDateTime64BestEffort('2025-12-31 23:05:00.000000000Z', 9)), toInt64(60000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT *, `anchor_ts` AS _src_ts FROM (SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT ? AS `MetricName`, `Attributes`, `TimeUnix`, toFloat64((toUnixTimestamp64Nano(`TimeUnix`) / toFloat64(?))) AS `Value` FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, `anchor_ts` AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2025-12-31 22:54:00.000000000Z', 9) + toIntervalNanosecond(i * 60000000000), range(0, 12))) AS `anchor_ts`)))))) WHERE `_src_ts` > parseDateTime64BestEffort('2025-12-31 22:58:00.000000000Z', 9) - toIntervalNanosecond(300000000000) AND `_src_ts` <= parseDateTime64BestEffort('2025-12-31 23:05:00.000000000Z', 9)) GROUP BY `Attributes`, `anchor_ts`)))) WHERE `_src_ts` > (parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(3600000000000)) - toIntervalNanosecond(180000000000) AND `_src_ts` <= (parseDateTime64BestEffort('2026-01-01 00:05:00.000000000Z', 9) - toIntervalNanosecond(3600000000000))) GROUP BY `Attributes`, `anchor_ts`
