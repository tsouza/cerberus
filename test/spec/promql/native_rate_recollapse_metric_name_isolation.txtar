    ('cerberus_queries_total', map('cerberus.ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:02:00', 9), 8.0),
    ('cerberus_queries_total', map('cerberus.ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:03:00', 9), 12.0),
    ('cerberus_queries_total', map('cerberus.ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:04:00', 9), 16.0),
    ('cerberus_queries_total', map('cerberus.ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:05:00', 9), 20.0),
    ('cerberus_errors_total', map('cerberus_ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:00:00', 9), 0.0),
    ('cerberus_errors_total', map('cerberus_ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:02:00', 9), 100.0),
    ('cerberus_errors_total', map('cerberus_ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:04:00', 9), 200.0);
