# Deferred label shaping (ts_grid_recollapse) must not pool across
# metric names.
#
# The table carries TWO metric names whose attribute maps collapse onto
# the SAME shaped label set:
#
#   cerberus_queries_total  Attributes = map('cerberus.ql', 'promql')
#   cerberus_errors_total   Attributes = map('cerberus_ql', 'promql')
#
# The query selects only `cerberus_queries_total`, so the decoy metric
# must contribute nothing. Its samples are an order of magnitude larger
# than the selected metric's, so ANY leak — a metric-name predicate the
# rewrite failed to keep beneath the state level, a raw grouping that
# merged the two series before the name filter applied — moves every
# value by ~25x rather than by a last bit. The row set below is the same
# `rate(t) = t / 4500` grid the collision fixture pins, which is what
# makes the two comparable by eye.
#
# On the three-level shape the node's GROUP BY holds
# (Attributes, ResourceAttributes, ServiceName) — the raw columns the
# shaping tower reads — and MetricName is neither a grouping key nor a
# series-identity column, because PromQL rate() drops `__name__` and the
# outer Project synthesises the empty name back. Metric selection is
# therefore carried entirely by the scan-level predicate, which is
# exactly what this fixture holds still. The emitter's pass-through arm,
# which carries a GroupBy key no shaping expression reads all the way to
# the outer SELECT, has no PromQL shape that reaches it and is pinned in
# internal/chsql/range_window_native_test.go instead.

-- query.promql --
rate(cerberus_queries_total[5m])
-- range_step --
30s
-- experimental_ts_grid_range --
-- experimental_ts_grid_recollapse --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    ResourceAttributes Map(String, String),
    ServiceName LowCardinality(String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
