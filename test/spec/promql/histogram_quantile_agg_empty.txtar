e(cs, 1, FnLength(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)))[1], FnArraySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list))))), FnArray(FnArrayMap(wv -> FnArrayMap(wo -> (FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wv) - wsr[1]), FnArraySum(FnArrayMap((p, c) -> FnIf((c < p), c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr)))), FnArray(FnArraySort((c, t) -> t, wv, wo)))[1] * (FnArrayMap(wcv -> FnArrayMap(wso -> FnArrayMap(wsi -> FnArrayMap(wag -> FnArrayMap(wtc -> FnArrayMap(wrc -> FnIf((wsi > 0), (((wsi + FnIf((FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc) < wtc), FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc), wtc)) + FnIf(((FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], FnToDateTime64("2026-01-01 00:00:01.000000000", 9))) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], FnToDateTime64("2026-01-01 00:00:01.000000000", 9))) / 1e+09))) / wsi), 1), FnArray(FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wcv) - wsr[1]), FnArraySum(FnArrayMap((p, c) -> FnIf((c < p), c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr)))), FnArray(FnArraySort((c, t) -> t, wcv, wo)))[1]))[1], FnArray(FnIf(((FnToFloat64(FnDateDiff("nanosecond", (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09))))[1], FnArray((wsi / (FnLength(wo) - 1))))[1], FnArray((FnToFloat64(FnDateDiff("nanosecond", wso[1], wso[FnLength(wso)])) / 1e+09)))[1], FnArray(FnArraySort(wo)))[1], FnArray(wv))[1] / 300)), FnArray(_hq_ts_list))[1], FnArray(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list)))[1])) AS _hq_window_ladder, FnArraySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list)))) AS ExplicitBounds]
              Filter predicate=(_hq_samples >= 2)
                Aggregate groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list, FnGroupArray(TimeUnix) AS _hq_ts_list, FnAny(AggregationTemporality) AS _hq_temporality, FnUniqExact(TimeUnix) AS _hq_samples]
                  Filter predicate=(((MetricName IN ("missing_metric", "missing.metric", "missing/metric")) AND (TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9))) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
                    Scan(otel_metrics_histogram)
-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, if(length(`BucketCounts`) = 0, nan, if(`_cerb_hqc_observations` = 0, nan, if(0.95 < 0, -inf, if(0.95 > 1, inf, if(`_cerb_hqc_idx` = length(`_cerb_hqc_cum`) AND length(`_cerb_hqc_buckets`) != length(`ExplicitBounds`), `_cerb_hqc_bounds`[length(`_cerb_hqc_bounds`)], if(`_cerb_hqc_idx` = 1 AND `_cerb_hqc_bounds`[1] <= 0, `_cerb_hqc_bounds`[1], (if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1]) + (`_cerb_hqc_bounds`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1])) * (((0.95 * `_cerb_hqc_observations`) - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])) / (`_cerb_hqc_cum`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])))))))))) AS `Value` FROM (SELECT *, arrayFirstIndex(c -> c >= (0.95 * `_cerb_hqc_observations`), `_cerb_hqc_cum`) AS `_cerb_hqc_idx` FROM (SELECT *, `_cerb_hqc_cum`[length(`_cerb_hqc_cum`)] AS `_cerb_hqc_observations` FROM (SELECT *, arrayMap(i -> `ExplicitBounds`[i], `_cerb_hqc_kept_idx`) AS `_cerb_hqc_bounds`, arrayMap(i -> `_cerb_hqc_buckets`[i], arrayConcat(`_cerb_hqc_kept_idx`, range(length(`ExplicitBounds`) + 1, length(`_cerb_hqc_buckets`) + 1))) AS `_cerb_hqc_cum` FROM (SELECT *, arrayFilter(i -> i = 1 OR `ExplicitBounds`[i] != `ExplicitBounds`[i - 1], range(1, length(`ExplicitBounds`) + 1)) AS `_cerb_hqc_kept_idx`, arrayMap(x -> toFloat64(x), `BucketCounts`) AS `_cerb_hqc_buckets` FROM (SELECT `Attributes` AS `Attributes`, arrayMap(i -> arrayMax(arraySlice(`_hq_ladder`, ?, i)), arrayEnumerate(`_hq_ladder`)) AS `BucketCounts`, `ExplicitBounds` AS `ExplicitBounds` FROM (SELECT CAST(map(), ?) AS `Attributes`, arrayConcat(arrayMap(u -> arraySum(arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((not((isNaN(b) OR isInfinite(b))) AND (b <= u)), toFloat64(c), toFloat64(?)), bs, arraySlice(cs, ?, length(bs)))), `_hq_bounds_list`, `_hq_counts_list`), `_hq_bounds_list`)), arraySort(arrayDistinct(arrayFlatten(arrayMap(bs -> arrayFilter(fb -> not((isNaN(fb) OR isInfinite(fb))), bs), `_hq_bounds_list`))))), array(arraySum(arrayMap(cs -> toFloat64(arraySum(cs)), `_hq_counts_list`)))) AS `_hq_ladder`, arraySort(arrayDistinct(arrayFlatten(arrayMap(bs -> arrayFilter(fb -> not((isNaN(fb) OR isInfinite(fb))), bs), `_hq_bounds_list`)))) AS `ExplicitBounds` FROM (SELECT `_hq_bounds_list`, `_hq_counts_list` FROM (SELECT groupArray(`ExplicitBounds`) AS `_hq_bounds_list`, groupArray(`BucketCounts`) AS `_hq_counts_list`, count() AS `_cerb_n` FROM (SELECT `Attributes` AS `Attributes`, arrayMap(j -> if((j = ?), `_hq_window_ladder`[j], (`_hq_window_ladder`[j] - `_hq_window_ladder`[(j - ?)])), arrayEnumerate(`_hq_window_ladder`)) AS `BucketCounts`, `ExplicitBounds` AS `ExplicitBounds` FROM (SELECT `Attributes` AS `Attributes`, arrayConcat(arrayMap(u -> arrayMap(wv -> arrayMap(wo -> (arrayMap(wsr -> if((`_hq_temporality` = ?), (arraySum(wv) - wsr[?]), arraySum(arrayMap((p, c) -> if((c < p), c, (c - p)), arrayPopBack(wsr), arrayPopFront(wsr)))), array(arraySort((c, t) -> t, wv, wo)))[?] * (arrayMap(wcv -> arrayMap(wso -> arrayMap(wsi -> arrayMap(wag -> arrayMap(wtc -> arrayMap(wrc -> if((wsi > ?), (((wsi + if((if((wrc > ?), (wsi * (arraySort((c, t) -> t, wcv, wo)[?] / wrc)), wtc) < wtc), if((wrc > ?), (wsi * (arraySort((c, t) -> t, wcv, wo)[?] / wrc)), wtc), wtc)) + if(((toFloat64(dateDiff(?, wso[length(wso)], toDateTime64(?, ?))) / toFloat64(?)) >= (toFloat64(?) * wag)), (wag / toFloat64(?)), (toFloat64(dateDiff(?, wso[length(wso)], toDateTime64(?, ?))) / toFloat64(?)))) / wsi), toFloat64(?)), array(arrayMap(wsr -> if((`_hq_temporality` = ?), (arraySum(wcv) - wsr[?]), arraySum(arrayMap((p, c) -> if((c < p), c, (c - p)), arrayPopBack(wsr), arrayPopFront(wsr)))), array(arraySort((c, t) -> t, wcv, wo)))[?]))[?], array(if(((toFloat64(dateDiff(?, (toDateTime64(?, ?) - toIntervalNanosecond(?)), wso[?])) / toFloat64(?)) >= (toFloat64(?) * wag)), (wag / toFloat64(?)), (toFloat64(dateDiff(?, (toDateTime64(?, ?) - toIntervalNanosecond(?)), wso[?])) / toFloat64(?)))))[?], array((wsi / (length(wo) - ?))))[?], array((toFloat64(dateDiff(?, wso[?], wso[length(wso)])) / toFloat64(?))))[?], array(arraySort(wo)))[?], array(wv))[?] / toFloat64(?))), array(arrayFilter((t, pbs) -> has(pbs, u), `_hq_ts_list`, `_hq_bounds_list`)))[?], array(arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((not((isNaN(b) OR isInfinite(b))) AND (b <= u)), toFloat64(c), toFloat64(?)), bs, arraySlice(cs, ?, length(bs)))), `_hq_bounds_list`, `_hq_counts_list`), `_hq_bounds_list`)))[?], arraySort(arrayDistinct(arrayFlatten(arrayMap(bs -> arrayFilter(fb -> not((isNaN(fb) OR isInfinite(fb))), bs), `_hq_bounds_list`))))), array(arrayMap(wv -> arrayMap(wo -> (arrayMap(wsr -> if((`_hq_temporality` = ?), (arraySum(wv) - wsr[?]), arraySum(arrayMap((p, c) -> if((c < p), c, (c - p)), arrayPopBack(wsr), arrayPopFront(wsr)))), array(arraySort((c, t) -> t, wv, wo)))[?] * (arrayMap(wcv -> arrayMap(wso -> arrayMap(wsi -> arrayMap(wag -> arrayMap(wtc -> arrayMap(wrc -> if((wsi > ?), (((wsi + if((if((wrc > ?), (wsi * (arraySort((c, t) -> t, wcv, wo)[?] / wrc)), wtc) < wtc), if((wrc > ?), (wsi * (arraySort((c, t) -> t, wcv, wo)[?] / wrc)), wtc), wtc)) + if(((toFloat64(dateDiff(?, wso[length(wso)], toDateTime64(?, ?))) / toFloat64(?)) >= (toFloat64(?) * wag)), (wag / toFloat64(?)), (toFloat64(dateDiff(?, wso[length(wso)], toDateTime64(?, ?))) / toFloat64(?)))) / wsi), toFloat64(?)), array(arrayMap(wsr -> if((`_hq_temporality` = ?), (arraySum(wcv) - wsr[?]), arraySum(arrayMap((p, c) -> if((c < p), c, (c - p)), arrayPopBack(wsr), arrayPopFront(wsr)))), array(arraySort((c, t) -> t, wcv, wo)))[?]))[?], array(if(((toFloat64(dateDiff(?, (toDateTime64(?, ?) - toIntervalNanosecond(?)), wso[?])) / toFloat64(?)) >= (toFloat64(?) * wag)), (wag / toFloat64(?)), (toFloat64(dateDiff(?, (toDateTime64(?, ?) - toIntervalNanosecond(?)), wso[?])) / toFloat64(?)))))[?], array((wsi / (length(wo) - ?))))[?], array((toFloat64(dateDiff(?, wso[?], wso[length(wso)])) / toFloat64(?))))[?], array(arraySort(wo)))[?], array(wv))[?] / toFloat64(?))), array(`_hq_ts_list`))[?], array(arrayMap(cs -> toFloat64(arraySum(cs)), `_hq_counts_list`)))[?])) AS `_hq_window_ladder`, arraySort(arrayDistinct(arrayFlatten(arrayMap(bs -> arrayFilter(fb -> not((isNaN(fb) OR isInfinite(fb))), bs), `_hq_bounds_list`)))) AS `ExplicitBounds` FROM (SELECT * FROM (SELECT mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, groupArray(`ExplicitBounds`) AS `_hq_bounds_list`, groupArray(`BucketCounts`) AS `_hq_counts_list`, groupArray(`TimeUnix`) AS `_hq_ts_list`, any(`AggregationTemporality`) AS `_hq_temporality`, uniqExact(`TimeUnix`) AS `_hq_samples` FROM (SELECT * FROM `otel_metrics_histogram` PREWHERE (`MetricName` IN (?, ?, ?)) WHERE (`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?)))) GROUP BY `Attributes`) WHERE (`_hq_samples` >= ?))))) WHERE `_cerb_n` > 0))))))))
