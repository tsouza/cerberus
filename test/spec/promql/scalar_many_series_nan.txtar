-- query.promql --
scalar(multi)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('multi', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('multi', map('host', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 2.0);
-- expected_rows --
