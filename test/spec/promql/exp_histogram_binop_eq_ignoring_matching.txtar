-- query.promql --
http_server_duration_exp_hist == ignoring(az) http_client_duration_exp_hist
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- `==` between two DIFFERENT exp-histogram metrics under
-- `ignoring(az)` custom vector matching (cerberus issue #2273, gap 1):
-- the match key drops `az` (everything but `az`), so a server/client
-- pair that disagree on `az` alone still gets compared for structural
-- equality via [applyVectorMatchToHistogramOperand]'s reduced-key
-- regroup ahead of the existing structural-equality filter
-- (histogram_native_binop_eq.go).
--
--   `us`: server (az=us-1) and client (az=us-2) share region=us and
--   publish BIT-IDENTICAL histogram payloads — `ignoring(az)` matches
--   them, `Equals` holds, the row survives with LHS's (server's) own
--   values and Attributes reduced to {region:"us"} (`az` dropped).
--
--   `eu`: server only, no client counterpart at region=eu — dropped
--   before `Equals` is ever evaluated, same as default matching.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('region', 'us', 'az', 'us-1'), toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 1, 0, [1, 2, 3], 0, []),
    ('http_client_duration_exp_hist', map('region', 'us', 'az', 'us-2'), toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 1, 0, [1, 2, 3], 0, []),
    ('http_server_duration_exp_hist', map('region', 'eu', 'az', 'eu-1'), toDateTime64('2026-01-01 00:00:00', 9), 4, 0.4,  0, 0, 0, [7],       0, []);
-- expected_rows --
[
  ["http_server_duration_exp_hist", {"region": "us"}, "2026-01-01T00:00:01Z", 0, 6, 42.5, 0, 0, 1, 0, [1,2,3], 0, []]
]
