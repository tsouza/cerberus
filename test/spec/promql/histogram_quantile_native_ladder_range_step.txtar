# The ClickHouse-native classic-histogram ladder for
# `histogram_quantile(phi, sum by(le)(rate(<bucket>[range])))` in range mode.
# The `experimental_ts_grid_histogram` section opts the fixture into
# LowerOpts{Lowerers.ClassicHistogram = NativeClassicHistogramWindowLowerer},
# so the per-series window stage lowers to a chplan.RangeBucketGridNative
# (rendered as the unnest + timeSeriesRateToGrid/timeSeriesResetsToGrid pair +
# ARRAY JOIN + regroup) instead of the RangeBucketFanout array-expression fold.
#
# The seed, the grid and the `expected_rows` are IDENTICAL to
# histogram_quantile_classic_range_step.txtar, which is enrolled in the
# Prometheus parity corpus (`oracle: prometheus`). That identity is the
# assertion: the native ladder answers, byte for byte, what reference
# Prometheus answers on this seed. Anything else shows up as a diff in this
# cell, not as a passing test. (Where the two paths' float evaluation orders
# DO part company they part by at most two ULP, inside the band the parity
# corpus already documents for this query class — see
# histogram_quantile_native_ladder_min_samples.txtar, the one fixture of the
# three where that happens.)
#
# The plan is a two-arm UnionAll: the native ladder over the CUMULATIVE (and
# temporality-unspecified) rows, and the unchanged RangeBucketFanout + array
# fold over the DELTA ones, which is the only path with delta semantics. This
# seed carries no DELTA rows, so its DELTA arm is empty; the arm is exercised
# with data by the chDB dual-emit parity gate
# (internal/chsql/histogram_quantile_classic_native_chdb_test.go).

-- query.promql --
histogram_quantile(0.95, sum by(le)(rate(http_server_request_duration_bucket[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_ts_grid_histogram --
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [0, 0, 0], [0.1, 0.5, 1.0]),
