Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.95 cumulative groupBy=[anchor_ts AS anchor_ts, Attributes AS Attributes]
    Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(i -> FnArrayMax(FnArraySlice(_hq_ladder, 1, i)), FnArrayEnumerate(_hq_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
      Project [anchor_ts AS anchor_ts, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnArrayConcat(FnArrayMap(u -> FnArraySum(FnArrayFilter((v, pbs) -> FnArrayHas(pbs, u), FnArrayMap((bs, cs) -> FnArraySum(FnArrayMap((b, c) -> FnIf((b <= u), FnToFloat64(c), 0), bs, FnArraySlice(cs, 1, FnLength(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)), FnArraySort(FnArrayDistinct(FnArrayFlatten(_hq_bounds_list)))), FnArray(FnArraySum(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list)))) AS _hq_ladder, FnArraySort(FnArrayDistinct(FnArrayFlatten(_hq_bounds_list))) AS ExplicitBounds]
        Aggregate groupBy=[anchor_ts AS anchor_ts] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list]
          UnionAll arms=2
            RangeBucketGridNative step=30s range=5m0s groupBy=[FnMapSort(FnMapMerge(FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] buckets=BucketCounts bounds=ExplicitBounds start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
              Filter predicate=((MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration")) AND (AggregationTemporality != 1))
                Scan(otel_metrics_histogram)
            Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(j -> FnIf((j = 1), _hq_window_ladder[j], (_hq_window_ladder[j] - _hq_window_ladder[(j - 1)])), FnArrayEnumerate(_hq_window_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
              Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayConcat(FnArrayMap(u -> FnArrayMap(wv -> FnArrayMap(wo -> (FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wv) - wsr[1]), FnArraySum(FnArrayMap((p, c) -> FnIf((c < p), c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr)))), FnArray(FnArraySort((c, t) -> t, wv, wo)))[1] * FnArrayMap(wcv -> FnArrayMap(wso -> FnArrayMap(wsi -> FnArrayMap(wag -> FnArrayMap(wtc -> FnArrayMap(wrc -> FnIf((wsi > 0), (((wsi + FnIf((FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc) < wtc), FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc), wtc)) + FnIf(((FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], anchor_ts)) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], anchor_ts)) / 1e+09))) / wsi), 1), FnArray(FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wcv) - wsr[1]), FnArraySum(FnArrayMap((p, c) -> FnIf((c < p), c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr)))), FnArray(FnArraySort((c, t) -> t, wcv, wo)))[1]))[1], FnArray(FnIf(((FnToFloat64(FnDateDiff("nanosecond", (anchor_ts - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", (anchor_ts - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09))))[1], FnArray((wsi / (FnLength(wo) - 1))))[1], FnArray((FnToFloat64(FnDateDiff("nanosecond", wso[1], wso[FnLength(wso)])) / 1e+09)))[1], FnArray(FnArraySort(wo)))[1], FnArray(wv))[1]), FnArray(FnArrayFilter((t, pbs) -> FnArrayHas(pbs, u), _hq_ts_list, _hq_bounds_list)))[1], FnArray(FnArrayFilter((v, pbs) -> FnArrayHas(pbs, u), FnArrayMap((bs, cs) -> FnArraySum(FnArrayMap((b, c) -> FnIf((b <= u), FnToFloat64(c), 0), bs, FnArraySlice(cs, 1, FnLength(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)))[1], FnArraySort(FnArrayDistinct(FnArrayFlatten(_hq_bounds_list)))), FnArray(FnArrayMap(wv -> FnArrayMap(wo -> (FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wv) - wsr[1]), FnArraySum(FnArrayMap((p, c) -> FnIf((c < p), c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr)))), FnArray(FnArraySort((c, t) -> t, wv, wo)))[1] * FnArrayMap(wcv -> FnArrayMap(wso -> FnArrayMap(wsi -> FnArrayMap(wag -> FnArrayMap(wtc -> FnArrayMap(wrc -> FnIf((wsi > 0), (((wsi + FnIf((FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc) < wtc), FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc), wtc)) + FnIf(((FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], anchor_ts)) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], anchor_ts)) / 1e+09))) / wsi), 1), FnArray(FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wcv) - wsr[1]), FnArraySum(FnArrayMap((p, c) -> FnIf((c < p), c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr)))), FnArray(FnArraySort((c, t) -> t, wcv, wo)))[1]))[1], FnArray(FnIf(((FnToFloat64(FnDateDiff("nanosecond", (anchor_ts - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", (anchor_ts - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09))))[1], FnArray((wsi / (FnLength(wo) - 1))))[1], FnArray((FnToFloat64(FnDateDiff("nanosecond", wso[1], wso[FnLength(wso)])) / 1e+09)))[1], FnArray(FnArraySort(wo)))[1], FnArray(wv))[1]), FnArray(_hq_ts_list))[1], FnArray(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list)))[1])) AS _hq_window_ladder, FnArraySort(FnArrayDistinct(FnArrayFlatten(_hq_bounds_list))) AS ExplicitBounds]
                RangeBucketFanout step=30s lookback=5m0s minSamples=2 groupBy=[FnMapSort(FnMapMerge(FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list, FnGroupArray(TimeUnix) AS _hq_ts_list, FnAny(AggregationTemporality) AS _hq_temporality] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
                  Filter predicate=((MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration")) AND (AggregationTemporality = 1))
                    Scan(otel_metrics_histogram)
-- sql --
