# Duplicate-labelset guard on a name-dropping range function (#1811).
#
# `rate` strips `__name__` (upstream's `dropName`), so a selector spanning
# SEVERAL metrics hands the reducer two series that differ only by name.
# Reference Prometheus refuses the query at that point —
# `Matrix.ContainsSameLabelset()` → "vector cannot contain metrics with the
# same labelset" (promql/engine.go:2295) — rather than folding them
# together. Cerberus used to answer with one silently merged series,
# because ClickHouse's `GROUP BY Attributes` is a merge by construction.
#
# The lowering therefore does two things, both visible below:
#   1. widens the window's grouping key with `MetricName`, which is what
#      makes the collision observable at all (and, on its own, fixes a
#      latent WRONG-VALUE bug — two metrics' interleaved samples were
#      being reduced as if they were one series); and
#   2. re-collapses the widened rows through an Aggregate whose HAVING
#      carries `throwIf(uniqExact(MetricName) > 1, …) = 0`, aborting any
#      group that held more than one name.
#
# HAVING rather than a SELECT column because ClickHouse's analyzer prunes
# unreferenced SELECT expressions, which would silently disarm the guard.
#
# This fixture carries no `-- seed --`: the query it pins is one that must
# FAIL, and the chDB round-trip runner has no shape for an expected error.
# The executable half lives at the wire, in
# internal/api/prom/handler_chdb_duplicate_labelset_test.go, which asserts
# HTTP 422 / errorType=execution / the upstream message text.
-- query.promql --
rate({__name__=~"cpu_temp|gpu_temp"}[5m])
-- args --
[0] string = ""
[1] int64 = 9
[2] int64 = 5000000000
[3] string = "service.name"
[4] string = "service_name"
[5] string = "service.name"
[6] string = "service_name"
[7] string = ""
[8] string = "service_name"
[9] string = "^(?:cpu_temp|gpu_temp)$"
[10] string = "[^a-zA-Z0-9_:]"
[11] string = "_"
[12] string = "^(?:cpu_temp|gpu_temp)$"
[13] string = "service.name"
[14] string = "service_name"
[15] string = "service.name"
[16] string = "service_name"
[17] string = ""
[18] string = "service_name"
[19] string = "^(?:cpu_temp|gpu_temp)$"
[20] string = "[^a-zA-Z0-9_:]"
[21] string = "_"
