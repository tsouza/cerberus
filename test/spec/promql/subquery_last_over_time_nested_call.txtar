# A `*parser.Call` INNER — the shape #1794 reported.
#
# The subquery's body is itself a range-function call rather than a bare
# selector, so the lowered spine is RangeWindow-over-RangeWindow. Both
# levels preserve `__name__` (`last_over_time`), so the name must survive
# BOTH windows: the outer reducer has no matcher context at all, and can
# only carry a name that the inner window already projects per row.
#
# Two metrics with an identical attribute set, so a dropped name would
# also collapse them into one series.
-- query.promql --
last_over_time(last_over_time({__name__=~"cpu_temp|gpu_temp"}[5m])[10m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 40.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 41.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 42.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 70.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 71.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 72.0);
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
