Unary minus over a label-sorted mixed union negates the histogram rows in place and the float row by value.

-- query.promql --
-sort_by_label(latency_exp_hist or temperature_celsius, "series")

-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full

-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    ResourceAttributes Map(String, String) DEFAULT map(),
    ServiceName LowCardinality(String) DEFAULT '',
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);

CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    ResourceAttributes Map(String, String) DEFAULT map(),
    ServiceName LowCardinality(String) DEFAULT '',
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);

-- The duplicate series distinguishes shadow-then-drop from drop-then-union.
-- The histogram-only series detects accidental reads of placeholder Value.
-- The selected sample precedes the evaluation instant by one second.
INSERT INTO otel_metrics_exponential_histogram
    (MetricName, Attributes, TimeUnix, Count, Sum, Scale, ZeroCount, PositiveOffset, PositiveBucketCounts, NegativeOffset, NegativeBucketCounts) VALUES
    ('latency_exp_hist', map('series', 'dup'), toDateTime64('2026-01-01 00:00:00', 9), 6, 9.0, 0, 0, 0, [6], 0, []),
    ('latency_exp_hist', map('series', 'hist_only'), toDateTime64('2026-01-01 00:00:00', 9), 4, 6.0, 0, 0, 0, [4], 0, []);

INSERT INTO otel_metrics_gauge
    (MetricName, Attributes, TimeUnix, Value) VALUES
    ('temperature_celsius', map('series', 'dup'), toDateTime64('2026-01-01 00:00:00', 9), 42.0),
    ('temperature_celsius', map('series', 'solo'), toDateTime64('2026-01-01 00:00:00', 9), 7.0);

-- expected_rows --
[
  ["", {"series": "dup"}, "2026-01-01T00:00:01Z", -0, -6, -9, 0, 0, -0, 0, [-6], 0, [], 1],
  ["", {"series": "hist_only"}, "2026-01-01T00:00:01Z", -0, -4, -6, 0, 0, -0, 0, [-4], 0, [], 1],
  ["", {"series": "solo"}, "2026-01-01T00:00:00Z", -7, -0, -0, 0, 0, -0, 0, [], 0, [], 0]
]
