# A BARE subquery — no range function wraps it, so nothing reduces the
# series and nothing may strip `__name__`. Reference Prometheus only drops
# the name in a reducing range function; `cpu_temp[10m:1m]` has no reducer
# at all, so every sample keeps the name of the series it came from (#1809).
#
# Cerberus lowers the bare form to an Identity RangeWindow, whose
# windowed-array emitter projects exactly the grouping keys — grouping on
# Attributes alone left `MetricName` out of the output relation, and the
# HTTP layer then classified the plan as a derived shape and stamped
# `'' AS MetricName` on it.
#
# The two seeded metrics share ONE attribute set, so the bug is doubly
# observable: the label is missing AND the two series merge into one. Two
# rows carrying two different names is only expressible if the name rode
# the window's grouping key all the way out.
-- query.promql --
{__name__=~"cpu_temp|gpu_temp"}[10m:1m]
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 41.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 42.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 71.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 72.0);
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- expected_rows --
[
  ["cpu_temp", {"host": "a"}, "2025-12-31T23:59:00Z", 41],
  ["cpu_temp", {"host": "a"}, "2026-01-01T00:00:00Z", 42],
  ["gpu_temp", {"host": "a"}, "2025-12-31T23:59:00Z", 71],
  ["gpu_temp", {"host": "a"}, "2026-01-01T00:00:00Z", 72]
]
