-- sql --
SELECT `Attributes`, tupleElement(outer_anchor, 1) AS `anchor_ts`, anchor_ts AS `TimeUnix`, tupleElement(outer_anchor, 2) AS `Value` FROM (SELECT `Attributes`, arrayJoin(arrayFilter(p -> tupleElement(p, 3) > 0, arrayMap(o -> arrayMap(q -> (o, arrayReduce('min', q), length(q)), [arrayMap(c -> tupleElement(c, 3), arrayFilter(c -> tupleElement(c, 2), arraySlice(anchor_grid, greatest(0, intDiv(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 30000000000) * 30000000000)) - 1, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 30000000000) * 30000000000)) - 1, toInt64(30000000000)) < 0) + 1) + 1, greatest(0, least(18, intDiv(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 30000000000) * 30000000000)) + 239999999999, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 30000000000) * 30000000000)) + 239999999999, toInt64(30000000000)) < 0) + 1) - greatest(0, intDiv(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 30000000000) * 30000000000)) - 1, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 30000000000) * 30000000000)) - 1, toInt64(30000000000)) < 0) + 1)))))])[1], arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(11))))) AS `outer_anchor` FROM (SELECT `Attributes`, arrayMap(a -> arrayMap(s -> (a, length(s) >= 2, if((toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) > 0, if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s))))) * (((toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) + if(if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s))))) > 0 AND if(temporality = 1, arraySum(arrayMap(p -> tupleElement(p, 2), arrayFilter(p -> tupleElement(p, 1) <= tupleElement(s[1], 1), samples))), tupleElement(s[1], 2)) >= 0, least(if((toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(120000000000), tupleElement(s[1], 1))) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(120000000000), tupleElement(s[1], 1))) / 1e9)), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) * if(temporality = 1, arraySum(arrayMap(p -> tupleElement(p, 2), arrayFilter(p -> tupleElement(p, 1) <= tupleElement(s[1], 1), samples))), tupleElement(s[1], 2)) / if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s)))))), if((toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(120000000000), tupleElement(s[1], 1))) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(120000000000), tupleElement(s[1], 1))) / 1e9))) + if((toFloat64(dateDiff('nanosecond', tupleElement(s[length(s)], 1), a)) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', tupleElement(s[length(s)], 1), a)) / 1e9))) / (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / 120), nan)), [arrayReverse(arrayCompact(p -> tupleElement(p, 1), arrayReverse(arrayFilter(p -> tupleElement(p, 1) > a - toIntervalNanosecond(120000000000) AND tupleElement(p, 1) <= a, samples))))])[1], arrayMap(i -> fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 30000000000) * 30000000000) - toIntervalNanosecond(i * 30000000000), range(18))) AS `anchor_grid` FROM (SELECT `Attributes`, arraySort(groupArray((`TimeUnix`, `Value`))) AS `samples`, any(`AggregationTemporality`) AS `temporality` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value`, `AggregationTemporality` AS `AggregationTemporality` FROM (SELECT * FROM `otel_metrics_sum` WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?)))) WHERE `TimeUnix` > toDateTime64('2025-12-31 23:56:00.000000000', 9) - toIntervalNanosecond(120000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9) GROUP BY `Attributes`)))
