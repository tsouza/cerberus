# `histogram_quantile(phi, sum by(le)(rate(<native hist>[5m])))` where the
# seeded series' ZERO BUCKET is a counter that was already non-zero when the
# window opened. This fixture exists to discriminate the zero bucket's
# reduction across TIME from a plain sum of its in-window readings.
#
# histogram_quantile_native_zero_band pins the zero band's SHAPE but cannot
# pin its fold: its first in-window sample carries ZeroCount = 0, and a fold
# that differences consecutive readings and a fold that sums them agree
# whenever the counter starts at zero. Its distribution is also zero-bucket
# only, so the quantile lands in the zero band and returns 0 for any
# ZeroCount at all.
#
# Here the zero bucket competes with a positive bucket, so its magnitude
# decides which bucket the quantile falls in:
#
#	ZeroCount 4 → 10, PositiveBucketCounts [0, 0] → [0, 10], Scale 0, offset 0
#
# The per-series increase is ZeroCount 6 and positive buckets [0, 10], total
# 16. For phi = 0.5 the cumulative array is [6, 6, 16] and the target 8 lands
# in the SECOND positive bucket, so the log-linear interpolation gives
# 2^(0 + 1 + (8-6)/(16-6)) = 2^1.2 ≈ 2.2974.
#
# Summing the zero bucket instead gives ZeroCount 14, cumulative
# [14, 14, 24] and a target of 12, which lands inside the zero band — the
# quantile collapses to 0. A bucket change, not a rounding wobble.
-- query.promql --
histogram_quantile(0.5, sum by(le)(rate(http_server_duration_exp_hist[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:58:00', 9), 0, 4, 0, [0, 0], 0, [], 4, 0),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 0, 10, 0, [0, 10], 0, [], 20, 0);
