# `or` in range mode (Step > 0), where the two arms cover DIFFERENT
# subsets of the step grid.
#
# PromQL evaluates a set operator once per evaluation timestamp: at each
# step the right arm contributes only the series the left arm did not
# produce AT THAT STEP. The arms cover overlapping but different anchor
# spans, because the 5m lookback window is half-open — a sample is in
# scope at anchor `t` when `t - 5m < sample <= t`:
#
#   left  (sparse, sample at 00:03) covers 00:03 00:04 00:05
#   right (dense,  sample at 00:00) covers 00:00 00:01 00:02 00:03 00:04
#
# The result therefore alternates arms mid-series: the right arm owns
# 00:00-00:02 and the left arm owns 00:03-00:05, six points in all.
#
# Matching on the label signature alone would let the left arm's
# presence ANYWHERE in the range suppress the right arm EVERYWHERE,
# collapsing the result to the left arm's three points. The match key is
# (signature, timestamp) in range mode precisely so this fixture keeps
# all six.
#
# Both metrics carry the same `job` label and the default set-op
# signature excludes the metric name, so the two arms share one match
# key while the surviving rows keep their own arm's metric name.

-- query.promql --
demo_sparse_bytes or demo_dense_bytes
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('demo_dense_bytes',  map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 100.0),
    ('demo_sparse_bytes', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 10.0);
-- expected_rows --
[
  ["demo_sparse_bytes", {"job": "api"}, "2026-01-01T00:03:00Z", 10],
  ["demo_sparse_bytes", {"job": "api"}, "2026-01-01T00:04:00Z", 10],
  ["demo_sparse_bytes", {"job": "api"}, "2026-01-01T00:05:00Z", 10],
  ["demo_dense_bytes", {"job": "api"}, "2026-01-01T00:00:00Z", 100],
  ["demo_dense_bytes", {"job": "api"}, "2026-01-01T00:01:00Z", 100],
  ["demo_dense_bytes", {"job": "api"}, "2026-01-01T00:02:00Z", 100]
]
