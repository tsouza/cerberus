-- chplan --
Filter predicate=(FnReinterpretAsUInt64(Value) != 9218868437227405314)
  Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
    Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnMax(TimeUnix) AS lwr_ts, FnArgMax(Value, TimeUnix) AS lwr_value]
      Filter predicate=((TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9)) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
        Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnTransform(k, FnArray("k8s.namespace.name", "service.version"), FnArray("k8s_namespace_name", "service_version"), k), FnMapKeys(FnMapFilter((k, v) -> ((k NOT IN ("service.name", "service_name")) AND (k IN ("k8s.namespace.name", "service.version"))), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> ((k NOT IN ("service.name", "service_name")) AND (k IN ("k8s.namespace.name", "service.version"))), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, FnIf((FnBitAnd(Flags, 1) != 0), FnReinterpretAsFloat64(9218868437227405314), Value) AS Value]
          Filter predicate=(MetricName IN ("requests_total", "requests.total", "requests/total"))
            Scan(otel_metrics_sum)
