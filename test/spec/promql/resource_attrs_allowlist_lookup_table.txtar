Layer 2a — query path, resource-attribute promotion with a configured
allowlist.

The allowlist closes the key set at plan time, so the key→Prom-name
rewrite is a constant lookup table rather than a regex substitution
evaluated per key per row. mapFilter has already narrowed the map to
exactly the tabulated keys, so the rewrite is exact and the table's
default arm is unreachable.

-- query.promql --
requests_total
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- resource_labels --
k8s.namespace.name
service.version
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    ResourceAttributes Map(String, String),
    ServiceName String,
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('requests.total', map('http.method', 'GET'), map('k8s.namespace.name', 'prod', 'service.version', '1.2.3', 'cloud.region', 'eu-west-1'), 'checkout', toDateTime64('2026-01-01 00:00:00', 9), 7.0);
-- expected_rows --
[
  ["requests.total", {"http_method": "GET", "k8s_namespace_name": "prod", "service_name": "checkout", "service_version": "1.2.3"}, "2026-01-01T00:00:00Z", 7]
]
-- sql --
SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `lwr_ts` AS `TimeUnix`, `lwr_value` AS `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, max(`TimeUnix`) AS `lwr_ts`, argMax(`Value`, `TimeUnix`) AS `lwr_value` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> transform(k, array(?, ?), array(?, ?), k), mapKeys(mapFilter((k, v) -> ((k NOT IN (?, ?)) AND (k IN (?, ?))), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> ((k NOT IN (?, ?)) AND (k IN (?, ?))), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM `otel_metrics_sum` WHERE (`MetricName` IN (?, ?, ?)))) WHERE ((`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?))))) GROUP BY `MetricName`, `Attributes`)
-- args --
[0] string = "k8s.namespace.name"
[1] string = "service.version"
[2] string = "k8s_namespace_name"
[3] string = "service_version"
[4] string = "service.name"
[5] string = "service_name"
[6] string = "k8s.namespace.name"
[7] string = "service.version"
[8] string = "service.name"
[9] string = "service_name"
[10] string = "k8s.namespace.name"
[11] string = "service.version"
[12] string = ""
[13] string = "service_name"
[14] string = "requests_total"
[15] string = "requests.total"
[16] string = "requests/total"
[17] string = "2026-01-01 00:00:01.000000000"
[18] int64 = 9
[19] string = "2026-01-01 00:00:01.000000000"
[20] int64 = 9
[21] int64 = 300000000000
-- chplan --
Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
  Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnMax(TimeUnix) AS lwr_ts, FnArgMax(Value, TimeUnix) AS lwr_value]
    Filter predicate=((TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9)) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
      Project [MetricName AS MetricName, mapSort(FnMapMerge(FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnTransform(k, FnArray("k8s.namespace.name", "service.version"), FnArray("k8s_namespace_name", "service_version"), k), FnMapKeys(FnMapFilter((k, v) -> ((k NOT IN ("service.name", "service_name")) AND (k IN ("k8s.namespace.name", "service.version"))), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> ((k NOT IN ("service.name", "service_name")) AND (k IN ("k8s.namespace.name", "service.version"))), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
        Filter predicate=(MetricName IN ("requests_total", "requests.total", "requests/total"))
          Scan(otel_metrics_sum)
