-- chplan --
Project ["" AS MetricName, Attributes, TimeUnix, FnToFloat64(((((100 * FnIntDiv(((4 * FnIntDiv((FnReinterpretAsUInt64(FnToInt64(FnIf(((Value >= -9.223372036854776e+18) AND (Value < 9.223372036854776e+18)), Value, -9.223372036854776e+18))) + FnToUInt64(9223372028741760000)), 86400)) + 3), 146097)) + FnIntDiv(((4 * FnIntDiv(FnModulo(((4 * FnIntDiv((FnReinterpretAsUInt64(FnToInt64(FnIf(((Value >= -9.223372036854776e+18) AND (Value < 9.223372036854776e+18)), Value, -9.223372036854776e+18))) + FnToUInt64(9223372028741760000)), 86400)) + 3), 146097), 4)) + 3), 1461)) + (FnIntDiv(FnModulo(((4 * FnIntDiv(FnModulo(((4 * FnIntDiv((FnReinterpretAsUInt64(FnToInt64(FnIf(((Value >= -9.223372036854776e+18) AND (Value < 9.223372036854776e+18)), Value, -9.223372036854776e+18))) + FnToUInt64(9223372028741760000)), 86400)) + 3), 146097), 4)) + 3), 1461), 4) >= 306)) - 292277022400)) AS Value]
  Aggregate groupBy=[Attributes AS Attributes] funcs=[FnAny(Value) AS Value, FnAny(TimeUnix) AS TimeUnix] having=(FnThrowIf((FnUniqExact(MetricName) > 1), "vector cannot contain metrics with the same labelset") = 0)
    Filter predicate=(FnReinterpretAsUInt64(Value) != 9218868437227405314)
      Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
        Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnMax(TimeUnix) AS lwr_ts, FnArgMax(Value, TimeUnix) AS lwr_value]
          Filter predicate=((TimeUnix <= FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9)) AND (TimeUnix > (FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9) - FnToIntervalNanosecond(300000000000))))
            Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, FnIf((FnBitAnd(Flags, 1) != 0), FnReinterpretAsFloat64(9218868437227405314), Value) AS Value]
              Filter predicate=(MetricName IN ("temperature_celsius", "temperature.celsius", "temperature/celsius"))
                Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- sql --
SELECT ? AS `MetricName`, `Attributes`, `TimeUnix`, toFloat64(((((? * intDiv(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?)) + intDiv(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?)) + (intDiv(modulo(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(toInt64(if(((`Value` >= toFloat64(?)) AND (`Value` < toFloat64(?))), `Value`, toFloat64(?)))) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?) >= ?)) - ?)) AS `Value` FROM (SELECT `Attributes` AS `Attributes`, any(`Value`) AS `Value`, any(`TimeUnix`) AS `TimeUnix` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `lwr_ts` AS `TimeUnix`, `lwr_value` AS `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, max(`TimeUnix`) AS `lwr_ts`, argMax(`Value`, `TimeUnix`) AS `lwr_value` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, if((bitAnd(`Flags`, ?) != ?), reinterpretAsFloat64(?), `Value`) AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?)))) WHERE ((`TimeUnix` <= parseDateTime64BestEffort(?, ?)) AND (`TimeUnix` > (parseDateTime64BestEffort(?, ?) - toIntervalNanosecond(?))))) GROUP BY `MetricName`, `Attributes`)) WHERE (reinterpretAsUInt64(`Value`) != ?)) GROUP BY `Attributes` HAVING (throwIf((uniqExact(`MetricName`) > ?), 'vector cannot contain metrics with the same labelset') = ?))
