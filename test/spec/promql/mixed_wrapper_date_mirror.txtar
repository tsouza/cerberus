BestEffort(?, ?) - toIntervalNanosecond(?))))) GROUP BY `MetricName`, `Attributes`)) WHERE (reinterpretAsUInt64(`Value`) != ?)) GROUP BY `Attributes` HAVING (throwIf((uniqExact(`MetricName`) > ?), 'vector cannot contain metrics with the same labelset') = ?))
