-- chplan --
Project ["" AS MetricName, _mvj_L_Attributes AS Attributes, _mvj_L_TimeUnix AS TimeUnix, (_mvj_L_Value * _mvj_R_Value) AS Value, FnIf((_mvj_R__setop_is_histogram = 1), (_mvj_R_HistogramCount * _mvj_L_Value), (_mvj_L_HistogramCount * _mvj_R_Value)) AS HistogramCount, FnIf((_mvj_R__setop_is_histogram = 1), (_mvj_R_HistogramSum * _mvj_L_Value), (_mvj_L_HistogramSum * _mvj_R_Value)) AS HistogramSum, FnIf((_mvj_R__setop_is_histogram = 1), (_mvj_R_HistogramZeroCount * _mvj_L_Value), (_mvj_L_HistogramZeroCount * _mvj_R_Value)) AS HistogramZeroCount, FnIf((_mvj_R__setop_is_histogram = 1), FnArrayMap(b -> (b * _mvj_L_Value), _mvj_R_HistogramPositiveBucketCounts), FnArrayMap(b -> (b * _mvj_R_Value), _mvj_L_HistogramPositiveBucketCounts)) AS HistogramPositiveBucketCounts, FnIf((_mvj_R__setop_is_histogram = 1), FnArrayMap(b -> (b * _mvj_L_Value), _mvj_R_HistogramNegativeBucketCounts), FnArrayMap(b -> (b * _mvj_R_Value), _mvj_L_HistogramNegativeBucketCounts)) AS HistogramNegativeBucketCounts, FnIf((_mvj_R__setop_is_histogram = 1), _mvj_R_HistogramScale, _mvj_L_HistogramScale) AS HistogramScale, FnIf((_mvj_R__setop_is_histogram = 1), _mvj_R_HistogramZeroThreshold, _mvj_L_HistogramZeroThreshold) AS HistogramZeroThreshold, FnIf((_mvj_R__setop_is_histogram = 1), _mvj_R_HistogramPositiveOffset, _mvj_L_HistogramPositiveOffset) AS HistogramPositiveOffset, FnIf((_mvj_R__setop_is_histogram = 1), _mvj_R_HistogramNegativeOffset, _mvj_L_HistogramNegativeOffset) AS HistogramNegativeOffset, FnIf(((_mvj_L__setop_is_histogram = 1) OR (_mvj_R__setop_is_histogram = 1)), 1, 0) AS _setop_is_histogram]
  Filter predicate=FnNot(((_mvj_L__setop_is_histogram = 1) AND (_mvj_R__setop_is_histogram = 1)))
    MixedVectorJoin match=default card=one-to-one
      Project [MetricName, Attributes, TimeUnix, Value, HistogramCount, HistogramSum, HistogramScale, HistogramZeroThreshold, HistogramZeroCount, HistogramPositiveOffset, HistogramPositiveBucketCounts, HistogramNegativeOffset, HistogramNegativeBucketCounts, _setop_is_histogram]
        OrderBy [FnArrayStringConcat(FnArrayMap(c -> FnIf(FnRegexMatch(c, "^[0-9]+$"), FnLeftPad(c, 20, "0"), c), FnRegexExtractAll(Attributes["series"], "[0-9]+|[^0-9]+"))) ASC]
          VectorSetOp op=or match=default mixed mixedHistogramOnLeft
            HistogramProjection project=[MetricName AS MetricName, Attributes AS Attributes, FnNow64(9) AS TimeUnix, 0 AS Value]
              Aggregate groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnArgMax(MetricName, TimeUnix) AS MetricName, FnArgMax(Count, TimeUnix) AS Count, FnArgMax(Sum, TimeUnix) AS Sum, FnArgMax(Scale, TimeUnix) AS Scale, FnArgMax(ZeroCount, TimeUnix) AS ZeroCount, FnArgMax(PositiveOffset, TimeUnix) AS PositiveOffset, FnArgMax(PositiveBucketCounts, TimeUnix) AS PositiveBucketCounts, FnArgMax(NegativeOffset, TimeUnix) AS NegativeOffset, FnArgMax(NegativeBucketCounts, TimeUnix) AS NegativeBucketCounts] dropEmptyOnNoGroup
                Filter predicate=(((MetricName IN ("latency_exp_hist", "latency.exp.hist", "latency.exp/hist", "latency.exp_hist", "latency/exp/hist", "latency/exp_hist", "latency_exp.hist")) AND (TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9))) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
                  Scan(otel_metrics_exponential_histogram)
            Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
              Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnMax(TimeUnix) AS lwr_ts, FnArgMax(Value, TimeUnix) AS lwr_value]
                Filter predicate=((TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9)) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
                  Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
                    Filter predicate=(MetricName IN ("temperature_celsius", "temperature.celsius", "temperature/celsius"))
                      Scan(merge(otel_metrics_gauge|otel_metrics_sum))
      Project [MetricName AS MetricName, Attributes AS Attributes, TimeUnix AS TimeUnix, Value AS Value, HistogramCount AS HistogramCount, HistogramSum AS HistogramSum, HistogramScale AS HistogramScale, HistogramZeroThreshold AS HistogramZeroThreshold, HistogramZeroCount AS HistogramZeroCount, HistogramPositiveOffset AS HistogramPositiveOffset, HistogramPositiveBucketCounts AS HistogramPositiveBucketCounts, HistogramNegativeOffset AS HistogramNegativeOffset, HistogramNegativeBucketCounts AS HistogramNegativeBucketCounts, 1 AS _setop_is_histogram]
        HistogramProjection project=[MetricName AS MetricName, Attributes AS Attributes, FnNow64(9) AS TimeUnix, 0 AS Value]
          Aggregate groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnArgMax(MetricName, TimeUnix) AS MetricName, FnArgMax(Count, TimeUnix) AS Count, FnArgMax(Sum, TimeUnix) AS Sum, FnArgMax(Scale, TimeUnix) AS Scale, FnArgMax(ZeroCount, TimeUnix) AS ZeroCount, FnArgMax(PositiveOffset, TimeUnix) AS PositiveOffset, FnArgMax(PositiveBucketCounts, TimeUnix) AS PositiveBucketCounts, FnArgMax(NegativeOffset, TimeUnix) AS NegativeOffset, FnArgMax(NegativeBucketCounts, TimeUnix) AS NegativeBucketCounts] dropEmptyOnNoGroup
            Filter predicate=(((MetricName IN ("partner_exp_hist", "partner.exp.hist", "partner.exp/hist", "partner.exp_hist", "partner/exp/hist", "partner/exp_hist", "partner_exp.hist")) AND (TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9))) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
              Scan(otel_metrics_exponential_histogram)
