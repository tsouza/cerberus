# `info` as a subquery inner (#1785). The subquery lowering admitted only
# calls that wrap a matrix selector, so an instant-vector transform inside
# the brackets was rejected; reference Prometheus answers
# `max_over_time(info(up)[5m:1m])` with one series.
#
# `info` is sample-preserving — it rewrites Attributes and leaves TimeUnix
# and Value alone — so it rides the same Identity wrap as `label_replace`.
# The `version` label on both output series is the load-bearing assertion:
# the target_info enrichment has to survive the per-anchor re-evaluation,
# not just the outer reduction.
-- query.promql --
max_over_time(info(up)[10m:5m])
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job', 'api'), toDateTime64('2025-12-31 23:55:00', 9), 1.0),
    ('up', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 3.0),
    ('up', map('job', 'db'), toDateTime64('2025-12-31 23:55:00', 9), 7.0),
    ('up', map('job', 'db'), toDateTime64('2026-01-01 00:00:00', 9), 2.0),
    ('target_info', map('job', 'api', 'version', '1.2.3'), toDateTime64('2025-12-31 23:55:00', 9), 1.0),
    ('target_info', map('job', 'api', 'version', '1.2.3'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('target_info', map('job', 'db', 'version', '4.5.6'), toDateTime64('2025-12-31 23:55:00', 9), 1.0),
    ('target_info', map('job', 'db', 'version', '4.5.6'), toDateTime64('2026-01-01 00:00:00', 9), 1.0);
-- expected_rows --
[
  [{"job": "api", "version": "1.2.3"}, 3],
  [{"job": "db", "version": "4.5.6"}, 7]
]
