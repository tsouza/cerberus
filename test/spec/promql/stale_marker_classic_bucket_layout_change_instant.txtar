# Seed: the classic histogram `stale_hist` is scraped every 30s. Series
# job="a" carries bounds 1/5/10 until 23:58:00 and 1/5 from 23:58:30; its
# target disappears behind a NoRecordedValue data point (Flags = 1, empty
# bucket arrays) at 23:59:30 and returns at 00:02:00 with bounds 1/5. Series
# job="b" carries bounds 1/5 throughout. Reference Prometheus holds the marker
# as a stale marker on every `_bucket` series job="a" has exposed, le="10"
# included.
#
# At 00:00:01 the newest job="a" sample of every bucket series, le="10"
# included, is the marker, so only job="b"'s bucket series answer.

-- query.promql --
stale_hist_bucket
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64),
    Flags UInt32
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram (MetricName, Attributes, TimeUnix, Count, Sum, BucketCounts, ExplicitBounds, Flags) VALUES
    ('stale_hist', map('job', 'a'), toDateTime64('2025-12-31 23:56:00', 9), 4, 4.0, [1, 1, 1, 1], [1.0, 5.0, 10.0], 0),
