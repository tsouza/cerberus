# Fixed-accumulator decomposition (cerberus issue #2760) for increase() in
# RANGE mode — chsql's emitFixedAccumulatorExtrapolatedMatrix. The
# `experimental_fixed_accumulator_increase` section opts the fixture into
# RangeLowerers.Increase = FixedAccumulatorIncreaseLowerer (WITHOUT the
# native ts_grid_increase strategy layered on top, so this pins the
# fixed-accumulator SQL shape itself, unshadowed).
#
# Same seed as fixed_accumulator_rate_range_step.txtar DELIBERATELY: job
# 'api' is a sawtooth counter (exercises the reset-correction sumIf term);
# job 'web' is monotonic.
-- query.promql --
sum by(job) (increase(http_requests_total[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_fixed_accumulator_increase --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
