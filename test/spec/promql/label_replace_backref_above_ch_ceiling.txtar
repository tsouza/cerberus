# A replacement referencing capture group TEN. Go's ExpandString — the
# engine reference Prometheus runs label_replace's replacement through —
# takes the LONGEST run of name characters, so `$10` is group ten, not
# group one followed by a literal `0`.
#
# ClickHouse's `replaceRegexpOne` substitution syntax stops at `\9`, so
# this template has no `replaceRegexpOne` spelling at all. The lowering
# decomposes it into literal runs and capture references instead, and the
# emitter builds the value with `concat` over `extractGroups`, which
# returns every group as an `Array(String)` and so has no ceiling.
#
# `host-abcdefghij` matches the ten single-character groups, so group ten
# is `j` and the destination label must read `g-j-tail`. A `\10` backref
# would have been read by ClickHouse as group one followed by `0` and
# produced `g-a0-tail`.

-- query.promql --
label_replace(temperature, "service", "g-$10-tail", "host", "host-(.)(.)(.)(.)(.)(.)(.)(.)(.)(.)")
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('temperature', map('host', 'host-abcdefghij'), toDateTime64('2026-01-01 00:00:00', 9), 22.5);
-- expected_rows --
[
  ["temperature", {"host": "host-abcdefghij", "service": "g-j-tail"}, "2026-01-01T00:00:00Z", 22.5]
]
