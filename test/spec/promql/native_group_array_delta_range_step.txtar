# Native array assembly (cerberus issue #2749) for delta() in RANGE mode —
# chsql's emitWindowedArrayExtrapolatedMatrix's plain regroup branch. delta()
# has no temporality-tracking split-window shape (extrapolationKind.isCounter()
# is false for delta), so its regroup always takes the plain
# groupArrayPairFrag/timeSeriesGroupArray branch regardless of schema — unlike
# rate()/increase() against a Sum-family table, which always route through the
# needsDeltaFirstLevel groupArrayIf split instead (out of scope for this
# feature, see chopt.FeatureTSGridGroupArray's own doc). The
# `experimental_ts_grid_group_array` section opts the fixture into
# RangeLowerers.NativeGroupArray = true, pinning the array-fold's own
# timeSeriesGroupArray SQL shape.
#
# job 'dup' carries a duplicate-timestamp sample pair (two rows at 00:01:00)
# to exercise the native aggregate's own duplicate-timestamp collapse in
# place of the arrayReverse/arrayCompact/arrayReverse triple; job 'flat' has
# no duplicates.
-- query.promql --
sum by(job) (delta(cpu_temp_celsius[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_ts_grid_group_array --
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('cpu_temp_celsius', map('job', 'dup'), toDateTime64('2026-01-01 00:00:00', 9), 40.0),
    ('cpu_temp_celsius', map('job', 'dup'), toDateTime64('2026-01-01 00:01:00', 9), 45.0),
    ('cpu_temp_celsius', map('job', 'dup'), toDateTime64('2026-01-01 00:01:00', 9), 55.0),
    ('cpu_temp_celsius', map('job', 'dup'), toDateTime64('2026-01-01 00:02:00', 9), 45.0),
    ('cpu_temp_celsius', map('job', 'dup'), toDateTime64('2026-01-01 00:03:00', 9), 60.0),
    ('cpu_temp_celsius', map('job', 'dup'), toDateTime64('2026-01-01 00:04:00', 9), 50.0),
    ('cpu_temp_celsius', map('job', 'dup'), toDateTime64('2026-01-01 00:05:00', 9), 65.0),
    ('cpu_temp_celsius', map('job', 'flat'), toDateTime64('2026-01-01 00:00:00', 9), 20.0),
    ('cpu_temp_celsius', map('job', 'flat'), toDateTime64('2026-01-01 00:01:00', 9), 20.0),
    ('cpu_temp_celsius', map('job', 'flat'), toDateTime64('2026-01-01 00:02:00', 9), 20.0),
    ('cpu_temp_celsius', map('job', 'flat'), toDateTime64('2026-01-01 00:03:00', 9), 20.0),
    ('cpu_temp_celsius', map('job', 'flat'), toDateTime64('2026-01-01 00:04:00', 9), 20.0),
    ('cpu_temp_celsius', map('job', 'flat'), toDateTime64('2026-01-01 00:05:00', 9), 20.0);
