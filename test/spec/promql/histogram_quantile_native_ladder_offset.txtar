-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.95 cumulative groupBy=[anchor_ts AS anchor_ts, Attributes AS Attributes]
    Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(i -> FnArrayMax(FnArraySlice(_hq_ladder, 1, i)), FnArrayEnumerate(_hq_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
      Project [anchor_ts AS anchor_ts, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnArrayConcat(FnArrayMap(u -> FnArraySum(FnArrayFilter((v, pbs) -> FnArrayHas(pbs, u), FnArrayMap((bs, cs) -> FnArraySum(FnArrayMap((b, c) -> FnIf((FnNot((FnIsNaN(b) OR FnIsInfinite(b))) AND (b <= u)), FnToFloat64(c), 0), bs, FnArraySlice(cs, 1, FnLength(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)), FnArraySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list))))), FnArray(FnArraySum(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list)))) AS _hq_ladder, FnArraySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list)))) AS ExplicitBounds]
        Filter predicate=(FnThrowIf(((FnLeast(FnArraySum(FnArrayMap(cbmw -> FnLength(cbmw), _hq_bounds_list)), 100000000) * FnLeast(FnArrayMax(FnArrayMap(cbmw -> FnLength(cbmw), _hq_bounds_list)), 100000000)) > 10000000), "classic-histogram bucket merge exceeds the bucket-volume-times-widest-row resource bound") = 0)
          Aggregate groupBy=[anchor_ts AS anchor_ts] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list] dropEmptyOnNoGroup
            UnionAll arms=2
              RangeBucketGridNative step=1m0s range=2m0s offset=5m0s groupBy=[Attributes AS Attributes] buckets=BucketCounts bounds=ExplicitBounds start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
                Project [FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, BucketCounts AS BucketCounts, ExplicitBounds AS ExplicitBounds]
                  Filter predicate=((MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration")) AND (AggregationTemporality != 1))
                    Scan(otel_metrics_histogram)
