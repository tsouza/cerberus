# The native classic-histogram ladder with an `offset` modifier. The offset
# folds onto the aggregate's membership grid (both start/end parameters shift
# left) while the REPORTED anchor axis — its own timeSeriesRange over the
# unshifted [start, end] — does not move, mirroring the fan-out contract
# exactly.
#
# The seed, grid and `expected_rows` are IDENTICAL to
# histogram_quantile_classic_agg_offset_range.txtar, which is enrolled in the
# Prometheus parity corpus. A dropped or mis-signed offset reads the wrong
# sample pair and so changes the VALUE, not merely the row count — see that
# fixture's header for the per-anchor arithmetic, which is why the byte-level
# identity of these cells is a real assertion about the offset and not a
# coincidence of a constant-shape window.

-- query.promql --
histogram_quantile(0.95, sum by(le)(rate(http_server_request_duration_bucket[2m] offset 5m)))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
60s
-- experimental_ts_grid_histogram --
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
