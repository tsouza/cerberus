# A classic histogram_quantile whose float le pipeline collapses the ladder,
# under promql.NativeQuantileRankWalkLowerer (the
# `experimental_quantile_prom_histogram` marker section). The selector drops
# the +Inf rung, so the cumulative ladder collapses to empty BucketCounts
# while ExplicitBounds keeps its two finite bounds. The rank-walk kernel
# still hands quantilePrometheusHistogram one count per bound and one for the
# appended +Inf, and the empty-ladder guard answers Prometheus's NaN.

-- query.promql --
histogram_quantile(0.5, topk(2, rate(reqs{le!="+Inf"}[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- experimental_quantile_prom_histogram --
-- seed --
