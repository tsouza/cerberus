Project ["" AS MetricName, Attributes AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.5 cumulative signed groupBy=[Attributes AS Attributes, TimeUnix AS TimeUnix]
    Project [gkey_0 AS Attributes, _hq_ts AS TimeUnix, FnArrayFilter(b -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_le_sorted, 1, -1)) AS ExplicitBounds, FnIf((FnArrayExists(b -> (FnIsInfinite(b) AND (b > 0)), _hq_le_sorted) AND (FnLength(FnArrayConcat(FnArrayFilter((c, b) -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_cum_sorted, 1, -1), FnArraySlice(_hq_le_sorted, 1, -1)), FnArraySlice(_hq_cum_sorted, -1))) >= 2)), FnArrayMap(kpl -> FnArrayMap(kpr -> FnArrayMap(kpm -> FnArrayFill((kpv, kpk) -> kpk, kpl, FnArrayMap((kpa, kpb) -> ((kpa > 0) AND (kpa = kpb)), kpr, kpm)), FnArray(FnArrayMap((kpa, kpb) -> (kpa + kpb), kpr, FnArrayCumSumNonNegative(FnArrayMap(kpd -> (0 - kpd), FnArrayDifference(kpr))))))[1], FnArray(FnArrayMap((kpa, kpv) -> FnIf(FnIsNaN(kpv), 0, FnToInt64(kpa)), FnArraySort((kpk, kpp) -> kpp, FnArrayEnumerate(kpl), FnArraySort((kpi, kpv) -> FnTuple(kpv, (0 - kpi)), FnArrayEnumerate(kpl), kpl)), kpl)))[1], FnArray(FnArrayConcat(FnArrayFilter((c, b) -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_cum_sorted, 1, -1), FnArraySlice(_hq_le_sorted, 1, -1)), FnArraySlice(_hq_cum_sorted, -1))))[1], FnArraySlice(FnArrayConcat(FnArrayFilter((c, b) -> FnNot(FnIsInfinite(b)), FnArraySlice(_hq_cum_sorted, 1, -1), FnArraySlice(_hq_le_sorted, 1, -1)), FnArraySlice(_hq_cum_sorted, -1)), 1, 0)) AS BucketCounts]
      Project [gkey_0 AS gkey_0, _hq_ts AS _hq_ts, FnArraySort(_hq_le_list) AS _hq_le_sorted, FnArraySort((c, b) -> b, _hq_cum_list, _hq_le_list) AS _hq_cum_sorted]
        Aggregate groupBy=[mapWithout(Attributes, [le]) AS gkey_0, FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9) AS _hq_ts] funcs=[FnGroupArray(FnAssumeNotNull(FnToFloat64OrNull(Attributes["le"]))) AS _hq_le_list, FnGroupArray(Value) AS _hq_cum_list]
          Filter predicate=FnIsNotNull(FnToFloat64OrNull(Attributes["le"]))
            TopK k=5 sort=Value DESC by=[Attributes["le"]] columns=[MetricName, Attributes, TimeUnix, Value]
              Filter predicate=(FnReinterpretAsUInt64(Value) != 9218868437227405314)
                Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
                  Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnMax(TimeUnix) AS lwr_ts, FnArgMax(Value, TimeUnix) AS lwr_value]
                    Filter predicate=((TimeUnix <= FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9)) AND (TimeUnix > (FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9) - FnToIntervalNanosecond(300000000000))))
                      Project ["http_server_request_duration_bucket" AS MetricName, FnMapMerge(Attributes, FnMap("le", FnTupleElement(le_pair, 1))) AS Attributes, TimeUnix AS TimeUnix, FnIf((FnBitAnd(Flags, 1) != 0), FnReinterpretAsFloat64(9218868437227405314), FnTupleElement(le_pair, 2)) AS Value]
                        Project [MetricName AS MetricName, Attributes AS Attributes, TimeUnix AS TimeUnix, Flags AS Flags, FnArrayJoin(FnArrayZip(FnArrayMap(le_idx -> FnIf((le_idx > FnLength(stale_layout_bounds)), "+Inf", FnArrayMap(pffv -> FnArrayMap(pffu -> FnMultiIf(FnIsNaN(pffv), "NaN", (FnIsInfinite(pffv) AND (pffv > 0)), "+Inf", FnIsInfinite(pffv), "-Inf", FnArrayMap(pffs -> FnArrayMap(pffe -> FnIf((pffe = 0), pffu, FnConcat(FnIf(FnStartsWith(pffu, "-"), "-", ""), FnArrayMap(pffm -> FnArrayMap(pffp -> FnArrayMap(pffd -> FnArrayMap(pffn -> FnMultiIf((pffn >= FnToInt64(FnLength(pffd))), FnConcat(pffd, FnLeftPad("", (pffn - FnToInt64(FnLength(pffd))), "0")), (pffn > 0), FnConcat(FnSubstring(pffd, 1, pffn), ".", FnSubstring(pffd, (pffn + 1))), FnConcat("0.", FnLeftPad("", (0 - pffn), "0"), pffd)), FnArray((FnIf((pffp > 0), (pffp - 1), FnToInt64(FnLength(pffm))) + FnToInt64(FnSubstring(pffs, (pffe + 1))))))[1], FnArray(FnIf((pffp > 0), FnConcat(FnSubstring(pffm, 1, (pffp - 1)), FnSubstring(pffm, (pffp + 1))), pffm)))[1], FnArray(FnToInt64(FnStringPosition(pffm, "."))))[1], FnArray(FnSubstring(pffs, 1, (pffe - 1))))[1])), FnArray(FnToInt64(FnStringPosition(pffs, "e"))))[1], FnArray(FnIf(FnStartsWith(pffu, "-"), FnSubstring(pffu, 2), pffu)))[1]), FnArray(FnToString(pffv)))[1], FnArray(stale_layout_bounds[le_idx]))[1]), FnArrayEnumerate(stale_layout_counts)), FnArrayMap(c -> FnToFloat64(c), FnArrayCumSum(stale_layout_counts)))) AS le_pair]
                          Project [MetricName AS MetricName, Attributes AS Attributes, TimeUnix AS TimeUnix, Flags AS Flags, FnIf((FnBitAnd(Flags, 1) != 0), FnArraySort(stale_layout_union), ExplicitBounds) AS stale_layout_bounds, FnIf((FnBitAnd(Flags, 1) != 0), FnArrayResize(BucketCounts, (FnLength(FnArraySort(stale_layout_union)) + 1)), BucketCounts) AS stale_layout_counts]
                            Project [MetricName AS MetricName, Attributes AS Attributes, stale_layout_union AS stale_layout_union, FnTupleElement(stale_layout_row, 1) AS TimeUnix, FnTupleElement(stale_layout_row, 2) AS Flags, FnTupleElement(stale_layout_row, 3) AS ExplicitBounds, FnTupleElement(stale_layout_row, 4) AS BucketCounts]
                              Project [MetricName AS MetricName, Attributes AS Attributes, stale_layout_union AS stale_layout_union, FnArrayJoin(stale_layout_rows) AS stale_layout_row]
                                Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnGroupUniqArrayArray(ExplicitBounds) AS stale_layout_union, FnGroupArray(FnTuple(TimeUnix, Flags, ExplicitBounds, BucketCounts)) AS stale_layout_rows]
                                  Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Flags AS Flags, ExplicitBounds AS ExplicitBounds, BucketCounts AS BucketCounts]
                                    Filter predicate=((TimeUnix > (FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9) - FnToIntervalNanosecond(300000000000))) AND (TimeUnix <= FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9)))
                                      Filter predicate=(MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration"))
                                        Scan(otel_metrics_histogram)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;agg=2
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
