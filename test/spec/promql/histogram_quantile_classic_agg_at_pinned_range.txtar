))), FnArray(FnArrayFilter((kwx, kwf) -> kwf, kwb, kws)))[1], FnArray(FnArrayMap((kwd, kwi) -> ((kwi = 1) OR (kwd != 0)), FnArrayDifference(kwb), FnArrayEnumerate(kwb))))[1], FnArray(FnArraySort((kwx, kwk, kwi) -> FnTuple(kwk, kwi), kweb, kweb, FnArrayEnumerate(kweb))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 3), kwe))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 2), kwe))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 1), kwe))))[1], FnArray(FnArrayMap((bs, cs, kwrt) -> FnArrayMap(kreb -> FnArrayMap(krev -> FnArrayMap(krb -> FnArrayMap(krs -> FnArrayMap(kru -> FnTuple(kru, FnArrayCumSum(FnArrayMap(krr -> FnArraySum(krr), FnArraySplit((krx, krf) -> krf, FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), krev, kreb, FnArrayEnumerate(kreb)), krs))), FnArrayWithConstant(FnLength(kru), kwrt)), FnArray(FnArrayFilter((krx, krf) -> krf, krb, krs)))[1], FnArray(FnArrayMap((krd, kri) -> ((kri = 1) OR (krd != 0)), FnArrayDifference(krb), FnArrayEnumerate(krb))))[1], FnArray(FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), kreb, kreb, FnArrayEnumerate(kreb))))[1], FnArray(FnArrayFilter((krrc, krrb) -> FnNot((FnIsNaN(krrb) OR FnIsInfinite(krrb))), FnArrayMap(krrc -> FnToFloat64(krrc), FnArraySlice(cs, 1, FnLength(bs))), bs)))[1], FnArray(FnArrayFilter(krx -> FnNot((FnIsNaN(krx) OR FnIsInfinite(krx))), bs)))[1], _hq_bounds_list, _hq_counts_list, _hq_ts_list)))[1] AS _hq_window_ladder]
