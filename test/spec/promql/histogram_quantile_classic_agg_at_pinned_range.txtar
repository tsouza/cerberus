# `histogram_quantile(phi, sum by(le)(rate(<classic hist>[5m] @ <ts>)))` over
# query_range. The `@` pins the bucket aggregation to `(23:55, 00:00]` for
# every step, so all six steps in `[00:00:00, 00:05:00]` interpolate the
# same summed bucket array.
#
# `sum by(le)` collapses the two seeded services, and the post-pin samples
# carry a wider bound set, so a window re-anchored onto each step would
# jump to the larger upper bound. Six identical rows are the pin surviving.

-- query.promql --
histogram_quantile(0.95, sum by(le)(rate(http_server_request_duration_bucket[5m] @ 1767225600)))
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:55:30', 9), [0, 0, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'web'), toDateTime64('2025-12-31 23:57:00', 9), [0, 0, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:56:00', 9), [1, 2, 3], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'web'), toDateTime64('2025-12-31 23:58:00', 9), [3, 2, 1], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:02:00', 9), [1, 2, 3], [10.0, 50.0, 100.0]),
    ('http_server_request_duration', map('service', 'web'), toDateTime64('2026-01-01 00:04:00', 9), [3, 2, 1], [10.0, 50.0, 100.0]);
