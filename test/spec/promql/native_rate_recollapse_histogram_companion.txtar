# NEGATIVE fixture: `rate(x_count[5m])` gets neither the native grid nor
# the shaping hoist, with both experimental sections on.
#
# `rate(x_count[5m])` lowers through wrapHistogramCompanionProject, which
# emits a Project carrying the SAME four aliases and the SAME
# label-shaping tower as the ordinary selector Project — differing only
# in projecting `toFloat64(Count) AS Value` instead of the identity
# `Value`. A classifier that keyed purely on "has a shaping tower aliased
# to a GroupBy key" would hoist it, and hoisting it would strip the cast
# and the Count -> Value rename: the aggregate would then read a `Value`
# column the histogram table does not have.
#
# What the goldens below record is that the ambiguity of a `_count`
# suffix settles the question FIRST. The name can be a histogram
# companion, a plain sum, or a gauge, so the selector fans out into a
# 3-arm UnionAll; a UnionAll is not a relation the native grid emitter
# can read, so lowering keeps the generic RangeWindow fan-out and the
# hoist is never consulted. That makes this a coverage floor for the
# UNION shape under the flag rather than a probe of the value-derivation
# clause: hoistableShapingProject's refusal of a derived Value is pinned
# directly, on a single-arm input, by the "histogram companion derives
# Value" case in internal/promql/shaping_hoist_test.go.
#
# The fixture is worth pinning here because widening the native emitter
# to read per-arm unions is a natural next step, and the day it lands
# this golden moves — which is the prompt to re-check that the value-cast
# refusal still stands on the arm that carries it.

-- query.promql --
rate(cerberus_request_duration_count[5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_ts_grid_range --
-- experimental_ts_grid_recollapse --
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
