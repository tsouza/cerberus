# NEGATIVE pin: a PRESERVING outer function over a NAME-DROPPING inner.
#
# Upstream resolves the surviving `__name__` from the outer function's
# INPUT SERIES, and `rate` has already stripped it — so
# `last_over_time(rate(x[5m])[10m:1m])` reports no `__name__` even though
# `last_over_time` preserves one. The subquery spine walk must therefore
# reject a spine whose inner RangeWindow runs a dropping function, rather
# than resurrect a name the inner step deleted.
#
# This is the fixture that fails if the carry is applied unconditionally
# to every preserving outer function.
#
# The two metrics sit on DISTINCT attribute sets (`host=a` / `host=b`).
# That is load-bearing since #1811: `rate` dropping the name off two series
# that shared one attribute set collapses them onto a single label set, and
# reference Prometheus refuses that query outright ("vector cannot contain
# metrics with the same labelset") rather than merging them. Splitting the
# hosts keeps this fixture on the question it exists to answer — is the
# name resurrected? — and leaves the collision to the fixtures and wire
# tests that own it.
-- query.promql --
last_over_time(rate({__name__=~"cpu_temp|gpu_temp"}[5m])[10m:1m])
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 40.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 41.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 42.0),
    ('gpu_temp', map('host', 'b'), toDateTime64('2025-12-31 23:55:00', 9), 70.0),
    ('gpu_temp', map('host', 'b'), toDateTime64('2025-12-31 23:59:00', 9), 71.0),
    ('gpu_temp', map('host', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 72.0);
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
