# Negative/scope-boundary regression fixture for cerberus issue #2888,
# found by #2852's own strict-scan CI run: composing ts_grid_recollapse with
# ts_grid_vector_agg on the rate()/increase() temporality-union arm emits an
# invalid query against a real ClickHouse server (`Unknown expression or
# function identifier` — the Recollapse-hoisted shaped key never gets
# restored to the "Attributes" column name the outer GroupBy expression
# still references). [tryNativeGridVectorAgg] in internal/promql/lower.go
# guards against this by refusing to fold when the native arm carries a
# non-empty Recollapse, falling back to the ordinary exploded-then-grouped
# Aggregate instead.
#
# Same query, same seed, same grid as native_rate_recollapse_range_step.txtar
# — the ONLY difference is the additional `experimental_ts_grid_vector_agg`
# section. The `-- chplan --` / `-- sql --` goldens below are BYTE-IDENTICAL
# to that fixture's own (ordinary Aggregate, three-level recollapse shape,
# no RangeWindowGridNativeVectorAgg anywhere) — proving the guard makes this
# combination inert rather than silently wrong, exactly like
# native_rate_avg_vector_agg_temporality_union_excluded.txtar pins for the
# avg/count exclusion.

-- query.promql --
sum by(cerberus_ql) (rate(cerberus_queries_total[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_ts_grid_range --
-- experimental_ts_grid_recollapse --
-- experimental_ts_grid_vector_agg --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
