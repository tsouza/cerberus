# `and` in instant mode (Step == 0), where the two arms share a label
# signature but carry DIFFERENT sample timestamps.
#
# An instant query evaluates at a single timestamp; each arm returns one
# row per series stamped with that series' own last sample time inside
# the lookback window, not with the evaluation instant. The two arms
# here are stamped a minute apart, and both are in scope at the
# evaluation instant, so `and` keeps the left arm's row.
#
# The match key is the label signature ALONE in instant mode. Extending
# it with the timestamp column — correct in range mode, where every arm
# projects the same grid anchor — would make the arms look disjoint and
# return nothing. The `-- sql --` golden below pins the instant key: the
# semi-join subquery selects `Attributes` with no `TimeUnix`.

-- query.promql --
demo_dense_bytes and demo_sparse_bytes
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('demo_dense_bytes',  map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 100.0),
    ('demo_sparse_bytes', map('job', 'api'), toDateTime64('2025-12-31 23:59:00', 9), 10.0);
-- expected_rows --
[
  ["demo_dense_bytes", {"job": "api"}, "2026-01-01T00:00:00Z", 100]
]
