-- chplan --
Project [coalesce(nullIf(if(mapContains(Attributes, "k8s_namespace_name"), Attributes["k8s_namespace_name"], if(mapContains(Attributes, "k8s.namespace.name"), Attributes["k8s.namespace.name"], if(mapContains(Attributes, "k8s.namespace/name"), Attributes["k8s.namespace/name"], if(mapContains(Attributes, "k8s.namespace_name"), Attributes["k8s.namespace_name"], if(mapContains(Attributes, "k8s/namespace/name"), Attributes["k8s/namespace/name"], if(mapContains(Attributes, "k8s/namespace_name"), Attributes["k8s/namespace_name"], Attributes["k8s_namespace.name"])))))), ""), nullIf(if(mapContains(ResourceAttributes, "k8s_namespace_name"), ResourceAttributes["k8s_namespace_name"], if(mapContains(ResourceAttributes, "k8s.namespace.name"), ResourceAttributes["k8s.namespace.name"], if(mapContains(ResourceAttributes, "k8s.namespace/name"), ResourceAttributes["k8s.namespace/name"], if(mapContains(ResourceAttributes, "k8s.namespace_name"), ResourceAttributes["k8s.namespace_name"], if(mapContains(ResourceAttributes, "k8s/namespace/name"), ResourceAttributes["k8s/namespace/name"], if(mapContains(ResourceAttributes, "k8s/namespace_name"), ResourceAttributes["k8s/namespace_name"], ResourceAttributes["k8s_namespace.name"])))))), ""), "") AS value]
  Filter predicate=(((MetricName IN ("requests_total", "requests.total", "requests/total")) AND (TimeUnix >= toDateTime64("1970-01-01 00:01:40.000000000", 9))) AND (TimeUnix <= toDateTime64("1970-01-01 00:08:20.000000000", 9)))
    Scan(otel_metrics_sum)
