# `and` in range mode with a SUBQUERY right arm
# (`max_over_time(demo_sparse_bytes[3m:1m])`).
#
# Same arm shapes as setop_or_subquery_arm_range: the subquery arm
# surfaces its anchor under `anchor_ts`, and the canonical-shape arm
# projection aliases it to the schema timestamp column so the
# `(signature, TimeUnix)` match key resolves.
#
# Coverage, with the half-open window rule (`t - w < sample <= t`):
#
#   left  (dense,  sample at 00:02, 5m lookback) covers 00:02 .. 00:05
#   right (sparse, sample at 00:00, [3m:1m])     covers 00:00 00:01 00:02
#
# The intersection is the single anchor 00:02.
-- query.promql --
demo_dense_bytes and max_over_time(demo_sparse_bytes[3m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('demo_sparse_bytes', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 10.0),
    ('demo_dense_bytes',  map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 100.0);
