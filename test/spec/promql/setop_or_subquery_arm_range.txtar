# `or` in range mode with a SUBQUERY right arm
# (`max_over_time(demo_sparse_bytes[3m:1m])`).
#
# A subquery arm reduces over an inner grid, so its own RangeWindow
# already carries `anchor_ts` as its timestamp column and its outer
# SELECT surfaces the anchor under that name rather than under the
# schema's `TimeUnix`. The set op's canonical-shape arm projection
# aliases across, so the emitted SQL never references an identifier the
# arm's own SELECT does not expose.
#
# Coverage, with the half-open window rule (`t - w < sample <= t`):
#
#   left  (dense,  sample at 00:02, 5m lookback) covers 00:02 .. 00:05
#   right (sparse, sample at 00:00, [3m:1m])     covers 00:00 00:01 00:02
#
# Both arms carry {job="api"}, so `or` keeps every left anchor and only
# the right anchors the left arm does not already hold: 00:00 and 00:01.
# The right arm is derived shape, so its rows carry the empty metric
# name.
-- query.promql --
demo_dense_bytes or max_over_time(demo_sparse_bytes[3m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('demo_sparse_bytes', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 10.0),
    ('demo_dense_bytes',  map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 100.0);
-- expected_rows --
[
  ["", {"job": "api"}, "2026-01-01T00:00:00Z", 10],
  ["", {"job": "api"}, "2026-01-01T00:01:00Z", 10],
  ["demo_dense_bytes", {"job": "api"}, "2026-01-01T00:02:00Z", 100],
  ["demo_dense_bytes", {"job": "api"}, "2026-01-01T00:03:00Z", 100],
  ["demo_dense_bytes", {"job": "api"}, "2026-01-01T00:04:00Z", 100],
  ["demo_dense_bytes", {"job": "api"}, "2026-01-01T00:05:00Z", 100]
]
-- args --
[0] string = "service.name"
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = ""
[5] string = "service_name"
[6] string = "demo_dense_bytes"
[7] string = "demo.dense.bytes"
[8] string = "demo.dense/bytes"
[9] string = "demo.dense_bytes"
[10] string = "demo/dense/bytes"
[11] string = "demo/dense_bytes"
[12] string = "demo_dense.bytes"
[13] string = ""
[14] string = "service.name"
[15] string = "service_name"
[16] string = "service.name"
[17] string = "service_name"
[18] string = ""
[19] string = "service_name"
[20] string = "demo_sparse_bytes"
[21] string = "demo.sparse.bytes"
[22] string = "demo.sparse/bytes"
[23] string = "demo.sparse_bytes"
[24] string = "demo/sparse/bytes"
[25] string = "demo/sparse_bytes"
[26] string = "demo_sparse.bytes"
-- chplan --
VectorSetOp op=or match=default stepAligned
  RangeLWR step=1m0s lookback=5m0s ts=TimeUnix value=Value start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
    Project [MetricName AS MetricName, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
      Filter predicate=(MetricName IN ("demo_dense_bytes", "demo.dense.bytes", "demo.dense/bytes", "demo.dense_bytes", "demo/dense/bytes", "demo/dense_bytes", "demo_dense.bytes"))
        Scan(merge(otel_metrics_gauge|otel_metrics_sum))
  RangeWindow func=max_over_time range=3m0s step=1m0s outerRange=5m0s ts=anchor_ts value=Value groupBy=[Attributes] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
    RangeWindow func= range=5m0s step=1m0s outerRange=8m0s identity=true ts=TimeUnix value=Value groupBy=[Attributes] start=2025-12-31T23:57:00Z end=2026-01-01T00:05:00Z
      Project [MetricName AS MetricName, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
        Filter predicate=(MetricName IN ("demo_sparse_bytes", "demo.sparse.bytes", "demo.sparse/bytes", "demo.sparse_bytes", "demo/sparse/bytes", "demo/sparse_bytes", "demo_sparse.bytes"))
          Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- sql --
SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, `_setop_side`, max(`_setop_side` = 0) OVER (PARTITION BY mapSort(`Attributes`), `TimeUnix`) AS `_setop_has_left` FROM (((SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, 0 AS `_setop_side` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, anchor_ts AS `TimeUnix`, lwr_value AS `Value` FROM (SELECT `MetricName`, `Attributes`, `anchor_ts`, argMax(`Value`, `TimeUnix`) AS lwr_value FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 300000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 300000000000, toInt64(60000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(60000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?)))) WHERE `TimeUnix` > toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9)) GROUP BY `MetricName`, `Attributes`, `anchor_ts`))))) UNION ALL ((SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, 1 AS `_setop_side` FROM (SELECT ? AS `MetricName`, `Attributes`, `anchor_ts` AS `TimeUnix`, `Value` FROM (SELECT `Attributes`, `anchor_ts`, max(`Value`) AS `Value` FROM (SELECT `Attributes`, `_src_ts`, `Value`, arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `_src_ts`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 180000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 180000000000, toInt64(60000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `_src_ts`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(60000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT *, `anchor_ts` AS _src_ts FROM (SELECT `Attributes`, `anchor_ts`, anchor_ts AS `TimeUnix`, if(length(window_vals) > 0, window_vals[length(window_vals)], nan) AS `Value` FROM (SELECT `Attributes`, `anchor_ts`, arrayMap(p -> tupleElement(p, 2), window_pairs) AS `window_vals`, arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), window_pairs)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), window_pairs)))) AS `counter_delta` FROM (SELECT `Attributes`, `anchor_ts`, arraySort(groupArray((`TimeUnix`, `Value`))) AS `window_pairs` FROM (SELECT `Attributes`, `TimeUnix`, `Value`, arrayJoin(arrayMap(i -> fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)) - 300000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)) - 300000000000, toInt64(60000000000)) < 0) + 1), least(8, intDiv(dateDiff('nanosecond', `TimeUnix`, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)), toInt64(60000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?)))) WHERE `TimeUnix` > toDateTime64('2025-12-31 23:57:00.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9)) GROUP BY `Attributes`, `anchor_ts`)) WHERE length(`window_vals`) >= 1)) WHERE `_src_ts` > toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(180000000000) AND `_src_ts` <= toDateTime64('2026-01-01 00:05:00.000000000', 9)) GROUP BY `Attributes`, `anchor_ts`)))))) WHERE `_setop_side` = 0 OR `_setop_has_left` = 0
