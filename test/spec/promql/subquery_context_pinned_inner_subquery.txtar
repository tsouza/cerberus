# A pin on a subquery nested in another fixes the inner subquery's grid
# at its pin at every step of the outer grid: each step counts the five
# steps of the pinned grid.

-- query.promql --
max_over_time(count_over_time(vector(1)[5m:1m] @ 1767200000)[10m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
