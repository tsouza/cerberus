# Sibling of histogram_quantile_classic_zero_count_plateau: same seed, a phi
# whose target lands PAST the plateau, in the trailing +Inf bucket.
#
# cum [2, 2, 2, 5], total 5, target = 0.8*5 = 4. The first cumulative entry
# reaching 4 is index 4 = length(cum), so the overflow branch returns the
# highest FINITE bound, ExplicitBounds[length(ExplicitBounds)] = 1.0 —
# never +Inf.
#
# Hand-check against upstream on the equivalent `le` ladder
# {0.1:2, 0.5:2, 1.0:2, +Inf:5}: rank = 4, sort.Search finds no bucket with
# count >= 4 below +Inf, so b = len(buckets)-1 and Prometheus returns
# buckets[len-2].UpperBound = 1.0. Same value, and the plateau does not
# shift which bound is selected.

-- query.promql --
histogram_quantile(0.8, http_server_request_duration_bucket)
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [2, 0, 0, 3], [0.1, 0.5, 1.0]);
-- expected_rows --
[
  ["", {"job": "api"}, "2026-01-01T00:00:01Z", 1.0]
]
-- args --
[0] string = ""
[1] int64 = 9
[2] string = "service.name"
[3] string = "service_name"
[4] string = "service.name"
[5] string = "service_name"
[6] string = ""
[7] string = "service_name"
[8] string = "http_server_request_duration"
[9] string = "http.server.request.duration"
[10] string = "http.server.request/duration"
[11] string = "http.server.request_duration"
[12] string = "http.server/request/duration"
[13] string = "http.server/request_duration"
[14] string = "http.server_request.duration"
[15] string = "http.server_request_duration"
[16] string = "http/server/request/duration"
[17] string = "http/server/request_duration"
[18] string = "http/server_request_duration"
[19] string = "http_server.request.duration"
[20] string = "http_server.request_duration"
[21] string = "http_server_request.duration"
[22] string = "2026-01-01 00:00:01.000000000"
[23] int64 = 9
[24] string = "2026-01-01 00:00:01.000000000"
[25] int64 = 9
[26] int64 = 300000000000
-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, now64(9) AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.8 groupBy=[Attributes AS Attributes]
    Aggregate groupBy=[mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes] funcs=[argMax(BucketCounts, TimeUnix) AS BucketCounts, argMax(ExplicitBounds, TimeUnix) AS ExplicitBounds]
      Filter predicate=(((MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration")) AND (TimeUnix <= toDateTime64("2026-01-01 00:00:01.000000000", 9))) AND (TimeUnix > (toDateTime64("2026-01-01 00:00:01.000000000", 9) - toIntervalNanosecond(300000000000))))
        Scan(otel_metrics_histogram)
-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, if(length(`BucketCounts`) = 0, nan, if(arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`)) = 0, nan, if(0.8 < 0, -inf, if(0.8 > 1, inf, if(arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = length(arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))), arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[length(arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1))))], if(arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1 AND arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[1] <= 0, arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[1], (if(arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1, 0.0, arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) - 1]) + (arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1))))] - if(arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1, 0.0, arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) - 1])) * ((0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))) - if(arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1, 0.0, arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))[arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) - 1])) / (arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))[arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1))))] - if(arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1, 0.0, arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))[arrayFirstIndex(c -> c >= (0.8 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) - 1]))))))))) AS `Value` FROM (SELECT mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, argMax(`BucketCounts`, `TimeUnix`) AS `BucketCounts`, argMax(`ExplicitBounds`, `TimeUnix`) AS `ExplicitBounds` FROM (SELECT * FROM `otel_metrics_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)) WHERE (`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?)))) GROUP BY `Attributes`))
