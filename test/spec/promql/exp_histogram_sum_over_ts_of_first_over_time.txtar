-- query.promql --
sum(ts_of_first_over_time(request_latency_exp_hist[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- cerberus issue #2619: ts_of_first_over_time(m_exp_hist[5m]) wrapped by
-- an outer sum() used to hard-reject even though the bare call already
-- lowered fine at the query root. Unlike sum_over_time/avg_over_time/
-- first_over_time/last_over_time, ts_of_first_over_time answers a plain
-- FLOAT timestamp per series, not a histogram — so the outer sum() is
-- ordinary float aggregation, not a histogram merge. Both series' oldest
-- in-window sample is at 2025-12-31 23:59:01Z (epoch 1767225541), so the
-- outer sum reports 2 * 1767225541 = 3534451082.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('request_latency_exp_hist', map('instance', 'a'), toDateTime64('2025-12-31 23:59:01', 9),  5, 3.0, 0, 0, 0, [1, 2], 0, []),
    ('request_latency_exp_hist', map('instance', 'a'), toDateTime64('2026-01-01 00:00:01', 9),  9, 6.0, 0, 0, 0, [3, 4], 0, []),
    ('request_latency_exp_hist', map('instance', 'b'), toDateTime64('2025-12-31 23:59:01', 9),  7, 4.0, 0, 0, 0, [3, 1], 0, []),
    ('request_latency_exp_hist', map('instance', 'b'), toDateTime64('2026-01-01 00:00:01', 9), 11, 8.0, 0, 0, 0, [5, 3], 0, []);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 3534451082]
]
