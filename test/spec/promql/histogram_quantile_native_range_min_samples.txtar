# `histogram_quantile(phi, sum by(le)(rate(<native hist>[5m])))` over
# query_range, where the sample floor is the whole point. The step grid runs
# `[00:00:00, 00:05:00]` every 60s and the selector's window is 5m, so each
# step reduces a different subset of the seed.
#
# `sum by(le)` names no attribute, so every row falls into ONE across-series
# group at every step. A floor counted per GROUP is therefore cleared by two
# samples drawn from two DIFFERENT series; only a floor counted per SERIES
# reproduces `rate()`, which needs two points from one series.
#
# All three series are scale 0 (base 2) with PositiveOffset 0 and cumulative
# counters:
#
#     api  23:59:00  [1000, 0,    0]   -> one scrape, no rate
#     db   00:00:00  [0,    5,    0]
#     web  00:01:00  [0,    0, 1000]   -> one scrape, no rate
#     db   00:02:00  [0,   25,    0]   -> increase [0, 20, 0]
#
# `db` is the only series that ever holds two scrapes in one window, and it
# holds them only for the steps `00:02:00`, `00:03:00` and `00:04:00`:
#
#   - `00:00:00` window `(23:55, 00:00]` holds api@23:59 + db@00:00 — two
#     rows, two series, one sample each.
#   - `00:01:00` window `(23:56, 00:01]` adds web@00:01 — three rows, still
#     one sample per series.
#   - `00:02:00` .. `00:04:00` windows hold db@00:00 + db@00:02, so `db`
#     alone contributes and the merged distribution is its increase
#     [0, 20, 0]: all mass in the second positive bucket, covering (2, 4].
#   - `00:05:00` window `(00:00, 00:05]` excludes db@00:00 on the half-open
#     lower bound, dropping `db` back to a single scrape.
#
# Three rows, all equal, is the per-series floor. Six rows — or three rows
# with api's and web's cumulative counts folded in — is the group-keyed one.
-- query.promql --
histogram_quantile(0.95, sum by(le)(rate(http_server_duration_exp_hist[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:59:00', 9), 0, 0, 0, [1000, 0, 0], 0, [], 1000, 0),
    ('http_server_duration_exp_hist', map('service', 'db'), toDateTime64('2026-01-01 00:00:00', 9), 0, 0, 0, [0, 5, 0], 0, [], 5, 0),
    ('http_server_duration_exp_hist', map('service', 'web'), toDateTime64('2026-01-01 00:01:00', 9), 0, 0, 0, [0, 0, 1000], 0, [], 1000, 0),
    ('http_server_duration_exp_hist', map('service', 'db'), toDateTime64('2026-01-01 00:02:00', 9), 0, 0, 0, [0, 25, 0], 0, [], 25, 0);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:02:00Z", 3.863745315699382],
  ["", {}, "2026-01-01T00:03:00Z", 3.863745315699382],
  ["", {}, "2026-01-01T00:04:00Z", 3.863745315699382]
]
