-- query.promql --
up{job="api",env!="prod",region=~"us-.*",cell!~"staging.*"}
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job', 'api', 'env', 'staging', 'region', 'us-east', 'cell', 'prod-1'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('up', map('job', 'api', 'env', 'prod', 'region', 'us-east', 'cell', 'prod-1'), toDateTime64('2026-01-01 00:00:00', 9), 2.0),
    ('up', map('job', 'api', 'env', 'staging', 'region', 'eu-west', 'cell', 'prod-1'), toDateTime64('2026-01-01 00:00:00', 9), 3.0),
    ('up', map('job', 'api', 'env', 'staging', 'region', 'us-east', 'cell', 'staging-2'), toDateTime64('2026-01-01 00:00:00', 9), 4.0),
    ('up', map('job', 'other', 'env', 'staging', 'region', 'us-east', 'cell', 'prod-1'), toDateTime64('2026-01-01 00:00:00', 9), 5.0);
