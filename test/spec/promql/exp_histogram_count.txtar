-- query.promql --
count(http_server_duration_exp_hist)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- THREE series, each with TWO samples inside the staleness lookback. The
-- answer is 3, not 6, and the gap between those two numbers is the whole
-- point of this fixture.
--
-- Reference evaluates the selector to an instant vector FIRST — at most
-- one sample per series — and only then counts, so `count()` reports the
-- number of SERIES. Counting the filtered scan directly would report the
-- number of stored rows, which is the scrape count. The two agree only
-- when every series was scraped exactly once in the window, so a seed
-- with one sample per series could not tell the correct lowering from the
-- broken one; this one gives 3 against 6.
--
-- The stored distributions differ wildly between the three series (and
-- between each series' two samples) precisely because `count()` must
-- ignore them: reference's aggregation switch reaches `group.groupCount++`
-- with no guard on the sample's value and no HistogramIgnoredInAggregation
-- annotation, which is exactly what separates `count` from the `min` /
-- `max` / `stddev` / `stdvar` / `quantile` family that DROPS histogram
-- samples. If any of those bucket ladders reached the answer, the number
-- would not be an integer 3.
--
-- `count()` with no by/without clause drops __name__ and every label, so
-- the output series is ["", {}] and the value is a plain float: 3.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api', 'pod', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 10,  5.0, 0, 0, 0, [2, 3, 5],  0, []),
    ('http_server_duration_exp_hist', map('service', 'api', 'pod', 'a'), toDateTime64('2025-12-31 23:59:00', 9),  6,  1.5, 0, 1, 0, [1, 2],     0, []),
    ('http_server_duration_exp_hist', map('service', 'api', 'pod', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 21, 12.5, 1, 0, 2, [7, 7, 7],  0, []),
    ('http_server_duration_exp_hist', map('service', 'api', 'pod', 'b'), toDateTime64('2025-12-31 23:59:00', 9),  3,  0.5, 1, 2, 2, [3],        0, []),
    ('http_server_duration_exp_hist', map('service', 'web', 'pod', 'a'), toDateTime64('2026-01-01 00:00:00', 9),  9,  4.0, 0, 0, 1, [4, 5],     0, []),
    ('http_server_duration_exp_hist', map('service', 'web', 'pod', 'a'), toDateTime64('2025-12-31 23:59:00', 9),  2,  0.25, 0, 0, 1, [2],       0, []);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 3]
]
