# The aggregating sibling of histogram_quantile_classic_zero_count_plateau:
# reaches the SAME target ladder that fixture pins — cum [2, 2, 2, 5] over
# bounds [0.1, 0.5, 1.0], quantile(0.4) = 0.1 — but via the aggregated
# `rate` path's per-series window reduction rather than one direct reading.
#
# Three same-`job` samples in the 5m window: a zero baseline at 23:59:00,
# a partial reading [1,0,0,1] at 23:59:30, and the final [2,0,0,3] at
# 00:00:00 (cumulative-over-time per bucket, all non-decreasing:
# bucket0 0→1→2, overflow 0→1→3). counterIncreaseFold's telescoping sum of
# CONSECUTIVE deltas — (partial-baseline)+(final-partial) — must equal the
# direct (final-baseline) delta: [1,0,0,1] + [1,0,0,2] = [2,0,0,3], which
# is exactly the fixture's target. Two samples would only pin a single
# delta; three is what actually exercises the multi-hop telescoping rather
# than a special case of it.
#
# That target ladder [2,2,2,5] is also, by construction, ALREADY monotonic
# (arraySum of non-negative per-bucket counts), so this fixture pins the
# plateau shape surviving the round trip without depending on the
# monotonic-repair envelope doing any work — the repair's own job is
# pinned separately by histogram_quantile_sum_by_le_layout_change_midwindow,
# whose ladder genuinely dips.

-- query.promql --
histogram_quantile(0.4, sum by(job)(rate(http_server_request_duration_bucket[5m])))
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2025-12-31 23:59:00', 9), [0, 0, 0, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2025-12-31 23:59:30', 9), [1, 0, 0, 1], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [2, 0, 0, 3], [0.1, 0.5, 1.0]);
-- expected_rows --
[
  ["", {"job": "api"}, "2026-01-01T00:00:01Z", 0.1]
]
