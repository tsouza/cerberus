A range function over a counter that is not a histogram bucket, under
arithmetic: its samples carry no `le`, so Prometheus answers an empty
vector. `rate` keeps its argument's labels and `requests_total` pins a
name without the `_bucket` suffix and has no `le` matcher, so cerberus
folds the query to that empty vector without reading the argument.

-- query.promql --
histogram_quantile(0.9, rate(requests_total[5m]) * 2)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String, Attributes Map(String, String), ResourceAttributes Map(String, String),
    TimeUnix DateTime64(9), Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('requests_total', map('job','a'), map(), toDateTime64('2025-12-31 23:58:00', 9), 10.0),
    ('requests_total', map('job','a'), map(), toDateTime64('2025-12-31 23:59:00', 9), 20.0),
    ('requests_total', map('job','a'), map(), toDateTime64('2026-01-01 00:00:00', 9), 40.0);
-- expected_rows --
[]
-- args --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] float64 = 0
[4] bool = false
-- args_optimized --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] float64 = 0
[4] bool = false
-- chplan --
Filter predicate=false
  Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, 0 AS Value]
    OneRow
-- settings --
enabled_opts=aggregation_in_order,classic_bucket_layout_two_level,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:filter
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
-- sql --
SELECT * FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT 1)) WHERE ?
-- sql_optimized --
SELECT * FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT 1)) WHERE ?
