rt, sampled_interval * first_val / counter_delta), duration_to_start) + duration_to_end) / sampled_interval / 300), nan) AS `Value` FROM (SELECT `Attributes`, `window_vals`, `counter_delta`, `first_val`, toFloat64(dateDiff('nanosecond', first_ts, last_ts)) / 1e9 AS `sampled_interval`, if(toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) - toIntervalNanosecond(300000000000), first_ts)) / 1e9 >= 1.1 * sampled_interval / (length(window_vals) - 1), sampled_interval / (length(window_vals) - 1) / 2, toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) - toIntervalNanosecond(300000000000), first_ts)) / 1e9) AS `duration_to_start`, if(toFloat64(dateDiff('nanosecond', last_ts, parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9))) / 1e9 >= 1.1 * sampled_interval / (length(window_vals) - 1), sampled_interval / (length(window_vals) - 1) / 2, toFloat64(dateDiff('nanosecond', last_ts, parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9))) / 1e9) AS `duration_to_end` FROM (SELECT `Attributes`, arrayMap(p -> tupleElement(p, 2), window_pairs) AS `window_vals`, if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), window_pairs)) - tupleElement(window_pairs[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), window_pairs)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), window_pairs))))) AS `counter_delta`, tupleElement(window_pairs[1], 1) AS `first_ts`, tupleElement(window_pairs[length(window_pairs)], 1) AS `last_ts`, if(temporality = 1, `delta_prefix_before_window` + tupleElement(window_pairs[1], 2), tupleElement(window_pairs[1], 2)) AS `first_val` FROM (SELECT `Attributes`, `temporality`, `delta_prefix_before_window`, arrayReverse(arrayCompact(p -> tupleElement(p, 1), arrayReverse(arraySort(p -> (tupleElement(p, 1), NOT isNaN(tupleElement(p, 2)), tupleElement(p, 2)), window_pairs)))) AS `window_pairs` FROM (SELECT `Attributes`, `temporality`, `delta_prefix_before_window`, arrayFilter(p -> tupleElement(p, 1) > parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) - toIntervalNanosecond(300000000000) AND tupleElement(p, 1) <= parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9), series_array) AS `window_pairs` FROM (SELECT `w`.`Attributes` AS `Attributes`, `w`.`series_array` AS `series_array`, `w`.`temporality` AS `temporality`, `p`.`delta_prefix_before_window` AS `delta_prefix_before_window` FROM (SELECT `Attributes`, arraySort(groupArray((`TimeUnix`, `Value`))) AS `series_array`, any(`AggregationTemporality`) AS `temporality` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value`, `AggregationTemporality` AS `AggregationTemporality` FROM (SELECT * FROM `otel_metrics_sum` PREWHERE (`MetricName` IN (?, ?, ?)) WHERE not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) GROUP BY `Attributes`) AS w LEFT JOIN (SELECT `Attributes` AS `delta_prefix_key_0`, sum(`Value`) AS `delta_prefix_before_window` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value`, `AggregationTemporality` AS `AggregationTemporality` FROM (SELECT * FROM `otel_metrics_sum` PREWHERE (`MetricName` IN (?, ?, ?)) WHERE not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` <= parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` > parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) - toIntervalNanosecond(300000000000) - toIntervalNanosecond(86400000000000) AND (SELECT max(`AggregationTemporality` = 1) FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value`, `AggregationTemporality` AS `AggregationTemporality` FROM (SELECT * FROM `otel_metrics_sum` PREWHERE (`MetricName` IN (?, ?, ?)) WHERE not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9)) GROUP BY `Attributes`) AS p ON `w`.`Attributes` = `p`.`delta_prefix_key_0`))))) WHERE length(`window_vals`) >= 2)) WHERE isNotNull(toFloat64OrNull(`Attributes`[?]))) GROUP BY `gkey_0`, `_hq_ts`))))))))))
