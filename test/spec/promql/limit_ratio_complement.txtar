-- query.promql --
limit_ratio(-0.5, up)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job', 'api', 'instance', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 0.1),
    ('up', map('job', 'api', 'instance', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 0.5),
    ('up', map('job', 'web', 'instance', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 0.3),
    ('up', map('job', 'web', 'instance', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 0.8),
    ('up', map('job', 'db', 'instance', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 0.2),
    ('up', map('job', 'db', 'instance', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 0.6);
-- expected_rows --
[
  ["up", {"instance": "a", "job": "api"}, "2026-01-01T00:00:00Z", 0.1],
  ["up", {"instance": "a", "job": "db"}, "2026-01-01T00:00:00Z", 0.2],
  ["up", {"instance": "a", "job": "web"}, "2026-01-01T00:00:00Z", 0.3]
]
-- args --
[0] string = "service.name"
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = ""
[5] string = "service_name"
[6] string = "up"
[7] string = "2026-01-01 00:00:01.000000000"
[8] int64 = 9
[9] string = "2026-01-01 00:00:01.000000000"
[10] int64 = 9
[11] int64 = 300000000000
[12] float64 = 1.8446744073709552e+19
[13] float64 = 0.5
-- chplan --
Filter predicate=((FnToFloat64(FnXxHash64(FnArrayStringConcat(FnArrayMap(k -> FnConcat(FnToString(FnChar(FnLength(k))), FnToString(k), FnToString(FnChar(FnLength(FnMapMerge(Attributes, FnMap("__name__", MetricName))[k]))), FnToString(FnMapMerge(Attributes, FnMap("__name__", MetricName))[k])), FnArraySort(FnMapKeys(FnMapMerge(Attributes, FnMap("__name__", MetricName)))))))) / 1.8446744073709552e+19) >= 0.5)
  Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
    Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnMax(TimeUnix) AS lwr_ts, FnArgMax(Value, TimeUnix) AS lwr_value]
      Filter predicate=((TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9)) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
        Project [MetricName AS MetricName, mapSort(FnMapMerge(FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
          Filter predicate=(MetricName = "up")
            Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- sql --
SELECT * FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `lwr_ts` AS `TimeUnix`, `lwr_value` AS `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, max(`TimeUnix`) AS `lwr_ts`, argMax(`Value`, `TimeUnix`) AS `lwr_value` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') PREWHERE (`MetricName` = ?))) WHERE ((`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?))))) GROUP BY `MetricName`, `Attributes`)) WHERE ((toFloat64(xxHash64(arrayStringConcat(arrayMap(k -> concat(toString(char(length(k))), toString(k), toString(char(length(mapConcat(`Attributes`, map('__name__', `MetricName`))[k]))), toString(mapConcat(`Attributes`, map('__name__', `MetricName`))[k])), arraySort(mapKeys(mapConcat(`Attributes`, map('__name__', `MetricName`)))))))) / toFloat64(?)) >= toFloat64(?))
