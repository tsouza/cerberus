# `or` in range mode whose arms are ClickHouse-native
# timeSeriesRateToGrid windows (chplan.RangeWindowNative), the shape the
# `experimental_ts_grid_range` section opts into.
#
# RangeWindowNative emits the same derived `(group keys…, anchor_ts,
# value)` schema as the fan-out matrix RangeWindow: `MetricName` never
# exists in that scope, and the per-anchor timestamp is the `anchor_ts`
# column rather than the instant-mode `now64()` synthesis. The set-op
# emitter's canonical-shape projection therefore has to synthesise the
# metric name as the empty string and read the timestamp from the grid
# column, exactly as the fan-out arms do.
#
# The two arms carry different `job` labels, so their signatures never
# collide and `or` returns every point both arms produce — this fixture
# pins the derived-shape projection, not the match key.
#
# Both series are perfect counters, so rate() is flat once the window
# holds two samples. The 5m lookback is half-open (`t - 5m < s <= t`),
# so anchor 00:00 sees a single sample and yields no rate at all, and
# anchor 00:05 drops the 00:00 sample. Prometheus extrapolates a
# counter back to its zero point, which is exactly the series start
# here, so the early anchors report the un-extrapolated slope over the
# samples actually present:
#
#   00:01  60/300s  00:02 120/300s  00:03 180/300s  00:04 240/300s
#
# and 00:05, whose window starts after the zero point, extrapolates the
# 00:01-00:05 delta across the full 5m to the true 1.0/s slope.

-- query.promql --
rate(demo_native_a_total[5m]) or rate(demo_native_b_total[5m])
-- range_step --
1m
-- experimental_ts_grid_range --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('demo_native_a_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 0.0),
    ('demo_native_a_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 60.0),
    ('demo_native_a_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 120.0),
    ('demo_native_a_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 180.0),
    ('demo_native_a_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 240.0),
    ('demo_native_a_total', map('job', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 300.0),
    ('demo_native_b_total', map('job', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 0.0),
    ('demo_native_b_total', map('job', 'web'), toDateTime64('2026-01-01 00:01:00', 9), 30.0),
    ('demo_native_b_total', map('job', 'web'), toDateTime64('2026-01-01 00:02:00', 9), 60.0),
    ('demo_native_b_total', map('job', 'web'), toDateTime64('2026-01-01 00:03:00', 9), 90.0),
    ('demo_native_b_total', map('job', 'web'), toDateTime64('2026-01-01 00:04:00', 9), 120.0),
    ('demo_native_b_total', map('job', 'web'), toDateTime64('2026-01-01 00:05:00', 9), 150.0);
