-- parity_exempt --
reason: no-comparable-oracle
detail: Same as exemplars_basic.txtar — a SQL-only golden with no query.promql section, pinning the UNION ALL fan-out across the histogram/sum/gauge Exemplars arrays for the /api/v1/query_exemplars-style endpoint. There is no PromQL expression to feed a reference PromQL engine and no exemplar-list comparator in RunParity's endpoint vocabulary.
-- sql --
(SELECT `MetricName`, `Attributes`, `ServiceName`, ts[i] AS `Timestamp`, val[i] AS `Value`, tid[i] AS `TraceID`, sid[i] AS `SpanID`, attrs_arr[i] AS `ExemplarAttributes` FROM (SELECT `MetricName`, `Attributes`, `ServiceName`, `Exemplars`.`TimeUnix` AS `ts`, `Exemplars`.`Value` AS `val`, `Exemplars`.`TraceId` AS `tid`, `Exemplars`.`SpanId` AS `sid`, `Exemplars`.`FilteredAttributes` AS `attrs_arr`, arrayJoin(arrayEnumerate(`Exemplars`.`TimeUnix`)) AS `i` FROM `otel_metrics_histogram` WHERE (`MetricName` = ?) AND `TimeUnix` >= parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) AND `TimeUnix` <= parseDateTime64BestEffort('2026-01-01 01:00:00.000000000Z', 9) AND length(`Exemplars`.`TimeUnix`) > 0)) UNION ALL (SELECT `MetricName`, `Attributes`, `ServiceName`, ts[i] AS `Timestamp`, val[i] AS `Value`, tid[i] AS `TraceID`, sid[i] AS `SpanID`, attrs_arr[i] AS `ExemplarAttributes` FROM (SELECT `MetricName`, `Attributes`, `ServiceName`, `Exemplars`.`TimeUnix` AS `ts`, `Exemplars`.`Value` AS `val`, `Exemplars`.`TraceId` AS `tid`, `Exemplars`.`SpanId` AS `sid`, `Exemplars`.`FilteredAttributes` AS `attrs_arr`, arrayJoin(arrayEnumerate(`Exemplars`.`TimeUnix`)) AS `i` FROM `otel_metrics_sum` WHERE (`MetricName` = ?) AND `TimeUnix` >= parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) AND `TimeUnix` <= parseDateTime64BestEffort('2026-01-01 01:00:00.000000000Z', 9) AND length(`Exemplars`.`TimeUnix`) > 0)) UNION ALL (SELECT `MetricName`, `Attributes`, `ServiceName`, ts[i] AS `Timestamp`, val[i] AS `Value`, tid[i] AS `TraceID`, sid[i] AS `SpanID`, attrs_arr[i] AS `ExemplarAttributes` FROM (SELECT `MetricName`, `Attributes`, `ServiceName`, `Exemplars`.`TimeUnix` AS `ts`, `Exemplars`.`Value` AS `val`, `Exemplars`.`TraceId` AS `tid`, `Exemplars`.`SpanId` AS `sid`, `Exemplars`.`FilteredAttributes` AS `attrs_arr`, arrayJoin(arrayEnumerate(`Exemplars`.`TimeUnix`)) AS `i` FROM `otel_metrics_gauge` WHERE (`MetricName` = ?) AND `TimeUnix` >= parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) AND `TimeUnix` <= parseDateTime64BestEffort('2026-01-01 01:00:00.000000000Z', 9) AND length(`Exemplars`.`TimeUnix`) > 0))
-- args --
[0] string = "http_request_duration_seconds"
[1] string = "http_request_duration_seconds_count"
[2] string = "http_request_duration_seconds_count"
