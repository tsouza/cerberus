Array(FnArrayMap(wv -> FnArrayMap(wo -> (FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wv) - wsr[1]), FnArraySum(FnArrayMap((p, c) -> FnIf((c < p), c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr)))), FnArray(FnArraySort((c, t) -> t, wv, wo)))[1] * FnArrayMap(wcv -> FnArrayMap(wso -> FnArrayMap(wsi -> FnArrayMap(wag -> FnArrayMap(wtc -> FnArrayMap(wrc -> FnIf((wsi > 0), (((wsi + FnIf((FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc) < wtc), FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc), wtc)) + FnIf(((FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], anchor_ts)) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], anchor_ts)) / 1e+09))) / wsi), 1), FnArray(FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wcv) - wsr[1]), FnArraySum(FnArrayMap((p, c) -> FnIf((c < p), c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr)))), FnArray(FnArraySort((c, t) -> t, wcv, wo)))[1]))[1], FnArray(FnIf(((FnToFloat64(FnDateDiff("nanosecond", (anchor_ts - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", (anchor_ts - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09))))[1], FnArray((wsi / (FnLength(wo) - 1))))[1], FnArray((FnToFloat64(FnDateDiff("nanosecond", wso[1], wso[FnLength(wso)])) / 1e+09)))[1], FnArray(FnArraySort(wo)))[1], FnArray(wv))[1]), FnArray(_hq_ts_list))[1], FnArray(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list)))[1]))), FnArray(FnArrayFilter((kwx, kwf) -> kwf, kwb, kws)))[1], FnArray(FnArrayMap((kwd, kwi) -> ((kwi = 1) OR (kwd != 0)), FnArrayDifference(kwb), FnArrayEnumerate(kwb))))[1], FnArray(FnArraySort((kwx, kwk, kwi) -> FnTuple(kwk, kwi), kweb, kweb, FnArrayEnumerate(kweb))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 3), kwe))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 2), kwe))))[1], FnArray(FnArrayFlatten(FnArrayMap(kwx -> FnTupleElement(kwx, 1), kwe))))[1], FnArray(FnArrayMap((bs, cs, kwrt) -> FnArrayMap(kreb -> FnArrayMap(krev -> FnArrayMap(krb -> FnArrayMap(krs -> FnArrayMap(kru -> FnTuple(kru, FnArrayCumSum(FnArrayMap(krr -> FnArraySum(krr), FnArraySplit((krx, krf) -> krf, FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), krev, kreb, FnArrayEnumerate(kreb)), krs))), FnArrayWithConstant(FnLength(kru), kwrt)), FnArray(FnArrayFilter((krx, krf) -> krf, krb, krs)))[1], FnArray(FnArrayMap((krd, kri) -> ((kri = 1) OR (krd != 0)), FnArrayDifference(krb), FnArrayEnumerate(krb))))[1], FnArray(FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), kreb, kreb, FnArrayEnumerate(kreb))))[1], FnArray(FnArrayFilter((krrc, krrb) -> FnNot((FnIsNaN(krrb) OR FnIsInfinite(krrb))), FnArrayMap(krrc -> FnToFloat64(krrc), FnArraySlice(cs, 1, FnLength(bs))), bs)))[1], FnArray(FnArrayFilter(krx -> FnNot((FnIsNaN(krx) OR FnIsInfinite(krx))), bs)))[1], _hq_bounds_list, _hq_counts_list, _hq_ts_list)))[1] AS _hq_window_ladder]
                RangeBucketFanout step=30s lookback=5m0s minSamples=2 groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list, FnGroupArray(TimeUnix) AS _hq_ts_list, FnAny(AggregationTemporality) AS _hq_temporality] peakIndependentOfGrid start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
                  Project [TimeUnix AS TimeUnix, ResourceAttributes AS ResourceAttributes, FnMapSort(Attributes) AS Attributes, ServiceName AS ServiceName, ExplicitBounds AS ExplicitBounds, BucketCounts AS BucketCounts, AggregationTemporality AS AggregationTemporality]
                    Filter predicate=((MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration")) AND FnNot((FnBitAnd(Flags, 1) != 0)))
                      Scan(otel_metrics_histogram)
-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, `anchor_ts` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, if(length(`BucketCounts`) = 0, nan, if(`_cerb_hqc_observations` = 0, nan, if(0.95 < 0, -inf, if(0.95 > 1, inf, if(`_cerb_hqc_idx` = length(`_cerb_hqc_cum`) AND length(`_cerb_hqc_buckets`) != length(`ExplicitBounds`), if(length(`ExplicitBounds`) = 0, nan, `_cerb_hqc_bounds`[length(`_cerb_hqc_bounds`)]), if(`_cerb_hqc_idx` = 1 AND `_cerb_hqc_bounds`[1] <= 0, `_cerb_hqc_bounds`[1], (if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1]) + (`_cerb_hqc_bounds`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1])) * (((0.95 * `_cerb_hqc_observations`) - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])) / (`_cerb_hqc_cum`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])))))))))) AS `Value` FROM (SELECT *, arrayFirstIndex(c -> c >= (0.95 * `_cerb_hqc_observations`), `_cerb_hqc_cum`) AS `_cerb_hqc_idx` FROM (SELECT *, `_cerb_hqc_cum`[length(`_cerb_hqc_cum`)] AS `_cerb_hqc_observations` FROM (SELECT *, arrayFilter((b, k) -> k, `ExplicitBounds`, `_cerb_hqc_kept_mask`) AS `_cerb_hqc_bounds`, arrayFilter((c, k) -> k, arrayResize(`_cerb_hqc_buckets`, greatest(length(`_cerb_hqc_buckets`), length(`ExplicitBounds`))), arrayConcat(`_cerb_hqc_kept_mask`, arrayWithConstant(greatest(length(`_cerb_hqc_buckets`) - length(`ExplicitBounds`), 0), 1))) AS `_cerb_hqc_cum` FROM (SELECT *, arrayMap((b, p) -> b != p, `ExplicitBounds`, arraySlice(arrayPushFront(`ExplicitBounds`, nan), 1, length(`ExplicitBounds`))) AS `_cerb_hqc_kept_mask`, arrayMap(x -> toFloat64(x), `BucketCounts`) AS `_cerb_hqc_buckets` FROM (SELECT `_cerb_histogram_input`.1 AS `anchor_ts`, `_cerb_histogram_input`.2 AS `Attributes`, `_cerb_histogram_input`.3 AS `BucketCounts`, `_cerb_histogram_input`.4 AS `ExplicitBounds` FROM (SELECT arrayJoin([(`anchor_