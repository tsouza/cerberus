    RangeWindow func=count_over_time range=5m0s step=0s ts=anchor_ts value=Value timeShiftMillis=-4999999920000 groupBy=[Attributes] start=0001-01-01T00:00:00Z end=2128-06-11T08:54:40Z distinctSampleRows
