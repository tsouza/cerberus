SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64(?) AS `Value`, toFloat64(`HistogramCount`) AS `HistogramCount`, toFloat64(`HistogramSum`) AS `HistogramSum`, toInt32(`HistogramScale`) AS `HistogramScale`, toFloat64(`HistogramZeroThreshold`) AS `HistogramZeroThreshold`, toFloat64(`HistogramZeroCount`) AS `HistogramZeroCount`, toInt32(`HistogramPositiveOffset`) AS `HistogramPositiveOffset`, arrayMap(x -> toFloat64(x), `HistogramPositiveBucketCounts`) AS `HistogramPositiveBucketCounts`, toInt32(`HistogramNegativeOffset`) AS `HistogramNegativeOffset`, arrayMap(x -> toFloat64(x), `HistogramNegativeBucketCounts`) AS `HistogramNegativeBucketCounts` FROM (SELECT `gkey_0` AS `Attributes`, arrayElement(`_hq_eq_MetricName_l`, ?) AS `MetricName`, arrayElement(`_hq_eq_HistogramScale_l`, ?) AS `HistogramScale`, arrayElement(`_hq_eq_HistogramCount_l`, ?) AS `HistogramCount`, arrayElement(`_hq_eq_HistogramSum_l`, ?) AS `HistogramSum`, arrayElement(`_hq_eq_HistogramZeroCount_l`, ?) AS `HistogramZeroCount`, arrayElement(`_hq_eq_HistogramZeroThreshold_l`, ?) AS `HistogramZeroThreshold`, arrayElement(`_hq_eq_HistogramPositiveOffset_l`, ?) AS `HistogramPositiveOffset`, arrayElement(`_hq_eq_HistogramPositiveBucketCounts_l`, ?) AS `HistogramPositiveBucketCounts`, arrayElement(`_hq_eq_HistogramNegativeOffset_l`, ?) AS `HistogramNegativeOffset`, arrayElement(`_hq_eq_HistogramNegativeBucketCounts_l`, ?) AS `HistogramNegativeBucketCounts` FROM (SELECT `Attributes` AS `gkey_0`, groupArrayIf(`MetricName`, (`_hq_eq_side` = ?)) AS `_hq_eq_MetricName_l`, groupArrayIf(`HistogramScale`, (`_hq_eq_side` = ?)) AS `_hq_eq_HistogramScale_l`, groupArrayIf(`HistogramScale`, (`_hq_eq_side` = ?)) AS `_hq_eq_HistogramScale_r`, groupArrayIf(`HistogramCount`, (`_hq_eq_side` = ?)) AS `_hq_eq_HistogramCount_l`, groupArrayIf(`HistogramCount`, (`_hq_eq_side` = ?)) AS `_hq_eq_HistogramCount_r`, groupArrayIf(`HistogramSum`, (`_hq_eq_side` = ?)) AS `_hq_eq_HistogramS