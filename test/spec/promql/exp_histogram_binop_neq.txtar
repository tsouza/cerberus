-- query.promql --
http_server_duration_exp_hist != http_client_duration_exp_hist
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- Binary `!=` between two DIFFERENT exp-histogram metrics — the
-- structural-equality filter's negated twin (see
-- exp_histogram_binop_eq.txtar for the shared mechanics). Reference's
-- `!hlhs.Equals(hrhs)` keeps exactly the pairs `==` drops, and the
-- surviving row's VALUE is STILL `hlhs` (LHS) unchanged — even though
-- the two operands disagree, the answer always echoes the LEFT side's
-- own histogram, never a merge of the two.
--
--   `same`: server and client publish IDENTICAL rows — `Equals` is
--   true, so `!=` drops the row (the mirror image of the `==` fixture
--   keeping it).
--
--   `diff`: server and client disagree on every field, including
--   Scale — `Equals` is false, so `!=` keeps the row with the SERVER's
--   (LHS) own values: Count=6, Sum=42.5, Scale=0, ZeroCount=1,
--   PositiveOffset=0, PositiveBucketCounts=[1,2,3], NegativeBucketCounts=[]
--   — the client's [9,9]-bucket row never appears in the output.
--
--   `server_only` exists on ONE side only — dropped by the default
--   one-to-one V-V join before `Equals` is ever evaluated, regardless
--   of operator.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('series', 'same'),        toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 1, 0, [1, 2, 3], 0, []),
    ('http_client_duration_exp_hist', map('series', 'same'),        toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 1, 0, [1, 2, 3], 0, []),
    ('http_server_duration_exp_hist', map('series', 'diff'),        toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 1, 0, [1, 2, 3], 0, []),
    ('http_client_duration_exp_hist', map('series', 'diff'),        toDateTime64('2026-01-01 00:00:00', 9), 9, 10.5, 1, 2, 0, [9, 9],    0, []),
    ('http_server_duration_exp_hist', map('series', 'server_only'), toDateTime64('2026-01-01 00:00:00', 9), 4, 0.4,  0, 0, 0, [7],       0, []);
-- expected_rows --
[
  ["http_server_duration_exp_hist", {"series": "diff"}, "2026-01-01T00:00:01Z", 0, 6, 42.5, 0, 0, 1, 0, [1,2,3], 0, []]
]
