# A nullable duplicate-name carrier with no non-empty ancestor of its own.
# The mandatory alternation enters exactly one non-repeated branch. Its second
# branch is non-empty, so an empty synthetic sibling probe proves that the
# first branch, and therefore its empty carrier, took part. #1956 tracks the
# remaining repeated and greedy-empty shapes this mechanism cannot prove.

-- query.promql --
label_replace(temperature, "service", "svc-$dup", "host", "(?:(?P<dup>a?)|(?P<dup>b))(?P<dup>c)")
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('temperature', map('host', 'c'), toDateTime64('2026-01-01 00:00:00', 9), 19.5),
    ('temperature', map('host', 'ac'), toDateTime64('2026-01-01 00:00:00', 9), 21.5),
    ('temperature', map('host', 'bc'), toDateTime64('2026-01-01 00:00:00', 9), 22.5);
