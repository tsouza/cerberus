# One series (host=a) that reports under bounds [1,2,3] early in the window
# and switches to bounds [10,20,30] mid-window — the layout-merge union-bounds
# case, now reached through the per-series `rate` window reduction rather
# than a single reading. Each layout gets its own zero baseline (23:59:00 /
# 23:59:30) so the window delta for that layout is the later real sample
# read directly: [1,2,3]-bounds delta [4,4,4] (u<=1,2,3 all see count 4),
# [10,20,30]-bounds delta [0,6,6] (only u=20,30 see the row's 6).
#
# Union bounds [1,2,3,10,20,30]: the [1,2,3] delta contributes only at
# u in {1,2,3} (4,4,4) and the [10,20,30] delta only at u in {10,20,30}
# (0,6,6) — each layout's rows are ABSENT (not zero) outside their own
# bounds, per classicBucketMergedLadderExpr's arrayFilter. Ladder before
# repair: [4,4,4,0,6,6,+Inf=6] — DIPS from 4 to 0, which the monotonic
# repair (prefix-max) lifts to [4,4,4,4,6,6,6]. rank = 0.5*6 = 3, first
# rung >= 3 is the FIRST bucket (bound=1, rung=4): value = 1*(3/4) = 0.75,
# hand-verified against Prometheus's own histogram_quantile interpolation.
-- query.promql --
histogram_quantile(0.5, sum by(le) (rate(http_server_request_duration_bucket[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), [0, 0, 0, 0], [1.0, 2.0, 3.0]),
    ('http_server_request_duration', map('host', 'a'), toDateTime64('2025-12-31 23:59:30', 9), [0, 0, 0, 0], [10.0, 20.0, 30.0]),
    ('http_server_request_duration', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), [4, 0, 0, 0], [1.0, 2.0, 3.0]),
    ('http_server_request_duration', map('host', 'a'), toDateTime64('2026-01-01 00:00:01', 9), [0, 6, 0, 0], [10.0, 20.0, 30.0]);

