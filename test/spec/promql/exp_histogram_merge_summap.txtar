-- query.promql --
sum(http_server_duration_exp_hist)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- experimental_exp_histogram_merge_summap --
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- The chopt.FeatureExpHistogramMergeSumMap counterpart of
-- exp_histogram_sum_mixed_scale.txtar's SIBLING shape (the identical
-- query, seed and mixed-Scale merge): byte-identical query and seed, but
-- the `experimental_exp_histogram_merge_summap` marker section opts the
-- fixture into promql.NativeExpHistogramMergeLowerer, so the cross-series
-- merge (histogram_native_sum.go's expHistogramGroupMergedInstant) renders
-- as a two-pass sumMap-keyed reshape (exp_histogram_merge_summap.go)
-- instead of the groupArray + arrayReduce/arraySlice picker fold.
--
-- Two series at DIFFERENT Scales exercises the downscale COLLAPSE case
-- (the `fine` series's Scale-1 buckets folding pairwise onto the `coarse`
-- series's Scale-0 layout) through the sumMap path's own row-level
-- downscaled-index keying, not just the fanout path's arraySlice picker.
-- expected_rows below is IDENTICAL to exp_histogram_sum_mixed_scale.txtar's
-- own — that identity is the point (cerberus issue #2757's own
-- differential proof, pinned directly against chDB in
-- exp_histogram_merge_summap_chdb_test.go's
-- TestExpHistogramMergeSumMapDifferential_ScaleNegotiation).
--
-- This is the [promql.ExpHistogramMergeLowerer] entry in the spec lane's
-- native-strategy coverage ratchet
-- (TestNativeStrategies_CoverEveryRangeLowerersField /
-- TestNativeStrategies_HaveNativeSideFixtures), not a new numeric case.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('series', 'fine'),   toDateTime64('2026-01-01 00:00:00', 9), 10, 1.0, 1, 0, 0, [1, 2, 3, 4], 0, []),
    ('http_server_duration_exp_hist', map('series', 'coarse'), toDateTime64('2026-01-01 00:00:00', 9), 15, 2.0, 0, 0, 0, [5, 10],      0, []);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 0, 25, 3, 0, 0, 0, 0, [8,17], 0, []]
]
