# histogram_quantile(phi, rate(<classic histogram>_bucket[range])) over a
# DELTA-temporality (AggregationTemporality = 1) classic histogram: each
# stored row's BucketCounts is already the per-window observation count,
# not a cumulative-since-start total. The window's per-bucket total is the
# SUM of the window's samples' counts EXCLUDING the earliest-in-time one,
# not their Prometheus counter-reset-aware difference — see
# counterIncreaseFold and issue #1628. The earliest sample's own count
# already covers the observation window ENDING at (and so starting before)
# its own timestamp, the same coverage a CUMULATIVE reading's `last -
# first` telescoping diff would otherwise reconstruct from a running total
# — summing it too would double-count that leading interval.
#
# ExplicitBounds [1.0, 5.0] give three rungs (<=1.0, <=5.0, +Inf).
# Per-sample BucketCounts:
#   23:59:02 -> [1, 1, 0]  (2 observations this sample's own window; EARLIEST, excluded)
#   00:00:00 -> [2, 1, 1]  (4 observations this sample's own window)
# Summed per bucket, excluding the earliest sample: [2, 1, 1] (with exactly
# two samples this telescopes to just the later one); cumulative ladder
# [2, 3, 4], total 4. phi=0.5 targets rank 2, landing exactly at the first
# rung's cumulative count — bucket_count_basic.txtar's neighbouring
# CUMULATIVE-default fixtures exercise the reset-rule branch over the same
# shape of query, so this fixture is the direct DELTA-vs-CUMULATIVE
# comparison point.
-- query.promql --
histogram_quantile(0.5, rate(http_latency_bucket[1m]))
-- seed --
CREATE TABLE otel_metrics_histogram (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    (1, 'http_latency', map('job', 'api'), toDateTime64('2025-12-31 23:59:02', 9), 2, 1.5, [1, 1, 0], [1.0, 5.0]),
    (1, 'http_latency', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 4, 3.0, [2, 1, 1], [1.0, 5.0]);
-- expected_rows --
[
  ["", {"job": "api"}, "2026-01-01T00:00:01Z", 1]
]
