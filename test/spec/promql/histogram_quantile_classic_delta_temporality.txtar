[32] int64 = 60000000000
[33] int64 = 2
-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, now64(9) AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.5 cumulative groupBy=[Attributes AS Attributes]
    Project [Attributes AS Attributes, arrayMap(i -> arrayMax(arraySlice(_hq_ladder, 1, i)), arrayEnumerate(_hq_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
      Project [gkey_0 AS Attributes, arrayConcat(arrayMap(u -> arraySum(arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((b <= u), toFloat64(c), 0), bs, arraySlice(cs, 1, length(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)), arraySort(arrayDistinct(arrayFlatten(_hq_bounds_list)))), array(arraySum(arrayMap(cs -> toFloat64(arraySum(cs)), _hq_counts_list)))) AS _hq_ladder, arraySort(arrayDistinct(arrayFlatten(_hq_bounds_list))) AS ExplicitBounds]
        Aggregate groupBy=[Attributes AS gkey_0] funcs=[groupArray(ExplicitBounds) AS _hq_bounds_list, groupArray(BucketCounts) AS _hq_counts_list]
          Project [Attributes AS Attributes, arrayMap(j -> if((j = 1), _hq_window_ladder[j], (_hq_window_ladder[j] - _hq_window_ladder[(j - 1)])), arrayEnumerate(_hq_window_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
            Project [Attributes AS Attributes, arrayConcat(arrayMap(u -> if((_hq_temporality = 1), (arraySum(arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((b <= u), toFloat64(c), 0), bs, arraySlice(cs, 1, length(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)) - arraySort((c, t) -> t, arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((b <= u), toFloat64(c), 0), bs, arraySlice(cs, 1, length(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list), arrayFilter((t, pbs) -> has(pbs, u), _hq_ts_list, _hq_bounds_list))[1]), arraySum(arrayMap((p, c) -> if((c < p), c, (c - p)), arrayPopBack(arraySort((c, t) -> t, arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((b <= u), toFloat64(c), 0), bs, arraySlice(cs, 1, length(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list), arrayFilter((t, pbs) -> has(pbs, u), _hq_ts_list, _hq_bounds_list))), arrayPopFront(arraySort((c, t) -> t, arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((b <= u), toFloat64(c), 0), bs, arraySlice(cs, 1, length(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list), arrayFilter((t, pbs) -> has(pbs, u), _hq_ts_list, _hq_bounds_list)))))), arraySort(arrayDistinct(arrayFlatten(_hq_bounds_list)))), array(if((_hq_temporality = 1), (arraySum(arrayMap(cs -> toFloat64(arraySum(cs)), _hq_counts_list)) - arraySort((c, t) -> t, arrayMap(cs -> toFloat64(arraySum(cs)), _hq_counts_list), _hq_ts_list)[1]), arraySum(arrayMap((p, c) -> if((c < p), c, (c - p)), arrayPopBack(arraySort((c, t) -> t, arrayMap(cs -> toFloat64(arraySum(cs)), _hq_counts_list), _hq_ts_list)), arrayPopFront(arraySort((c, t) -> t, arrayMap(cs -> toFloat64(arraySum(cs)), _hq_counts_list), _hq_ts_list))))))) AS _hq_window_ladder, arraySort(arrayDistinct(arrayFlatten(_hq_bounds_list))) AS ExplicitBounds]
              Filter predicate=(_hq_samples >= 2)
                Aggregate groupBy=[mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes] funcs=[groupArray(ExplicitBounds) AS _hq_bounds_list, groupArray(BucketCounts) AS _hq_counts_list, groupArray(TimeUnix) AS _hq_ts_list, any(AggregationTemporality) AS _hq_temporality, uniqExact(TimeUnix) AS _hq_samples]
                  Filter predicate=(((MetricName IN ("http_latency", "http.latency", "http/latency")) AND (TimeUnix <= toDateTime64("2026-01-01 00:00:01.000000000", 9))) AND (TimeUnix > (toDateTime64("2026-01-01 00:00:01.000000000", 9) - toIntervalNanosecond(60000000000))))
                    Scan(otel_metrics_histogram)
