-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.5 cumulative groupBy=[anchor_ts AS anchor_ts, Attributes AS Attributes]
    Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(kpl -> FnArrayMap(kpr -> FnArrayMap(kpm -> FnArrayFill((kpv, kpk) -> kpk, kpl, FnArrayMap((kpa, kpb) -> ((kpa > 0) AND (kpa = kpb)), kpr, kpm)), FnArray(FnArrayMap((kpa, kpb) -> (kpa + kpb), kpr, FnArrayCumSumNonNegative(FnArrayMap(kpd -> (0 - kpd), FnArrayDifference(kpr))))))[1], FnArray(FnArrayMap((kpa, kpv) -> FnIf(FnIsNaN(kpv), 0, FnToInt64(kpa)), FnArraySort((kpk, kpp) -> kpp, FnArrayEnumerate(kpl), FnArraySort((kpi, kpv) -> FnTuple(kpv, (0 - kpi)), FnArrayEnumerate(kpl), kpl)), kpl)))[1], FnArray(FnTupleElement(_hq_merged, 2)))[1] AS BucketCounts, FnTupleElement(_hq_merged, 1) AS ExplicitBounds]
      Project [anchor_ts AS anchor_ts, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnArrayMap(kme -> FnArrayMap(kmeb -> FnArrayMap(kmev -> FnArrayMap(kmb -> FnArrayMap(kms -> FnArrayMap(kmu -> FnTuple(kmu, FnArrayConcat(FnArrayMap(kmr -> FnArraySum(kmr), FnArraySplit((kmx, kmf) -> kmf, FnArraySort((kmx, kmk, kmi) -> FnTuple(kmk, kmi), kmev, kmeb, FnArrayEnumerate(kmeb)), kms)), FnArray(FnArraySum(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list))))), FnArray(FnArrayFilter((kmx, kmf) -> kmf, kmb, kms)))[1], FnArray(FnArrayMap((kmd, kmi) -> ((kmi = 1) OR (kmd != 0)), FnArrayDifference(kmb), FnArrayEnumerate(kmb))))[1], FnArray(FnArraySort((kmx, kmk, kmi) -> FnTuple(kmk, kmi), kmeb, kmeb, FnArrayEnumerate(kmeb))))[1], FnArray(FnArrayFlatten(FnArrayMap(kmx -> FnTupleElement(kmx, 2), kme))))[1], FnArray(FnArrayFlatten(FnArrayMap(kmx -> FnTupleElement(kmx, 1), kme))))[1], FnArray(FnArrayMap((bs, cs) -> FnArrayMap(kreb -> FnArrayMap(krev -> FnArrayMap(krb -> FnArrayMap(krs -> FnArrayMap(kru -> FnTuple(kru, FnArrayCumSum(FnArrayMap(krr -> FnArraySum(krr), FnArraySplit((krx, krf) -> krf, FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), krev, kreb, FnArrayEnumerate(kreb)), krs)))), FnArray(FnArrayFilter((krx, krf) -> krf, krb, krs)))[1], FnArray(FnArrayMap((krd, kri) -> ((kri = 1) OR (krd != 0)), FnArrayDifference(krb), FnArrayEnumerate(krb))))[1], FnArray(FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), kreb, kreb, FnArrayEnumerate(kreb))))[1], FnArray(FnArrayFilter((krrc, krrb) -> FnNot((FnIsNaN(krrb) OR FnIsInfinite(krrb))), FnArrayMap(krrc -> FnToFloat64(krrc), FnArraySlice(cs, 1, FnLength(bs))), bs)))[1], FnArray(FnArrayFilter(krx -> FnNot((FnIsNaN(krx) OR FnIsInfinite(krx))), bs)))[1], _hq_bounds_list, _hq_counts_list)))[1] AS _hq_merged]
        Aggregate groupBy=[anchor_ts AS anchor_ts] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list] dropEmptyOnNoGroup
          Project * REPLACE [FnArraySlice(ExplicitBounds, 1, (FnLength(ExplicitBounds) + FnThrowIf((FnSum((FnLength(ExplicitBounds) + 1)) OVER (PARTITION BY []) > 2982616), "classic-histogram bucket merge exceeds the merged-bucket-entry resource bound"))) AS ExplicitBounds, FnArraySlice(BucketCounts, 1, (FnLength(BucketCounts) + FnThrowIf((FnSum((FnLength(ExplicitBounds) + 1)) OVER (PARTITION BY []) > 2982616), "classic-histogram bucket merge exceeds the merged-bucket-entry resource bound"))) AS BucketCounts]
