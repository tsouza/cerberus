# The native classic-histogram ladder against the per-series two-sample floor
# `rate` imposes — the semantic the fan-out spells as
# chplan.RangeBucketFanout.MinSamples (a `HAVING uniqExact(TimeUnix) >= 2`) and
# the native shape spells as the +Inf rung's own NULL: that rung is reported by
# every stored row, so its sample set IS the series' whole in-window sample set
# and timeSeriesRateToGrid NULLs it exactly when the window holds fewer than
# two samples.
#
# The seed and grid are IDENTICAL to
# histogram_quantile_classic_agg_rate_min_samples.txtar, which is enrolled in
# the Prometheus parity corpus — so the ROW SET here (four anchors, not eleven,
# and at exactly those four timestamps) is checked against reference
# Prometheus, not merely against the fan-out. That row set is what this fixture
# exists to pin, and it is byte-identical to the twin's.
#
# The VALUES are the fixture's second, weaker pin, and three of the four differ
# from the twin's in the last two bits: 0.29999999999999993 /
# 0.30000000000000016 here against 0.30000000000000004 there. Both paths
# compute Prometheus's extrapolatedRate over the same window; they differ only
# in evaluation ORDER (the native aggregate accumulates in compiled C++ and
# divides by the window seconds, which the emitter multiplies back out; the
# fan-out evaluates the same arithmetic as an array expression), and the
# quantile interpolation then divides through the resulting ladder, carrying
# the last-bit difference into the answer.
#
# Two ULP is exactly the band the parity corpus already documents for this
# query class — see [oracle.EqualClassicHistogramRateQuantileValues] and its
# classicHistogramRateQuantileULPTolerance = 2, whose own measured evidence is
# THIS fixture's twin (0.29999999999999993 from reference Prometheus against
# 0.30000000000000004 from the fan-out). The native ladder lands inside the
# same band, on the Prometheus side of it at the 00:00:20 anchor.

-- query.promql --
histogram_quantile(0.5, sum by(le)(rate(http_server_request_duration_bucket[1m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
10s
-- experimental_ts_grid_histogram --
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [0, 0, 0], [0.1, 0.5]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:00:15', 9), [1, 1, 1], [0.1, 0.5]);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:20Z", 0.29999999999999993],
  ["", {}, "2026-01-01T00:00:30Z", 0.30000000000000004],
  ["", {}, "2026-01-01T00:00:40Z", 0.30000000000000016],
  ["", {}, "2026-01-01T00:00:50Z", 0.30000000000000016]
]
