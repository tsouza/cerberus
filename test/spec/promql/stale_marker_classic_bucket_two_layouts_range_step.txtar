            Filter predicate=((TimeUnix >= FnToDateTime64("2025-12-31 23:54:30.000000000", 9)) AND (TimeUnix <= FnToDateTime64("2026-01-01 00:05:00.000000000", 9)))
              Filter predicate=(MetricName IN ("stale_hist", "stale.hist", "stale/hist"))
                Scan(otel_metrics_histogram)
