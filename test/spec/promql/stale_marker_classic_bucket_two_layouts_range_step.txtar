# Seed: the classic histogram `stale_hist` is scraped every 30s. Series
# job="a" carries bounds 1/5; its target disappears behind a NoRecordedValue
# data point (Flags = 1, empty bucket arrays) at 23:59:30 and returns at
# 00:02:00. Series job="b" carries bounds 0.5/2/10 throughout.
#
# Each series' marker takes its own series' layout: job="a" has no bucket
# sample from 00:00:00 to 00:01:30, and job="b"'s 0.5/2/10/+Inf series answer
# at every step.

-- query.promql --
stale_hist_bucket
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64),
    Flags UInt32
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram (MetricName, Attributes, TimeUnix, Count, Sum, BucketCounts, ExplicitBounds, Flags) VALUES
