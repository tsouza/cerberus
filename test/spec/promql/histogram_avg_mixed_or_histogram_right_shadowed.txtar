-- query.promql --
histogram_avg((up or latency_exp_hist))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- cerberus issue #2618: histogram is now the RIGHT operand of `or`, and its
-- ONLY row shares its full label-set signature with the LEFT (float)
-- operand's only row. Reference `or` keeps every LHS row plus only the RHS
-- rows whose signature is absent from LHS -- so this histogram row is
-- SHADOWED and never joins the union at all, and histogram_avg (which reads
-- only the surviving histogram-typed rows) must answer the EMPTY vector.
-- Regression coverage for splitMixedExpHistogramSetOpByType splitting the
-- already-shadow-resolved Mixed union rather than re-deriving each operand
-- independently (which would incorrectly keep this row).
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('service', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 10, 20.0, 0, 0, 0, [1, 2, 3, 4], 0, []);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('service', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 1.0);
