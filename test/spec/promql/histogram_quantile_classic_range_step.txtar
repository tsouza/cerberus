Flatten(FnArrayMap(kwx -> FnTupleElement(kwx, 1), kwe))))[1], FnArray(FnArrayMap((bs, cs, kwrt) -> FnArrayMap(kreb -> FnArrayMap(krev -> FnArrayMap(krb -> FnArrayMap(krs -> FnArrayMap(kru -> FnTuple(kru, FnArrayCumSum(FnArrayMap(krr -> FnArraySum(krr), arraySplit((krx, krf) -> krf, FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), krev, kreb, FnArrayEnumerate(kreb)), krs))), arrayWithConstant(FnLength(kru), kwrt)), FnArray(FnArrayFilter((krx, krf) -> krf, krb, krs)))[1], FnArray(FnArrayMap((krd, kri) -> ((kri = 1) OR (krd != 0)), arrayDifference(krb), FnArrayEnumerate(krb))))[1], FnArray(FnArraySort((krx, krk, kri) -> FnTuple(krk, kri), kreb, kreb, FnArrayEnumerate(kreb))))[1], FnArray(FnArrayFilter((krrc, krrb) -> FnNot((FnIsNaN(krrb) OR FnIsInfinite(krrb))), FnArrayMap(krrc -> FnToFloat64(krrc), FnArraySlice(cs, 1, FnLength(bs))), bs)))[1], FnArray(FnArrayFilter(krx -> FnNot((FnIsNaN(krx) OR FnIsInfinite(krx))), bs)))[1], _hq_bounds_list, _hq_counts_list, _hq_ts_list)))[1] AS _hq_window_ladder]
              RangeBucketFanout step=30s lookback=5m0s minSamples=2 groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list, FnGroupArray(TimeUnix) AS _hq_ts_list, FnAny(AggregationTemporality) AS _hq_temporality] peakIndependentOfGrid start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
                Project [TimeUnix AS TimeUnix, ResourceAttributes AS ResourceAttributes, FnMapSort(Attributes) AS Attributes, ServiceName AS ServiceName, ExplicitBounds AS ExplicitBounds, BucketCounts AS BucketCounts, AggregationTemporality AS AggregationTemporality]
                  Filter predicate=((MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration")) AND FnNot((FnBitAnd(Flags, 1) != 0)))
                    Scan(otel_metrics_histogram)
