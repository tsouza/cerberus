  ["", {}, "2026-01-01T00:02:00Z", 0.95],
  ["", {}, "2026-01-01T00:02:30Z", 0.95],
  ["", {}, "2026-01-01T00:03:00Z", 0.95],
  ["", {}, "2026-01-01T00:03:30Z", 0.95],
  ["", {}, "2026-01-01T00:04:00Z", 0.95],
  ["", {}, "2026-01-01T00:04:30Z", 0.95]
]
