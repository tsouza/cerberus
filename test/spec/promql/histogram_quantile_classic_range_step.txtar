# Range step 30s, eval window 00:00:00..00:05:00 = 11 anchors. Seed places two
# histogram observations, at 00:00:00 and 00:00:30. The lookback predicate
# `TimeUnix > anchor - 5m` is STRICT, so both samples match anchors 00:00:30
# through 04:30 but the 00:00 sample drops out at 05:00 (00:00 > 00:00 fails).
#
# `rate` needs TWO samples in its window, so the 00:00 anchor (which sees only
# the 00:00 sample) and the 05:00 anchor (which sees only the 00:30 one) emit
# nothing at all — reference PromQL returns no point there, not a zero. That
# leaves 9 anchors, 00:00:30 through 00:04:30.
#
# Sum-by-le aggregation collapses Attributes to empty map.
# Two rows of [1,2,3] sum to [2,4,6] with bounds [0.1,0.5,1.0]: cumsum =
# [2,6,12], total = 12. 0.95 * 12 = 11.4. arrayFirstIndex(c->c>=11.4,
# [2,6,12]) = 3 = length(cumsum), so the helper returns the last bound = 1.0
# (Prom +Inf-bucket equivalent).

-- query.promql --
histogram_quantile(0.95, sum by(le)(rate(http_server_request_duration_bucket[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [0, 0, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:00:30', 9), [1, 2, 3], [0.1, 0.5, 1.0]);
