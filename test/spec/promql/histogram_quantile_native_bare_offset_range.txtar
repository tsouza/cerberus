-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  HistogramQuantileNative phi=0.95 groupBy=[anchor_ts AS anchor_ts, Attributes AS Attributes]
    Project [anchor_ts AS anchor_ts, Attributes AS Attributes, Scale AS Scale, ZeroCount AS ZeroCount, PositiveOffset AS PositiveOffset, PositiveBucketCounts AS PositiveBucketCounts, NegativeOffset AS NegativeOffset, NegativeBucketCounts AS NegativeBucketCounts]
      RangeBucketFanout step=1m0s lookback=5m0s offset=5m0s groupBy=[mapSort(Attributes) AS Attributes] funcs=[argMax(Scale, TimeUnix) AS Scale, argMax(ZeroCount, TimeUnix) AS ZeroCount, argMax(PositiveOffset, TimeUnix) AS PositiveOffset, argMax(PositiveBucketCounts, TimeUnix) AS PositiveBucketCounts, argMax(NegativeOffset, TimeUnix) AS NegativeOffset, argMax(NegativeBucketCounts, TimeUnix) AS NegativeBucketCounts] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
        Filter predicate=((coalesce(nullIf(Attributes["service"], ""), nullIf(ResourceAttributes["service"], ""), "") = "api") AND (MetricName IN ("http_server_duration_exp_hist", "http.server.duration.exp.hist", "http.server.duration.exp/hist", "http.server.duration.exp_hist", "http.server.duration/exp/hist", "http.server.duration/exp_hist", "http.server.duration_exp.hist", "http.server.duration_exp_hist", "http.server/duration/exp/hist", "http.server/duration/exp_hist", "http.server/duration_exp_hist", "http.server_duration.exp.hist", "http.server_duration.exp_hist", "http.server_duration_exp.hist", "http.server_duration_exp_hist", "http/server/duration/exp/hist", "http/server/duration/exp_hist", "http/server/duration_exp_hist", "http/server_duration_exp_hist", "http_server.duration.exp.hist", "http_server.duration.exp_hist", "http_server.duration_exp.hist", "http_server.duration_exp_hist", "http_server_duration.exp.hist", "http_server_duration.exp_hist", "http_server_duration_exp.hist")))
          Scan(otel_metrics_exponential_histogram)
-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, `anchor_ts` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, if(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))] = 0, nan, if(0.95 < 0, -inf, if(0.95 > 1, inf, if(0.95 = 0, if(length(`NegativeBucketCounts`) > 0, -pow(pow(2, pow(2, -`Scale`)), `NegativeOffset` + length(`NegativeBucketCounts`)), 0.0), if(0.95 = 1, if(length(`PositiveBucketCounts`) > 0, pow(pow(2, pow(2, -`Scale`)), `PositiveOffset` + length(`PositiveBucketCounts`)), if(`ZeroCount` > 0, 0., -pow(pow(2, pow(2, -`Scale`)), `NegativeOffset`))), if(arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) <= length(`NegativeBucketCounts`), -pow(pow(2, pow(2, -`Scale`)), `NegativeOffset` + (length(`NegativeBucketCounts`) - arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))) + 1 - ((0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]) - arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) - 1]) / (arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))] - arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) - 1])), if(arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) = length(`NegativeBucketCounts`) + 1, -0. + 2 * 0. * ((0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]) - arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) - 1]) / (arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))] - arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) - 1]), pow(pow(2, pow(2, -`Scale`)), `PositiveOffset` + (arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) - length(`NegativeBucketCounts`) - 2) + ((0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]) - arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) - 1]) / (arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))] - arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[arrayFirstIndex(c -> c >= (0.95 * arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))[length(arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`)))]), arrayCumSum(arrayConcat(arrayReverse(`NegativeBucketCounts`), [`ZeroCount`], `PositiveBucketCounts`))) - 1]))))))))) AS `Value` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, `Scale` AS `Scale`, `ZeroCount` AS `ZeroCount`, `PositiveOffset` AS `PositiveOffset`, `PositiveBucketCounts` AS `PositiveBucketCounts`, `NegativeOffset` AS `NegativeOffset`, `NegativeBucketCounts` AS `NegativeBucketCounts` FROM (SELECT anchor_ts AS `anchor_ts`, mapSort(`Attributes`) AS `Attributes`, argMax(`Scale`, `TimeUnix`) AS `Scale`, argMax(`ZeroCount`, `TimeUnix`) AS `ZeroCount`, argMax(`PositiveOffset`, `TimeUnix`) AS `PositiveOffset`, argMax(`PositiveBucketCounts`, `TimeUnix`) AS `PositiveBucketCounts`, argMax(`NegativeOffset`, `TimeUnix`) AS `NegativeOffset`, argMax(`NegativeBucketCounts`, `TimeUnix`) AS `NegativeBucketCounts` FROM (SELECT *, arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))) - 300000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))) - 300000000000, toInt64(60000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `TimeUnix`, (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))), toInt64(60000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT * FROM `otel_metrics_exponential_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)) WHERE (coalesce(nullIf(`Attributes`[?], ?), nullIf(`ResourceAttributes`[?], ?), ?) = ?)) WHERE `TimeUnix` > (toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(300000000000)) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))) GROUP BY anchor_ts, `Attributes`)))
