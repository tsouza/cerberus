# `histogram_quantile(phi, <native hist> offset 5m)` over query_range. A
# bare `offset` is a RELATIVE shift against each step's eval time, so
# unlike an `@` pin it rides the step fan-out: every anchor in
# `[00:00:00, 00:05:00]` reads `(anchor - 10m, anchor - 5m]` while still
# emitting its own unshifted timestamp.
#
# The two seeded samples sit at 23:52 and 23:58, so the shifted windows
# select the small one for 00:00-00:01, nothing at all for 00:02, and the
# three-buckets-higher one for 00:03-00:05. The 00:03 decoy sample is
# outside every shifted window and must not appear — it is what a dropped
# offset would surface.

-- query.promql --
histogram_quantile(0.95, http_server_duration_exp_hist{service="api"} offset 5m)
-- range_step --
60s
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:52:00', 9), 0, 0, 0, [1, 2, 3], 0, [], 6, 0),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:58:00', 9), 0, 0, 3, [1, 2, 3], 0, [], 6, 0),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 0, 0, 9, [1, 2, 3], 0, [], 6, 0);
