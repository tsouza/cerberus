# The chopt.FeatureClassicBucketMergeSumMap counterpart of
# histogram_quantile_classic_range_step_native.txtar's SIBLING shape (a
# plain range-mode `sum by(le)(rate(...))`, no
# `experimental_quantile_prom_histogram` marker): byte-identical query, seed
# and grid, but the `experimental_classic_bucket_merge_summap` marker
# section opts the fixture into promql.NativeClassicBucketMergeLowerer, so
# the cross-series merge (lowerHistogramQuantileClassicAggRange,
# histogram_quantile_range.go) renders as sumMap(bounds, counts) +
# arrayCumSum (classic_bucket_merge_summap.go) instead of the groupArray +
# per-rung arrayFilter-rescan fold.
#
# The seed carries a HOMOGENEOUS bucket layout (every row shares
# ExplicitBounds [0.1, 0.5, 1.0]) — classic_bucket_merge_summap.go's header
# proves the two constructions are mathematically identical here, so the
# `expected_rows` cells are expected to match a plain fan-out fixture over
# the same query/seed exactly; that identity is the point. This is the
# [promql.ClassicBucketMergeLowerer] entry in the spec lane's native-
# strategy coverage ratchet (TestNativeStrategies_CoverEveryRangeLowerersField
# / TestNativeStrategies_HaveNativeSideFixtures), not a new numeric case.
#
# Range mode (a `range_step:` section) is required here — the instant-mode
# lowering path (promql.LowerAt, lower_test.go's `default` arm with no
# `range_step:` section) never threads a RangeLowerers table through at
# all, so an instant-mode fixture's marker section would be silently
# ignored and always lower through the fan-out default.
#
# A HETEROGENEOUS layout (where the two constructions diverge — see
# https://github.com/tsouza/cerberus/issues/2817) is deliberately NOT
# covered here: TestClassicBucketMergeSumMapDifferential_Heterogeneous
# (classic_bucket_merge_summap_chdb_test.go) pins that divergence directly
# against chDB instead, where it can assert the documented difference rather
# than a spec fixture asserting a value that would fail Prometheus parity.

-- query.promql --
histogram_quantile(0.95, sum by(le) (rate(http_server_request_duration_bucket[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_classic_bucket_merge_summap --
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), [0, 0, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('host', 'b'), toDateTime64('2026-01-01 00:00:00', 9), [0, 0, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('host', 'a'), toDateTime64('2026-01-01 00:00:30', 9), [1, 2, 3], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('host', 'b'), toDateTime64('2026-01-01 00:00:30', 9), [3, 4, 3], [0.1, 0.5, 1.0]);
