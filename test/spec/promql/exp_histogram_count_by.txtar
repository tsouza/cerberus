-- query.promql --
count by (service) (http_server_duration_exp_hist)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- The same three series as exp_histogram_count.txtar, read through a
-- `by (service)` clause: two `api` pods and one `web` pod, so the answer
-- is two output series carrying 2 and 1.
--
-- This is the fixture that pins WHICH key each of the two stages groups
-- on, a distinction the unkeyed sibling cannot see. Stage 1 must collapse
-- on SERIES identity and stage 2 on the user's clause. Collapsing on
-- `service` in stage 1 instead — the plausible shortcut, since that is
-- what the answer is keyed by — would take one newest sample per service
-- and report 1 for `api` rather than 2, silently losing the second pod.
--
-- Each series again carries TWO in-window samples, so the per-series
-- collapse still has to happen before the count: without it `api` would
-- report 4 and `web` 2.
--
-- `count by (service)` drops __name__ and every label EXCEPT `service`,
-- so the output series are ["", {"service":"api"}] and
-- ["", {"service":"web"}].
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api', 'pod', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 10,  5.0, 0, 0, 0, [2, 3, 5],  0, []),
    ('http_server_duration_exp_hist', map('service', 'api', 'pod', 'a'), toDateTime64('2025-12-31 23:59:00', 9),  6,  1.5, 0, 1, 0, [1, 2],     0, []),
    ('http_server_duration_exp_hist', map('service', 'api', 'pod', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 21, 12.5, 1, 0, 2, [7, 7, 7],  0, []),
    ('http_server_duration_exp_hist', map('service', 'api', 'pod', 'b'), toDateTime64('2025-12-31 23:59:00', 9),  3,  0.5, 1, 2, 2, [3],        0, []),
    ('http_server_duration_exp_hist', map('service', 'web', 'pod', 'a'), toDateTime64('2026-01-01 00:00:00', 9),  9,  4.0, 0, 0, 1, [4, 5],     0, []),
    ('http_server_duration_exp_hist', map('service', 'web', 'pod', 'a'), toDateTime64('2025-12-31 23:59:00', 9),  2,  0.25, 0, 0, 1, [2],       0, []);
-- expected_rows --
[
  ["", {"service": "api"}, "2026-01-01T00:00:01Z", 2],
  ["", {"service": "web"}, "2026-01-01T00:00:01Z", 1]
]
