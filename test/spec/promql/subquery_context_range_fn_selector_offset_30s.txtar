(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes`, `Flags`, `MetricName`, `ResourceAttributes`, `ServiceName`, `TimeUnix`, `Value` FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') PREWHERE (`MetricName` = ?) WHERE not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > (parseDateTime64BestEffort('2025-12-31 23:59:00.000000000Z', 9) - toIntervalNanosecond(30000000000)) - toIntervalNanosecond(600000000000) AND `TimeUnix` <= (parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(30000000000))) GROUP BY `Attributes`, `anchor_ts`)) WHERE length(`window_vals`) >= 1))) WHERE `anchor_ts` > parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) - toIntervalNanosecond(120000000000) AND `anchor_ts` <= parseDateTime64BestEffort('2026-01-01 00:00:01.000000000Z', 9) GROUP BY `Attributes`
