# Fixed-accumulator decomposition (cerberus issue #2760) for delta() in RANGE
# mode — chsql's emitFixedAccumulatorExtrapolatedMatrix. The
# `experimental_fixed_accumulator_delta` section opts the fixture into
# RangeLowerers.Delta = FixedAccumulatorDeltaLowerer — delta has no native
# timeSeries*ToGrid competitor, so this pins the fixed-accumulator SQL shape
# directly.
#
# job 'gauge' walks up and down (a plain gauge, no counter-reset semantics);
# job 'flat' never changes (delta 0 throughout).
-- query.promql --
sum by(job) (delta(cpu_temp_celsius[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_fixed_accumulator_delta --
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('cpu_temp_celsius', map('job', 'gauge'), toDateTime64('2026-01-01 00:00:00', 9), 40.0),
