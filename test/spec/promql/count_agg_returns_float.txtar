# count(<metric>) over a chDB-seeded gauge must scan cleanly into
# chclient.Sample.Value (*float64). CH's `count(...)` aggregate
# returns UInt64; without the chsql/emit_node.go toFloat64 wrap on
# the plain Aggregate path, clickhouse-go/v2 refuses the coercion
# at scan time (`converting UInt64 to *float64 is unsupported`) and
# the prom handler surfaces it as a 502. This is the compat-lane
# `count(demo_memory_usage_bytes)` 502 made deterministic.
#
# Three seeded label-different rows; count(...) collapses them to a
# single scalar value of 3.0. The matrix path (range_window.go) was
# already wrapping every reducer in toFloat64; this fixture pins
# the matching wrap on the plain Aggregate path.

-- query.promql --
count(demo_memory_usage_bytes)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('demo_memory_usage_bytes', map('job', 'api', 'instance', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 1024.0),
    ('demo_memory_usage_bytes', map('job', 'api', 'instance', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 2048.0),
    ('demo_memory_usage_bytes', map('job', 'db',  'instance', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 4096.0);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 3.0]
]
-- args --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] string = "service_name"
[4] string = "service.name"
[5] string = "service_name"
[6] string = "service.name"
[7] string = "service_name"
[8] string = ""
[9] string = "service_name"
[10] string = "demo_memory_usage_bytes"
[11] string = "demo.memory.usage.bytes"
[12] string = "demo.memory.usage/bytes"
[13] string = "demo.memory.usage_bytes"
[14] string = "demo.memory/usage/bytes"
[15] string = "demo.memory/usage_bytes"
[16] string = "demo.memory_usage.bytes"
[17] string = "demo.memory_usage_bytes"
[18] string = "demo/memory/usage/bytes"
[19] string = "demo/memory/usage_bytes"
[20] string = "demo/memory_usage_bytes"
[21] string = "demo_memory.usage.bytes"
[22] string = "demo_memory.usage_bytes"
[23] string = "demo_memory_usage.bytes"
[24] string = "2026-01-01 00:00:01.000000000"
[25] int64 = 9
[26] string = "2026-01-01 00:00:01.000000000"
[27] int64 = 9
[28] int64 = 300000000000
-- chplan --
Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, Value AS Value]
  Aggregate groupBy=[] funcs=[FnCount(Value) AS Value]
    Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
      Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[FnMax(TimeUnix) AS lwr_ts, FnArgMax(Value, TimeUnix) AS lwr_value]
        Filter predicate=((TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9)) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
          Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
            Filter predicate=(MetricName IN ("demo_memory_usage_bytes", "demo.memory.usage.bytes", "demo.memory.usage/bytes", "demo.memory.usage_bytes", "demo.memory/usage/bytes", "demo.memory/usage_bytes", "demo.memory_usage.bytes", "demo.memory_usage_bytes", "demo/memory/usage/bytes", "demo/memory/usage_bytes", "demo/memory_usage_bytes", "demo_memory.usage.bytes", "demo_memory.usage_bytes", "demo_memory_usage.bytes"))
              Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- sql --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Value` FROM (SELECT toFloat64(count(`Value`)) AS `Value`, count() AS `_cerb_n` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `lwr_ts` AS `TimeUnix`, `lwr_value` AS `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, max(`TimeUnix`) AS `lwr_ts`, argMax(`Value`, `TimeUnix`) AS `lwr_value` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)))) WHERE ((`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?))))) GROUP BY `MetricName`, `Attributes`))) WHERE `_cerb_n` > 0)
