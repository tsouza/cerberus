-- sql --
SELECT `Attributes`, max(`Value`) AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes`, `anchor_ts`, anchor_ts AS `TimeUnix`, max(`Value`) AS `Value` FROM (SELECT `Attributes`, `_src_ts`, `Value`, arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `_src_ts`, parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9)) - 120000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9)) - 120000000000, toInt64(60000000000)) < 0) + 1), least(5, intDiv(dateDiff('nanosecond', `_src_ts`, parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9)), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9)), toInt64(60000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT *, `anchor_ts` AS _src_ts FROM (SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT ? AS `MetricName`, `Attributes`, `TimeUnix`, toFloat64((toFloat64(toUnixTimestamp64Milli(`TimeUnix`)) / toFloat64(?))) AS `Value` FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, `anchor_ts` AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2025-12-31 23:54:20.000000000Z', 9) + toIntervalNanosecond(i * 20000000000), range(0, 18))) AS `anchor_ts`)))))) WHERE `_src_ts` > parseDateTime64BestEffort('2025-12-31 23:56:00.000000000Z', 9) - toIntervalNanosecond(120000000000) AND `_src_ts` <= parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9)) GROUP BY `Attributes`, `anchor_ts`))) WHERE `anchor_ts` > parseDateTime64BestEffort('2026-01-01 00:00:30.000000000Z', 9) - toIntervalNanosecond(300000000000) AND `anchor_ts` <= parseDateTime64BestEffort('2026-01-01 00:00:30.000000000Z', 9) GROUP BY `Attributes`
