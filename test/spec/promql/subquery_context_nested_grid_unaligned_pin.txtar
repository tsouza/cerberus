  Project [Attributes AS Attributes, anchor_ts AS anchor_ts, TimeUnix AS TimeUnix, Value AS Value]
    Project [Attributes AS Attributes, TimeUnix AS anchor_ts, TimeUnix AS TimeUnix, Value AS Value] subqueryGrid
      RangeWindow func=max_over_time range=2m0s step=1m0s outerRange=4m0s ts=anchor_ts value=Value groupBy=[Attributes] start=2025-12-31T23:56:00Z end=2026-01-01T00:00:00Z distinctSampleRows
        Project [Attributes AS Attributes, anchor_ts AS anchor_ts, TimeUnix AS TimeUnix, Value AS Value]
          Project [Attributes AS Attributes, TimeUnix AS anchor_ts, TimeUnix AS TimeUnix, Value AS Value] subqueryGrid
            Project ["" AS MetricName, Attributes, TimeUnix, FnToFloat64((FnToFloat64(FnToUnixMillis(TimeUnix)) / 1000)) AS Value]
              Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, anchor_ts AS TimeUnix, 1 AS Value]
                StepGrid start=2025-12-31T23:54:20.000000000Z end=2026-01-01T00:00:00.000000000Z step=20s
