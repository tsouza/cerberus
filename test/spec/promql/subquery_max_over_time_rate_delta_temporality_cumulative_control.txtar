# The CUMULATIVE-temporality control for
# subquery_max_over_time_rate_delta_temporality.txtar: same query shape,
# same timestamps, same raw values (10, 20, 30, 40) — only
# AggregationTemporality flips from 1 (DELTA) to 2 (CUMULATIVE)
# EXPLICITLY, so this fixture pins the CUMULATIVE arm of the fused path's
# runtime branch on purpose rather than by omission.
#
# Read as a running total, both kept inner anchors reduce to a reset-free
# diff of 10 over a 30s sampled_interval, and the zero-crossing clamp
# leaves duration_to_start at its raw 30s in both:
# 10 * (30+30)/30/60 = 1/3 at 23:59:00 and at 00:00:00 alike, so
# max_over_time is 1/3 — a third of the DELTA fixture's 1.1666…
-- query.promql --
max_over_time(rate(http_requests_cumulative_total[1m])[2m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2025-12-31 23:58:30', 9), 10.0),
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2025-12-31 23:59:00', 9), 20.0),
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2025-12-31 23:59:30', 9), 30.0),
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 40.0);
