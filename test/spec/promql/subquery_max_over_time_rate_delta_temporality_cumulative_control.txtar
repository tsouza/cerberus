# The CUMULATIVE-temporality control for
# subquery_max_over_time_rate_delta_temporality.txtar: same query shape,
# same timestamps, same raw values (10, 20, 30, 40) — only
# AggregationTemporality flips from 1 (DELTA) to 2 (CUMULATIVE)
# EXPLICITLY, so this fixture pins the CUMULATIVE arm of the fused path's
# runtime branch on purpose rather than by omission.
#
# Read as a running total, both kept inner anchors reduce to a reset-free
# diff of 10 over a 30s sampled_interval, and the zero-crossing clamp
# leaves duration_to_start at its raw 30s in both:
# 10 * (30+30)/30/60 = 1/3 at 23:59:00 and at 00:00:00 alike, so
# max_over_time is 1/3 — a third of the DELTA fixture's 1.1666…
-- query.promql --
max_over_time(rate(http_requests_cumulative_total[1m])[2m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2025-12-31 23:58:30', 9), 10.0),
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2025-12-31 23:59:00', 9), 20.0),
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2025-12-31 23:59:30', 9), 30.0),
    (2, 'http_requests_cumulative_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 40.0);
-- expected_rows --
[
  [{"job": "api"}, 0.3333333333333333]
]
-- args --
[0] string = "service.name"
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = ""
[5] string = "service_name"
[6] string = "http_requests_cumulative_total"
[7] string = "http.requests.cumulative.total"
[8] string = "http.requests.cumulative/total"
[9] string = "http.requests.cumulative_total"
[10] string = "http.requests/cumulative/total"
[11] string = "http.requests/cumulative_total"
[12] string = "http.requests_cumulative.total"
[13] string = "http.requests_cumulative_total"
[14] string = "http/requests/cumulative/total"
[15] string = "http/requests/cumulative_total"
[16] string = "http/requests_cumulative_total"
[17] string = "http_requests.cumulative.total"
[18] string = "http_requests.cumulative_total"
[19] string = "http_requests_cumulative.total"
-- chplan --
RangeWindow func=max_over_time range=2m0s step=0s ts=anchor_ts value=Value groupBy=[Attributes] start=0001-01-01T00:00:00Z end=2026-01-01T00:00:01Z
  RangeWindow func=rate range=1m0s step=1m0s outerRange=2m0s ts=TimeUnix value=Value temporality=AggregationTemporality groupBy=[Attributes] start=2025-12-31T23:58:01Z end=2026-01-01T00:00:01Z
    Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value, AggregationTemporality AS AggregationTemporality]
      Filter predicate=(MetricName IN ("http_requests_cumulative_total", "http.requests.cumulative.total", "http.requests.cumulative/total", "http.requests.cumulative_total", "http.requests/cumulative/total", "http.requests/cumulative_total", "http.requests_cumulative.total", "http.requests_cumulative_total", "http/requests/cumulative/total", "http/requests/cumulative_total", "http/requests_cumulative_total", "http_requests.cumulative.total", "http_requests.cumulative_total", "http_requests_cumulative.total"))
        Scan(otel_metrics_sum)
-- sql --
SELECT `Attributes`, arrayReduce('max', vals) AS `Value` FROM (SELECT `Attributes`, arrayMap(t -> tupleElement(t, 2), arrayFilter(t -> tupleElement(t, 1), arrayMap(a -> arrayMap(s -> (a > toDateTime64('2026-01-01 00:00:01.000000000', 9) - toIntervalNanosecond(120000000000) AND a <= toDateTime64('2026-01-01 00:00:01.000000000', 9) AND length(s) >= 2, if((toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) > 0, if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s))))) * (((toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) + if(if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s))))) > 0 AND if(temporality = 1, arraySum(arrayMap(p -> tupleElement(p, 2), arrayFilter(p -> tupleElement(p, 1) <= tupleElement(s[1], 1), samples))), tupleElement(s[1], 2)) >= 0, least(if((toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(60000000000), tupleElement(s[1], 1))) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(60000000000), tupleElement(s[1], 1))) / 1e9)), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) * if(temporality = 1, arraySum(arrayMap(p -> tupleElement(p, 2), arrayFilter(p -> tupleElement(p, 1) <= tupleElement(s[1], 1), samples))), tupleElement(s[1], 2)) / if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s)))))), if((toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(60000000000), tupleElement(s[1], 1))) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(60000000000), tupleElement(s[1], 1))) / 1e9))) + if((toFloat64(dateDiff('nanosecond', tupleElement(s[length(s)], 1), a)) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', tupleElement(s[length(s)], 1), a)) / 1e9))) / (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / 60), nan)), [arrayReverse(arrayCompact(p -> tupleElement(p, 1), arrayReverse(arrayFilter(p -> tupleElement(p, 1) > a - toIntervalNanosecond(60000000000) AND tupleElement(p, 1) <= a, samples))))])[1], arrayMap(i -> fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:00:01.000000000', 9)), 60000000000) * 60000000000) - toIntervalNanosecond(i * 60000000000), range(2))))) AS `vals` FROM (SELECT `Attributes`, arraySort(groupArray((`TimeUnix`, `Value`))) AS `samples`, any(`AggregationTemporality`) AS `temporality` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value`, `AggregationTemporality` AS `AggregationTemporality` FROM (SELECT * FROM `otel_metrics_sum` WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)))) WHERE `TimeUnix` > toDateTime64('2025-12-31 23:58:01.000000000', 9) - toIntervalNanosecond(60000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:00:01.000000000', 9) GROUP BY `Attributes`)) WHERE length(vals) > 0
