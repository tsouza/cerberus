-- query.promql --
histogram_quantile(0.9, mko_hist_bucket)
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('mko_hist', map('dc', 'eu', 'job', 'api'), toDateTime64('2025-12-31 23:59:00', 9), 10, 50, [10, 0, 0], [1.0, 2.0]),
    ('mko_hist', map('job', 'api', 'dc', 'eu'), toDateTime64('2026-01-01 00:00:00', 9), 25, 250, [0, 0, 25], [1.0, 2.0]);
