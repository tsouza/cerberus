  ["", {"service": "api"}, "2026-01-01T00:04:00Z", 0, 55, 27.5, 0, 0, 0, 0, [28.75,26.25], 0, []],
  ["", {"service": "api"}, "2026-01-01T00:05:00Z", 0, 55, 27.5, 0, 0, 0, 0, [25,30], 0, []]
]
