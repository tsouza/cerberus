  Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(wv -> FnArrayMap(wo -> (FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wv) - wsr[1]), FnArraySum(FnArrayMap((p, c, r) -> FnIf(r, c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr), _hq_resets))), FnArray(FnArraySort((c, t) -> t, wv, wo)))[1] * FnArrayMap(wcv -> FnArrayMap(wso -> FnArrayMap(wsi -> FnArrayMap(wag -> FnArrayMap(wtc -> FnArrayMap(wrc -> FnIf((wsi > 0), (((wsi + FnIf((FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc) < wtc), FnIf((wrc > 0), (wsi * (FnArraySort((c, t) -> t, wcv, wo)[1] / wrc)), wtc), wtc)) + FnIf(((FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], anchor_ts)) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", wso[FnLength(wso)], anchor_ts)) / 1e+09))) / wsi), 1), FnArray(FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wcv) - wsr[1]), FnArraySum(FnArrayMap((p, c, r) -> FnIf(r, c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr), _hq_resets))), FnArray(FnArraySort((c, t) -> t, wcv, wo)))[1]))[1], FnArray(FnIf(((FnToFloat64(FnDateDiff("nanosecond", (anchor_ts - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09) >= (1.1 * wag)), (wag / 2), (FnToFloat64(FnDateDiff("nanosecond", (anchor_ts - FnToIntervalNanosecond(300000000000)), wso[1])) / 1e+09))))[1], FnArray((wsi / (FnLength(wo) - 1))))[1], FnArray((FnToFloat64(FnDateDiff("nanosecond", wso[1], wso[FnLength(wso)])) / 1e+09)))[1], FnArray(FnArraySort(wo)))[1], FnArray(FnArrayMap(n -> FnToFloat64(n), _hq_count_list)))[1]), FnArray(_hq_ts_list))[1], FnArray(FnArrayMap(n -> FnToFloat64(n), _hq_count_list)))[1] AS Count, FnArrayMap(wv -> FnArrayMap(wo -> (FnArrayMap(wsr -> FnIf((_hq_temporality = 1), (FnArraySum(wv) - wsr[1]), FnArraySum(FnArrayMap((p, c, r) -> FnIf(r, c, (c - p)), FnArrayPopBack(wsr), FnArrayPopFront(wsr), _hq_resets))), FnArray(FnArraySort((c, t) -> t, wv, wo)))[1] * FnArrayMap(wcv -> FnArrayMap(wso -> FnArrayMap(wsi -