# The `ignoreSeries` carve-out when the base vector does NOT pin one
# metric name, so membership is a per-row question rather than a
# compile-time one.
#
# `{__name__=~"up|target_info"}` selects both an ordinary metric and an
# info metric. The effective info name matcher is the default
# `__name__="target_info"` (no second argument), so of the two base
# series only `target_info` is in the ignore set. The lowering splits
# the base vector on that predicate and unions the arms back together:
#
#   - `target_info{job="api", version="1.2.3"}` passes through verbatim;
#   - `up{job="api"}` is enriched from `target_info` on the shared `job`
#     and comes back carrying `version="1.2.3"`.
#
# Without the split the ignored arm would self-join and the answer would
# still look right by accident here — the graft rewrites labels the
# series already carries — which is exactly why the wrongly-dropped and
# wrongly-enriched fixtures alongside this one pin the observable cases.
# This one pins the plan SHAPE: a UnionAll of the join arm and the
# pass-through arm.

-- query.promql --
info({__name__=~"up|target_info"})
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('target_info', map('job', 'api', 'version', '1.2.3'), toDateTime64('2026-01-01 00:00:00', 9), 1.0);
-- expected_rows --
[
  ["target_info", {"job": "api", "version": "1.2.3"}, "2026-01-01T00:00:00Z", 1],
  ["up", {"job": "api", "version": "1.2.3"}, "2026-01-01T00:00:00Z", 1]
]
