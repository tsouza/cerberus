# `histogram_quantile(phi, <native hist> @ <ts>)` over query_range. The `@`
# pins the selection window to `(23:55, 00:00]` for EVERY step, so all six
# steps in `[00:00:00, 00:05:00]` report the quantile of the 23:58 sample
# and only the output timestamp varies.
#
# The post-pin samples sit three buckets higher (PositiveOffset 3 vs 0), so
# a window re-anchored onto each step would climb to a visibly larger
# quantile from 00:01 onward. Six identical rows are the pin surviving.

-- query.promql --
histogram_quantile(0.95, http_server_duration_exp_hist{service="api"} @ 1767225600)
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:58:00', 9), 0, 0, 0, [1, 2, 3], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 0, 0, 3, [1, 2, 3], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 0, 0, 3, [2, 4, 6], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 0, 0, 3, [4, 8, 12], 0, []);
