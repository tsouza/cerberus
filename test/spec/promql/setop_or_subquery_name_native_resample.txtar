# `__name__` across a SET-OPERATOR subquery inner, on the NATIVE ts_grid
# staleness path (#1810).
#
# This is the twin of setop_or_subquery_name.txtar. Same query, same seed,
# same names on the wire — but the `experimental_ts_grid_resample:` section
# swaps the staleness lowering from the fan-out `chplan.RangeLWR` to the
# native `chplan.RangeWindowResample`
# (timeSeriesResampleToGridWithStaleness), which is what a ClickHouse new
# enough to have ts_grid actually runs.
#
# The two nodes are the two halves of ONE lowering, chosen per deployment by
# RangeLowerers.Staleness. The subquery spine walk that decides whether
# `__name__` survives to the anchor projection knew only the fan-out half,
# so the same query returned named series on an old ClickHouse and nameless
# ones on a new one — one query, two answers, decided by the server version.
# Only a fixture that pins BOTH halves catches that; the fan-out fixture
# alone is green either way.
-- query.promql --
last_over_time((cpu_temp or gpu_temp)[10m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- experimental_ts_grid_resample --
on
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    ResourceAttributes Map(String, String) DEFAULT map(),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge (MetricName, Attributes, TimeUnix, Value) VALUES
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 41.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 42.0),
    ('gpu_temp', map('host', 'b'), toDateTime64('2025-12-31 23:59:00', 9), 71.0),
    ('gpu_temp', map('host', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 72.0);
-- expected_rows --
[
  ["cpu_temp", {"host": "a"}, "2026-01-01T00:00:00Z", 42],
  ["cpu_temp", {"host": "a"}, "2026-01-01T00:01:00Z", 42],
  ["cpu_temp", {"host": "a"}, "2026-01-01T00:02:00Z", 42],
  ["cpu_temp", {"host": "a"}, "2026-01-01T00:03:00Z", 42],
  ["cpu_temp", {"host": "a"}, "2026-01-01T00:04:00Z", 42],
  ["cpu_temp", {"host": "a"}, "2026-01-01T00:05:00Z", 42],
  ["gpu_temp", {"host": "b"}, "2026-01-01T00:00:00Z", 72],
  ["gpu_temp", {"host": "b"}, "2026-01-01T00:01:00Z", 72],
  ["gpu_temp", {"host": "b"}, "2026-01-01T00:02:00Z", 72],
  ["gpu_temp", {"host": "b"}, "2026-01-01T00:03:00Z", 72],
  ["gpu_temp", {"host": "b"}, "2026-01-01T00:04:00Z", 72],
  ["gpu_temp", {"host": "b"}, "2026-01-01T00:05:00Z", 72]
]
-- args --
[0] string = "service.name"
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = ""
[5] string = "service_name"
[6] string = "cpu_temp"
[7] string = "cpu.temp"
[8] string = "cpu/temp"
[9] string = "service.name"
[10] string = "service_name"
[11] string = "service.name"
[12] string = "service_name"
[13] string = ""
[14] string = "service_name"
[15] string = "gpu_temp"
[16] string = "gpu.temp"
[17] string = "gpu/temp"
-- chplan --
Project [MetricName AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  RangeWindow func=last_over_time range=10m0s step=1m0s outerRange=5m0s ts=anchor_ts value=Value groupBy=[Attributes, MetricName] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
    Project [MetricName AS MetricName, Attributes AS Attributes, TimeUnix AS anchor_ts, TimeUnix AS TimeUnix, Value AS Value]
      VectorSetOp op=or match=default stepAligned
        RangeWindowResample step=1m0s lookback=5m0s ts=TimeUnix value=Value start=2025-12-31T23:51:00Z end=2026-01-01T00:05:00Z
          Project [MetricName AS MetricName, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
            Filter predicate=(MetricName IN ("cpu_temp", "cpu.temp", "cpu/temp"))
              Scan(merge(otel_metrics_gauge|otel_metrics_sum))
        RangeWindowResample step=1m0s lookback=5m0s ts=TimeUnix value=Value start=2025-12-31T23:51:00Z end=2026-01-01T00:05:00Z
          Project [MetricName AS MetricName, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
            Filter predicate=(MetricName IN ("gpu_temp", "gpu.temp", "gpu/temp"))
              Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- sql --
SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `anchor_ts` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes`, `MetricName`, `anchor_ts`, if(length(window_vals) > 0, window_vals[length(window_vals)], nan) AS `Value` FROM (SELECT `Attributes`, `MetricName`, `anchor_ts`, arrayMap(p -> tupleElement(p, 2), window_pairs) AS `window_vals`, arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), window_pairs)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), window_pairs)))) AS `counter_delta` FROM (SELECT `Attributes`, `MetricName`, `anchor_ts`, arraySort(groupArray((`_src_ts`, `Value`))) AS `window_pairs` FROM (SELECT `Attributes`, `MetricName`, `_src_ts`, `Value`, arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `_src_ts`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 600000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 600000000000, toInt64(60000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `_src_ts`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `_src_ts`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(60000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT *, `anchor_ts` AS _src_ts FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, `_setop_side`, max(`_setop_side` = 0) OVER (PARTITION BY mapSort(`Attributes`), `TimeUnix`) AS `_setop_has_left` FROM (((SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, 0 AS `_setop_side` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value` FROM (SELECT `MetricName`, `Attributes`, toDateTime64(`anchor_ts`, 9) AS `TimeUnix`, toFloat64(assumeNotNull(`grid_val`)) AS `Value` FROM (SELECT `MetricName`, `Attributes`, timeSeriesResampleToGridWithStaleness(toDateTime(1767225060, 'UTC'), toDateTime(1767225900, 'UTC'), 60, 300)(`TimeUnix`, `Value`) AS `grid`, timeSeriesRange(toDateTime(1767225060, 'UTC'), toDateTime(1767225900, 'UTC'), 60) AS `grid_ts` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?)))) WHERE `TimeUnix` > toDateTime64('2025-12-31 23:51:00.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9) GROUP BY `MetricName`, `Attributes`) ARRAY JOIN `grid` AS `grid_val`, `grid_ts` AS `anchor_ts` WHERE `grid_val` IS NOT NULL)))) UNION ALL ((SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, 1 AS `_setop_side` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value` FROM (SELECT `MetricName`, `Attributes`, toDateTime64(`anchor_ts`, 9) AS `TimeUnix`, toFloat64(assumeNotNull(`grid_val`)) AS `Value` FROM (SELECT `MetricName`, `Attributes`, timeSeriesResampleToGridWithStaleness(toDateTime(1767225060, 'UTC'), toDateTime(1767225900, 'UTC'), 60, 300)(`TimeUnix`, `Value`) AS `grid`, timeSeriesRange(toDateTime(1767225060, 'UTC'), toDateTime(1767225900, 'UTC'), 60) AS `grid_ts` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?)))) WHERE `TimeUnix` > toDateTime64('2025-12-31 23:51:00.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9) GROUP BY `MetricName`, `Attributes`) ARRAY JOIN `grid` AS `grid_val`, `grid_ts` AS `anchor_ts` WHERE `grid_val` IS NOT NULL)))))) WHERE `_setop_side` = 0 OR `_setop_has_left` = 0))) WHERE `_src_ts` > toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(600000000000) AND `_src_ts` <= toDateTime64('2026-01-01 00:05:00.000000000', 9)) GROUP BY `Attributes`, `MetricName`, `anchor_ts`)) WHERE length(`window_vals`) >= 1)
