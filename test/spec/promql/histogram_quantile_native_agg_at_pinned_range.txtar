# `histogram_quantile(phi, sum by(le)(rate(<native hist>[5m] @ <ts>)))` over
# query_range. The `@` pins the merge window to `(23:55, 00:00]` for every
# step, so all six steps in `[00:00:00, 00:05:00]` report the quantile of
# the merged 23:56 + 23:58 histograms.
#
# Each service is a counter starting from an all-zero baseline inside the
# pinned window (api at 23:55:30, web at 23:57:00), so its `rate()` clears
# the two-sample-per-series floor and its increase across the window is
# exactly the counts recorded at 23:56 and 23:58.
#
# `sum by(le)` collapses the two seeded services into one merged
# distribution, and the post-pin samples sit three buckets higher, so a
# window re-anchored onto each step would climb. Six identical rows are the
# pin surviving.

-- query.promql --
histogram_quantile(0.95, sum by(le)(rate(http_server_duration_exp_hist[5m] @ 1767225600)))
-- range_step --
60s
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:55:30', 9), 0, 0, 0, [0, 0, 0], 0, [], 0, 0),
    ('http_server_duration_exp_hist', map('service', 'web'), toDateTime64('2025-12-31 23:57:00', 9), 0, 0, 0, [0, 0, 0], 0, [], 0, 0),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:56:00', 9), 0, 0, 0, [1, 2, 3], 0, [], 6, 0),
    ('http_server_duration_exp_hist', map('service', 'web'), toDateTime64('2025-12-31 23:58:00', 9), 0, 0, 0, [3, 2, 1], 0, [], 6, 0),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 0, 0, 3, [1, 2, 3], 0, [], 6, 0),
    ('http_server_duration_exp_hist', map('service', 'web'), toDateTime64('2026-01-01 00:04:00', 9), 0, 0, 3, [3, 2, 1], 0, [], 6, 0);
