-- sql --
SELECT `Attributes`, toFloat64(uniqExact(`TimeUnix`, `Value`)) AS `Value` FROM (SELECT `MetricName` AS `MetricName`, CAST((mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `_typed_9dd667188fe2e4e7`), toTypeName(`_typed_9dd667188fe2e4e7`)) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM `otel_metrics_sum` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?)) WHERE not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > parseDateTime64BestEffort('2262-04-11 23:47:16.854000000Z', 9) - toIntervalNanosecond(336854000000) AND `TimeUnix` <= parseDateTime64BestEffort('2262-04-11 23:47:16.854000000Z', 9) GROUP BY `Attributes`
