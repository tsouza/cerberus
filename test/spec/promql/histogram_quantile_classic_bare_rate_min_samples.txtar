-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.5 cumulative groupBy=[anchor_ts AS anchor_ts, Attributes AS Attributes]
    Project [anchor_ts AS anchor_ts, Attributes AS Attributes, arrayMap(i -> arrayMax(arraySlice(_hq_ladder, 1, i)), arrayEnumerate(_hq_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
      Project [anchor_ts AS anchor_ts, gkey_0 AS Attributes, arrayConcat(arrayMap(u -> arraySum(arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((b <= u), c, 0), bs, arraySlice(cs, 1, length(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)), arraySort(arrayDistinct(arrayFlatten(_hq_bounds_list)))), array(arraySum(arrayMap(cs -> arraySum(cs), _hq_counts_list)))) AS _hq_ladder, arraySort(arrayDistinct(arrayFlatten(_hq_bounds_list))) AS ExplicitBounds]
        RangeBucketFanout step=10s lookback=1m0s minSamples=2 groupBy=[mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS gkey_0] funcs=[groupArray(ExplicitBounds) AS _hq_bounds_list, groupArray(BucketCounts) AS _hq_counts_list] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
          Filter predicate=(MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration"))
            Scan(otel_metrics_histogram)
