# A classic histogram whose lowest ExplicitBounds entry is NEGATIVE, with a
# rank that lands in that first bucket. OTel permits non-positive explicit
# bounds; upstream BucketQuantile short-circuits `b == 0 &&
# buckets[0].UpperBound <= 0` to the bound itself rather than interpolating up
# from an assumed lower edge of 0, because `[0, -10]` is not an interval any
# observation lives in.
#
# bounds [-10, 0, 5], counts [4, 1, 1, 1] → ladder [4, 5, 6, 7], total 7.
# phi=0.5 → rank 3.5, which the first rung (4) already covers, so upstream
# answers -10. Interpolating from 0 instead answers -8.75.
-- query.promql --
histogram_quantile(0.5, http_server_request_duration_bucket)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [4, 1, 1, 1], [-10.0, 0.0, 5.0]);
-- expected_rows --
[
  ["", {"job": "api"}, "2026-01-01T00:00:01Z", -10]
]
