-- query.promql --
metric_a or metric_b
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('metric_a', map('job', 'api', 'dc', 'eu'), toDateTime64('2026-01-01 00:00:00', 9), 3.0),
    ('metric_b', map('dc', 'eu', 'job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 4.0);
