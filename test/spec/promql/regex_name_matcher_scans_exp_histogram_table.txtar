# A regex-only `__name__` matcher fans across the exp-histogram
# companion arms too (#1549 residue 1): `<base>_count`/`<base>_sum` are
# synthesized from ExpHistogramTable's Count/Sum columns, mirroring the
# classic-histogram companion arms already covered by
# regex_name_matcher_scans_sum_table.txtar. The decoy classic-histogram
# row (same base name, different Count/Sum) proves the two tables stay
# distinct arms rather than one clobbering the other.

-- query.promql --
{__name__=~".*latency_exp_hist.*"}
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    ExplicitBounds Array(Float64),
    BucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 7, 21.0, 0, 1, 0, [3, 4], 1, [2]);
INSERT INTO otel_metrics_histogram VALUES
    ('latency_exp_hist', map('service', 'decoy'), toDateTime64('2026-01-01 00:00:00', 9), 99, 999.0, [1.0], [0, 99]);
