[
  ["latency_exp_hist_bucket", {"le": "+Inf", "service": "decoy"}, "2026-01-01T00:00:00Z", 99],
  ["latency_exp_hist_bucket", {"le": "1", "service": "decoy"}, "2026-01-01T00:00:00Z", 0],
  ["latency_exp_hist_count", {"service": "api"}, "2026-01-01T00:00:00Z", 7],
  ["latency_exp_hist_count", {"service": "decoy"}, "2026-01-01T00:00:00Z", 99],
  ["latency_exp_hist_sum", {"service": "api"}, "2026-01-01T00:00:00Z", 21],
  ["latency_exp_hist_sum", {"service": "decoy"}, "2026-01-01T00:00:00Z", 999]
]
