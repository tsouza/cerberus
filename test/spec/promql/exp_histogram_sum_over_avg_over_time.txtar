-- query.promql --
sum(avg_over_time(request_latency_exp_hist[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- cerberus issue #2619: avg_over_time(m_exp_hist[5m]) wrapped by an outer
-- sum() used to hard-reject even though sum(rate(m_exp_hist[5m])) already
-- composed. Each series folds its own two in-window samples via
-- avg_over_time (Kahan sum / 2 samples): series a -> Count 7, Sum 4.5,
-- buckets [2,3]; series b -> Count 9, Sum 6, buckets [4,2]. The outer sum()
-- then merges those two already-folded per-series histograms across
-- series — the SAME across-series merge sum(rate(...)) already exercises
-- — landing on Count 16, Sum 10.5, buckets [6,5].
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('request_latency_exp_hist', map('instance', 'a'), toDateTime64('2025-12-31 23:59:01', 9),  5, 3.0, 0, 0, 0, [1, 2], 0, []),
    ('request_latency_exp_hist', map('instance', 'a'), toDateTime64('2026-01-01 00:00:01', 9),  9, 6.0, 0, 0, 0, [3, 4], 0, []),
    ('request_latency_exp_hist', map('instance', 'b'), toDateTime64('2025-12-31 23:59:01', 9),  7, 4.0, 0, 0, 0, [3, 1], 0, []),
    ('request_latency_exp_hist', map('instance', 'b'), toDateTime64('2026-01-01 00:00:01', 9), 11, 8.0, 0, 0, 0, [5, 3], 0, []);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 0, 16, 10.5, 0, 0, 0, 0, [6,5], 0, []]
]
