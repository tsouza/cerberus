# A vector-vector binary op whose BOTH operands lower to the ClickHouse-native
# timeSeriesRateToGrid aggregate: `sum(rate(a)) / sum(rate(b))` in range mode.
# The `experimental_ts_grid_range` section wires the boot-decided native-rate
# strategy into the lowering, so neither operand takes the arrayJoin fan-out
# path — the plan's ONLY eval-grid carriers are the two RangeWindowGridNative nodes.
#
# Two properties this fixture pins that the single-operand native fixtures
# (native_rate_range_step.txtar) cannot:
#
#  1. The inner-scan time bound is rendered PER OPERAND. Each side of the join
#     is an independent scalar subquery over its own metric, so a bound applied
#     once at the top would leave one side reading unbounded. The golden below
#     carries the half-open `(Start - window, End]` predicate on `TimeUnix`
#     twice, once per side, ahead of each per-series GROUP BY.
#  2. The by-less `sum(...)` collapses the group key to the step bucket alone,
#     which is the shape that leaves NO fan-out window node anywhere in the
#     plan. That is the configuration in which a grid reader that enumerates
#     node kinds rather than dispatching on the eval-grid interface sees no
#     carrier at all and reports the range query as an instant one — see
#     internal/api/prom/native_range_grid_test.go for the invariant pin.
#
# The seed uses two synthetic counters on a shared attribute set so the join
# key matches and the ratio is exact at every anchor.
-- query.promql --
sum(rate(cerberus_requests_total[2m])) / sum(rate(cerberus_attempts_total[2m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- experimental_ts_grid_range --
on
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    ResourceAttributes Map(String, String) DEFAULT map(),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum (MetricName, Attributes, TimeUnix, Value) VALUES
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 0.0),
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 60.0),
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 120.0),
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 180.0),
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 240.0),
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 300.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 0.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 30.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 60.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 90.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 120.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 150.0);
