    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 120.0),
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 180.0),
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 240.0),
    ('cerberus_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 300.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 0.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 30.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 60.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 90.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 120.0),
    ('cerberus_attempts_total', map('job', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 150.0);
