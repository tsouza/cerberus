    ('http_requests_a_total', map('job', 'web'),   toDateTime64('2026-01-01 00:00:00', 9), 400.0),
    ('http_requests_b_total', map('job', 'api'),   toDateTime64('2025-12-31 23:59:31', 9), 5.0),
    ('http_requests_b_total', map('job', 'api'),   toDateTime64('2026-01-01 00:00:00', 9), 20.0),
    ('http_requests_b_total', map('job', 'web'),   toDateTime64('2025-12-31 23:59:31', 9), 50.0),
    ('http_requests_b_total', map('job', 'web'),   toDateTime64('2026-01-01 00:00:00', 9), 200.0);
