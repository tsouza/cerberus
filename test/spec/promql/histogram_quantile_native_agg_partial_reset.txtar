-- query.promql --
histogram_quantile(0.5, sum by(le)(rate(latency_exp_hist[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- The same restart exp_histogram_increase_partial_reset seeds, read
-- through the OTHER path that shares the window fold: the aggregated
-- `histogram_quantile` idiom. One defect, two callers (#2017), and this
-- is the one where it is partly masked — a quantile reads only the
-- RATIOS between buckets, so a miscount that scaled every bucket alike
-- would cancel out of the answer entirely. This one does not scale them
-- alike, which is exactly why it survives to the answer here too.
--
--   TimeUnix   Count   Sum   buckets
--   23:58:01     10    5.0   [ 8, 2]
--   23:59:01     20   10.0   [16, 4]
--   00:00:01     12    6.0   [ 5, 7]     <- the process restarted
--
-- Count fell, so reference's `FloatHistogram.DetectReset` condemns the
-- whole third sample and adds the whole second one back:
--
--   bucket 1   (16-8) + 5 = 13
--   bucket 2   ( 4-2) + 7 =  9    (7 > 4, so this bucket alone says "no reset")
--
-- Both buckets then take the same boundary-extrapolation factor of 1.25
-- (see exp_histogram_increase_partial_reset for its derivation), giving
-- [16.25, 11.25] — a distribution whose median sits proportionally
-- further into the first bucket than the [16.25, 6.25] a per-component
-- reset rule would build. Scale 0 puts bucket 1 over (1, 2], so the
-- answer is a point inside that interval either way, and the two
-- readings differ in where.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:58:01', 9), 10,  5.0, 0, 0, 0, [ 8, 2], 0, []),
    ('latency_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:59:01', 9), 20, 10.0, 0, 0, 0, [16, 4], 0, []),
    ('latency_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:01', 9), 12,  6.0, 0, 0, 0, [ 5, 7], 0, []);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 1.7977019463910837]
]
