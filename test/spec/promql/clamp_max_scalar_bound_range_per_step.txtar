# A computed scalar argument is re-evaluated at EVERY step of a range
# query, exactly as reference Prometheus does (`newFParams` evaluates the
# parameter expression once per evaluation step before the enclosing call
# sees it). This fixture is the executable proof, so its scalar source
# deliberately CHANGES across the window: `bound` climbs by 10 each
# minute while `cpu` is a flat 100, and over the fixture's
# `[2026-01-01 00:00:00, 00:05:00]` window at a 1m step the anchors that
# have a bound must clamp to 30, 40, 50, 60.
#
# Binding the scalar ONCE for the whole statement — the shape a lowering
# gets by forcing the argument into an instant context — cannot produce
# that: it yields the same number at all six anchors. A fixture whose
# scalar source is constant cannot tell the two apart, which is why this
# one varies at every anchor.
#
# `bound` also deliberately starts LATE, at 00:02. The first two anchors
# have no bound sample within the 5m lookback, so `scalar(bound)` is NaN
# there and reference's clamp — `math.Max(-Inf, math.Min(NaN, 100))` —
# is NaN. That covers the branch the per-step lookup table can most
# easily get wrong: a key the map does not hold must read back NULL and
# become NaN, not ClickHouse's zero-valued default for the element type,
# which would silently clamp to 0.
-- query.promql --
clamp_max(cpu, scalar(bound))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('cpu', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 100.0),
    ('cpu', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 100.0),
    ('cpu', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 100.0),
    ('cpu', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 100.0),
    ('cpu', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 100.0),
    ('cpu', map('job', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 100.0);
INSERT INTO otel_metrics_gauge VALUES
    ('bound', map('env', 'prod'), toDateTime64('2026-01-01 00:02:00', 9), 30.0),
    ('bound', map('env', 'prod'), toDateTime64('2026-01-01 00:03:00', 9), 40.0),
    ('bound', map('env', 'prod'), toDateTime64('2026-01-01 00:04:00', 9), 50.0),
    ('bound', map('env', 'prod'), toDateTime64('2026-01-01 00:05:00', 9), 60.0);
