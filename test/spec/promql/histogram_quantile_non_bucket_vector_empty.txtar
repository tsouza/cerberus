`vector(1)` outputs one sample with no labels, so it provably carries no
`le` and histogram_quantile over it is Prometheus's empty vector. The
lowering folds it to that empty vector without evaluating it.

-- query.promql --
histogram_quantile(0.9, vector(1))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String, Attributes Map(String, String), ResourceAttributes Map(String, String),
    TimeUnix DateTime64(9), Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job','a'), map(), toDateTime64('2026-01-01 00:00:00', 9), 1.0);
-- expected_rows --
[]
