# histogram_quantiles with a computed phi small enough to render in
# scientific notation (#1765). The sibling fixture pins phi = 0.5, which
# leaves the formatter's fixed-notation arm; this one crosses the
# `abs(v) < 1e-4` boundary and renders through the scientific arm, the
# only arm that derives an exponent.
#
# Prometheus formats the label with strconv.FormatFloat(f, 'g', -1, 64):
# 1e-05 has decimal exponent -5, outside [-4, 6), so Go writes scientific
# notation and pads the exponent to two digits — "1e-05", never "1e-5".
# The mantissa is a single digit, so no ".0" is appended (the string
# already carries an 'e').
#
# What this fixture is for is the LABEL, not the quantile: the value at
# this phi is the ordinary first-bucket interpolation the phi = 0.5
# fixture already covers. The exponent arm was reachable only after the
# computed-phi guard came down, and it was the arm whose integer
# sub-expressions had no common ClickHouse supertype.
-- query.promql --
histogram_quantiles(http_server_request_duration_bucket, "q", scalar(phi_k))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [1, 2, 3], [0.1, 0.5, 1.0]);
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('phi_k', map(), toDateTime64('2026-01-01 00:00:00', 9), 0.00001);
