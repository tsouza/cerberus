# Range-query counterpart of histogram_quantile_native_delta_temporality. The
# fanout's per-(anchor, series) aggregate must carry the DELTA temporality into
# the native histogram window fold.
-- query.promql --
histogram_quantile(0.5, rate(delta_quantile_range_exp_hist[1m]))
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
