ap(krrc -> FnToFloat64(krrc), FnArraySlice(cs, 1, FnLength(bs))), bs)))[1], FnArray(FnArrayFilter(krx -> FnNot((FnIsNaN(krx) OR FnIsInfinite(krx))), bs)))[1], _hq_bounds_list, _hq_counts_list, _hq_ts_list)))[1] AS _hq_window_ladder]
