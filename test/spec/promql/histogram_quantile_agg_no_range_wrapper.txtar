-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, if(length(`BucketCounts`) = 0, nan, if(`_cerb_hqc_observations` = 0, nan, if(0.5 < 0, -inf, if(0.5 > 1, inf, if(`_cerb_hqc_idx` = length(`_cerb_hqc_cum`) AND length(`_cerb_hqc_buckets`) != length(`ExplicitBounds`), if(length(`ExplicitBounds`) = 0, nan, `_cerb_hqc_bounds`[length(`_cerb_hqc_bounds`)]), if(`_cerb_hqc_idx` = 1 AND `_cerb_hqc_bounds`[1] <= 0, `_cerb_hqc_bounds`[1], (if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1]) + (`_cerb_hqc_bounds`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1])) * (((0.5 * `_cerb_hqc_observations`) - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])) / (`_cerb_hqc_cum`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])))))))))) AS `Value` FROM (SELECT *, arrayFirstIndex(c -> c >= (0.5 * `_cerb_hqc_observations`), `_cerb_hqc_cum`) AS `_cerb_hqc_idx` FROM (SELECT *, `_cerb_hqc_cum`[length(`_cerb_hqc_cum`)] AS `_cerb_hqc_observations` FROM (SELECT *, arrayFilter((b, k) -> k, `ExplicitBounds`, `_cerb_hqc_kept_mask`) AS `_cerb_hqc_bounds`, arrayFilter((c, k) -> k, arrayResize(`_cerb_hqc_buckets`, greatest(length(`_cerb_hqc_buckets`), length(`ExplicitBounds`))), arrayConcat(`_cerb_hqc_kept_mask`, arrayWithConstant(greatest(length(`_cerb_hqc_buckets`) - length(`ExplicitBounds`), 0), 1))) AS `_cerb_hqc_cum` FROM (SELECT *, arrayMap((b, p) -> b != p, `ExplicitBounds`, arraySlice(arrayPushFront(`ExplicitBounds`, nan), 1, length(`ExplicitBounds`))) AS `_cerb_hqc_kept_mask`, arrayMap(x -> toFloat64(x), `BucketCounts`) AS `_cerb_hqc_buckets` FROM (SELECT `_cerb_histogram_input`.1 AS `Attributes`, `_cerb_histogram_input`.2 AS `BucketCounts`, `_cerb_histogram_input`.3 AS `ExplicitBounds` FROM (SELECT arrayJoin([(`Attributes`, `BucketCounts`, `ExplicitBounds`)]) AS `_cerb_histogram_input` FROM (SELECT `Attributes` AS `Attributes`, arrayMap(kpl -> arrayMap(kpr -> arrayMap(kpm -> arrayFill((kpv, kpk) -> kpk, kpl, arrayMap((kpa, kpb) -> ((kpa > ?) AND (kpa = kpb)), kpr, kpm)), array(arrayMap((kpa, kpb) -> (kpa + kpb), kpr, arrayCumSumNonNegative(arrayMap(kpd -> (? - kpd), arrayDifference(kpr))))))[?], array(arrayMap((kpa, kpv) -> if(isNaN(kpv), ?, toInt64(kpa)), arraySort((kpk, kpp) -> kpp, arrayEnumerate(kpl), arraySort((kpi, kpv) -> tuple(kpv, (? - kpi)), arrayEnumerate(kpl), kpl)), kpl)))[?], array(tupleElement(`_hq_merged`, ?)))[?] AS `BucketCounts`, tupleElement(`_hq_merged`, ?) AS `ExplicitBounds` FROM (SELECT CAST(map(), ?) AS `Attributes`, arrayMap(kme -> arrayMap(kmeb -> arrayMap(kmev -> arrayMap(kmb -> arrayMap(kms -> arrayMap(kmu -> tuple(kmu, arrayConcat(arrayMap(kmr -> arraySum(kmr), arraySplit((kmx, kmf) -> kmf, arraySort((kmx, kmk, kmi) -> tuple(kmk, kmi), kmev, kmeb, arrayEnumerate(kmeb)), kms)), array(arraySum(arrayMap(cs -> toFloat64(arraySum(cs)), arraySlice(`_hq_counts_list`, ?, (length(`_hq_counts_list`) + throwIf((`_hq_merge_entries` > ?), 'classic-histogram bucket merge exceeds the merged-bucket-entry resource bound')))))))), array(arrayFilter((kmx, kmf) -> kmf, kmb, kms)))[?], array(arrayMap((kmd, kmi) -> ((kmi = ?) OR (kmd != ?)), arrayDifference(kmb), arrayEnumerate(kmb))))[?], array(arraySort((kmx, kmk, kmi) -> tuple(kmk, kmi), kmeb, kmeb, arrayEnumerate(kmeb))))[?], array(arrayFlatten(arrayMap(kmx -> tupleElement(kmx, ?), kme))))[?], array(arrayFlatten(arrayMap(kmx -> tupleElement(kmx, ?), kme))))[?], array(arrayMap((bs, cs) -> arrayMap(kreb -> arrayMap(krev -> arrayMap(krb -> arrayMap(krs -> arrayMap(kru -> tuple(kru, arrayCumSum(arrayMap(krr -> arraySum(krr), arraySplit((krx, krf) -> krf, arraySort((krx, krk, kri) -> tuple(krk, kri), krev, kreb, arrayEnumerate(kreb)), krs)))), array(arrayFilter((krx, krf) -> krf, krb, krs)))[?], array(arrayMap((krd, kri) -> ((kri = ?) OR (krd != ?)), arrayDifference(krb), arrayEnumerate(krb))))[?], array(arraySort((krx, krk, kri) -> tuple(krk, kri), kreb, kreb, arrayEnumerate(kreb))))[?], array(arrayFilter((krrc, krrb) -> not((isNaN(krrb) OR isInfinite(krrb))), arrayMap(krrc -> toFloat64(krrc), arraySlice(cs, ?, length(bs))), bs)))[?], array(arrayFilter(krx -> not((isNaN(krx) OR isInfinite(krx))), bs)))[?], arraySlice(`_hq_bounds_list`, ?, (length(`_hq_bounds_list`) + throwIf((`_hq_merge_entries` > ?), 'classic-histogram bucket merge exceeds the merged-bucket-entry resource bound'))), arraySlice(`_hq_counts_list`, ?, (length(`_hq_counts_list`) + throwIf((`_hq_merge_entries` > ?), 'classic-histogram bucket merge exceeds the merged-bucket-entry resource bound'))))))[?] AS `_hq_merged` FROM (SELECT `_hq_bounds_list`, `_hq_counts_list`, `_hq_merge_entries` FROM (SELECT groupArray(`ExplicitBounds`) AS `_hq_bounds_list`, groupArray(`BucketCounts`) AS `_hq_counts_list`, sum((length(`ExplicitBounds`) + ?)) AS `_hq_merge_entries`, count() AS `_cerb_n` FROM (SELECT `Attributes` AS `Attributes`, arrayConcat(arraySlice(tupleElement(`_hq_window_ladder`, ?), ?, ?), arrayPopFront(arrayDifference(tupleElement(`_hq_window_ladder`, ?)))) AS `BucketCounts`, tupleElement(`_hq_window_ladder`, ?) AS `ExplicitBounds` FROM (SELECT `Attributes` AS `Attributes`, arrayMap(kwe -> arrayMap(kweb -> arrayMap(kwev -> arrayMap(kwet -> arrayMap(kwb -> arrayMap(kws -> arrayMap(kwu -> tuple(kwu, arrayConcat(arrayMap((kwr, kwo) -> arraySort((c, t) -> t, kwr, kwo)[length(arraySort((c, t) -> t, kwr, kwo))], arraySplit((kwx, kwf) -> kwf, arraySort((kwx, kwk, kwi) -> tuple(kwk, kwi), kwev, kweb, arrayEnumerate(kweb)), kws), arraySplit((kwx, kwf) -> kwf, arraySort((kwx, kwk, kwi) -> tuple(kwk, kwi), kwet, kweb, arrayEnumerate(kweb)), kws)), array(arraySort((c, t) -> t, arrayMap(cs -> toFloat64(arraySum(cs)), `_hq_counts_list`), `_hq_ts_list`)[length(arraySort((c, t) -> t, arrayMap(cs -> toFloat64(arraySum(cs)), `_hq_counts_list`), `_hq_ts_list`))]))), array(arrayFilter((kwx, kwf) -> kwf, kwb, kws)))[?], array(arrayMap((kwd, kwi) -> ((kwi = ?) OR (kwd != ?)), arrayDifference(kwb), arrayEnumerate(kwb))))[?], array(arraySort((kwx, kwk, kwi) -> tuple(kwk, kwi), kweb, kweb, arrayEnumerate(kweb))))[?], array(arrayFlatten(arrayMap(kwx -> tupleElement(kwx, ?), kwe))))[?], array(arrayFlatten(arrayMap(kwx -> tupleElement(kwx, ?), kwe))))[?], array(arrayFlatten(arrayMap(kwx -> tupleElement(kwx, ?), kwe))))[?], array(arrayMap((bs, cs, kwrt) -> arrayMap(kreb -> arrayMap(krev -> arrayMap(krb -> arrayMap(krs -> arrayMap(kru -> tuple(kru, arrayCumSum(arrayMap(krr -> arraySum(krr), arraySplit((krx, krf) -> krf, arraySort((krx, krk, kri) -> tuple(krk, kri), krev, kreb, arrayEnumerate(kreb)), krs))), arrayWithConstant(length(kru), kwrt)), array(arrayFilter((krx, krf) -> krf, krb, krs)))[?], array(arrayMap((krd, kri) -> ((kri = ?) OR (krd != ?)), arrayDifference(krb), arrayEnumerate(krb))))[?], array(arraySort((krx, krk, kri) -> tuple(krk, kri), kreb, kreb, arrayEnumerate(kreb))))[?], array(arrayFilter((krrc, krrb) -> not((isNaN(krrb) OR isInfinite(krrb))), arrayMap(krrc -> toFloat64(krrc), arraySlice(cs, ?, length(bs))), bs)))[?], array(arrayFilter(krx -> not((isNaN(krx) OR isInfinite(krx))), bs)))[?], `_hq_bounds_list`, `_hq_counts_list`, `_hq_ts_list`)))[?] AS `_hq_window_ladder` FROM (SELECT mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, groupArray(`ExplicitBounds`) AS `_hq_bounds_list`, groupArray(`BucketCounts`) AS `_hq_counts_list`, groupArray(`TimeUnix`) AS `_hq_ts_list`, uniqExact(`TimeUnix`) AS `_hq_samples` FROM (SELECT * FROM `otel_metrics_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)) WHERE (`TimeUnix` <= parseDateTime64BestEffort(?, ?)) AND (`TimeUnix` > (parseDateTime64BestEffort(?, ?) - toIntervalNanosecond(?))) AND not((bitAnd(`Flags`, ?) != ?))) GROUP BY `Attributes`)))) WHERE `_cerb_n` > 0))))))))))
