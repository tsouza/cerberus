-- query.promql --
http_server_duration_exp_hist + on(region) http_client_duration_exp_hist
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- `+` between two DIFFERENT exp-histogram metrics under `on(region)`
-- custom vector matching (cerberus issue #2273, gap 1). Reference
-- Prometheus's vector-matching machinery (which pair of series combine)
-- is orthogonal to the per-pair histogram Add — `on(region)` reduces the
-- match key to the `region` label alone, so a server/client pair that
-- disagree on `az` still merge as long as `region` agrees, and the
-- result keeps ONLY the `region` label (Prometheus's resultMetric
-- Keep() rule for on()):
--
--   `us`: server (az=us-1) and client (az=us-2) share region=us, so
--   `on(region)` matches them despite the differing `az` — merged
--   Count=10+5=15, Sum=1.0+0.5=1.5, buckets [1,2]+[3,4]=[4,6] (both
--   already Scale=0, PositiveOffset=0), output Attributes={region:"us"}
--   (`az` dropped — on() keeps only the listed labels).
--
--   `eu`: server only, no client counterpart at region=eu — PromQL's
--   default one-to-one V-V matching (still one-to-one under on()) drops
--   an unmatched series, so it never reaches the output.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('region', 'us', 'az', 'us-1'), toDateTime64('2026-01-01 00:00:00', 9), 10, 1.0, 0, 0, 0, [1, 2], 0, []),
    ('http_client_duration_exp_hist', map('region', 'us', 'az', 'us-2'), toDateTime64('2026-01-01 00:00:00', 9), 5,  0.5, 0, 0, 0, [3, 4], 0, []),
    ('http_server_duration_exp_hist', map('region', 'eu', 'az', 'eu-1'), toDateTime64('2026-01-01 00:00:00', 9), 2,  0.2, 0, 0, 0, [1],    0, []);
-- expected_rows --
[
  ["", {"region": "us"}, "2026-01-01T00:00:01Z", 0, 15, 1.5, 0, 0, 0, 0, [4,6], 0, []]
]
