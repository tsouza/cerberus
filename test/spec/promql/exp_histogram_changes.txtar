-- query.promql --
changes(http_server_duration_exp_hist[5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- ONE series, five in-window samples, so the answer is a count over the
-- four consecutive PAIRS. Reference's funcChanges counts the pairs where
-- `!curSample.H.Equals(prevSample.H)` — structural whole-row inequality,
-- NOT the directional regression `resets()` tests.
--
-- Each pair isolates ONE field, so a verdict that forgot any single field
-- would under-count by exactly one and a verdict that reused the reset
-- kernel would get a different number entirely:
--
--   t1 vs t0: byte-for-byte IDENTICAL                     -> no change
--   t2 vs t1: buckets [2,3,5] -> [2,4,4], Count and Sum   -> CHANGE (buckets alone)
--             both UNCHANGED
--   t3 vs t2: Sum 5.0 -> 6.0, everything else unchanged   -> CHANGE (Sum alone)
--   t4 vs t3: ZeroCount 0 -> 1, everything else unchanged -> CHANGE (ZeroCount alone)
--
-- Answer: 3 of 4 pairs.
--
-- The identical pair is what pins the "any change" reading as EQUALITY
-- rather than "a new sample arrived": a verdict that counted every pair
-- would report 4. The Count-and-Sum-preserving bucket move is what pins
-- that the ladder is compared at all — reference's Equals reads every
-- bucket, and this pair is invisible to any reading that stops at the
-- whole-histogram scalars.
--
-- Contrast with exp_histogram_resets.txtar deliberately: over THIS seed
-- `resets()` would answer 1 (only t2's bucket[2] 5 -> 4 regresses; the
-- Sum and ZeroCount pairs are not regressions at all, and DetectReset
-- does not read Sum). Same samples, different question, different number.
--
-- `changes()` drops __name__ but KEEPS the series' own labels, so the
-- output series is ["", {"service":"api"}] and the value is a plain
-- float: 3.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:56:30', 9), 10, 5.0, 0, 0, 0, [2, 3, 5], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:57:30', 9), 10, 5.0, 0, 0, 0, [2, 3, 5], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:58:30', 9), 10, 5.0, 0, 0, 0, [2, 4, 4], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:59:30', 9), 10, 6.0, 0, 0, 0, [2, 4, 4], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 10, 6.0, 0, 1, 0, [2, 4, 4], 0, []);
-- expected_rows --
[
  ["", {"service": "api"}, "2026-01-01T00:00:01Z", 3]
]
