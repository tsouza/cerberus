-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, FnNow64(9) AS TimeUnix, Value AS Value]
  Project [Attributes AS Attributes, FnToFloat64(FnArraySum(FnArrayMap(wcp -> FnArrayMap((ca, cb) -> ((((((((_hq_scales[cb] != _hq_scales[ca]) OR (_hq_count_list[cb] != _hq_count_list[ca])) OR ((_hq_sum_list[cb] != _hq_sum_list[ca]) AND FnNot((FnIsNaN(_hq_sum_list[cb]) AND FnIsNaN(_hq_sum_list[ca]))))) OR (_hq_zero_counts[cb] != _hq_zero_counts[ca])) OR (_hq_pos_offsets[cb] != _hq_pos_offsets[ca])) OR (_hq_pos_buckets[cb] != _hq_pos_buckets[ca])) OR (_hq_neg_offsets[cb] != _hq_neg_offsets[ca])) OR (_hq_neg_buckets[cb] != _hq_neg_buckets[ca])), FnArrayPopBack(wcp), FnArrayPopFront(wcp)), FnArray(FnArraySort((cp, ct) -> ct, FnArrayEnumerate(_hq_ts_list), _hq_ts_list)))[1])) AS Value]
    Aggregate groupBy=[FnMapSort(FnMapMerge(FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnMin(Scale) AS _hq_merged_scale, FnGroupArray(Scale) AS _hq_scales, FnGroupArray(ZeroCount) AS _hq_zero_counts, FnGroupArray(Count) AS _hq_count_list, FnGroupArray(PositiveOffset) AS _hq_pos_offsets, FnGroupArray(PositiveBucketCounts) AS _hq_pos_buckets, FnGroupArray(NegativeOffset) AS _hq_neg_offsets, FnGroupArray(NegativeBucketCounts) AS _hq_neg_buckets, FnGroupArray(TimeUnix) AS _hq_ts_list, FnGroupArray(Sum) AS _hq_sum_list, FnUniqExact(TimeUnix) AS _hq_samples]
      Filter predicate=(((MetricName IN ("http_server_duration_exp_hist", "http.server.duration.exp.hist", "http.server.duration.exp/hist", "http.server.duration.exp_hist", "http.server.duration/exp/hist", "http.server.duration/exp_hist", "http.server.duration_exp.hist", "http.server.duration_exp_hist", "http.server/duration/exp/hist", "http.server/duration/exp_hist", "http.server/duration_exp_hist", "http.server_duration.exp.hist", "http.server_duration.exp_hist", "http.server_duration_exp.hist", "http.server_duration_exp_hist", "http/server/duration/exp/hist", "http/server/duration/exp_hist", "http/server/duration_exp_hist", "http/server_duration_exp_hist", "http_server.duration.exp.hist", "http_server.duration.exp_hist", "http_server.duration_exp.hist", "http_server.duration_exp_hist", "http_server_duration.exp.hist", "http_server_duration.exp_hist", "http_server_duration_exp.hist")) AND (TimeUnix <= FnToDateTime64("2026-01-01 00:00:01.000000000", 9))) AND (TimeUnix > (FnToDateTime64("2026-01-01 00:00:01.000000000", 9) - FnToIntervalNanosecond(300000000000))))
        Scan(otel_metrics_exponential_histogram)
-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, toFloat64(arraySum(arrayMap(wcp -> arrayMap((ca, cb) -> ((((((((`_hq_scales`[cb] != `_hq_scales`[ca]) OR (`_hq_count_list`[cb] != `_hq_count_list`[ca])) OR ((`_hq_sum_list`[cb] != `_hq_sum_list`[ca]) AND not((isNaN(`_hq_sum_list`[cb]) AND isNaN(`_hq_sum_list`[ca]))))) OR (`_hq_zero_counts`[cb] != `_hq_zero_counts`[ca])) OR (`_hq_pos_offsets`[cb] != `_hq_pos_offsets`[ca])) OR (`_hq_pos_buckets`[cb] != `_hq_pos_buckets`[ca])) OR (`_hq_neg_offsets`[cb] != `_hq_neg_offsets`[ca])) OR (`_hq_neg_buckets`[cb] != `_hq_neg_buckets`[ca])), arrayPopBack(wcp), arrayPopFront(wcp)), array(arraySort((cp, ct) -> ct, arrayEnumerate(`_hq_ts_list`), `_hq_ts_list`)))[?])) AS `Value` FROM (SELECT mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, min(`Scale`) AS `_hq_merged_scale`, groupArray(`Scale`) AS `_hq_scales`, groupArray(`ZeroCount`) AS `_hq_zero_counts`, groupArray(`Count`) AS `_hq_count_list`, groupArray(`PositiveOffset`) AS `_hq_pos_offsets`, groupArray(`PositiveBucketCounts`) AS `_hq_pos_buckets`, groupArray(`NegativeOffset`) AS `_hq_neg_offsets`, groupArray(`NegativeBucketCounts`) AS `_hq_neg_buckets`, groupArray(`TimeUnix`) AS `_hq_ts_list`, groupArray(`Sum`) AS `_hq_sum_list`, uniqExact(`TimeUnix`) AS `_hq_samples` FROM (SELECT * FROM `otel_metrics_exponential_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)) WHERE (`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?)))) GROUP BY `Attributes`))
