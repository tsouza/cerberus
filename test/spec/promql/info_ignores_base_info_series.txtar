# `info()` never enriches a base series that is ITSELF an info series.
# The reference engine collects every base series whose `__name__`
# matches all the effective name matchers into `ignoreSeries`
# (promql/info.go::evalInfo) and appends those samples to the output
# verbatim, BEFORE the data-label and drop logic runs
# (combineWithInfoVector).
#
# Here the base vector IS `target_info`, and the effective name matcher
# is the default `__name__="target_info"` — so every base series is in
# the ignore set and the call is a pass-through.
#
# The `{version=~".+"}` data-label matcher cannot match the empty
# string, which is what makes this observable: without the carve-out the
# join is an INNER JOIN, and the `target_info` series carrying no
# `version` at all finds no partner on the info side and is DROPPED.
# Upstream keeps it, un-enriched. Both seeded series must come back
# exactly as stored.

-- query.promql --
info(target_info, {version=~".+"})
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('target_info', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('target_info', map('job', 'db', 'version', '1.2.3'), toDateTime64('2026-01-01 00:00:00', 9), 1.0);
-- expected_rows --
[
  ["target_info", {"job": "api"}, "2026-01-01T00:00:00Z", 1],
  ["target_info", {"job": "db", "version": "1.2.3"}, "2026-01-01T00:00:00Z", 1]
]
-- args --
[0] string = "service.name"
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = ""
[5] string = "service_name"
[6] string = "target_info"
[7] string = "target.info"
[8] string = "target/info"
[9] string = "2026-01-01 00:00:01.000000000"
[10] int64 = 9
[11] string = "2026-01-01 00:00:01.000000000"
[12] int64 = 9
[13] int64 = 300000000000
-- chplan --
Project [MetricName AS MetricName, Attributes AS Attributes, lwr_ts AS TimeUnix, lwr_value AS Value]
  Aggregate groupBy=[MetricName AS MetricName, Attributes AS Attributes] funcs=[max(TimeUnix) AS lwr_ts, argMax(Value, TimeUnix) AS lwr_value]
    Filter predicate=((TimeUnix <= toDateTime64("2026-01-01 00:00:01.000000000", 9)) AND (TimeUnix > (toDateTime64("2026-01-01 00:00:01.000000000", 9) - toIntervalNanosecond(300000000000))))
      Project [MetricName AS MetricName, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
        Filter predicate=(MetricName IN ("target_info", "target.info", "target/info"))
          Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- sql --
SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, `lwr_ts` AS `TimeUnix`, `lwr_value` AS `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, max(`TimeUnix`) AS `lwr_ts`, argMax(`Value`, `TimeUnix`) AS `lwr_value` FROM (SELECT * FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?)))) WHERE ((`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?))))) GROUP BY `MetricName`, `Attributes`)
