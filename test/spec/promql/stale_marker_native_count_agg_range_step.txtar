# Seed: the native histogram `stale_exp_hist` is scraped every 30s. Series
# job="a" is scraped until 23:59:00; its target then disappears and the
# collector writes a NoRecordedValue data point (Flags = 1, empty bucket
# arrays) at 23:59:30, and the target returns at 00:02:00 with its counters
# continuing. Series job="b" is scraped throughout. Reference Prometheus holds
# that data point as a native-histogram stale marker on job="a".
#
# count() counts each series' instant selection, so job="a" is not counted
# from 00:00:00 to 00:01:30 although its 23:59:00 sample is inside the
# 5m lookback, and answers again from 00:02:00.

-- query.promql --
count(stale_exp_hist)
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64),
    Flags UInt32
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram (MetricName, Attributes, TimeUnix, Count, Sum, Scale, ZeroCount, PositiveOffset, PositiveBucketCounts, NegativeOffset, NegativeBucketCounts, Flags) VALUES
