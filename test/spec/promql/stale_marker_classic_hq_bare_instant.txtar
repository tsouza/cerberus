# Seed: the classic histogram `stale_hist` is scraped every 30s. Series
# job="a" is scraped until 23:59:00; its target then disappears and the
# collector writes a NoRecordedValue data point (Flags = 1, empty
# BucketCounts / ExplicitBounds) at 23:59:30, and the target returns at
# 00:02:00 with its counters continuing. Series job="b" is scraped
# throughout. Reference Prometheus holds that data point as a stale marker on
# every `_bucket` series, `_count` and `_sum` of job="a".
#
# At 00:00:01 the newest job="a" sample is the marker, so only job="b"
# has a quantile.

-- query.promql --
histogram_quantile(0.5, stale_hist_bucket)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64),
    Flags UInt32
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram (MetricName, Attributes, TimeUnix, Count, Sum, BucketCounts, ExplicitBounds, Flags) VALUES
    ('stale_hist', map('job', 'a'), toDateTime64('2025-12-31 23:56:00', 9), 4, 10.0, [1, 2, 1], [1.0, 5.0], 0),
