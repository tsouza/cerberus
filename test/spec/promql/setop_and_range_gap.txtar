# `and` in range mode (Step > 0), where the right arm covers only part
# of the step grid.
#
# PromQL keeps a left-arm sample at a given evaluation timestamp only
# when the right arm produced a matching series AT THAT SAME timestamp.
# The arms cover overlapping but different anchor spans, because the 5m
# lookback window is half-open — a sample is in scope at anchor `t` when
# `t - 5m < sample <= t`:
#
#   left  (dense,  sample at 00:00) covers 00:00 00:01 00:02 00:03 00:04
#   right (sparse, sample at 00:03) covers 00:03 00:04 00:05
#
# Only the two anchors in the intersection survive.
#
# Matching on the label signature alone would let the right arm's
# presence ANYWHERE in the range admit the left arm EVERYWHERE,
# inventing the three early points the reference engine never emits. The
# match key is (signature, timestamp) in range mode precisely so those
# steps are dropped.

-- query.promql --
demo_dense_bytes and demo_sparse_bytes
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('demo_dense_bytes',  map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 100.0),
    ('demo_sparse_bytes', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 10.0);
