# `day_of_week()` — the zero-arg form. PromQL spec:
# `day_of_week()` ≡ `day_of_week(vector(time()))`. cerberus lowers
# it to a OneRow source. CH's `toDayOfWeek` returns 1-7 (Mon=1..Sun=7);
# PromQL `day_of_week` returns 0-6 (Sun=0..Sat=6) — `toDayOfWeek(d) % 7`
# bridges the gap.
#
# The result is wrapped in `toFloat64(...)`: `toDayOfWeek` returns
# UInt8, and the cursor decodes into `*float64`. Without the wrap
# the clickhouse-go/v2 driver errors with
# `converting UInt8 to *float64 is unsupported`. With the wrap CH
# projects the column as Float64 on the wire.

-- query.promql --
day_of_week()
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 4]
]
-- args --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] string = "2026-01-01 00:00:01.000000000Z"
[4] int64 = 9
[5] int64 = 1000000000
[6] int64 = 9223372028741760000
[7] int64 = 86400
[8] int64 = 3
[9] int64 = 7
-- chplan --
Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, FnToFloat64(FnModulo((FnIntDiv((FnReinterpretAsUInt64(FnIntDiv(FnToUnixNanos(FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9)), 1000000000)) + FnToUInt64(9223372028741760000)), 86400) + 3), 7)) AS Value]
  OneRow
-- sql --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64(modulo((intDiv((reinterpretAsUInt64(intDiv(toUnixTimestamp64Nano(parseDateTime64BestEffort(?, ?)), ?)) + toUInt64(?)), ?) + ?), ?)) AS `Value` FROM (SELECT 1)
-- args_optimized --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] string = "2026-01-01 00:00:01.000000000Z"
[4] int64 = 9
[5] int64 = 1000000000
[6] int64 = 9223372028741760000
[7] int64 = 86400
[8] int64 = 3
[9] int64 = 7
-- settings --
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
-- sql_optimized --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64(modulo((intDiv((reinterpretAsUInt64(intDiv(toUnixTimestamp64Nano(parseDateTime64BestEffort(?, ?)), ?)) + toUInt64(?)), ?) + ?), ?)) AS `Value` FROM (SELECT 1)
