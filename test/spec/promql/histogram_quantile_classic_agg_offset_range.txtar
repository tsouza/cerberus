# `histogram_quantile(phi, sum by(le)(rate(<classic hist>[2m] offset 5m)))`
# over query_range. The aggregated path takes its window from the inner
# rate's `[2m]` rather than the 5m staleness horizon, so each anchor in
# `[00:00:00, 00:05:00]` reads `(anchor - 7m, anchor - 5m]` — the offset
# shifts the window without moving the emitted timestamp.
#
# The six seeded samples sit one minute apart from 23:54 to 23:59, inside the
# shifted windows; the 00:02 decoy carries a hundred-fold wider bound set
# and is outside every one of them, so it is what a dropped offset would
# surface.
#
# The 1m spacing against the 2m window is what keeps every emitting anchor at
# TWO samples: `rate` needs two points to span a delta and emits nothing where
# it has fewer. The 00:05 anchor reads `(23:58, 00:00]`, which holds only the
# 23:59 sample, so it drops out — the same leading/trailing-edge rule the
# unshifted fixtures pin.

-- query.promql --
histogram_quantile(0.95, sum by(le)(rate(http_server_request_duration[2m] offset 5m)))
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:54:00', 9), [1, 2, 3], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:55:00', 9), [1, 2, 3], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:56:00', 9), [3, 2, 1], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:57:00', 9), [1, 2, 3], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:58:00', 9), [1, 1, 1], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:59:00', 9), [1, 2, 3], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:02:00', 9), [1, 2, 3], [10.0, 50.0, 100.0]);
-- args --
[0] string = ""
[1] string = "Map(String,String)"
[2] string = "http_server_request_duration"
[3] string = "http.server.request.duration"
[4] string = "http.server.request/duration"
[5] string = "http.server.request_duration"
[6] string = "http.server/request/duration"
[7] string = "http.server/request_duration"
[8] string = "http.server_request.duration"
[9] string = "http.server_request_duration"
[10] string = "http/server/request/duration"
[11] string = "http/server/request_duration"
[12] string = "http/server_request_duration"
[13] string = "http_server.request.duration"
[14] string = "http_server.request_duration"
[15] string = "http_server_request.duration"
-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.95 groupBy=[anchor_ts AS anchor_ts, Attributes AS Attributes]
    Project [anchor_ts AS anchor_ts, CAST(map(), "Map(String,String)") AS Attributes, BucketCounts AS BucketCounts, ExplicitBounds AS ExplicitBounds]
      RangeBucketFanout step=1m0s lookback=2m0s offset=5m0s minSamples=2 groupBy=[ExplicitBounds AS ExplicitBounds] funcs=[sumForEach(BucketCounts) AS BucketCounts] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
        Filter predicate=(MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration"))
          Scan(otel_metrics_histogram)
-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, `anchor_ts` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, if(length(`BucketCounts`) = 0, nan, if(arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`)) = 0, nan, if(0.95 < 0, -inf, if(0.95 > 1, inf, if(arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = length(arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))), arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[length(arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1))))], (if(arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1, 0.0, arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) - 1]) + (arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1))))] - if(arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1, 0.0, arrayMap(i -> `ExplicitBounds`[i], arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)))[arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) - 1])) * ((0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))) - if(arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1, 0.0, arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))[arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) - 1])) / (arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))[arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1))))] - if(arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) = 1, 0.0, arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))[arrayFirstIndex(c -> c >= (0.95 * arraySum(arrayMap(x -> toFloat64(x), `BucketCounts`))), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayConcat(arrayFilter(i -> i = length(`ExplicitBounds`) OR `ExplicitBounds`[i] != `ExplicitBounds`[i + 1], range(1, length(`ExplicitBounds`) + 1)), range(length(`ExplicitBounds`) + 1, length(arrayMap(x -> toFloat64(x), `BucketCounts`)) + 1)))) - 1])))))))) AS `Value` FROM (SELECT `anchor_ts` AS `anchor_ts`, CAST(map(), ?) AS `Attributes`, `BucketCounts` AS `BucketCounts`, `ExplicitBounds` AS `ExplicitBounds` FROM (SELECT anchor_ts AS `anchor_ts`, `ExplicitBounds` AS `ExplicitBounds`, sumForEach(`BucketCounts`) AS `BucketCounts` FROM (SELECT *, arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 60000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))) - 120000000000, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))) - 120000000000, toInt64(60000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `TimeUnix`, (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))), toInt64(60000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))), toInt64(60000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT * FROM `otel_metrics_histogram` WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?))) WHERE `TimeUnix` > (toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(300000000000)) - toIntervalNanosecond(120000000000) AND `TimeUnix` <= (toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(300000000000))) GROUP BY anchor_ts, `ExplicitBounds` HAVING uniqExact(`TimeUnix`) >= 2)))
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:00Z", 1],
  ["", {}, "2026-01-01T00:01:00Z", 1],
  ["", {}, "2026-01-01T00:02:00Z", 1],
