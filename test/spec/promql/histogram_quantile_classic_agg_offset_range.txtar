# `histogram_quantile(phi, sum by(le)(rate(<classic hist>[2m] offset 5m)))`
# over query_range. The aggregated path takes its window from the inner
# rate's `[2m]` rather than the 5m staleness horizon, so each anchor in
# `[00:00:00, 00:05:00]` reads `(anchor - 7m, anchor - 5m]` — the offset
# shifts the window without moving the emitted timestamp.
#
# The six seeded samples sit one minute apart from 23:54 to 23:59, inside the
# shifted windows; the 00:02 decoy carries a hundred-fold wider bound set
# and is outside every one of them, so it is what a dropped offset would
# surface.
#
# The 1m spacing against the 2m window is what keeps every emitting anchor at
# TWO samples: `rate` needs two points to span a delta and emits nothing where
# it has fewer. The 00:05 anchor reads `(23:58, 00:00]`, which holds only the
# 23:59 sample, so it drops out — the same leading/trailing-edge rule the
# unshifted fixtures pin.
#
# Each pair of consecutive samples carries a DIFFERENT per-bucket increase —
# not a constant scale-up — so a wrong offset (reading the wrong pair) would
# read as a wrong VALUE, not merely a wrong row count. The per-sample
# cumulative-over-time BucketCounts (bounds 0.1/0.5/1.0, zero overflow) are:
#
#   23:54 [0,0,0,0]   23:55 [0,0,20,0]   23:56 [0,20,20,0]
#   23:57 [20,20,20,0]  23:58 [25,30,25,0]  23:59 [27,38,35,0]
#
# giving per-window rung deltas (cumulative-over-bucket-index, at
# 0.1/0.5/1.0/+Inf) of [0,0,20,20], [0,20,20,20], [20,20,20,20],
# [5,15,20,20], [2,10,20,20] for anchors 00:00..00:04 respectively — each
# hand-verified against Prometheus's own histogram_quantile interpolation
# (promql/quantile.go): rank = phi * total, then either the first-bucket
# `bound * (rank / rung)` form or the between-buckets linear interpolation,
# depending which rung the rank first meets or exceeds.

-- query.promql --
histogram_quantile(0.95, sum by(le)(rate(http_server_request_duration_bucket[2m] offset 5m)))
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:54:00', 9), [0, 0, 0, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:55:00', 9), [0, 0, 20, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:56:00', 9), [0, 20, 20, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:57:00', 9), [20, 20, 20, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:58:00', 9), [25, 30, 25, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:59:00', 9), [27, 38, 35, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:02:00', 9), [1, 2, 3], [10.0, 50.0, 100.0]);
