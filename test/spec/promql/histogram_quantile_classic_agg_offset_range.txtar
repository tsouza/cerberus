      Project [anchor_ts AS anchor_ts, CAST(map(), "Map(String,String)") AS Attributes, arrayConcat(arrayMap(u -> arraySum(arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((b <= u), toFloat64(c), 0), bs, arraySlice(cs, 1, length(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)), arraySort(arrayDistinct(arrayFlatten(_hq_bounds_list)))), array(arraySum(arrayMap(cs -> toFloat64(arraySum(cs)), _hq_counts_list)))) AS _hq_ladder, arraySort(arrayDistinct(arrayFlatten(_hq_bounds_list))) AS ExplicitBounds]
        Aggregate groupBy=[anchor_ts AS anchor_ts] funcs=[groupArray(ExplicitBounds) AS _hq_bounds_list, groupArray(BucketCounts) AS _hq_counts_list]
          Project [anchor_ts AS anchor_ts, Attributes AS Attributes, arrayMap(j -> if((j = 1), _hq_window_ladder[j], (_hq_window_ladder[j] - _hq_window_ladder[(j - 1)])), arrayEnumerate(_hq_window_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
