# expected_rows is intentionally empty. Reference Prometheus's PreprocessExpr
# wraps an `@`-pinned subquery argument in a StepInvariantExpr unless the
# call around it is step invariant, and predict_linear is in
# AtModifierUnsafeFunctions, so it never is. The evaluator then finds no range
# vector among predict_linear's arguments and funcPredictLinear answers an
# empty vector, at every evaluation instant, although the subquery itself
# holds five points on a line.

-- query.promql --
predict_linear(vector(time())[5m:1m] @ 1767225600, 60)
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
60s
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('machine_load', map('job', 'api'), toDateTime64('2025-12-31 23:59:00', 9), 1.0);
-- expected_rows --
[]
-- args --
[0] string = ""
[1] string = "Map(String,String)"
[2] float64 = 0
[3] float64 = -1
-- args_optimized --
[0] string = ""
[1] string = "Map(String,String)"
[2] float64 = 0
[3] float64 = -1
-- chplan --
Filter predicate=(Value < -1)
  Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, anchor_ts AS TimeUnix, 0 AS Value]
    StepGrid start=2026-01-01T00:00:00.000000000Z end=2026-01-01T00:05:00.000000000Z step=1m0s
-- settings --
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:filter;sg
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
-- sql --
SELECT * FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, `anchor_ts` AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) + toIntervalNanosecond(i * 60000000000), range(0, 6))) AS `anchor_ts`)) WHERE (`Value` < toFloat64(?))
-- sql_optimized --
SELECT * FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, `anchor_ts` AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) + toIntervalNanosecond(i * 60000000000), range(0, 6))) AS `anchor_ts`)) WHERE (`Value` < toFloat64(?))
