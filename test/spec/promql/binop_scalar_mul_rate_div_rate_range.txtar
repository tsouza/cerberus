# Regression: a scalar-wrapped rate arm feeding a step-aligned vector↔vector
# join used to fail at CH with `Unknown expression identifier '_join_TimeUnix'`
# (code 47). PromQL `2 * rate(m[5m]) / rate(m[5m])` lowers as
# `(2 * rate(m)) / rate(m)`; the left arm is the scalar-vector arithmetic
# Project produced by `lowerVectorScalar` -> `projectValueOverInner`. In range
# mode (Step > 0) the matrix RangeWindow surfaces `anchor_ts AS TimeUnix`, but
# the value-rewrite Project only forwarded `Attributes, anchor_ts, Value`,
# dropping `TimeUnix`. The wrapping VectorJoin then reads `argMax(Value,
# TimeUnix)` / aliases `TimeUnix AS _join_TimeUnix` off that arm, referencing a
# column that no longer materialises -> CH 47. The bare-rate arm keeps TimeUnix,
# so only the scalar-wrapped arm broke. The fix forwards `TimeUnix` through the
# matrix-shape value-rewrite Project. This mirrors the real prod-aws crash on
# `100 * rate(redis_keyspace_hits[5m]) / (rate(redis_keyspace_hits[5m]) +
# rate(redis_keyspace_misses[5m]))`. The chDB roundtrip below is the
# load-bearing proof: it executes the SQL and proves the column resolves.
#
# Value identity: `(2 * rate) / rate == 2` at every anchor.

-- query.promql --
2 * rate(req_total[5m]) / rate(req_total[5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('req_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 0.0),
    ('req_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 12.0),
    ('req_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 24.0),
    ('req_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 36.0),
    ('req_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 48.0),
    ('req_total', map('job', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 60.0);
