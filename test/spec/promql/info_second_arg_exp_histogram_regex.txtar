# Cerberus issue #2584: info(v, {label matchers})'s SECOND argument names
# an exponential-histogram metric through a REGEX `__name__` matcher
# (`=~`), the sibling of #2574's PINNED-equality case
# (info_second_arg_exp_histogram.txtar). A regex/negated `__name__`
# matcher routes through lowerRegexHistogramSelector
# (hasUnpinnedMetricNameMatcher) rather than the pinned selector path
# (expHistogramSelectorRouting) that #2574 fixed — a distinct code path
# with its own bare-exp-histogram-row arm to add. Reference Prometheus's
# info() (promql/info.go) only ever reads the info-metric series' LABELS
# for the identity-label join, so a base float vector still enriches
# normally even though the info metric the regex matches is stored as a
# native histogram row, not a plain Gauge/Sum sample.

-- query.promql --
info(up, {__name__=~".*_exp_hist"})
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job', 'api', 'instance', 'i1'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('up', map('job', 'db',  'instance', 'i2'), toDateTime64('2026-01-01 00:00:00', 9), 0.0);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('job', 'api', 'instance', 'i1', 'version', '1.2.3'), toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 0, 0, [1, 2, 3], 0, []),
    ('latency_exp_hist', map('job', 'db',  'instance', 'i2', 'version', '4.5.6'), toDateTime64('2026-01-01 00:00:00', 9), 4, 10.0, 0, 0, 0, [7],        0, []);
