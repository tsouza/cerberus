-- sql --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64((? - (intDiv(modulo(((? * intDiv(modulo(((? * intDiv(modulo(((? * intDiv((toUInt64(((intDiv((reinterpretAsUInt64(intDiv(toUnixTimestamp64Nano(parseDateTime64BestEffort(?, ?)), ?)) + toUInt64(?)), ?) + ?) - (intDiv(modulo(((? * intDiv(modulo(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(intDiv(toUnixTimestamp64Nano(parseDateTime64BestEffort(?, ?)), ?)) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?)) + ?), ?), ?) + ?))) * toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?)) + ?), ?), ?) + ?))) AS `Value` FROM (SELECT 1)
