-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64(?) AS `Value`, toFloat64(`Count`) AS `HistogramCount`, toFloat64(`Sum`) AS `HistogramSum`, toInt32(`Scale`) AS `HistogramScale`, toFloat64(0.) AS `HistogramZeroThreshold`, toFloat64(`ZeroCount`) AS `HistogramZeroCount`, toInt32(`PositiveOffset`) AS `HistogramPositiveOffset`, arrayMap(x -> toFloat64(x), `PositiveBucketCounts`) AS `HistogramPositiveBucketCounts`, toInt32(`NegativeOffset`) AS `HistogramNegativeOffset`, arrayMap(x -> toFloat64(x), `NegativeBucketCounts`) AS `HistogramNegativeBucketCounts` FROM (SELECT `Attributes` AS `Attributes`, arrayMap(wsr -> (wsr[length(wsr)] - wsr[(length(wsr) - ?)]), array(arraySort((c, t) -> t, arrayMap(n -> toFloat64(n), `_hq_count_list`), `_hq_ts_list`)))[?] AS `Count`, arrayMap(wsr -> (wsr[length(wsr)] - wsr[(length(wsr) - ?)]), array(arraySort((c, t) -> t, arrayMap(n -> toFloat64(n), `_hq_sum_list`), `_hq_ts_list`)))[?] AS `Sum`, `_hq_merged_scale` AS `Scale`, arrayMap(wsr -> (wsr[length(wsr)] - wsr[(length(wsr) - ?)]), array(arraySort((c, t) -> t, arrayMap(n -> toFloat64(n), `_hq_zero_counts`), `_hq_ts_list`)))[?] AS `ZeroCount`, arrayMin(arrayMap((s, off) -> bitShiftRight(off, (s - `_hq_merged_scale`)), `_hq_scales`, `_hq_pos_offsets`)) AS `PositiveOffset`, arrayMap(mst -> arrayMap(tb -> arrayMap(wsr -> (wsr[length(wsr)] - wsr[(length(wsr) - ?)]), array(arraySort((c, t) -> t, arrayMap(n -> toFloat64(n), arrayMap((s, off, arr) -> arrayMap(kh_final -> (tupleElement(kh_final, ?) + tupleElement(kh_final, ?)), array(arrayFold((kh_acc, kh_x) -> arrayMap(kh_total -> tuple(kh_total, if(isInfinite(kh_total), toFloat64(?), (tupleElement(kh_acc, ?) + if((abs(tupleElement(kh_acc, ?)) >= abs(kh_x)), ((tupleElement(kh_acc, ?) - kh_total) + kh_x), ((kh_x - kh_total) + tupleElement(kh_acc, ?)))))), array((tupleElement(kh_acc, ?) + kh_x)))[?], arraySlice(arr, least(greatest(((greatest(off, ((mst + tb) * bitShiftLeft(?, (s - `_hq_merged_scale`)))) - off) + ?), ?), (length(arr) + ?)), greatest(?, ((least(((off + length(arr)) - ?), ((((mst + tb) + ?) * bitShiftLeft(?, (s - `_hq_merged_scale`))) - ?)) - greatest(off, ((mst + tb) * bitShiftLeft(?, (s - `_hq_merged_scale`))))) + ?))), tuple(toFloat64(?), toFloat64(?)))))[?], `_hq_scales`, `_hq_pos_offsets`, `_hq_pos_buckets`)), `_hq_ts_list`)))[?], range(toUInt64(greatest(?, ((arrayMax(arrayMap((sm, om, am) -> bitShiftRight((om + (length(am) - ?)), (sm - `_hq_merged_scale`)), `_hq_scales`, `_hq_pos_offsets`, `_hq_pos_buckets`)) - mst) + ?))))), array(arrayMin(arrayMap((sm, om) -> bitShiftRight(om, (sm - `_hq_merged_scale`)), `_hq_scales`, `_hq_pos_offsets`))))[?] AS `PositiveBucketCounts`, arrayMin(arrayMap((s, off) -> bitShiftRight(off, (s - `_hq_merged_scale`)), `_hq_scales`, `_hq_neg_offsets`)) AS `NegativeOffset`, arrayMap(mst -> arrayMap(tb -> arrayMap(wsr -> (wsr[length(wsr)] - wsr[(length(wsr) - ?)]), array(arraySort((c, t) -> t, arrayMap(n -> toFloat64(n), arrayMap((s, off, arr) -> arrayMap(kh_final -> (tupleElement(kh_final, ?) + tupleElement(kh_final, ?)), array(arrayFold((kh_acc, kh_x) -> arrayMap(kh_total -> tuple(kh_total, if(isInfinite(kh_total), toFloat64(?), (tupleElement(kh_acc, ?) + if((abs(tupleElement(kh_acc, ?)) >= abs(kh_x)), ((tupleElement(kh_acc, ?) - kh_total) + kh_x), ((kh_x - kh_total) + tupleElement(kh_acc, ?)))))), array((tupleElement(kh_acc, ?) + kh_x)))[?], arraySlice(arr, least(greatest(((greatest(off, ((mst + tb) * bitShiftLeft(?, (s - `_hq_merged_scale`)))) - off) + ?), ?), (length(arr) + ?)), greatest(?, ((least(((off + length(arr)) - ?), ((((mst + tb) + ?) * bitShiftLeft(?, (s - `_hq_merged_scale`))) - ?)) - greatest(off, ((mst + tb) * bitShiftLeft(?, (s - `_hq_merged_scale`))))) + ?))), tuple(toFloat64(?), toFloat64(?)))))[?], `_hq_scales`, `_hq_neg_offsets`, `_hq_neg_buckets`)), `_hq_ts_list`)))[?], range(toUInt64(greatest(?, ((arrayMax(arrayMap((sm, om, am) -> bitShiftRight((om + (length(am) - ?)), (sm - `_hq_merged_scale`)), `_h