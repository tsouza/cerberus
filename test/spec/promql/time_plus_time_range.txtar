# `time() + time()` — synthetic-scalar V-V fold. Pre-fix this lowered
# to a VectorJoin whose per-side argMax collapse produced 1×1 rows;
# in range mode that surfaced as 12 compat-lane shape-diffs because
# Prom emits one row per (start, end, step) step. The fix detects
# "both legs are synthetic-scalar plans" at lowering time and folds
# to a single Project over the shared OneRow / StepGrid source —
# mirroring how TryFoldScalar folds literal-literal binops.
#
# Instant-mode shape here pins the fold's chplan + SQL: a single
# 4-slot Project over (SELECT 1) with Value = (left_time + right_time).
# Range mode (StepGrid source) exercised by the chDB step-loop test
# under internal/api/prom/handler_chdb_step_loop_test.go.
-- query.promql --
time() + time()
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 3534451202]
]
-- args --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] string = "2026-01-01 00:00:01.000000000Z"
[4] int64 = 9
[5] float64 = 1000
[6] string = "2026-01-01 00:00:01.000000000Z"
[7] int64 = 9
[8] float64 = 1000
-- chplan --
Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, ((FnToFloat64(FnToUnixMillis(FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9))) / 1000) + (FnToFloat64(FnToUnixMillis(FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9))) / 1000)) AS Value]
  OneRow
-- sql --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, ((toFloat64(toUnixTimestamp64Milli(parseDateTime64BestEffort(?, ?))) / toFloat64(?)) + (toFloat64(toUnixTimestamp64Milli(parseDateTime64BestEffort(?, ?))) / toFloat64(?))) AS `Value` FROM (SELECT 1)
-- args_optimized --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] string = "2026-01-01 00:00:01.000000000Z"
[4] int64 = 9
[5] float64 = 1000
[6] string = "2026-01-01 00:00:01.000000000Z"
[7] int64 = 9
[8] float64 = 1000
-- settings --
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:project
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
-- sql_optimized --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, ((toFloat64(toUnixTimestamp64Milli(parseDateTime64BestEffort(?, ?))) / toFloat64(?)) + (toFloat64(toUnixTimestamp64Milli(parseDateTime64BestEffort(?, ?))) / toFloat64(?))) AS `Value` FROM (SELECT 1)
