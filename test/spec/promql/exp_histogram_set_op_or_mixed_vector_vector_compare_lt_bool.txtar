-- query.promql --
(mvc_fx_lhs_hist_exp_hist or histogram_quantile(0.5, mvc_fx_lhs_base_exp_hist)) < bool (mvc_fx_rhs_hist_exp_hist or histogram_quantile(0.5, mvc_fx_rhs_base_exp_hist))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- `(<LHS hist> or <LHS quantile>) < bool (<RHS hist> or <RHS quantile>)` —
-- cerberus issue #2449's eighth wrapper family, vector-vector `<` with
-- `bool` over TWO independently mixed float/histogram `or` operands.
-- histogram_native_mixed_or_vector_comparison.go's own header has the
-- full four-combination accounting; the case this fixture pins is the
-- most surprising one — an ORDERING comparison over two histogram-shaped
-- rows drops the pair even WITH `bool`, rather than answering 0.0:
--   - series "float": both operands resolve FLOAT, LHS's quantile <
--     RHS's quantile -> kept, Value = 1.0 (the `bool` fold).
--   - series "histordering": both operands resolve HISTOGRAM -> DROPPED
--     entirely, not even a 0.0 row — reference has no ordering on
--     histograms, and the incompatible-types error this hits is checked
--     BEFORE the `bool`-modifier override ever runs.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('mvc_fx_lhs_base_exp_hist', map('series', 'float'), toDateTime64('2026-01-01 00:00:00', 9), 10, 10.0, 0, 0, 0, [1, 2, 3, 4], 0, []),
    ('mvc_fx_rhs_base_exp_hist', map('series', 'float'), toDateTime64('2026-01-01 00:00:00', 9), 10, 20.0, 0, 0, 0, [2, 4, 6, 8], 0, []),
    ('mvc_fx_lhs_hist_exp_hist', map('series', 'histordering'), toDateTime64('2026-01-01 00:00:00', 9), 2, 4.0, 0, 0, 0, [6], 0, []),
    ('mvc_fx_rhs_hist_exp_hist', map('series', 'histordering'), toDateTime64('2026-01-01 00:00:00', 9), 5, 10.0, 0, 0, 0, [15], 0, []);
-- expected_rows --
[]
