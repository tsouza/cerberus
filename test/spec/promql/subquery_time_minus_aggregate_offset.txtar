-- seed --
-- PromQL re-evaluates a subquery's inner as an INSTANT query at every
-- anchor of an absolute-epoch grid, so this fixture pins three things at
-- once against the reference engine:
--
--   1. `time()` is the ANCHOR, not the scrape timestamp of whichever row
--      the binary folded against. With the eval instant at 00:00:01 and
--      `offset 5m`, the anchors are the 10s-epoch points in the left-open
--      window (23:54:01, 23:55:01] — 23:54:10/20/30/40/50 and 23:55:00.
--   2. Each anchor selects the latest sample within the 5m staleness
--      lookback, NOT within one sub-step: the series is scraped every 30s,
--      so an anchor at 23:54:10 has no sample of its own and must still
--      resolve to the 23:54:00 one.
--   3. 23:54:00 is NOT an anchor. It is the excluded left endpoint of the
--      window, and emitting it would add a spurious leading 240.
--
-- The metric is a constant timestamp C = 1767225000 (2025-12-31T23:50:00Z)
-- on two instances, the second lower so `max` always picks the first.
-- Every anchor's value is therefore exactly `anchor - C` in seconds:
-- 250, 260, 270, 280, 290, 300.
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('batch_last_success_timestamp_seconds', map('instance', 'a'), toDateTime64('2025-12-31 23:53:00', 9), 1767225000),
    ('batch_last_success_timestamp_seconds', map('instance', 'a'), toDateTime64('2025-12-31 23:53:30', 9), 1767225000),
    ('batch_last_success_timestamp_seconds', map('instance', 'a'), toDateTime64('2025-12-31 23:54:00', 9), 1767225000),
    ('batch_last_success_timestamp_seconds', map('instance', 'a'), toDateTime64('2025-12-31 23:54:30', 9), 1767225000),
    ('batch_last_success_timestamp_seconds', map('instance', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 1767225000),
    ('batch_last_success_timestamp_seconds', map('instance', 'b'), toDateTime64('2025-12-31 23:53:00', 9), 1767224900),
    ('batch_last_success_timestamp_seconds', map('instance', 'b'), toDateTime64('2025-12-31 23:53:30', 9), 1767224900),
    ('batch_last_success_timestamp_seconds', map('instance', 'b'), toDateTime64('2025-12-31 23:54:00', 9), 1767224900),
    ('batch_last_success_timestamp_seconds', map('instance', 'b'), toDateTime64('2025-12-31 23:54:30', 9), 1767224900),
    ('batch_last_success_timestamp_seconds', map('instance', 'b'), toDateTime64('2025-12-31 23:55:00', 9), 1767224900);
