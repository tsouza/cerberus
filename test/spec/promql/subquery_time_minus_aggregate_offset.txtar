[
  [{}, "2025-12-31T23:54:10Z", "2025-12-31T23:54:10Z", 250],
  [{}, "2025-12-31T23:54:20Z", "2025-12-31T23:54:20Z", 260],
  [{}, "2025-12-31T23:54:30Z", "2025-12-31T23:54:30Z", 270],
  [{}, "2025-12-31T23:54:40Z", "2025-12-31T23:54:40Z", 280],
  [{}, "2025-12-31T23:54:50Z", "2025-12-31T23:54:50Z", 290],
  [{}, "2025-12-31T23:55:00Z", "2025-12-31T23:55:00Z", 300]
]
-- sql --
SELECT `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT ? AS `MetricName`, `Attributes`, `TimeUnix`, (toFloat64((toUnixTimestamp64Nano(`TimeUnix`) / ?)) - `Value`) AS `Value` FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, `bucket_ts` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `TimeUnix` AS `bucket_ts`, max(`Value`) AS `Value` FROM (SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, anchor_ts AS `TimeUnix`, lwr_value AS `Value` FROM (SELECT `MetricName`, `Attributes`, `anchor_ts`, argMax(`Value`, `TimeUnix`) AS lwr_value FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, arrayJoin(arrayMap(i -> toDateTime64('2025-12-31 23:55:00.000000000', 9) - toIntervalNanosecond(i * 10000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2025-12-31 23:55:00.000000000', 9)) - 300000000000, toInt64(10000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2025-12-31 23:55:00.000000000', 9)) - 300000000000, toInt64(10000000000)) < 0) + 1), least(6, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2025-12-31 23:55:00.000000000', 9)), toInt64(10000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2025-12-31 23:55:00.000000000', 9)), toInt64(10000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)))) WHERE `TimeUnix` > toDateTime64('2025-12-31 23:54:10.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('2025-12-31 23:55:00.000000000', 9)) GROUP BY `MetricName`, `Attributes`, `anchor_ts`)) GROUP BY `bucket_ts`)))
-- chplan --
Project [Attributes AS Attributes, TimeUnix AS anchor_ts, TimeUnix AS TimeUnix, Value AS Value]
  Project ["" AS MetricName, Attributes, TimeUnix, (toFloat64((toUnixTimestamp64Nano(TimeUnix) / 1000000000)) - Value) AS Value]
    Project ["" AS MetricName, CAST(map(), "Map(String,String)") AS Attributes, bucket_ts AS TimeUnix, Value AS Value]
      Aggregate groupBy=[TimeUnix AS bucket_ts] funcs=[max(Value) AS Value]
        RangeLWR step=10s lookback=5m0s ts=TimeUnix value=Value start=2025-12-31T23:54:10Z end=2025-12-31T23:55:00Z
          Project [MetricName AS MetricName, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
            Filter predicate=(MetricName IN ("batch_last_success_timestamp_seconds", "batch.last.success.timestamp.seconds", "batch.last.success.timestamp/seconds", "batch.last.success.timestamp_seconds", "batch.last.success/timestamp/seconds", "batch.last.success/timestamp_seconds", "batch.last.success_timestamp.seconds", "batch.last.success_timestamp_seconds", "batch.last/success/timestamp/seconds", "batch.last/success/timestamp_seconds", "batch.last/success_timestamp_seconds", "batch.last_success.timestamp.seconds", "batch.last_success.timestamp_seconds", "batch.last_success_timestamp.seconds", "batch.last_success_timestamp_seconds", "batch/last/success/timestamp/seconds", "batch/last/success/timestamp_seconds", "batch/last/success_timestamp_seconds", "batch/last_success_timestamp_seconds", "batch_last.success.timestamp.seconds", "batch_last.success.timestamp_seconds", "batch_last.success_timestamp.seconds", "batch_last.success_timestamp_seconds", "batch_last_success.timestamp.seconds", "batch_last_success.timestamp_seconds", "batch_last_success_timestamp.seconds"))
              Scan(merge(otel_metrics_gauge|otel_metrics_sum))
