# Experimental: ts_grid_vector_agg (cerberus issue #2763) composed with the
# rate() temporality-split UnionAll (issue #2843). `rate()` against a schema
# carrying a per-row AggregationTemporality column never lowers to a bare
# RangeWindowGridNative — it always splits into
# Project(UnionAll{RangeWindowGridNative (CUMULATIVE arm), RangeWindow
# (DELTA-temporality fan-out arm)}), so the PLAIN ts_grid_vector_agg branch
# (a bare type assertion on RangeWindowGridNative) can never fire for it —
# even though #2763's own headline example is exactly `sum by (...)
# (rate(m[5m]))` (cerberus issue #2852).
#
# This fixture proves the fix folds `sum by(host)` into just the CUMULATIVE
# arm (RangeWindowGridNativeVectorAgg), then re-combines that already-reduced
# row with the raw DELTA-temporality arm's rows via one more `sum` at a
# wrapping Aggregate — WITHOUT double-counting or dropping either side. The
# seed deliberately gives host=a TWO series that collapse into the SAME
# output group under `by(host)`: worker=x is CUMULATIVE-temporality (feeds
# the native arm), worker=y is DELTA-temporality (feeds the raw fan-out arm).
# A correct answer sums BOTH contributions at every anchor; the `parity`
# section cross-checks that answer against a real Prometheus engine over the
# same seed, and `expected_rows` pins the same answer via chDB execution.

-- query.promql --
sum by(host) (rate(cerberus_requests_total[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_ts_grid_range --
-- experimental_ts_grid_vector_agg --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64,
    AggregationTemporality Int32
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
