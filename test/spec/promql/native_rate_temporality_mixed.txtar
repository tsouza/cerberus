# Mixed temporality has two disjoint arms. Each label contributes a distinct
# value, proving that the UNION ALL neither duplicates nor drops a series.
-- query.promql --
sum by(temporality) (rate(cerberus_queries_total[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- experimental_ts_grid_range --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64,
    AggregationTemporality Int32
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
