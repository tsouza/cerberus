-- chplan --
Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, FnToFloat64((FnIntDiv(((5 * FnIntDiv(FnModulo(((4 * FnIntDiv(FnModulo(((4 * FnIntDiv((FnReinterpretAsUInt64(FnIntDiv(FnToUnixNanos(FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9)), 1000000000)) + FnToUInt64(9223372028741760000)), 86400)) + 3), 146097), 4)) + 3), 1461), 4)) + 461), 153) - (12 * (FnIntDiv(FnModulo(((4 * FnIntDiv(FnModulo(((4 * FnIntDiv((FnReinterpretAsUInt64(FnIntDiv(FnToUnixNanos(FnParseDateTime64BestEffort("2026-01-01 00:00:01.000000000Z", 9)), 1000000000)) + FnToUInt64(9223372028741760000)), 86400)) + 3), 146097), 4)) + 3), 1461), 4) >= 306)))) AS Value]
  OneRow
-- sql --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64((intDiv(((? * intDiv(modulo(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(intDiv(toUnixTimestamp64Nano(parseDateTime64BestEffort(?, ?)), ?)) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?)) + ?), ?) - (? * (intDiv(modulo(((? * intDiv(modulo(((? * intDiv((reinterpretAsUInt64(intDiv(toUnixTimestamp64Nano(parseDateTime64BestEffort(?, ?)), ?)) + toUInt64(?)), ?)) + ?), ?), ?)) + ?), ?), ?) >= ?)))) AS `Value` FROM (SELECT 1)
