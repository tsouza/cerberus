# `metric offset -5m` over query_range — exercise the range-mode LWR path
# (wrapRangeLatestPerSeries) with a negative `offset` modifier. Prom
# semantics: negative offset shifts the lookback window FORWARD in time
# (evaluating at `t - (-5m) = t + 5m`). Pre-fix, the
# `if anchor.Offset > 0` guard in internal/promql/lower.go silently
# zeroed the negative-offset subtract on the upper bound, leaving the
# window pinned to `(anchor - lookback, anchor]` and returning no
# samples for the forward-shifted compat queries.
#
# Post-fix, both bounds carry the offset subtract; `Offset != 0` so
# zero-offset queries stay byte-stable while signed offsets render
# correctly (CH interval arithmetic flips the sign:
# `anchor - toIntervalNanosecond(-300_000_000_000)` renders as
# `anchor + 5m`). Bucket 7 from
# docs/compat-residual-audit-25898791664.md (2 diffs).
-- query.promql --
demo_memory_usage_bytes offset -5m
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('demo_memory_usage_bytes', map('instance', 'a'), toDateTime64('2026-01-01 00:03:00', 9), 100.0),
    ('demo_memory_usage_bytes', map('instance', 'a'), toDateTime64('2026-01-01 00:06:00', 9), 200.0);
