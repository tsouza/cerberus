# The duplicate-row contract of cerberus issue #2914, checked against the REAL
# upstream Prometheus engine rather than against a hand-derived answer.
#
# job 'api' seeds 00:02:00 TWICE with the SAME value, 2.0. That is the shape
# Prometheus's own appender absorbs: tsdb.memSeries.appendable accepts a
# re-append whose value bits match the sample already stored at that timestamp
# as a silent no-op, and rejects one whose bits differ with
# ErrDuplicateSampleForTimestamp. So the reference head holds five samples for
# 'api', not six, and cerberus must reduce the same five.
#
# That is exactly why this fixture is parity-ENROLLED while its
# conflicting-value siblings (sorted_slab_{sum,avg}_over_time_range_step,
# lag_adjacency_idelta_duplicate_ts) are parity-EXEMPT under
# `duplicate-timestamp-seed`. The exemption exists for a seed whose survivor
# the reference picks by ingestion order, leaving nothing well-defined to
# compare. Here no survivor question arises: both rows carry the same number,
# so the answer is determinate and both engines can reach it.
# `.github/scripts/forbid-parity-duplicate-samples.mjs` permits precisely this
# shape for that reason, and this fixture is what makes that permission
# load-bearing rather than theoretical.
#
# job 'web' is a plain monotonic control that no duplicate touches, so a
# regression that collapsed rows too eagerly would move it too.
-- query.promql --
sum by(job) (sum_over_time(http_requests_total[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 5.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 2.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 2.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:00', 9), 8.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 1.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2026-01-01 00:05:00', 9), 6.0),
    ('http_requests_total', map('job', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 10.0),
    ('http_requests_total', map('job', 'web'), toDateTime64('2026-01-01 00:01:00', 9), 20.0),
    ('http_requests_total', map('job', 'web'), toDateTime64('2026-01-01 00:02:00', 9), 30.0),
    ('http_requests_total', map('job', 'web'), toDateTime64('2026-01-01 00:03:00', 9), 40.0),
    ('http_requests_total', map('job', 'web'), toDateTime64('2026-01-01 00:04:00', 9), 50.0),
    ('http_requests_total', map('job', 'web'), toDateTime64('2026-01-01 00:05:00', 9), 60.0);
