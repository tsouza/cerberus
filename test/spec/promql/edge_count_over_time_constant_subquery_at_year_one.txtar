-- sql --
SELECT `Attributes`, toFloat64(uniqExact(`anchor_ts`, `Value`)) AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, `TimeUnix` AS `anchor_ts`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, `anchor_ts` AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT arrayJoin(arrayMap(i -> fromUnixTimestamp64Nano(toInt64(-6795364860000000000)) + toIntervalNanosecond(i * 60000000000), range(0, 5))) AS `anchor_ts`)))) WHERE `anchor_ts` > fromUnixTimestamp64Nano(toInt64(-6795364578871000000)) - toIntervalNanosecond(300000000000) AND `anchor_ts` <= fromUnixTimestamp64Nano(toInt64(-6795364578871000000)) GROUP BY `Attributes`
