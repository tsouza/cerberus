# Negative-offset arm: a range-mode `rate(metric[5m] offset -3m)` is Prom's
# forward-shift form. As with a positive offset, the output anchors stay on the
# UNSHIFTED request grid a_i = End - i*step — only the membership window shifts,
# here forward, into (a_i + 3m - 5m, a_i + 3m]. The emitter's internal anchor is
# shifted forward for the window/rate math (`End - toIntervalNanosecond(-3m)`
# folds to `End + 3m`) and gridAnchorFrag adds the (negative) offset back on the
# emitted TimeUnix so the reported grid is unshifted. The inner-scan pushdown
# widens the upper bound to the RIGHT past End with the sign: `TimeUnix >
# (Start + 3m) - 5m AND TimeUnix <= (End + 3m)`. Seed extends forward past
# rangeEnd so the forward-shifted windows stay populated; expected_rows pin the
# unshifted output timestamps.

-- query.promql --
sum by(cerberus_ql) (rate(cerberus_queries_total[5m] offset -3m))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
