# The `_sum` / `_count` suffixes make schema.Metrics.TablesFor fan the scan
# across [Histogram, Sum, Gauge], so the emitted SQL unions all three tables.
# The seed creates the two companions EMPTY: the assertion is that the
# histogram arm alone supplies the rows. Without them the fixture would only
# execute when some EARLIER fixture in the same shared chDB session happened
# to create those tables — a corpus-order dependency, not a round trip.
-- query.promql --
rate(http_server_request_duration_sum[1m]) / rate(http_server_request_duration_count[1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2025-12-31 23:59:30', 9), 10, 5.0,  [3, 4, 3], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 70, 35.0, [21, 28, 21], [0.1, 0.5, 1.0]);
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
