  [{"job": "api"}, "2026-01-01T00:02:00Z", "2026-01-01T00:02:00Z", 1.3333333333333333],
  [{"job": "api"}, "2026-01-01T00:03:00Z", "2026-01-01T00:03:00Z", 1.3333333333333333]
]
