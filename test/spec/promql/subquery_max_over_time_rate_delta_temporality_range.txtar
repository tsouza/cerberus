# The RANGE-mode sibling of
# subquery_max_over_time_rate_delta_temporality.txtar — the fused MATRIX
# subquery emitter (chsql's emitFusedMatrixSubquery), a different layer
# stack from the instant one: the inner sample grid is built once per
# series as `anchor_grid` and each outer request-grid anchor reduces the
# contiguous run of inner anchors its own window covers. Both shapes read
# the series' single AggregationTemporality from the SAME `samples` group,
# which is what keeps them from drifting apart. See issue #1963, item 2.
#
# Request grid [00:00:00, 00:05:00] step 1m over inner anchors on the same
# epoch-aligned 1m grid. Only two inner anchors hold 2+ samples:
#
#   00:01:00  (00:00:30, 00:01:00] = 10, 20 : DELTA total 20, clamped
#             duration_to_start 15s ⇒ 20 * (30+15)/30/60 = 0.5
#   00:02:00  (00:01:30, 00:02:00] = 30, 40 : DELTA total 40, clamped
#             duration_to_start 22.5s ⇒ 40 * (30+22.5)/30/60 = 1.1666…
#
# Each outer anchor reduces the qualifying inner anchors inside its own
# `(o - 2m, o]` window, so 00:01:00 sees only the first (0.5) and both
# 00:02:00 and 00:03:00 see the larger one (1.1666…); the outer anchors
# whose window covers no qualifying inner anchor emit no row at all.
#
# Read as a CUMULATIVE counter the same samples give a reset-free diff of
# 10 in both windows and an unclamped duration_to_start, i.e. 1/3 at every
# emitted anchor — so this fixture's numbers are only reachable through the
# DELTA arm of the branch.
-- query.promql --
max_over_time(rate(http_requests_delta_total[1m])[2m:1m])
-- range_step --
1m
-- seed --
CREATE TABLE otel_metrics_sum (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:30', 9), 10.0),
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 20.0),
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:30', 9), 30.0),
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 40.0);
-- expected_rows --
[
  [{"job": "api"}, "2026-01-01T00:01:00Z", 0.5],
  [{"job": "api"}, "2026-01-01T00:02:00Z", 1.1666666666666667],
  [{"job": "api"}, "2026-01-01T00:03:00Z", 1.1666666666666667]
]
-- args --
[0] string = "service.name"
[1] string = "service_name"
[2] string = "service.name"
[3] string = "service_name"
[4] string = ""
[5] string = "service_name"
[6] string = "http_requests_delta_total"
[7] string = "http.requests.delta.total"
[8] string = "http.requests.delta/total"
[9] string = "http.requests.delta_total"
[10] string = "http.requests/delta/total"
[11] string = "http.requests/delta_total"
[12] string = "http.requests_delta.total"
[13] string = "http.requests_delta_total"
[14] string = "http/requests/delta/total"
[15] string = "http/requests/delta_total"
[16] string = "http/requests_delta_total"
[17] string = "http_requests.delta.total"
[18] string = "http_requests.delta_total"
[19] string = "http_requests_delta.total"
-- chplan --
RangeWindow func=max_over_time range=2m0s step=1m0s outerRange=5m0s ts=anchor_ts value=Value groupBy=[Attributes] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
  RangeWindow func=rate range=1m0s step=1m0s outerRange=7m0s ts=TimeUnix value=Value temporality=AggregationTemporality groupBy=[Attributes] start=2025-12-31T23:58:00Z end=2026-01-01T00:05:00Z
    Project [MetricName AS MetricName, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value, AggregationTemporality AS AggregationTemporality]
      Filter predicate=(MetricName IN ("http_requests_delta_total", "http.requests.delta.total", "http.requests.delta/total", "http.requests.delta_total", "http.requests/delta/total", "http.requests/delta_total", "http.requests_delta.total", "http.requests_delta_total", "http/requests/delta/total", "http/requests/delta_total", "http/requests_delta_total", "http_requests.delta.total", "http_requests.delta_total", "http_requests_delta.total"))
        Scan(otel_metrics_sum)
-- sql --
SELECT `Attributes`, tupleElement(outer_anchor, 1) AS `anchor_ts`, tupleElement(outer_anchor, 2) AS `Value` FROM (SELECT `Attributes`, arrayJoin(arrayFilter(p -> tupleElement(p, 3) > 0, arrayMap(o -> arrayMap(q -> (o, arrayReduce('max', q), length(q)), [arrayMap(c -> tupleElement(c, 3), arrayFilter(c -> tupleElement(c, 2), arraySlice(anchor_grid, greatest(0, intDiv(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)) - 1, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)) - 1, toInt64(60000000000)) < 0) + 1) + 1, greatest(0, least(7, intDiv(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)) + 119999999999, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)) + 119999999999, toInt64(60000000000)) < 0) + 1) - greatest(0, intDiv(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)) - 1, toInt64(60000000000)) - (modulo(dateDiff('nanosecond', o, fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000)) - 1, toInt64(60000000000)) < 0) + 1)))))])[1], arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 60000000000), range(6))))) AS `outer_anchor` FROM (SELECT `Attributes`, arrayMap(a -> arrayMap(s -> (a, length(s) >= 2, if((toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) > 0, if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s))))) * (((toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) + if(if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s))))) > 0 AND tupleElement(s[1], 2) >= 0, least(if((toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(60000000000), tupleElement(s[1], 1))) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(60000000000), tupleElement(s[1], 1))) / 1e9)), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) * tupleElement(s[1], 2) / if(temporality = 1, arraySum(arrayMap(x -> tupleElement(x, 2), s)) - tupleElement(s[1], 2), arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), s)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), s)))))), if((toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(60000000000), tupleElement(s[1], 1))) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', a - toIntervalNanosecond(60000000000), tupleElement(s[1], 1))) / 1e9))) + if((toFloat64(dateDiff('nanosecond', tupleElement(s[length(s)], 1), a)) / 1e9) >= 1.1 * (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1), (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / (length(s) - 1) / 2, (toFloat64(dateDiff('nanosecond', tupleElement(s[length(s)], 1), a)) / 1e9))) / (toFloat64(dateDiff('nanosecond', tupleElement(s[1], 1), tupleElement(s[length(s)], 1))) / 1e9) / 60), nan)), [arrayReverse(arrayCompact(p -> tupleElement(p, 1), arrayReverse(arrayFilter(p -> tupleElement(p, 1) > a - toIntervalNanosecond(60000000000) AND tupleElement(p, 1) <= a, samples))))])[1], arrayMap(i -> fromUnixTimestamp64Nano(intDiv(toUnixTimestamp64Nano(toDateTime64('2026-01-01 00:05:00.000000000', 9)), 60000000000) * 60000000000) - toIntervalNanosecond(i * 60000000000), range(7))) AS `anchor_grid` FROM (SELECT `Attributes`, arraySort(groupArray((`TimeUnix`, `Value`))) AS `samples`, any(`AggregationTemporality`) AS `temporality` FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value`, `AggregationTemporality` AS `AggregationTemporality` FROM (SELECT * FROM `otel_metrics_sum` WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)))) WHERE `TimeUnix` > toDateTime64('2025-12-31 23:58:00.000000000', 9) - toIntervalNanosecond(60000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9) GROUP BY `Attributes`)))
