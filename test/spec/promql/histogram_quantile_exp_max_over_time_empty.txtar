-- query.promql --
histogram_quantile(0.5, max_over_time(http_server_duration_exp_hist[5m]))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 6, 42.5, 0, 0, 0, [1, 2, 3], 0, []);
-- expected_rows --
[]
-- description --
histogram_quantile over max_over_time of an exponential histogram answers an empty
vector, as Prometheus does: max_over_time drops histogram samples. The classic-bucket
idiom accepts max_over_time for classic buckets only, so an exponential histogram
keeps its own lowering and never reaches the classic per-rung fold, which
would answer a quantile.
-- args --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] float64 = 0
[4] bool = false
-- args_optimized --
[0] string = ""
[1] string = "Map(String,String)"
[2] int64 = 9
[3] float64 = 0
[4] bool = false
-- chplan --
Filter predicate=false
  Project ["" AS MetricName, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnNow64(9) AS TimeUnix, 0 AS Value]
    OneRow
-- settings --
enabled_opts=aggregation_in_order,classic_bucket_layout_two_level,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:filter
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
-- sql --
SELECT * FROM (SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, toFloat64(?) AS `Value` FROM (SELECT 1)) WHERE ?
