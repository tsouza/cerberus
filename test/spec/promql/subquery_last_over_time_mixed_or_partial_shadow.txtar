# `last_over_time` over a SUBQUERY whose inner is a mixed float/histogram
# `or` between two arms carrying BYTE-IDENTICAL attributes (#3227).
#
# `or`'s default set-op match key is "every label except `__name__`"
# (promql/engine.go:1454-1465), so `latency_exp_hist{x="1"}` and
# `latency_float{x="1"}` share ONE signature and the histogram arm
# shadows the float arm — but only at the anchors where the histogram
# actually has a sample. Across this subquery's three anchors that shadow
# is therefore PARTIAL: the float series SURVIVES at the anchor the
# histogram does not cover, and `last_over_time` (one of the two range
# functions reference never strips `__name__` from) reports BOTH series.
#
# This is the shape the sibling setop_or_subquery_name.txtar deliberately
# avoids — its comment says the two metrics sit on DISTINCT attribute
# sets "so two metrics sharing one attribute set would see the right arm
# dropped as already-present rather than merged". That is exactly the
# case here, and the point: an all-or-nothing shadow is what makes
# distributing the outer function over the two arms an identity, and a
# PARTIAL shadow is what breaks it.
#
# Seed timings, against the corpus's fixed 2026-01-01T00:00:01Z instant.
# `[3m:1m]` anchors at the step multiples inside (23:57:01, 00:00:01]:
#
#   23:58:00 — no histogram sample within lookback; the float sample at
#              23:57:30 wins, so the float series is live here
#   23:59:00 — histogram sample at 23:58:30 shadows the float
#   00:00:00 — histogram sample at 23:59:30 shadows the float
#
# So the float series' surviving sample is the 23:57:30 one (value 7),
# NOT the later 23:59:45 one (value 99). The two float values are
# deliberately distinct: an implementation that folds each arm over its
# FULL window before shadowing answers 99 for the float series, or drops
# it altogether, and neither can be mistaken for the reference answer.
# The `-- parity --` section is what makes that claim checkable — the
# expected rows below are compared against the upstream Prometheus
# engine's own answer over this same seed, not merely against whatever
# cerberus last emitted.
-- query.promql --
last_over_time((latency_exp_hist or latency_float)[3m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('x', '1'), toDateTime64('2025-12-31 23:58:30', 9), 10, 20.0, 0, 0, 0, [1, 2, 3, 4], 0, []),
    ('latency_exp_hist', map('x', '1'), toDateTime64('2025-12-31 23:59:30', 9), 14, 28.0, 0, 0, 0, [2, 3, 4, 5], 0, []);
INSERT INTO otel_metrics_gauge VALUES
    ('latency_float', map('x', '1'), toDateTime64('2025-12-31 23:57:30', 9), 7.0),
    ('latency_float', map('x', '1'), toDateTime64('2025-12-31 23:59:45', 9), 99.0);
-- expected_rows --
[
  ["latency_exp_hist", {"x": "1"}, "2026-01-01T00:00:01Z", 0, 14, 28, 0, 0, 0, 0, [2,3,4,5], 0, [], 1],
  ["latency_float", {"x": "1"}, "2026-01-01T00:00:01Z", 7, 0, 0, 0, 0, 0, 0, [], 0, [], 0]
]
