SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, toDateTime64(?, ?) AS `TimeUnix`, `Value` AS `Value`, `HistogramCount` AS `HistogramCount`, `HistogramSum` AS `HistogramSum`, `HistogramScale` AS `HistogramScale`, `HistogramZeroCount` AS `HistogramZeroCount`, `HistogramZeroThreshold` AS `HistogramZeroThreshold`, `HistogramPositiveOffset` AS `HistogramPositiveOffset`, `HistogramPositiveBucketCounts` AS `HistogramPositiveBucketCounts`, `HistogramNegativeOffset` AS `HistogramNegativeOffset`, `HistogramNegativeBucketCounts` AS `HistogramNegativeBucketCounts`, `_setop_is_histogram` AS `_setop_is_histogram` FROM (SELECT `Attributes` AS `Attributes`, `MetricName` AS `MetricName`, argMax(`Value`, `TimeUnix`) AS `Value`, argMax(`_setop_is_histogram`, `TimeUnix`) AS `_setop_is_histogram`, argMax(`HistogramCount`, `TimeUnix`) AS `HistogramCount`, argMax(`HistogramSum`, `TimeUnix`) AS `HistogramSum`, argMax(`HistogramScale`, `TimeUnix`) AS `HistogramScale`, argMax(`HistogramZeroCount`, `TimeUnix`) AS `HistogramZeroCount`, argMax(`HistogramPositiveOffset`, `TimeUnix`) AS `HistogramPositiveOffset`, argMax(`HistogramPositiveBucketCounts`, `TimeUnix`) AS `HistogramPositiveBucketCounts`, argMax(`HistogramNegativeOffset`, `TimeUnix`) AS `HistogramNegativeOffset`, argMax(`HistogramNegativeBucketCounts`, `TimeUnix`) AS `HistogramNegativeBucketCounts`, argMax(`HistogramZeroThreshold`, `TimeUnix`) AS `HistogramZeroThreshold` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, `HistogramCount`, `HistogramSum`, `HistogramScale`, `HistogramZeroThreshold`, `HistogramZeroCount`, `HistogramPositiveOffset`, `HistogramPositiveBucketCounts`, `HistogramNegativeOffset`, `HistogramNegativeBucketCounts`, `_setop_is_histogram` FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, `HistogramCount`, `HistogramSum`, `HistogramScale`, `HistogramZeroThreshold`, `HistogramZeroCount`, `HistogramPositiveOffset`, `HistogramPositiveBucketCounts`, `HistogramNegativeOffset`, `Hi