-- chplan --
Project [MetricName AS MetricName, Attributes AS Attributes, FnToDateTime64("2026-01-01 00:00:01.000000000", 9) AS TimeUnix, Value AS Value, HistogramCount AS HistogramCount, HistogramSum AS HistogramSum, HistogramScale AS HistogramScale, HistogramZeroCount AS HistogramZeroCount, HistogramZeroThreshold AS HistogramZeroThreshold, HistogramPositiveOffset AS HistogramPositiveOffset, HistogramPositiveBucketCounts AS HistogramPositiveBucketCounts, HistogramNegativeOffset AS HistogramNegativeOffset, HistogramNegativeBucketCounts AS HistogramNegativeBucketCounts, _setop_is_histogram AS _setop_is_histogram]
  Aggregate groupBy=[Attributes AS Attributes, MetricName AS MetricName] funcs=[FnArgMax(Value, TimeUnix) AS Value, FnArgMax(_setop_is_histogram, TimeUnix) AS _setop_is_histogram, FnArgMax(HistogramCount, TimeUnix) AS HistogramCount, FnArgMax(HistogramSum, TimeUnix) AS HistogramSum, FnArgMax(HistogramScale, TimeUnix) AS HistogramScale, FnArgMax(HistogramZeroCount, TimeUnix) AS HistogramZeroCount, FnArgMax(HistogramPositiveOffset, TimeUnix) AS HistogramPositiveOffset, FnArgMax(HistogramPositiveBucketCounts, TimeUnix) AS HistogramPositiveBucketCounts, FnArgMax(HistogramNegativeOffset, TimeUnix) AS HistogramNegativeOffset, FnArgMax(HistogramNegativeBucketCounts, TimeUnix) AS HistogramNegativeBucketCounts, FnArgMax(HistogramZeroThreshold, TimeUnix) AS HistogramZeroThreshold] dropEmptyOnNoGroup
    VectorSetOp op=or match=default stepAligned mixed mixedHistogramOnLeft
      HistogramProjection project=[MetricName AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, 0 AS Value]
        RangeBucketFanout step=1m0s lookback=5m0s groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnArgMax(MetricName, TimeUnix) AS MetricName, FnArgMax(Count, TimeUnix) AS Count, FnArgMax(Sum, TimeUnix) AS Sum, FnArgMax(Scale, TimeUnix) AS Scale, FnArgMax(ZeroCount, TimeUnix) AS ZeroCount, FnArgMax(PositiveOffset, TimeUnix) AS PositiveOffset, FnArgMax(PositiveBucketCounts, TimeUnix) AS PositiveBucketCounts, FnArgMax(NegativeOffset, TimeUnix) AS NegativeOffset, FnArgMax(NegativeBucketCounts, TimeUnix) AS NegativeBucketCounts] start=2025-12-31T23:58:00Z end=2026-01-01T00:00:00Z
          Filter predicate=(MetricName IN ("latency_exp_hist", "latency.exp.hist", "latency.exp/hist", "latency.exp_hist", "latency/exp/hist", "latency/exp_hist", "latency_exp.hist"))
            Scan(otel_metrics_exponential_histogram)
      RangeLWR step=1m0s lookback=5m0s ts=TimeUnix value=Value stepAlign start=2025-12-31T23:58:00Z end=2026-01-01T00:00:00Z
        Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
