-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, anchor_ts AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.5 cumulative groupBy=[anchor_ts AS anchor_ts, Attributes AS Attributes]
    Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(i -> FnArrayMax(FnArraySlice(_hq_ladder, 1, i)), FnArrayEnumerate(_hq_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
      Project [anchor_ts AS anchor_ts, FnCast(FnMap(), "Map(String,String)") AS Attributes, FnArrayConcat(FnArrayMap(u -> FnArraySum(FnArrayFilter((v, pbs) -> FnArrayHas(pbs, u), FnArrayMap((bs, cs) -> FnArraySum(FnArrayMap((b, c) -> FnIf((FnNot((FnIsNaN(b) OR FnIsInfinite(b))) AND (b <= u)), FnToFloat64(c), 0), bs, FnArraySlice(cs, 1, FnLength(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)), FnArraySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list))))), FnArray(FnArraySum(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list)))) AS _hq_ladder, FnArraySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list)))) AS ExplicitBounds]
        Aggregate groupBy=[anchor_ts AS anchor_ts] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list]
          Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayMap(j -> FnIf((j = 1), _hq_window_ladder[j], (_hq_window_ladder[j] - _hq_window_ladder[(j - 1)])), FnArrayEnumerate(_hq_window_ladder)) AS BucketCounts, ExplicitBounds AS ExplicitBounds]
            Project [anchor_ts AS anchor_ts, Attributes AS Attributes, FnArrayConcat(FnArrayMap(u -> FnArraySum(FnArrayFilter((v, pbs) -> FnArrayHas(pbs, u), FnArrayMap((bs, cs) -> FnArraySum(FnArrayMap((b, c) -> FnIf((FnNot((FnIsNaN(b) OR FnIsInfinite(b))) AND (b <= u)), FnToFloat64(c), 0), bs, FnArraySlice(cs, 1, FnLength(bs)))), _hq_bounds_list, _hq_counts_list), _hq_bounds_list)), FnArraySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list))))), FnArray(FnArraySum(FnArrayMap(cs -> FnToFloat64(FnArraySum(cs)), _hq_counts_list)))) AS _hq_window_ladder, FnArraySort(FnArrayDistinct(FnArrayFlatten(FnArrayMap(bs -> FnArrayFilter(fb -> FnNot((FnIsNaN(fb) OR FnIsInfinite(fb))), bs), _hq_bounds_list)))) AS ExplicitBounds]
              RangeBucketFanout step=30s lookback=5m0s groupBy=[FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes] funcs=[FnGroupArray(ExplicitBounds) AS _hq_bounds_list, FnGroupArray(BucketCounts) AS _hq_counts_list, FnGroupArray(TimeUnix) AS _hq_ts_list] start=2026-01-01T00:00:00Z end=2026-01-01T00:05:00Z
                Filter predicate=(MetricName IN ("http_server_request_duration", "http.server.request.duration", "http.server.request/duration", "http.server.request_duration", "http.server/request/duration", "http.server/request_duration", "http.server_request.duration", "http.server_request_duration", "http/server/request/duration", "http/server/request_duration", "http/server_request_duration", "http_server.request.duration", "http_server.request_duration", "http_server_request.duration"))
                  Scan(otel_metrics_histogram)
-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, `anchor_ts` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, if(length(`BucketCounts`) = 0, nan, if(`_cerb_hqc_observations` = 0, nan, if(0.5 < 0, -inf, if(0.5 > 1, inf, if(`_cerb_hqc_idx` = length(`_cerb_hqc_cum`) AND length(`_cerb_hqc_buckets`) != length(`ExplicitBounds`), `_cerb_hqc_bounds`[length(`_cerb_hqc_bounds`)], if(`_cerb_hqc_idx` = 1 AND `_cerb_hqc_bounds`[1] <= 0, `_cerb_hqc_bounds`[1], (if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1]) + (`_cerb_hqc_bounds`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1])) * (((0.5 * `_cerb_hqc_observations`) - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])) / (`_cerb_hqc_cum`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])))))))))) AS `Value` FROM (SELECT *, arrayFirstIndex(c -> c >= (0.5 * `_cerb_hqc_observations`), `_cerb_hqc_cum`) AS `_cerb_hqc_idx` FROM (SELECT *, `_cerb_hqc_cum`[length(`_cerb_hqc_cum`)] AS `_cerb_hqc_observations` FROM (SELECT *, arrayMap(i -> `ExplicitBounds`[i], `_cerb_hqc_kept_idx`) AS `_cerb_hqc_bounds`, arrayMap(i -> `_cerb_hqc_buckets`[i], arrayConcat(`_cerb_hqc_kept_idx`, range(length(`ExplicitBounds`) + 1, length(`_cerb_hqc_buckets`) + 1))) AS `_cerb_hqc_cum` FROM (SELECT *, arrayFilter(i -> i = 1 OR `ExplicitBounds`[i] != `ExplicitBounds`[i - 1], range(1, length(`ExplicitBounds`) + 1)) AS `_cerb_hqc_kept_idx`, arrayMap(x -> toFloat64(x), `BucketCounts`) AS `_cerb_hqc_buckets` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, arrayMap(i -> arrayMax(arraySlice(`_hq_ladder`, ?, i)), arrayEnumerate(`_hq_ladder`)) AS `BucketCounts`, `ExplicitBounds` AS `ExplicitBounds` FROM (SELECT `anchor_ts` AS `anchor_ts`, CAST(map(), ?) AS `Attributes`, arrayConcat(arrayMap(u -> arraySum(arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((not((isNaN(b) OR isInfinite(b))) AND (b <= u)), toFloat64(c), toFloat64(?)), bs, arraySlice(cs, ?, length(bs)))), `_hq_bounds_list`, `_hq_counts_list`), `_hq_bounds_list`)), arraySort(arrayDistinct(arrayFlatten(arrayMap(bs -> arrayFilter(fb -> not((isNaN(fb) OR isInfinite(fb))), bs), `_hq_bounds_list`))))), array(arraySum(arrayMap(cs -> toFloat64(arraySum(cs)), `_hq_counts_list`)))) AS `_hq_ladder`, arraySort(arrayDistinct(arrayFlatten(arrayMap(bs -> arrayFilter(fb -> not((isNaN(fb) OR isInfinite(fb))), bs), `_hq_bounds_list`)))) AS `ExplicitBounds` FROM (SELECT `anchor_ts` AS `anchor_ts`, groupArray(`ExplicitBounds`) AS `_hq_bounds_list`, groupArray(`BucketCounts`) AS `_hq_counts_list` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, arrayMap(j -> if((j = ?), `_hq_window_ladder`[j], (`_hq_window_ladder`[j] - `_hq_window_ladder`[(j - ?)])), arrayEnumerate(`_hq_window_ladder`)) AS `BucketCounts`, `ExplicitBounds` AS `ExplicitBounds` FROM (SELECT `anchor_ts` AS `anchor_ts`, `Attributes` AS `Attributes`, arrayConcat(arrayMap(u -> arraySum(arrayFilter((v, pbs) -> has(pbs, u), arrayMap((bs, cs) -> arraySum(arrayMap((b, c) -> if((not((isNaN(b) OR isInfinite(b))) AND (b <= u)), toFloat64(c), toFloat64(?)), bs, arraySlice(cs, ?, length(bs)))), `_hq_bounds_list`, `_hq_counts_list`), `_hq_bounds_list`)), arraySort(arrayDistinct(arrayFlatten(arrayMap(bs -> arrayFilter(fb -> not((isNaN(fb) OR isInfinite(fb))), bs), `_hq_bounds_list`))))), array(arraySum(arrayMap(cs -> toFloat64(arraySum(cs)), `_hq_counts_list`)))) AS `_hq_window_ladder`, arraySort(arrayDistinct(arrayFlatten(arrayMap(bs -> arrayFilter(fb -> not((isNaN(fb) OR isInfinite(fb))), bs), `_hq_bounds_list`)))) AS `ExplicitBounds` FROM (SELECT anchor_ts AS `anchor_ts`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, groupArray(`ExplicitBounds`) AS `_hq_bounds_list`, groupArray(`BucketCounts`) AS `_hq_counts_list`, groupArray(`TimeUnix`) AS `_hq_ts_list` FROM (SELECT * FROM (SELECT * FROM (SELECT *, arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 300000000000, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 300000000000, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(30000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT * FROM `otel_metrics_histogram` WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?))) WHERE `TimeUnix` > toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9)) LIMIT 4000001) WHERE throwIf((SELECT count() AS `n` FROM (SELECT `TimeUnix` FROM (SELECT *, arrayJoin(arrayMap(i -> toDateTime64('2026-01-01 00:05:00.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 300000000000, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)) - 300000000000, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('2026-01-01 00:05:00.000000000', 9)), toInt64(30000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT * FROM `otel_metrics_histogram` WHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?))) WHERE `TimeUnix` > toDateTime64('2026-01-01 00:00:00.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('2026-01-01 00:05:00.000000000', 9)) LIMIT 4000001)) > 4000000, 'histogram/LWR sample fanout exceeds the series-times-anchors resource bound') = 0) GROUP BY anchor_ts, `Attributes`))) GROUP BY `anchor_ts`))))))))
