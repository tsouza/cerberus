# The anchor-injection window-slide lowering (#2408 follow-up) for
# `histogram_quantile(phi, sum by(le)(sum_over_time(<bucket>[range])))` in
# range mode, at a Lookback/Step ratio (5m/30s = 10) that clears
# windowSlideMinLookbackStepRatio.
#
# Unlike every other native strategy in this table, ClassicHistogram's row
# does not gate window-slide behind a marker section at all: it is
# chopt.AlwaysAvailable (issue #2408's Task-1 spike found no ClickHouse
# version floor for it), so cmd/cerberus wires
# WindowSlideClassicHistogramWindowLowerer unconditionally, and
# wireNativeStrategies (internal/promql/native_strategy_coverage_test.go)
# seeds every fixture with the same chain regardless of marker sections.
#
# windowSlideEligible (internal/promql/histogram_quantile_window_slide.go)
# is currently gated off unconditionally by windowSlideDisabledPending2511:
# a real chDB/testcontainers benchmark against production-shaped data found
# this mechanism OOMs at every tested Lookback/Step ratio for sum_over_time,
# including this fixture's own 10:1 ratio — see issue #2511. So this query
# currently lowers through the plain chplan.RangeBucketFanout fallback, not
# chplan.RangeBucketWindowSlide, even though its shape clears every other
# windowSlideShapeEligible guard. Once #2511 is root-caused and
# windowSlideDisabledPending2511 is flipped back to false, this fixture's
# `-- chplan --` section needs regenerating back to the RangeBucketWindowSlide
# shape (see git history for that shape, e.g. the state before #2511's fix).
#
# The seed and grid are IDENTICAL to
# histogram_quantile_native_ladder_range_step.txtar's, with `rate` swapped
# for `sum_over_time`: a single series, stable bucket layout, growing
# counter, sampled twice inside the range.

-- query.promql --
histogram_quantile(0.5, sum by(le)(sum_over_time(http_server_request_duration_bucket[5m])))
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- range_step --
30s
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [0, 0, 0], [0.1, 0.5, 1.0]),
    ('http_server_request_duration', map('service', 'api'), toDateTime64('2026-01-01 00:00:30', 9), [1, 2, 3], [0.1, 0.5, 1.0]);
