# irate() over a DELTA-temporality counter in RANGE mode — the matrix
# fan-out emitter (chsql's emitWindowedArrayPairsMatrix), a different
# layer stack from the instant shape irate_delta_temporality.txtar pins:
# the per-series AggregationTemporality read rides the sample-side fanout
# and is re-read by any() in the per-(series, anchor) regroup. See issue
# #1963, item 1.
#
# Request grid [00:00:00, 00:05:00] step 1m; each anchor's window is
# `(a - 1m, a]`, and only anchors holding 2+ samples emit a row:
#
#   00:01:00  (00:00:30, 00:01:00] = 10, 40  → DELTA 40/30 = 1.333…
#   00:02:00  (00:01:30, 00:02:00] = 20, 100 → DELTA 100/30 = 3.333…
#   00:04:00  (00:03:30, 00:04:00] = 50, 5   → DELTA 5/30 = 0.1666…
#
# Read as a CUMULATIVE counter the same three windows answer 30/30 = 1,
# 80/30 = 2.666… and — because 5 < 50 is a counter RESET, whose rule takes
# the raw current sample — 5/30 = 0.1666… The third row is deliberately
# identical across both arms: the CUMULATIVE reset branch and the DELTA
# branch coincide exactly on a decreasing pair, so a fixture built only
# from resets could not tell the two apart. The first two rows are where
# the branch is observable.
-- query.promql --
irate(http_requests_delta_total[1m])
-- range_step --
1m
-- parity --
oracle: prometheus
endpoint: /api/v1/query_range
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    AggregationTemporality Int32,
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:00:30', 9), 10.0),
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:00', 9), 40.0),
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:01:30', 9), 20.0),
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:02:00', 9), 100.0),
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:03:30', 9), 50.0),
    (1, 'http_requests_delta_total', map('job', 'api'), toDateTime64('2026-01-01 00:04:00', 9), 5.0);
-- expected_rows --
[
  ["", {"job": "api"}, "2026-01-01T00:01:00Z", "2026-01-01T00:01:00Z", 1.3333333333333333],
  ["", {"job": "api"}, "2026-01-01T00:02:00Z", "2026-01-01T00:02:00Z", 3.3333333333333335],
  ["", {"job": "api"}, "2026-01-01T00:04:00Z", "2026-01-01T00:04:00Z", 0.16666666666666666]
]
