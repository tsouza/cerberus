# An escaped metacharacter is a literal: `a\.b|c` is the set {a.b, c},
# so 'axb', which the unescaped dot would match, is not selected.

-- query.promql --
up{job=~"a\\.b|c"}
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('up', map('job', 'a.b'), toDateTime64('2026-01-01 00:00:00', 9), 1.0),
    ('up', map('job', 'axb'), toDateTime64('2026-01-01 00:00:00', 9), 2.0),
    ('up', map('job', 'c'), toDateTime64('2026-01-01 00:00:00', 9), 3.0);
-- expected_rows --
