# The un-hoisted twin of native_rate_recollapse_collision.txtar: same
# query, same `range_step`, same seed, native timeSeriesRateToGrid — but
# NO `experimental_ts_grid_recollapse` section, so the label-shaping
# tower stays BELOW the aggregate and the emitter renders the ordinary
# two-level shape.
#
# The two fixtures' `expected_rows` sections must be cell-for-cell
# identical. That pair is the semantics-preservation proof for the
# hoist, over the one dataset where the shaping is non-injective and the
# colliding raw series are time-disjoint — i.e. over the only dataset on
# which pooling samples and combining finished grids give different
# answers. Two-level is the reference here because it groups on the
# SHAPED key directly, so its pooling is not in question.
#
# If a future change makes these two row sets diverge, the hoist is
# wrong; do not reconcile them by regenerating whichever golden moved.
# TestNativeRateRecollapseFixturePairPreservesRows (internal/promql)
# enforces that in the default lane: it names both files, compares the
# two `expected_rows` sections directly, and fails when they drift —
# `just update-golden` cannot restore agreement between two wrong row
# sets without the divergence surfacing there first.

-- query.promql --
rate(cerberus_queries_total[5m])
-- range_step --
30s
-- experimental_ts_grid_range --
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    ResourceAttributes Map(String, String),
    ServiceName LowCardinality(String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('cerberus_queries_total', map('cerberus.ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:00:00', 9), 0.0),
    ('cerberus_queries_total', map('cerberus.ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:01:00', 9), 4.0),
    ('cerberus_queries_total', map('cerberus.ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:02:00', 9), 8.0),
    ('cerberus_queries_total', map('cerberus_ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:03:00', 9), 12.0),
    ('cerberus_queries_total', map('cerberus_ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:04:00', 9), 16.0),
    ('cerberus_queries_total', map('cerberus_ql', 'promql'), map(), 'api', toDateTime64('2026-01-01 00:05:00', 9), 20.0);
