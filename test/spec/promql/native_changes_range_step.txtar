  ["", {"host": "a"}, "2026-01-01T00:02:00Z", 1],
  ["", {"host": "a"}, "2026-01-01T00:02:30Z", 1],
  ["", {"host": "a"}, "2026-01-01T00:03:00Z", 2],
  ["", {"host": "a"}, "2026-01-01T00:03:30Z", 2],
  ["", {"host": "a"}, "2026-01-01T00:04:00Z", 3],
  ["", {"host": "a"}, "2026-01-01T00:04:30Z", 3],
  ["", {"host": "a"}, "2026-01-01T00:05:00Z", 2],
  ["", {"host": "b"}, "2026-01-01T00:00:00Z", 0],
  ["", {"host": "b"}, "2026-01-01T00:00:30Z", 0],
  ["", {"host": "b"}, "2026-01-01T00:01:00Z", 0],
  ["", {"host": "b"}, "2026-01-01T00:01:30Z", 0],
  ["", {"host": "b"}, "2026-01-01T00:02:00Z", 1],
  ["", {"host": "b"}, "2026-01-01T00:02:30Z", 1],
  ["", {"host": "b"}, "2026-01-01T00:03:00Z", 1],
  ["", {"host": "b"}, "2026-01-01T00:03:30Z", 1],
  ["", {"host": "b"}, "2026-01-01T00:04:00Z", 2],
