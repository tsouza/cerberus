-- query.promql --
rate(http_errors_total[5m]) / on(job) rate(http_requests_total[5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('http_errors_total',   map('job', 'api', 'instance', 'a'), toDateTime64('2025-12-31 23:59:31', 9), 1.0),
    ('http_errors_total',   map('job', 'api', 'instance', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 7.0),
    ('http_requests_total', map('job', 'api', 'instance', 'b'), toDateTime64('2025-12-31 23:59:31', 9), 10.0),
    ('http_requests_total', map('job', 'api', 'instance', 'b'), toDateTime64('2026-01-01 00:00:00', 9), 40.0);
