# `last_over_time` over a SUBQUERY whose own body is a SUBQUERY.
#
# The sibling `subquery_last_over_time_nested_call` fixture nests a
# MATRIX inner (`[5m]`); this one nests a SUBQUERY inner (`[5m:1m]`),
# which is a different lowering path and the only shape this change
# reshapes twice over: `lowerOuterRangeFnOverSubquery` runs once for the
# inner `last_over_time(...[5m:1m])` and again for the outer one, so the
# inner call's return type changes from a bare `*chplan.RangeWindow` to
# the canonical name-preserving `*chplan.Project` wrap — and that Project
# then becomes the outer subquery's own body.
#
# Three stacked windows therefore have to agree: the inner reducer, the
# outer subquery's Identity resampler, and the outer reducer. Every one
# of them must carry `MetricName` in its `GROUP BY`, because the
# windowed-array emitter projects exactly the grouping keys — a single
# window left on `Attributes` alone would erase the name for the levels
# above it (and, since the two metrics below share an identical attribute
# set, would also collapse them into one series).
-- query.promql --
last_over_time(last_over_time({__name__=~"cpu_temp|gpu_temp"}[5m:1m])[10m:1m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 40.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 41.0),
    ('cpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 42.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:55:00', 9), 70.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2025-12-31 23:59:00', 9), 71.0),
    ('gpu_temp', map('host', 'a'), toDateTime64('2026-01-01 00:00:00', 9), 72.0);
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
