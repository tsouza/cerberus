An `le` matcher makes a plain-named selector able to carry `le`, so
histogram_quantile reassembles a float ladder from its samples. Here
`le!="x"` matches both series: job=a carries no `le`, and job=b carries
one that does not parse as a bound. Prometheus skips both samples and
answers an empty vector; so does the float-domain ladder reassembly,
which admits only samples whose `le` parses as a bound.

-- query.promql --
histogram_quantile(0.8, queue_depth{le!="x"} * 2)
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_gauge (
    MetricName String, Attributes Map(String, String), ResourceAttributes Map(String, String),
    TimeUnix DateTime64(9), Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('queue_depth', map('job','a'), map(), toDateTime64('2026-01-01 00:00:00', 9), 3.0),
    ('queue_depth', map('job','b','le','not-a-bound'), map(), toDateTime64('2026-01-01 00:00:00', 9), 5.0);
-- expected_rows --
[]
