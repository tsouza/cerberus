  Project [_hq_L_Attributes AS Attributes, _hq_L_MetricName AS MetricName, _hq_L_HistogramScale AS HistogramScale, _hq_L_HistogramCount AS HistogramCount, _hq_L_HistogramSum AS HistogramSum, _hq_L_HistogramZeroCount AS HistogramZeroCount, _hq_L_HistogramZeroThreshold AS HistogramZeroThreshold, _hq_L_HistogramPositiveOffset AS HistogramPositiveOffset, _hq_L_HistogramPositiveBucketCounts AS HistogramPositiveBucketCounts, _hq_L_HistogramNegativeOffset AS HistogramNegativeOffset, _hq_L_HistogramNegativeBucketCounts AS HistogramNegativeBucketCounts]
    Filter predicate=(((((((((_hq_L_HistogramScale != _hq_R_HistogramScale) OR (_hq_L_HistogramCount != _hq_R_HistogramCount)) OR (_hq_L_HistogramSum != _hq_R_HistogramSum)) OR (_hq_L_HistogramZeroCount != _hq_R_HistogramZeroCount)) OR (_hq_L_HistogramZeroThreshold != _hq_R_HistogramZeroThreshold)) OR (_hq_L_HistogramPositiveOffset != _hq_R_HistogramPositiveOffset)) OR (_hq_L_HistogramPositiveBucketCounts != _hq_R_HistogramPositiveBucketCounts)) OR (_hq_L_HistogramNegativeOffset != _hq_R_HistogramNegativeOffset)) OR (_hq_L_HistogramNegativeBucketCounts != _hq_R_HistogramNegativeBucketCounts))
      <unknown:*chplan.HistogramVectorJoin>
