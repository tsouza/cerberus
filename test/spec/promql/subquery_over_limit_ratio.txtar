# limit_ratio inside a subquery (#1786). The ratio predicate is
# per-series and step-independent — the same series survive at every
# anchor — so over a subquery matrix it lowers to a row filter. r = 1.0
# keeps every series, which makes the fixture independent of the
# label-hash ordering while still exercising the whole path.
-- query.promql --
max_over_time(limit_ratio(1.0, rate(http_requests_total[5m]))[30m:5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
