-- query.promql --
sum(demo_latency_exp_hist or histogram_quantile(0.5, demo_latency_exp_hist))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- cerberus issue #2346's own representative query, verbatim: both sides
-- of the `or` select the SAME metric with the SAME (default, full)
-- vector matching, so histogram_quantile's output label set is always
-- IDENTICAL to the raw selector's — every RHS row is shadowed by an LHS
-- row with the same signature at the same timestamp, and the `or`
-- reduces to the raw histogram-valued LHS alone. `sum(...)` therefore
-- answers the plain histogram merge of demo_latency_exp_hist, exactly
-- as `sum(demo_latency_exp_hist)` would on its own — pinning that the
-- self-referencing shape the issue used to demonstrate the bug lowers
-- and executes rather than merely that a synthetic disjoint-label
-- fixture does.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('demo_latency_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 10, 10.0, 0, 0, 0, [1, 2, 3, 4], 0, []),
    ('demo_latency_exp_hist', map('service', 'web'), toDateTime64('2026-01-01 00:00:00', 9), 3, 3.0,  0, 0, 0, [9],           0, []);
-- expected_rows --
[
  ["", {}, "2026-01-01T00:00:01Z", 0, 13, 13, 0, 0, 0, 0, [10,2,3,4], 0, [], 1]
]
