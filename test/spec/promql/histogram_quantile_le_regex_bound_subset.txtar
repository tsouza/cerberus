-- query.promql --
histogram_quantile(0.5, http_server_request_duration_bucket{le=~"1|2.5|\\+Inf"})
-- seed --
CREATE TABLE otel_metrics_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    BucketCounts Array(UInt64),
    ExplicitBounds Array(Float64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_histogram VALUES
    ('http_server_request_duration', map('job', 'api'), toDateTime64('2026-01-01 00:00:00', 9), [1, 5, 2, 1, 1], [0.05, 0.1, 1.0, 2.5]);
-- expected_rows --
[
  ["", {"job": "api"}, "2026-01-01T00:00:01Z", 0.625]
]
-- chplan --
Project ["" AS MetricName, Attributes AS Attributes, now64(9) AS TimeUnix, Value AS Value]
  HistogramQuantile phi=0.5 groupBy=[Attributes AS Attributes]
    Aggregate groupBy=[mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapValues(mapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, "[^a-zA-Z0-9_]", "_"), mapKeys(Attributes)), mapValues(Attributes))), mapFilter((k, v) -> (v != ""), map("service_name", toString(ServiceName))))) AS Attributes] funcs=[argMax(BucketCounts, TimeUnix) AS BucketCounts, argMax(ExplicitBounds, TimeUnix) AS ExplicitBounds]
      Project * REPLACE [if(not((has(arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(BucketCounts) + 1))), length(BucketCounts)) AND (length(arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(BucketCounts) + 1)))) >= 2))), arraySlice(arrayMap((cur, prev) -> (cur - prev), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), BucketCounts))[i], arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(BucketCounts) + 1)))), if((length(arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(BucketCounts) + 1)))) = 0), emptyArrayFloat64(), arrayConcat(array(0), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), BucketCounts))[i], arraySlice(arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(BucketCounts) + 1))), 1, greatest((length(arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(BucketCounts) + 1)))) - 1), 0)))))), 1, 0), arrayMap((cur, prev) -> (cur - prev), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), BucketCounts))[i], arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(BucketCounts) + 1)))), if((length(arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(BucketCounts) + 1)))) = 0), emptyArrayFloat64(), arrayConcat(array(0), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), BucketCounts))[i], arraySlice(arrayFilter(i -> (if((i > length(ExplicitBounds)), "+Inf", toString(ExplicitBounds[i])) =~ "^(?:1|2.5|\\+Inf)$"), range(1, (length(