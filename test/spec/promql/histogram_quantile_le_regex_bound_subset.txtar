-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, if(length(`BucketCounts`) = 0, nan, if(`_cerb_hqc_observations` = 0, nan, if(0.5 < 0, -inf, if(0.5 > 1, inf, if(`_cerb_hqc_idx` = length(`_cerb_hqc_cum`) AND length(`_cerb_hqc_buckets`) != length(`ExplicitBounds`), `_cerb_hqc_bounds`[length(`_cerb_hqc_bounds`)], if(`_cerb_hqc_idx` = 1 AND `_cerb_hqc_bounds`[1] <= 0, `_cerb_hqc_bounds`[1], (if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1]) + (`_cerb_hqc_bounds`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_bounds`[`_cerb_hqc_idx` - 1])) * (((0.5 * `_cerb_hqc_observations`) - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])) / (`_cerb_hqc_cum`[`_cerb_hqc_idx`] - if(`_cerb_hqc_idx` = 1, 0.0, `_cerb_hqc_cum`[`_cerb_hqc_idx` - 1])))))))))) AS `Value` FROM (SELECT *, arrayFirstIndex(c -> c >= (0.5 * `_cerb_hqc_observations`), `_cerb_hqc_cum`) AS `_cerb_hqc_idx` FROM (SELECT *, arraySum(`_cerb_hqc_buckets`) AS `_cerb_hqc_observations` FROM (SELECT *, arrayMap(i -> `ExplicitBounds`[i], `_cerb_hqc_kept_idx`) AS `_cerb_hqc_bounds`, arrayMap(i -> arrayCumSum(`_cerb_hqc_buckets`)[i], arrayConcat(`_cerb_hqc_kept_idx`, range(length(`ExplicitBounds`) + 1, length(`_cerb_hqc_buckets`) + 1))) AS `_cerb_hqc_cum` FROM (SELECT *, arrayFilter(i -> i = 1 OR `ExplicitBounds`[i] != `ExplicitBounds`[i - 1], range(1, length(`ExplicitBounds`) + 1)) AS `_cerb_hqc_kept_idx`, arrayMap(x -> toFloat64(x), `BucketCounts`) AS `_cerb_hqc_buckets` FROM (SELECT mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, argMax(`BucketCounts`, `TimeUnix`) AS `BucketCounts`, argMax(`ExplicitBounds`, `TimeUnix`) AS `ExplicitBounds` FROM (SELECT * REPLACE (if(not((has(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?))), length(`BucketCounts`)) AND (length(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?)))) >= ?))), arraySlice(arrayMap((cur, prev) -> (cur - prev), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?)))), if((length(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?)))) = ?), emptyArrayFloat64(), arrayConcat(array(toFloat64(?)), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arraySlice(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?))), ?, greatest((length(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?)))) - ?), ?)))))), ?, ?), arrayMap((cur, prev) -> (cur - prev), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?)))), if((length(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?)))) = ?), emptyArrayFloat64(), arrayConcat(array(toFloat64(?)), arrayMap(i -> arrayCumSum(arrayMap(x -> toFloat64(x), `BucketCounts`))[i], arraySlice(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?))), ?, greatest((length(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?)))) - ?), ?))))))) AS `BucketCounts`, arrayMap(i -> `ExplicitBounds`[i], arraySlice(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?))), ?, greatest((length(arrayFilter(i -> match(if((i > length(`ExplicitBounds`)), ?, toString(`ExplicitBounds`[i])), ?), range(?, (length(`BucketCounts`) + ?)))) - ?), ?))) AS `ExplicitBounds`) FROM (SELECT * FROM `otel_metrics_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)) WHERE (`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?))))) GROUP BY `Attributes`))))))
