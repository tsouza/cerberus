# double_exponential_smoothing with COMPUTED smoothing/trend factors
# (#1782). Upstream type-checks both factors as scalar-valued and reads
# them per step, erroring only when a value falls outside (0,1); cerberus
# threads them through RangeWindow.ScalarExprs and guards the domain in
# SQL, so an out-of-domain factor answers NaN rather than a row.
-- query.promql --
double_exponential_smoothing(rate(http_requests_total[5m])[1h:5m], scalar(sf_k), scalar(tf_k))
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_sum VALUES
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:50:30', 9), 0.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:54:30', 9), 8.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:55:30', 9), 8.0),
    ('http_requests_total', map('job', 'api'), toDateTime64('2025-12-31 23:59:30', 9), 20.0);
CREATE TABLE otel_metrics_gauge (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
INSERT INTO otel_metrics_gauge VALUES
    ('sf_k', map(), toDateTime64('2026-01-01 00:00:00', 9), 0.5),
    ('tf_k', map(), toDateTime64('2026-01-01 00:00:00', 9), 0.5);
