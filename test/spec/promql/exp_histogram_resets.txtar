+ ?) * bitShiftLeft(?, (`_hq_scales`[ra] - least(`_hq_scales`[ra], `_hq_scales`[rb])))) - ?)) - greatest(`_hq_neg_offsets`[ra], ((mst + dk) * bitShiftLeft(?, (`_hq_scales`[ra] - least(`_hq_scales`[ra], `_hq_scales`[rb])))))) + ?)))), range(toUInt64(greatest(?, ((arrayMax(arrayMap((sm, om, am) -> bitShiftRight((om + (length(am) - ?)), (sm - least(`_hq_scales`[ra], `_hq_scales`[rb]))), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_neg_offsets`[ra], `_hq_neg_offsets`[rb]), array(`_hq_neg_buckets`[ra], `_hq_neg_buckets`[rb]))) - mst) + ?))))), arrayMap(n -> toFloat64(n), `_hq_neg_buckets`[ra]))), array(arrayMin(arrayMap((sm, om) -> bitShiftRight(om, (sm - least(`_hq_scales`[ra], `_hq_scales`[rb]))), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_neg_offsets`[ra], `_hq_neg_offsets`[rb])))))[?]), arrayPopBack(wrp), arrayPopFront(wrp)), array(arraySort((rp, rt) -> rt, arrayEnumerate(`_hq_ts_list`), `_hq_ts_list`)))[?])) AS `Value` FROM (SELECT mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, min(`Scale`) AS `_hq_merged_scale`, groupArray(`Scale`) AS `_hq_scales`, groupArray(`ZeroCount`) AS `_hq_zero_counts`, groupArray(`Count`) AS `_hq_count_list`, groupArray(`PositiveOffset`) AS `_hq_pos_offsets`, groupArray(`PositiveBucketCounts`) AS `_hq_pos_buckets`, groupArray(`NegativeOffset`) AS `_hq_neg_offsets`, groupArray(`NegativeBucketCounts`) AS `_hq_neg_buckets`, groupArray(`TimeUnix`) AS `_hq_ts_list`, uniqExact(`TimeUnix`) AS `_hq_samples` FROM (SELECT * FROM `otel_metrics_exponential_histogram` PREWHERE (`MetricName` IN (?, ?, ?,