-- query.promql --
resets(http_server_duration_exp_hist[5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- ONE series, five in-window samples, so the answer is a count over the
-- four consecutive PAIRS. Reference's funcResets walks those pairs and
-- counts the ones `curSample.H.DetectReset(prevSample.H)` condemns.
--
-- The two resets are deliberately caused by DIFFERENT conditions, because
-- a kernel that only compared Count would still pass a fixture whose
-- every reset dropped Count:
--
--   t1 vs t0: Count 10 -> 15, every bucket grows          -> no reset
--   t2 vs t1: Count 15 -> 4                               -> RESET (Count regressed)
--   t3 vs t2: Count 4 -> 9, every bucket grows            -> no reset
--   t4 vs t3: Count 9 -> 10 GROWS, but bucket[0] 2 -> 1   -> RESET (bucket regressed)
--
-- The last pair is the load-bearing one. Its Count rises, so a Count-only
-- reading reports 1 reset where reference reports 2; only a kernel that
-- walks the bucket ladder sees it. It is also why the buckets are spelled
-- out rather than scaled uniformly — a uniform shrink would let a Sum- or
-- Count-shaped shortcut agree with the right answer by accident.
--
-- `resets()` drops __name__ but KEEPS the series' own labels, so the
-- output series is ["", {"service":"api"}] and the value is a plain
-- float: 2. Only an aggregation collapses labels; a range-vector function
-- reduces each series in place and hands back the series it reduced.
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:56:30', 9), 10,  5.0, 0, 0, 0, [2, 3, 5], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:57:30', 9), 15,  8.0, 0, 0, 0, [3, 5, 7], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:58:30', 9),  4,  2.0, 0, 0, 0, [1, 1, 2], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:59:30', 9),  9,  4.0, 0, 0, 0, [2, 3, 4], 0, []),
    ('http_server_duration_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:00', 9), 10,  5.0, 0, 0, 0, [1, 3, 6], 0, []);
-- expected_rows --
[
  ["", {"service": "api"}, "2026-01-01T00:00:01Z", 2]
]
