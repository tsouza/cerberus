-- sql --
SELECT ? AS `MetricName`, `Attributes` AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Attributes` AS `Attributes`, toFloat64(arraySum(arrayMap(wrp -> arrayMap((ra, rb) -> (((((`_hq_count_list`[rb] < `_hq_count_list`[ra]) OR (`_hq_zero_counts`[rb] < `_hq_zero_counts`[ra])) OR (`_hq_scales`[rb] > `_hq_scales`[ra])) OR arrayExists(rk -> (arrayMap(s -> arrayMap(off -> arrayMap(arr -> arrayMap(kh_final -> (tupleElement(kh_final, ?) + tupleElement(kh_final, ?)), array(arrayFold((kh_acc, kh_x) -> arrayMap(kh_total -> tuple(kh_total, if(isInfinite(kh_total), toFloat64(?), (tupleElement(kh_acc, ?) + if((abs(tupleElement(kh_acc, ?)) >= abs(kh_x)), ((tupleElement(kh_acc, ?) - kh_total) + kh_x), ((kh_x - kh_total) + tupleElement(kh_acc, ?)))))), array((tupleElement(kh_acc, ?) + kh_x)))[?], arrayMap(j -> if((bitShiftRight((off + (j - ?)), (s - `_hq_scales`[rb])) = (arrayMin(arrayMap((sm, om) -> bitShiftRight(om, (sm - `_hq_scales`[rb])), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_pos_offsets`[ra], `_hq_pos_offsets`[rb]))) + rk)), arr[j], ?), arrayEnumerate(arr)), tuple(toFloat64(?), toFloat64(?)))))[?], array(`_hq_pos_buckets`[rb]))[?], array(`_hq_pos_offsets`[rb]))[?], array(`_hq_scales`[rb]))[?] < arrayMap(s -> arrayMap(off -> arrayMap(arr -> arrayMap(kh_final -> (tupleElement(kh_final, ?) + tupleElement(kh_final, ?)), array(arrayFold((kh_acc, kh_x) -> arrayMap(kh_total -> tuple(kh_total, if(isInfinite(kh_total), toFloat64(?), (tupleElement(kh_acc, ?) + if((abs(tupleElement(kh_acc, ?)) >= abs(kh_x)), ((tupleElement(kh_acc, ?) - kh_total) + kh_x), ((kh_x - kh_total) + tupleElement(kh_acc, ?)))))), array((tupleElement(kh_acc, ?) + kh_x)))[?], arrayMap(j -> if((bitShiftRight((off + (j - ?)), (s - `_hq_scales`[rb])) = (arrayMin(arrayMap((sm, om) -> bitShiftRight(om, (sm - `_hq_scales`[rb])), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_pos_offsets`[ra], `_hq_pos_offsets`[rb]))) + rk)), arr[j], ?), arrayEnumerate(arr)), tuple(toFloat64(?), toFloat64(?)))))[?], array(`_hq_pos_buckets`[ra]))[?], array(`_hq_pos_offsets`[ra]))[?], array(`_hq_scales`[ra]))[?]), range(toUInt64(greatest(?, ((arrayMax(arrayMap((sm, om, am) -> bitShiftRight((om + (length(am) - ?)), (sm - `_hq_scales`[rb])), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_pos_offsets`[ra], `_hq_pos_offsets`[rb]), array(`_hq_pos_buckets`[ra], `_hq_pos_buckets`[rb]))) - arrayMin(arrayMap((sm, om) -> bitShiftRight(om, (sm - `_hq_scales`[rb])), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_pos_offsets`[ra], `_hq_pos_offsets`[rb])))) + ?)))))) OR arrayExists(rk -> (arrayMap(s -> arrayMap(off -> arrayMap(arr -> arrayMap(kh_final -> (tupleElement(kh_final, ?) + tupleElement(kh_final, ?)), array(arrayFold((kh_acc, kh_x) -> arrayMap(kh_total -> tuple(kh_total, if(isInfinite(kh_total), toFloat64(?), (tupleElement(kh_acc, ?) + if((abs(tupleElement(kh_acc, ?)) >= abs(kh_x)), ((tupleElement(kh_acc, ?) - kh_total) + kh_x), ((kh_x - kh_total) + tupleElement(kh_acc, ?)))))), array((tupleElement(kh_acc, ?) + kh_x)))[?], arrayMap(j -> if((bitShiftRight((off + (j - ?)), (s - `_hq_scales`[rb])) = (arrayMin(arrayMap((sm, om) -> bitShiftRight(om, (sm - `_hq_scales`[rb])), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_neg_offsets`[ra], `_hq_neg_offsets`[rb]))) + rk)), arr[j], ?), arrayEnumerate(arr)), tuple(toFloat64(?), toFloat64(?)))))[?], array(`_hq_neg_buckets`[rb]))[?], array(`_hq_neg_offsets`[rb]))[?], array(`_hq_scales`[rb]))[?] < arrayMap(s -> arrayMap(off -> arrayMap(arr -> arrayMap(kh_final -> (tupleElement(kh_final, ?) + tupleElement(kh_final, ?)), array(arrayFold((kh_acc, kh_x) -> arrayMap(kh_total -> tuple(kh_total, if(isInfinite(kh_total), toFloat64(?), (tupleElement(kh_acc, ?) + if((abs(tupleElement(kh_acc, ?)) >= abs(kh_x)), ((tupleElement(kh_acc, ?) - kh_total) + kh_x), ((kh_x - kh_total) + tupleElement(kh_acc, ?)))))), array((tupleElement(kh_acc, ?) + kh_x)))[?], arrayMap(j -> if((bitShiftRight((off + (j - ?)), (s - `_hq_scales`[rb])) = (arrayMin(arrayMap((sm, om) -> bitShiftRight(om, (sm - `_hq_scales`[rb])), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_neg_offsets`[ra], `_hq_neg_offsets`[rb]))) + rk)), arr[j], ?), arrayEnumerate(arr)), tuple(toFloat64(?), toFloat64(?)))))[?], array(`_hq_neg_buckets`[ra]))[?], array(`_hq_neg_offsets`[ra]))[?], array(`_hq_scales`[ra]))[?]), range(toUInt64(greatest(?, ((arrayMax(arrayMap((sm, om, am) -> bitShiftRight((om + (length(am) - ?)), (sm - `_hq_scales`[rb])), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_neg_offsets`[ra], `_hq_neg_offsets`[rb]), array(`_hq_neg_buckets`[ra], `_hq_neg_buckets`[rb]))) - arrayMin(arrayMap((sm, om) -> bitShiftRight(om, (sm - `_hq_scales`[rb])), array(`_hq_scales`[ra], `_hq_scales`[rb]), array(`_hq_neg_offsets`[ra], `_hq_neg_offsets`[rb])))) + ?)))))), arrayPopBack(wrp), arrayPopFront(wrp)), array(arraySort((rp, rt) -> rt, arrayEnumerate(`_hq_ts_list`), `_hq_ts_list`)))[?])) AS `Value` FROM (SELECT mapSort(mapConcat(mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, min(`Scale`) AS `_hq_merged_scale`, groupArray(`Scale`) AS `_hq_scales`, groupArray(`ZeroCount`) AS `_hq_zero_counts`, groupArray(`Count`) AS `_hq_count_list`, groupArray(`PositiveOffset`) AS `_hq_pos_offsets`, groupArray(`PositiveBucketCounts`) AS `_hq_pos_buckets`, groupArray(`NegativeOffset`) AS `_hq_neg_offsets`, groupArray(`NegativeBucketCounts`) AS `_hq_neg_buckets`, groupArray(`TimeUnix`) AS `_hq_ts_list`, uniqExact(`TimeUnix`) AS `_hq_samples` FROM (SELECT * FROM `otel_metrics_exponential_histogram` PREWHERE (`MetricName` IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)) WHERE (`TimeUnix` <= toDateTime64(?, ?)) AND (`TimeUnix` > (toDateTime64(?, ?) - toIntervalNanosecond(?)))) GROUP BY `Attributes`))
