# topk with a computed K inside a subquery. The rejection-parity
# catalogue classed this site as a shared rejection, but reference
# Prometheus answers `max_over_time(topk(scalar(m), v)[r:s])` — it
# re-evaluates the aggregation per step with the scalar's value as K.
# The lowering reuses the instant path's KExpr rank filter, with
# anchor_ts in the partition list so K series are picked per step.
-- query.promql --
max_over_time(topk(scalar(metric_k), rate(http_requests_total[5m]))[30m:5m])
-- seed --
CREATE TABLE otel_metrics_sum (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Value Float64
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
