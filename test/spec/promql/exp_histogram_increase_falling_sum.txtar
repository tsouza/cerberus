-- query.promql --
increase(latency_exp_hist[5m])
-- parity --
oracle: prometheus
endpoint: /api/v1/query
scope: full
-- seed --
CREATE TABLE otel_metrics_exponential_histogram (
    MetricName String,
    Attributes Map(String, String),
    TimeUnix DateTime64(9),
    Count UInt64,
    Sum Float64,
    Scale Int32,
    ZeroCount UInt64,
    PositiveOffset Int32,
    PositiveBucketCounts Array(UInt64),
    NegativeOffset Int32,
    NegativeBucketCounts Array(UInt64)
) ENGINE = MergeTree ORDER BY (MetricName, Attributes, TimeUnix);
-- A histogram that observes NEGATIVE values, so its Sum falls while
-- nothing else does. No counter reset happens anywhere in this window,
-- and reference Prometheus agrees: `FloatHistogram.DetectReset` reads
-- the bucket counts, the zero count, the schema and the observation
-- COUNT — and deliberately not the observation SUM ("in any bucket, in
-- the zero count, or in the count of observations, but NOT the sum of
-- observations"). Letting Sum vote on its own reset is the second of
-- the three divergences #2017 records.
--
-- Three scrapes 60s apart, evaluated at 00:00:01, so [5m] spans
-- (23:55:01, 00:00:01] and holds all three. Scale 0 puts positive
-- bucket 0 over (1, 2] and bucket 1 over (2, 4]; the negative array
-- starts at index 2, covering magnitudes (4, 8].
--
--   TimeUnix   Count   Sum   positive   negative
--   23:58:01      6   12.0    [4, 2]      [0]
--   23:59:01     12    0.0    [6, 3]      [3]     <- three -6s observed
--   00:00:01     15    6.0    [8, 4]      [3]
--
-- Every counter rises: Count 6 -> 12 -> 15, positives [4,2] -> [6,3] ->
-- [8,4], negatives [0] -> [3] -> [3]. Only Sum dips, at the scrape that
-- recorded the three negative observations, and it recovers afterwards.
--
-- The whole-histogram verdict is therefore "no reset at either step",
-- and every component telescopes:
--
--   Count       15 - 6  =  9
--   Sum       6.0 - 12.0 = -6.0
--   positive   [8-4, 4-2] = [4, 2]
--   negative   [3-0]      = [3]
--
-- Asking Sum alone whether it regressed answers yes at the second
-- scrape, which would contribute 0.0 for that step and 6.0 for the next
-- — a window Sum of +6.0 where reference says -6.0, wrong in sign as
-- well as magnitude.
--
-- Boundary extrapolation:
--   sampledInterval = 00:00:01 - 23:58:01           = 120s
--   averageDurationBetweenSamples = 120 / (3-1)     = 60s
--   extrapolationThreshold = 66s
--   durationToStart raw = 23:58:01 - 23:55:01 = 180s >= 66 -> 30s
--   durationToZero = 120 * (6/9) = 80s, not < 30 -> stays 30s
--   durationToEnd  = 0s
--   factor = (120 + 30 + 0) / 120                   = 1.25
--
--   Count 9*1.25 = 11.25, Sum -6.0*1.25 = -7.5,
--   positive [4*1.25, 2*1.25] = [5, 2.5], negative [3*1.25] = [3.75]
INSERT INTO otel_metrics_exponential_histogram VALUES
    ('latency_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:58:01', 9),  6, 12.0, 0, 0, 0, [4, 2], 2, [0]),
    ('latency_exp_hist', map('service', 'api'), toDateTime64('2025-12-31 23:59:01', 9), 12,  0.0, 0, 0, 0, [6, 3], 2, [3]),
    ('latency_exp_hist', map('service', 'api'), toDateTime64('2026-01-01 00:00:01', 9), 15,  6.0, 0, 0, 0, [8, 4], 2, [3]);
-- expected_rows --
[
  ["", {"service": "api"}, "2026-01-01T00:00:01Z", 0, 11.25, -7.5, 0, 0, 0, 0, [5,2.5], 2, [3.75]]
]
