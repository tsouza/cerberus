[0] string = "nanosecond"
[1] string = "2025-12-31 23:58:00.500000000Z"
[2] int64 = 9
[3] float64 = 1e+09
[4] float64 = 60
[5] string = "service_name"
[6] string = "service.name"
[7] string = "service_name"
[8] string = "service.name"
[9] string = "service_name"
[10] string = ""
[11] string = "service_name"
[12] string = "machine_load"
[13] string = "machine.load"
[14] string = "machine/load"
[15] int64 = 1
[16] int64 = 0
