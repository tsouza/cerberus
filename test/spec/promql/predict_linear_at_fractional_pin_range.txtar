-- chplan --
Project [Attributes AS Attributes, anchor_ts AS anchor_ts, anchor_ts AS TimeUnix, (Value + (predict_slope * (FnToFloat64(FnDateDiff("nanosecond", FnParseDateTime64BestEffort("2025-12-31 23:58:00.500000000Z", 9), anchor_ts)) / 1e+09))) AS Value]
  CrossJoin
    StepGrid start=2026-01-01T00:00:00.000000000Z end=2026-01-01T00:05:00.000000000Z step=1m0s
    RangeWindow func=predict_linear range=10m0s step=0s ts=TimeUnix value=Value predictSlope=predict_slope groupBy=[Attributes] scalars=[60] start=0001-01-01T00:00:00Z end=2025-12-31T23:58:00Z distinctSampleRows
      Project [MetricName AS MetricName, FnMapSort(FnMapMerge(FnMapFilter((k, v) -> (k NOT IN ("service_name")), FnMapUpdate(FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapValues(FnMapFilter((k, v) -> (k NOT IN ("service.name", "service_name")), ResourceAttributes))), FnMapFromArrays(FnArrayMap(k -> FnRegexReplaceAll(k, "[^a-zA-Z0-9_]", "_"), FnMapKeys(Attributes)), FnMapValues(Attributes)))), FnMapFilter((k, v) -> (v != ""), FnMap("service_name", FnToString(ServiceName))))) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
        Filter predicate=((MetricName IN ("machine_load", "machine.load", "machine/load")) AND FnNot((FnBitAnd(Flags, 1) != 0)))
          Scan(merge(otel_metrics_gauge|otel_metrics_sum))
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,result_cache,trace_id_bitmap_filter
log_comment=cerb:project;rw;sg;join;union
max_bytes_before_external_group_by=536870912
max_bytes_before_external_join=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
-- sql --
SELECT `Attributes` AS `Attributes`, `anchor_ts` AS `anchor_ts`, `anchor_ts` AS `TimeUnix`, (`Value` + (`predict_slope` * (toFloat64(dateDiff(?, parseDateTime64BestEffort(?, ?), `anchor_ts`)) / toFloat64(?)))) AS `Value` FROM (SELECT * FROM (SELECT arrayJoin(arrayMap(i -> parseDateTime64BestEffort('2026-01-01 00:00:00.000000000Z', 9) + toIntervalNanosecond(i * 60000000000), range(0, 6))) AS `anchor_ts`) AS L CROSS JOIN (SELECT `Attributes`, if(length(window_pairs) > 1, tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2025-12-31 23:58:00.500000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 2) + tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2025-12-31 23:58:00.500000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 1) * ?, nan) AS Value, tupleElement(arrayReduce('simpleLinearRegression', arrayMap(p -> toFloat64(dateDiff('nanosecond', parseDateTime64BestEffort('2025-12-31 23:58:00.500000000Z', 9), tupleElement(p, 1))) / 1e9, window_pairs), arrayMap(p -> tupleElement(p, 2), window_pairs)), 1) AS predict_slope FROM (SELECT `Attributes`, arrayFilter(p -> tupleElement(p, 1) > parseDateTime64BestEffort('2025-12-31 23:58:00.500000000Z', 9) - toIntervalNanosecond(600000000000) AND tupleElement(p, 1) <= parseDateTime64BestEffort('2025-12-31 23:58:00.500000000Z', 9), series_array) AS window_pairs FROM (SELECT `Attributes`, arrayCompact(arraySort(groupArray((`TimeUnix`, `Value`)))) AS series_array FROM (SELECT `MetricName` AS `MetricName`, mapSort(mapConcat(mapFilter((k, v) -> (k NOT IN (?)), mapUpdate(mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapValues(mapFilter((k, v) -> (k NOT IN (?, ?)), `ResourceAttributes`))), mapFromArrays(arrayMap(k -> replaceRegexpAll(k, '[^a-zA-Z0-9_]', '_'), mapKeys(`Attributes`)), mapValues(`Attributes`)))), mapFilter((k, v) -> (v != ?), map(?, toString(`ServiceName`))))) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT * FROM merge(currentDatabase(), '^(otel_metrics_gauge|otel_metrics_sum)$') PREWHERE (`MetricName` IN (?, ?, ?)) WHERE not((bitAnd(`Flags`, ?) != ?)))) WHERE `TimeUnix` > parseDateTime64BestEffort('2025-12-31 23:58:00.500000000Z', 9) - toIntervalNanosecond(600000000000) AND `TimeUnix` <= parseDateTime64BestEffort('2025-12-31 23:58:00.500000000Z', 9) GROUP BY `Attributes`)) WHERE length(`window_pairs`) >= 2) AS R)
