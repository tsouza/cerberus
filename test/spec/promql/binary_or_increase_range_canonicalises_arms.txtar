            Filter predicate=(MetricName IN ("otelcol_processor_refused_metric_points", "otelcol.processor.refused.metric.points", "otelcol.processor.refused.metric/points", "otelcol.processor.refused.metric_points", "otelcol.processor.refused/metric/points", "otelcol.processor.refused/metric_points", "otelcol.processor.refused_metric.points", "otelcol.processor.refused_metric_points", "otelcol.processor/refused/metric/points", "otelcol.processor/refused/metric_points", "otelcol.processor/refused_metric_points", "otelcol.processor_refused.metric.points", "otelcol.processor_refused.metric_points", "otelcol.processor_refused_metric.points", "otelcol.processor_refused_metric_points", "otelcol/processor/refused/metric/points", "otelcol/processor/refused/metric_points", "otelcol/processor/refused_metric_points", "otelcol/processor_refused_metric_points", "otelcol_processor.refused.metric.points", "otelcol_processor.refused.metric_points", "otelcol_processor.refused_metric.points", "otelcol_processor.refused_metric_points", "otelcol_processor_refused.metric.points", "otelcol_processor_refused.metric_points", "otelcol_processor_refused_metric.points"))
