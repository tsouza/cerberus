-- sql --
SELECT ? AS `MetricName`, mapConcat(L.`Attributes`, mapFilter((k, v) -> k IN (?), R.`Attributes`)) AS `Attributes`, L.`TimeUnix` AS `TimeUnix`, pow(L.`Value`, R.`Value`) AS `Value` FROM (SELECT `_join_MetricName` AS `MetricName`, `_join_Attributes` AS `Attributes`, `_join_TimeUnix` AS `TimeUnix`, `_join_Value` AS `Value` FROM (SELECT ? AS `_join_MetricName`, CAST((mapSort(`Attributes`) AS `_typed_18ee61412fc7a727`), toTypeName(`_typed_18ee61412fc7a727`)) AS `_join_Attributes`, max(`TimeUnix`) AS `_join_TimeUnix`, argMax(`Value`, `TimeUnix`) AS `_join_Value` FROM (SELECT * FROM `otel_metrics_gauge`) GROUP BY CAST((mapSort(`Attributes`) AS `_typed_18ee61412fc7a727`), toTypeName(`_typed_18ee61412fc7a727`)))) AS L INNER JOIN (SELECT `_join_MetricName` AS `MetricName`, `_join_Attributes` AS `Attributes`, `_join_TimeUnix` AS `TimeUnix`, `_join_Value` AS `Value` FROM (SELECT ? AS `_join_MetricName`, argMax(CAST((mapSort(`Attributes`) AS `_typed_18ee61412fc7a727`), toTypeName(`_typed_18ee61412fc7a727`)), `TimeUnix`) AS `_join_Attributes`, max(`TimeUnix`) AS `_join_TimeUnix`, argMax(`Value`, `TimeUnix`) AS `_join_Value` FROM (SELECT * FROM `otel_metrics_sum`) GROUP BY CAST((mapSort(mapFilter((k, v) -> k IN (?, ?), `Attributes`)) AS `_typed_dbafb9b067dde84d`), toTypeName(`_typed_dbafb9b067dde84d`)) HAVING throwIf(uniqExact(CAST((mapSort(`Attributes`) AS `_typed_18ee61412fc7a727`), toTypeName(`_typed_18ee61412fc7a727`))) > 1, 'many-to-many matching not allowed: matching labels must be unique on one side') = 0)) AS R ON L.`Attributes`[?] = R.`Attributes`[?] AND L.`Attributes`[?] = R.`Attributes`[?]
-- args --
[0] string = ""
[1] string = "job"
[2] string = ""
[3] string = ""
[4] string = "instance"
[5] string = "type"
[6] string = "instance"
[7] string = "instance"
[8] string = "type"
[9] string = "type"
-- chplan --
VectorJoin op=^ match=on(instance,type) card=many-to-one include=[job]
  Scan(otel_metrics_gauge)
  Scan(otel_metrics_sum)
