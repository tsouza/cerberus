-- sql --
SELECT `Attributes` AS `attrs`, `total` AS `v` FROM (SELECT `Attributes`, sum(`Value`) AS `total` FROM (SELECT * REPLACE (CAST((mapSort(`Attributes`) AS `_typed_18ee61412fc7a727`), toTypeName(`_typed_18ee61412fc7a727`)) AS `Attributes`) FROM (SELECT * FROM `otel_metrics_gauge`)) GROUP BY `Attributes`)
-- args --
(none)
-- chplan --
Project [Attributes AS attrs, total AS v]
  Aggregate groupBy=[Attributes] funcs=[FnSum(Value) AS total]
    Scan(otel_metrics_gauge)
