-- sql --
SELECT `Attributes`, quantile(toFloat64(?))(`Value`) AS `p95` FROM (SELECT * REPLACE (mapSort(`Attributes`) AS `Attributes`) FROM (SELECT * FROM `otel_metrics_gauge`)) GROUP BY `Attributes`
-- args --
[0] float64 = 0.95
-- chplan --
Aggregate groupBy=[Attributes] funcs=[quantile(0.95)(Value) AS p95]
  Scan(otel_metrics_gauge)
