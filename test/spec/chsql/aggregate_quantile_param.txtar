-- sql --
SELECT `Attributes`, quantileExactInclusive(toFloat64(?))(`Value`) AS `p95` FROM (SELECT * REPLACE (CAST((mapSort(`Attributes`) AS `_typed_18ee61412fc7a727`), toTypeName(`_typed_18ee61412fc7a727`)) AS `Attributes`) FROM (SELECT * FROM `otel_metrics_gauge`)) GROUP BY `Attributes`
-- args --
[0] float64 = 0.95
-- chplan --
Aggregate groupBy=[Attributes] funcs=[FnQuantile(0.95)(Value) AS p95]
  Scan(otel_metrics_gauge)
