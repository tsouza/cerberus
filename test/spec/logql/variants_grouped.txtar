-- chplan --
Project [MetricName AS MetricName, FnMapMerge(Attributes, FnMap("__variant__", __variant__)) AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
  Project ["" AS MetricName, FnMap("app", gkey_0) AS Attributes, FnNow64(9) AS TimeUnix, Value AS Value, __variant__ AS __variant__]
    Aggregate groupBy=[ResourceAttributes["app"] AS gkey_0, __variant__ AS __variant__] funcs=[FnSum(Value) AS Value] dropEmptyOnNoGroup
      RangeWindow func= range=5m0s step=0s variants=[0:count_over_time=Value_0, 1:sum_over_time=Value_1] variantCol=__variant__ ts=Timestamp value=Value groupBy=[ResourceAttributes]
        Project [FnMapSort(FnMapMerge(ResourceAttributes, FnMapFilter((k, v) -> (v != ""), FnMap("detected_level", _logql_detected_level, "app", FnIf(FnMapContainsKey(LogAttributes, "app"), LogAttributes["app"], ResourceAttributes["app"]))))) AS ResourceAttributes, Timestamp, 1 AS Value_0, FnToFloat64(FnLength(Body)) AS Value_1]
          Project [Body, LogAttributes, ResourceAttributes, Timestamp, FnMultiIf((FnLower(_logql_level_source) = ""), "unknown", ((FnLower(_logql_level_source) = "trace") OR (FnLower(_logql_level_source) = "trc")), "trace", ((FnLower(_logql_level_source) = "debug") OR (FnLower(_logql_level_source) = "dbg")), "debug", (((FnLower(_logql_level_source) = "info") OR (FnLower(_logql_level_source) = "inf")) OR (FnLower(_logql_level_source) = "information")), "info", (((FnLower(_logql_level_source) = "warn") OR (FnLower(_logql_level_source) = "wrn")) OR (FnLower(_logql_level_source) = "warning")), "warn", ((FnLower(_logql_level_source) = "error") OR (FnLower(_logql_level_source) = "err")), "error", (FnLower(_logql_level_source) = "critical"), "critical", (FnLower(_logql_level_source) = "fatal"), "fatal", _logql_level_source) AS _logql_detected_level]
            Project [Body, LogAttributes, ResourceAttributes, Timestamp, FnMultiIf((LogAttributes["detected_level"] != ""), LogAttributes["detected_level"], (LogAttributes["level"] != ""), LogAttributes["level"], (LogAttributes["log.level"] != ""), LogAttributes["log.level"], (LogAttributes["severity"] != ""), LogAttributes["severity"], (LogAttributes["severity_text"] != ""), LogAttributes["severity_text"], FnMultiIf((SeverityText != ""), SeverityText, FnMultiIf((SeverityNumber <= 0), "", (SeverityNumber <= 4), "trace", (SeverityNumber <= 8), "debug", (SeverityNumber <= 12), "info", (SeverityNumber <= 16), "warn", (SeverityNumber <= 20), "error", (SeverityNumber <= 24), "fatal", ""))) AS _logql_level_source]
              Filter predicate=(ResourceAttributes["app"] = "foo")
                Scan(otel_logs)
-- sql --
SELECT `MetricName` AS `MetricName`, mapConcat(`Attributes`, map(?, `__variant__`)) AS `Attributes`, `TimeUnix` AS `TimeUnix`, `Value` AS `Value` FROM (SELECT ? AS `MetricName`, map(?, `gkey_0`) AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value`, `__variant__` AS `__variant__` FROM (SELECT `ResourceAttributes`[?] AS `gkey_0`, `__variant__` AS `__variant__`, sum(`Value`) AS `Value` FROM (SELECT `ResourceAttributes`, `Value`, `__variant__` FROM (SELECT `ResourceAttributes`, `window_pairs`, arrayMap(p -> tupleElement(p, 2), arraySort(p -> (tupleElement(p, 1), tupleElement(p, 2)), window_pairs)) AS `window_vals_0`, arrayMap(p -> tupleElement(p, 3), arraySort(p -> (tupleElement(p, 1), tupleElement(p, 3)), window_pairs)) AS `window_vals_1` FROM (SELECT `ResourceAttributes`, arrayFilter(p -> tupleElement(p, 1) > now64(9) - toIntervalNanosecond(300000000000) AND tupleElement(p, 1) <= now64(9), series_array) AS `window_pairs` FROM (SELECT `ResourceAttributes`, arraySort(groupArray((`Timestamp`, `Value_0`, `Value_1`))) AS `series_array` FROM (SELECT mapSort(mapConcat(`ResourceAttributes`, mapFilter((k, v) -> (v != ?), map(?, `_logql_detected_level`, ?, if(mapContains(`LogAttributes`, ?), `LogAttributes`[?], `ResourceAttributes`[?]))))) AS `ResourceAttributes`, `Timestamp`, ? AS `Value_0`, toFloat64(length(`Body`)) AS `Value_1` FROM (SELECT `Body`, `LogAttributes`, `ResourceAttributes`, `Timestamp`, multiIf((lower(`_logql_level_source`) = ?), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, (((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)) OR (lower(`_logql_level_source`) = ?)), ?, (((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)) OR (lower(`_logql_level_source`) = ?)), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, (lower(`_logql_level_source`) = ?), ?, (lower(`_logql_level_source`) = ?), ?, `_logql_level_source`) AS `_logql_detected_level` FROM (SELECT `Body`, `LogAttributes`, `ResourceAttributes`, `Timestamp`, multiIf((`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], multiIf((`SeverityText` != ?), `SeverityText`, multiIf((`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, ?))) AS `_logql_level_source` FROM (SELECT * FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?))))) WHERE `Timestamp` > now64(9) - toIntervalNanosecond(300000000000) AND `Timestamp` <= now64(9) GROUP BY `ResourceAttributes`))) ARRAY JOIN [toFloat64(length(window_vals_0)), arraySum(window_vals_1)] AS `Value`, [?, ?] AS `__variant__` WHERE length(`window_pairs`) >= 1) GROUP BY `gkey_0`, `__variant__`))
