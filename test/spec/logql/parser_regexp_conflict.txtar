-- query.logql --
{level="error"} | regexp "level=(?P<level>\\w+)" | level_extracted="warn"
-- seed --
CREATE TABLE otel_logs (
    LogAttributes Map(String, String) MATERIALIZED map(),
    Body String,
    ResourceAttributes Map(String, String) MATERIALIZED map('level', 'error')
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES
    ('ts=2025-01-01 level=warn msg="picks-up"'),
    ('ts=2025-01-01 level=info msg="rejected"'),
    ('ts=2025-01-01 level=warn msg="also-picks-up"');
-- expected_rows --
[
  ["ts=2025-01-01 level=warn msg=\"also-picks-up\""],
  ["ts=2025-01-01 level=warn msg=\"picks-up\""]
]
-- args --
[0] string = "level"
[1] string = "error"
[2] string = "level"
[3] string = "level_extracted"
[4] string = "level"
[5] string = "level=(?P<level>\\w+)"
[6] int64 = 1
[7] int64 = 1
[8] string = "level_extracted"
[9] string = "level"
[10] string = "level_extracted"
[11] string = "level"
[12] string = "level=(?P<level>\\w+)"
[13] int64 = 1
[14] int64 = 1
[15] string = "level_extracted"
[16] string = "level_extracted"
[17] string = "level_extracted"
[18] string = "level.extracted"
