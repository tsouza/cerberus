-- query.logql --
{job="api",env!="prod",region=~"us-.*",cell!~"staging.*"}
-- seed --
CREATE TABLE otel_logs (
    Body String,
    ResourceAttributes Map(String, String) MATERIALIZED map(
        'job', if(Body = 'wrong-job', 'other', 'api'),
        'env', if(Body = 'wrong-env', 'prod', 'staging'),
        'region', if(Body = 'wrong-region', 'eu-west', 'us-east'),
        'cell', if(Body = 'wrong-cell', 'staging-2', 'prod-1')
    )
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES ('match'), ('wrong-env'), ('wrong-region'), ('wrong-cell'), ('wrong-job');
-- expected_rows --
[
  ["match"]
]
