-- chplan --
RangeWindow func=avg_over_time range=5m0s step=0s ts=Timestamp value=Value groupBy=[ResourceAttributes]
  Project [FnMapSort(FnIf(FnMapContainsKey(_logql_unwrap_labels, "__error__"), FnMapMerge(_logql_unwrap_labels, FnMapFilter((k, v) -> (v != ""), FnMap("detected_level", _logql_detected_level))), FnMapMerge(mapWithout(_logql_unwrap_labels, [latency]), FnMapFilter((k, v) -> (v != ""), FnMap("detected_level", _logql_detected_level))))) AS ResourceAttributes, Timestamp, FnToFloat64OrZero(_logql_unwrap_source) AS Value]
    Project [Timestamp, _logql_detected_level, _logql_unwrap_source, FnMapMerge(ResourceAttributes, FnIf((FnNot(FnMapContainsKey(ResourceAttributes, "__error__")) AND FnNot(FnRegexMatch(_logql_unwrap_source, "^[+-]?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?|[iI][nN][fF]([iI][nN][iI][tT][yY])?|[nN][aA][nN])$"))), FnMap("__error__", "SampleExtractionErr", "__error_details__", FnConcat("strconv.ParseFloat: parsing \"", _logql_unwrap_source, "\": invalid syntax")), FnMap())) AS _logql_unwrap_labels]
      Filter predicate=(_logql_unwrap_source != "")
        Project [ResourceAttributes, Timestamp, _logql_detected_level, FnIf(FnMapContainsKey(LogAttributes, "latency"), LogAttributes["latency"], ResourceAttributes["latency"]) AS _logql_unwrap_source]
          Project [LogAttributes, ResourceAttributes, Timestamp, FnMultiIf((FnLower(_logql_level_source) = ""), "unknown", ((FnLower(_logql_level_source) = "trace") OR (FnLower(_logql_level_source) = "trc")), "trace", ((FnLower(_logql_level_source) = "debug") OR (FnLower(_logql_level_source) = "dbg")), "debug", (((FnLower(_logql_level_source) = "info") OR (FnLower(_logql_level_source) = "inf")) OR (FnLower(_logql_level_source) = "information")), "info", (((FnLower(_logql_level_source) = "warn") OR (FnLower(_logql_level_source) = "wrn")) OR (FnLower(_logql_level_source) = "warning")), "warn", ((FnLower(_logql_level_source) = "error") OR (FnLower(_logql_level_source) = "err")), "error", (FnLower(_logql_level_source) = "critical"), "critical", (FnLower(_logql_level_source) = "fatal"), "fatal", _logql_level_source) AS _logql_detected_level]
            Project [LogAttributes, ResourceAttributes, Timestamp, FnMultiIf((LogAttributes["detected_level"] != ""), LogAttributes["detected_level"], (LogAttributes["level"] != ""), LogAttributes["level"], (LogAttributes["log.level"] != ""), LogAttributes["log.level"], (LogAttributes["severity"] != ""), LogAttributes["severity"], (LogAttributes["severity_text"] != ""), LogAttributes["severity_text"], FnMultiIf((SeverityText != ""), SeverityText, FnMultiIf((SeverityNumber <= 0), "", (SeverityNumber <= 4), "trace", (SeverityNumber <= 8), "debug", (SeverityNumber <= 12), "info", (SeverityNumber <= 16), "warn", (SeverityNumber <= 20), "error", (SeverityNumber <= 24), "fatal", ""))) AS _logql_level_source]
              Filter predicate=(ResourceAttributes["job"] = "api")
                Scan(otel_logs)
-- sql --
SELECT `ResourceAttributes`, if(length(window_vals) > 0, arrayAvg(window_vals), nan) AS `Value` FROM (SELECT `ResourceAttributes`, arrayMap(p -> tupleElement(p, 2), window_pairs) AS `window_vals`, arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), window_pairs)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), window_pairs)))) AS `counter_delta` FROM (SELECT `ResourceAttributes`, arrayFilter(p -> tupleElement(p, 1) > now64(9) - toIntervalNanosecond(300000000000) AND tupleElement(p, 1) <= now64(9), series_array) AS `window_pairs` FROM (SELECT `ResourceAttributes`, arraySort(groupArray((`Timestamp`, `Value`))) AS `series_array` FROM (SELECT mapSort(if(mapContains(`_logql_unwrap_labels`, ?), mapConcat(`_logql_unwrap_labels`, mapFilter((k, v) -> (v != ?), map(?, `_logql_detected_level`))), mapConcat(mapFilter((k, v) -> NOT (k IN (?)), `_logql_unwrap_labels`), mapFilter((k, v) -> (v != ?), map(?, `_logql_detected_level`))))) AS `ResourceAttributes`, `Timestamp`, toFloat64OrZero(`_logql_unwrap_source`) AS `Value` FROM (SELECT `Timestamp`, `_logql_detected_level`, `_logql_unwrap_source`, mapConcat(`ResourceAttributes`, if((not(mapContains(`ResourceAttributes`, ?)) AND not(match(`_logql_unwrap_source`, ?))), map(?, ?, ?, concat(?, `_logql_unwrap_source`, ?)), map())) AS `_logql_unwrap_labels` FROM (SELECT * FROM (SELECT `ResourceAttributes`, `Timestamp`, `_logql_detected_level`, if(mapContains(`LogAttributes`, ?), `LogAttributes`[?], `ResourceAttributes`[?]) AS `_logql_unwrap_source` FROM (SELECT `LogAttributes`, `ResourceAttributes`, `Timestamp`, multiIf((lower(`_logql_level_source`) = ?), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, (((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)) OR (lower(`_logql_level_source`) = ?)), ?, (((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)) OR (lower(`_logql_level_source`) = ?)), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, (lower(`_logql_level_source`) = ?), ?, (lower(`_logql_level_source`) = ?), ?, `_logql_level_source`) AS `_logql_detected_level` FROM (SELECT `LogAttributes`, `ResourceAttributes`, `Timestamp`, multiIf((`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], multiIf((`SeverityText` != ?), `SeverityText`, multiIf((`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, ?))) AS `_logql_level_source` FROM (SELECT * FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?))))) WHERE (`_logql_unwrap_source` != ?)))) WHERE `Timestamp` > now64(9) - toIntervalNanosecond(300000000000) AND `Timestamp` <= now64(9) GROUP BY `ResourceAttributes`))) WHERE length(`window_vals`) >= 1
-- parity_exempt --
reason: structured-metadata-unobservable
detail: seed populates LogAttributes ({'latency':'10'}), which upstream's in-process querier discards before the pipeline runs, so `avg_over_time({job="api"} | unwrap latency [5m])` would be answered over different data on the two sides
