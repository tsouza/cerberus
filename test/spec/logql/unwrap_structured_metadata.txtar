-- query.logql --
avg_over_time({job="api"} | unwrap latency [5m])
-- seed --
CREATE TABLE otel_logs (
    Timestamp DateTime64(9),
    Body String,
    SeverityText LowCardinality(String) DEFAULT '',
    SeverityNumber UInt8 DEFAULT 0,
    ResourceAttributes Map(String, String),
    LogAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_logs (Timestamp, Body, SeverityText, ResourceAttributes, LogAttributes) VALUES
    (toDateTime64('2025-12-31 23:58:00', 9), 'a', 'INFO', map('job', 'api'), map('latency', '10')),
    (toDateTime64('2025-12-31 23:59:00', 9), 'b', 'INFO', map('job', 'api'), map('latency', '20')),
    (toDateTime64('2026-01-01 00:00:00', 9), 'c', 'INFO', map('job', 'api'), map('latency', '30'));
-- expected_rows --
[
  [{"detected_level": "info", "job": "api"}, 20]
]
