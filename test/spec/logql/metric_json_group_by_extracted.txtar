-- query.logql --
sum by (category) (count_over_time({job="api"} | json [5m]))
-- seed --
CREATE TABLE otel_logs (
    Timestamp DateTime64(9),
    Body String,
    SeverityText LowCardinality(String) DEFAULT '',
    SeverityNumber UInt8 DEFAULT 0,
    ResourceAttributes Map(String, String),
    LogAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_logs (Timestamp, Body, SeverityText, ResourceAttributes) VALUES
    (toDateTime64('2025-12-31 23:58:00', 9), '{"msg":"login ok","category":"auth"}', 'INFO', map('job', 'api')),
    (toDateTime64('2025-12-31 23:59:00', 9), '{"msg":"login denied","category":"auth"}', 'WARN', map('job', 'api')),
    (toDateTime64('2026-01-01 00:00:00', 9), '{"msg":"query ran","category":"db"}', 'INFO', map('job', 'api'));
