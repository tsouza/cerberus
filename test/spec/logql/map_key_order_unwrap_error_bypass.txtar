-- sql --
SELECT ? AS `MetricName`, CAST(map(), ?) AS `Attributes`, now64(?) AS `TimeUnix`, `Value` AS `Value` FROM (SELECT `Value` FROM (SELECT toFloat64(count(`Value`)) AS `Value`, count() AS `_cerb_n` FROM (SELECT `ResourceAttributes`, arraySum(window_vals) AS `Value` FROM (SELECT `ResourceAttributes`, arrayMap(p -> tupleElement(p, 2), window_pairs) AS `window_vals`, arraySum(arrayMap((p, c) -> if(c < p, c, c - p), arrayPopBack(arrayMap(x -> tupleElement(x, 2), window_pairs)), arrayPopFront(arrayMap(x -> tupleElement(x, 2), window_pairs)))) AS `counter_delta` FROM (SELECT `ResourceAttributes`, arrayFilter(p -> tupleElement(p, 1) > now64(9) - toIntervalNanosecond(300000000000) AND tupleElement(p, 1) <= now64(9), series_array) AS `window_pairs` FROM (SELECT `ResourceAttributes`, arraySort(groupArray((`Timestamp`, `Value`))) AS `series_array` FROM (SELECT mapSort(if(mapContains(`_logql_unwrap_post_labels`, ?), mapConcat(`_logql_unwrap_post_labels`, mapFilter((k, v) -> (v != ?), map(?, `_logql_detected_level`))), mapConcat(mapFilter((k, v) -> NOT (k IN (?)), `_logql_unwrap_post_labels`), mapFilter((k, v) -> (v != ?), map(?, `_logql_detected_level`))))) AS `ResourceAttributes`, `Timestamp`, toFloat64OrZero(`_logql_unwrap_source`) AS `Value` FROM (SELECT `Timestamp`, `_logql_detected_level`, `_logql_unwrap_source`, mapConcat(`_logql_unwrap_labels`, if((not(mapContains(`_logql_unwrap_labels`, ?)) AND ((mapContains(`_logql_unwrap_labels`, ?) OR mapContains(`LogAttributes`, ?)) AND not(match(if(mapContains(`_logql_unwrap_labels`, ?), `_logql_unwrap_labels`[?], `LogAttributes`[?]), ?)))), map(?, ?, ?, concat(?, if(mapContains(`_logql_unwrap_labels`, ?), `_logql_unwrap_labels`[?], `LogAttributes`[?]), ?)), map())) AS `_logql_unwrap_post_labels` FROM (SELECT * FROM (SELECT `LogAttributes`, `Timestamp`, `_logql_detected_level`, `_logql_unwrap_source`, mapConcat(`_logql_labels_0`, if((not(mapContains(`_logql_labels_0`, ?)) AND not(match(`_logql_unwrap_source`, ?))), map(?, ?, ?, concat(?, `_logql_unwrap_source`, ?)), map())) AS `_logql_unwrap_labels` FROM (SELECT * FROM (SELECT `LogAttributes`, `Timestamp`, `_logql_detected_level`, `_logql_labels_0`, if(mapContains(`_logql_labels_0`, ?), `_logql_labels_0`[?], `LogAttributes`[?]) AS `_logql_unwrap_source` FROM (SELECT `LogAttributes`, `Timestamp`, `_logql_labels_0`, multiIf((lower(`_logql_level_source`) = ?), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, (((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)) OR (lower(`_logql_level_source`) = ?)), ?, (((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)) OR (lower(`_logql_level_source`) = ?)), ?, ((lower(`_logql_level_source`) = ?) OR (lower(`_logql_level_source`) = ?)), ?, (lower(`_logql_level_source`) = ?), ?, (lower(`_logql_level_source`) = ?), ?, `_logql_level_source`) AS `_logql_detected_level` FROM (SELECT `LogAttributes`, `Timestamp`, `_logql_labels_0`, multiIf((`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], (`LogAttributes`[?] != ?), `LogAttributes`[?], multiIf((`SeverityText` != ?), `SeverityText`, multiIf((`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, (`SeverityNumber` <= ?), ?, ?))) AS `_logql_level_source` FROM (SELECT `LogAttributes`, `SeverityNumber`, `SeverityText`, `Timestamp`, mapConcat(`ResourceAttributes`, mapApply((k, v) -> tuple(if(mapContains(`ResourceAttributes`, k), concat(k, ?), k), v), CAST(arrayReverse(arrayFold((__json_seen, __json_entry) -> if(has(arrayMap(__json_seen_entry -> tupleElement(__json_seen_entry, ?), __json_seen), tupleElement(__json_entry, ?)), __json_seen, arrayPushBack(__json_seen, __json_entry)), arrayReverse(CAST(extractKeyValuePairs(`Body`, ?, ?, ?), ?)), CAST(array(), ?))), ?))) AS `_logql_labels_0` FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?))))) WHERE (`_logql_unwrap_source` != ?))) WHERE multiIf(not((mapContains(`_logql_unwrap_labels`, ?) OR mapContains(`LogAttributes`, ?))), ?, not(match(if(mapContains(`_logql_unwrap_labels`, ?), `_logql_unwrap_labels`[?], `LogAttributes`[?]), ?)), ?, (toFloat64OrZero(if(mapContains(`_logql_unwrap_labels`, ?), `_logql_unwrap_labels`[?], `LogAttributes`[?])) > toFloat64(?)))))) WHERE `Timestamp` > now64(9) - toIntervalNanosecond(300000000000) AND `Timestamp` <= now64(9) GROUP BY `ResourceAttributes`))) WHERE length(`window_vals`) >= 1)) WHERE `_cerb_n` > 0)
-- parity_exempt --
reason: structured-metadata-unobservable
detail: seed populates SeverityText (INFO), which upstream's in-process querier discards before the pipeline runs, so `count(sum_over_time({job="api"} | logfmt | unwrap latency | status > 100 [5m]))` would be answered over different data on the two sides
