        Project [Timestamp, _logql_detected_level, _logql_unwrap_source, FnMapMerge(_logql_unwrap_labels, FnIf((FnNot(FnMapContainsKey(_logql_unwrap_labels, "__error__")) AND ((FnMapContainsKey(_logql_unwrap_labels, "status") OR FnMapContainsKey(LogAttributes, "status")) AND FnNot(FnRegexMatch(FnIf(FnMapContainsKey(_logql_unwrap_labels, "status"), _logql_unwrap_labels["status"], LogAttributes["status"]), "^[+-]?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?|[iI][nN][fF]([iI][nN][iI][tT][yY])?|[nN][aA][nN])$")))), FnMap("__error__", "LabelFilterErr", "__error_details__", FnConcat("strconv.ParseFloat: parsing \"", FnIf(FnMapContainsKey(_logql_unwrap_labels, "status"), _logql_unwrap_labels["status"], LogAttributes["status"]), "\": invalid syntax")), FnMap())) AS _logql_unwrap_post_labels]
