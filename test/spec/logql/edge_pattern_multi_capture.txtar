-- query.logql --
{job="api"} | pattern "<ts> <level> <msg>" | level="error"
-- args --
[0] string = "job"
[1] string = "api"
[2] string = "level"
[3] string = "level"
[4] string = "level"
[5] string = "error"
-- sql --
SELECT * FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?) AND (if(mapContains(`LogAttributes`, ?), `LogAttributes`[?], `ResourceAttributes`[?]) = ?)
-- seed --
CREATE TABLE otel_logs (
    LogAttributes Map(String, String) DEFAULT map(),
    Body String,
    ResourceAttributes Map(String, String) DEFAULT map(
        'job', 'api',
        'level', if(Body LIKE 'e%', 'error', if(Body LIKE 'w%', 'warn', 'info'))
    ),
    SeverityNumber UInt8 DEFAULT 0,
    SeverityText LowCardinality(String) DEFAULT '',
    Timestamp DateTime64(9) DEFAULT 0
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES
    ('e1 2026-01-01 error db timeout'),
    ('e2 2026-01-01 error upstream gone'),
    ('w1 2026-01-01 warn slow'),
    ('i1 2026-01-01 info ok');
-- expected_rows --
[
  ["e1 2026-01-01 error db timeout"],
  ["e2 2026-01-01 error upstream gone"]
]
-- chplan --
Filter predicate=((ResourceAttributes["job"] = "api") AND (FnIf(FnMapContainsKey(LogAttributes, "level"), LogAttributes["level"], ResourceAttributes["level"]) = "error"))
  Scan(otel_logs)
-- parity_exempt --
reason: log-query-answer
detail: log query `{job="api"} | pattern "<ts> <level> <msg>" | level="error"` answers with log lines: the reference returns logqlmodel.Streams and cerberus the log rows (line, labels, timestamp, structured metadata) its lowering projects, which have no element-wise correspondence
