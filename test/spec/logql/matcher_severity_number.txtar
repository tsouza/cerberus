-- query.logql --
{SeverityNumber="9"}
-- seed --
-- Task #240 twin of matcher_severity_text: SeverityNumber is one of the
-- 9 top-level OTel-CH scalar columns. The OTel collector → CH exporter
-- promotes severity_number into a dedicated UInt8 column, but the
-- matcher pre-#240 looked only at ResourceAttributes['SeverityNumber'] (empty
-- map for promoted rows) so `{SeverityNumber="9"}` returned 0 rows
-- even though the row was present. The coalesce fallback fixes it.
--
-- NB: LogQL matchers are string-typed. The value "9" matches the
-- CH-rendered string form of the UInt8 (9 → '9') through the coalesce.
--
-- The column is declared UInt8 here because that is what the OTel-CH
-- exporter declares (test/e2e/migration/expected/schema/default.sql:225).
-- It used to be declared String, which is what made this fixture unable
-- to see cerberus issue #3183's defect: the fallback NULLed the column
-- out against the STRING literal '', which ClickHouse refuses on a UInt8
-- with `Code: 32 … while converting '' to UInt8`, so `{SeverityNumber="9"}`
-- was a 502 in production while this fixture passed. A seed that models a
-- column at the wrong type cannot catch a type error.
--
-- The `map-only` row is what pins the numeric "unset" sentinel: with a
-- UInt8 there is no empty string, and the exporter writes 0 for a record
-- carrying no severity, so 0 is the value the coalesce must fall through
-- to the map on.
CREATE TABLE otel_logs (
    Timestamp DateTime64(9),
    Body String,
    SeverityNumber UInt8 DEFAULT multiIf(
        Body = 'top-level-only', 9,
        Body = 'both', 9,
        Body = 'negative-top', 17,
        0
    ),
    ResourceAttributes Map(String, String) DEFAULT multiIf(
        Body = 'map-only', map('SeverityNumber', '9'),
        Body = 'both', map('SeverityNumber', '9'),
        Body = 'negative-map', map('SeverityNumber', '17'),
        CAST(map() AS Map(String, String))
    ),
    LogAttributes Map(String, String) DEFAULT map(),
    SeverityText LowCardinality(String) DEFAULT ''
) ENGINE = Memory;
INSERT INTO otel_logs (Timestamp, Body) VALUES
    (toDateTime64('2026-05-20 12:00:00.000000000', 9), 'top-level-only'),
    (toDateTime64('2026-05-20 12:01:00.000000000', 9), 'map-only'),
    (toDateTime64('2026-05-20 12:02:00.000000000', 9), 'both'),
    (toDateTime64('2026-05-20 12:03:00.000000000', 9), 'negative-top'),
    (toDateTime64('2026-05-20 12:04:00.000000000', 9), 'negative-map');
-- expected_rows --
[
  ["both", {"SeverityNumber": "9", "detected_level": "info"}, "2026-05-20T12:02:00Z", {}],
  ["map-only", {"SeverityNumber": "9", "detected_level": "unknown"}, "2026-05-20T12:01:00Z", {}],
  ["top-level-only", {"detected_level": "info"}, "2026-05-20T12:00:00Z", {}]
]
