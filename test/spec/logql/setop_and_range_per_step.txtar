  Project [MetricName AS MetricName, Attributes AS Attributes, TimeUnix AS TimeUnix, Value AS Value]
    Project ["" AS MetricName, FnMap("env", gkey_0) AS Attributes, bucket_ts AS TimeUnix, Value AS Value]
      Aggregate groupBy=[ResourceAttributes["env"] AS gkey_0, anchor_ts AS bucket_ts] funcs=[FnSum(Value) AS Value] dropEmptyOnNoGroup
        RangeWindow func=count_over_time range=1m0s step=1m0s outerRange=3m0s ts=Timestamp value=Value groupBy=[ResourceAttributes] start=2026-01-01T00:00:00Z end=2026-01-01T00:03:00Z
          Project [FnMapSort(FnMapMerge(ResourceAttributes, FnMapFilter((k, v) -> (v != ""), FnMap("detected_level", _logql_detected_level, "env", FnIf(FnMapContainsKey(LogAttributes, "env"), LogAttributes["env"], ResourceAttributes["env"]))))) AS ResourceAttributes, Timestamp, 1 AS Value]
