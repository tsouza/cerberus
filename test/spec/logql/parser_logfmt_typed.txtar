[
  ["ts=2025-01-01 severity=error msg=\"oops\"", {"detected_level": "unknown", "job": "api", "level": "error"}, "1970-01-01T00:00:00Z", {}],
  ["ts=2025-01-01 severity=error msg=\"retry\"", {"detected_level": "unknown", "job": "api", "level": "error"}, "1970-01-01T00:00:00Z", {}]
]
