-- query.logql --
{job="api"} | keep job, env
-- args --
[0] string = ""
[1] string = "job"
[2] string = "api"
-- sql --
SELECT `Body` AS `Line`, `ResourceAttributes` AS `Attributes`, `Timestamp` AS `TimeUnix`, toJSONString(mapFilter((k, v) -> (v != ?), `LogAttributes`)) AS `Metadata` FROM (SELECT * FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?))
-- seed --
CREATE TABLE otel_logs (
    Body String,
    ResourceAttributes Map(String, String) DEFAULT map('job', 'api', 'env', 'prod', 'pod', 'web-1'),
    LogAttributes Map(String, String) DEFAULT map(),
    Timestamp DateTime64(9) DEFAULT 0
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES ('hi');
-- expected_rows --
[
  ["hi", {"env": "prod", "job": "api", "pod": "web-1"}, "1970-01-01T00:00:00Z", {}]
]
-- chplan --
Project [Body AS Line, ResourceAttributes AS Attributes, Timestamp AS TimeUnix, FnToJSONString(FnMapFilter((k, v) -> (v != ""), LogAttributes)) AS Metadata] oneScopeRows
  Filter predicate=(ResourceAttributes["job"] = "api")
    Scan(otel_logs)
-- parity_exempt --
reason: log-query-answer
detail: log query `{job="api"} | keep job, env` answers with log lines: the reference returns logqlmodel.Streams and cerberus the log rows (line, labels, timestamp, structured metadata) its lowering projects, which have no element-wise correspondence
