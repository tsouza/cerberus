-- query.logql --
{job="api"} | regexp "(?P<status>\\d{3})" | status="500"
-- sql --
SELECT * FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?) AND (if(mapContains(mapConcat(`ResourceAttributes`, map(if(mapContains(`ResourceAttributes`, ?), ?, ?), extractAllGroupsHorizontal(`Body`, ?)[?][?])), ?), mapConcat(`ResourceAttributes`, map(if(mapContains(`ResourceAttributes`, ?), ?, ?), extractAllGroupsHorizontal(`Body`, ?)[?][?]))[?], `LogAttributes`[?]) = ?)
