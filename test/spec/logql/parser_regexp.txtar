-- query.logql --
{job="api"} | regexp "(?P<status>\\d{3})" | status="500"
-- sql --
SELECT * FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?) AND (if(mapContains(mapConcat(`ResourceAttributes`, map(if(mapContains(`ResourceAttributes`, ?), ?, ?), extractAllGroupsHorizontal(`Body`, ?)[?][?])), ?), mapConcat(`ResourceAttributes`, map(if(mapContains(`ResourceAttributes`, ?), ?, ?), extractAllGroupsHorizontal(`Body`, ?)[?][?]))[?], `LogAttributes`[?]) = ?)
-- args --
[0] string = "job"
[1] string = "api"
[2] string = "status"
[3] string = "status_extracted"
[4] string = "status"
[5] string = "(?P<status>\\d{3})"
[6] int64 = 1
[7] int64 = 1
[8] string = "status"
[9] string = "status"
[10] string = "status_extracted"
[11] string = "status"
[12] string = "(?P<status>\\d{3})"
[13] int64 = 1
[14] int64 = 1
[15] string = "status"
[16] string = "status"
[17] string = "500"
-- seed --
CREATE TABLE otel_logs (
    LogAttributes Map(String, String) MATERIALIZED map(),
    Body String,
    ResourceAttributes Map(String, String) MATERIALIZED map('job', 'api')
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES
    ('GET /api 500 took=12ms'),
    ('GET /api 200 took=5ms'),
    ('POST /api 500 took=22ms');
-- expected_rows --
[
  ["GET /api 500 took=12ms"],
  ["POST /api 500 took=22ms"]
]
-- chplan --
Filter predicate=((ResourceAttributes["job"] = "api") AND (if(mapContains(mapConcat(ResourceAttributes, map(if(mapContains(ResourceAttributes, "status"), "status_extracted", "status"), extractAllGroupsHorizontal(Body, "(?P<status>\\d{3})")[1][1])), "status"), mapConcat(ResourceAttributes, map(if(mapContains(ResourceAttributes, "status"), "status_extracted", "status"), extractAllGroupsHorizontal(Body, "(?P<status>\\d{3})")[1][1]))["status"], LogAttributes["status"]) = "500"))
  Scan(otel_logs)
