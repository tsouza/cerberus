[
  ["GET /api 500 took=12ms", {"detected_level": "unknown", "job": "api", "status": "500"}, "1970-01-01T00:00:00Z", {}],
  ["POST /api 500 took=22ms", {"detected_level": "unknown", "job": "api", "status": "500"}, "1970-01-01T00:00:00Z", {}]
]
