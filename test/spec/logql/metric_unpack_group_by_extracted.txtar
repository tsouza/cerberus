-- query.logql --
sum by (category) (count_over_time({job="api"} | unpack | __error__="" [5m]))
-- seed --
CREATE TABLE otel_logs (
    Timestamp DateTime64(9),
    Body String,
    SeverityText LowCardinality(String) DEFAULT '',
    ResourceAttributes Map(String, String),
    LogAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_logs (Timestamp, Body, SeverityText, ResourceAttributes) VALUES
    (toDateTime64('2025-12-31 23:58:00', 9), '{"_entry":"login ok","category":"auth"}', 'INFO', map('job', 'api')),
    (toDateTime64('2025-12-31 23:59:00', 9), '{"_entry":"login denied","category":"auth"}', 'WARN', map('job', 'api')),
    (toDateTime64('2026-01-01 00:00:00', 9), '{"_entry":"query ran","category":"db"}', 'INFO', map('job', 'api')),
    (toDateTime64('2026-01-01 00:00:00', 9), '{"_entry":"truncated', 'ERROR', map('job', 'api'));
-- expected_rows --
[
  ["", {"category": "auth"}, "2026-01-01T00:00:01Z", 2],
  ["", {"category": "db"}, "2026-01-01T00:00:01Z", 1]
]
