    ('{"user":{"id":"42","name":"ana"},"level":"error","msg":"nested-hit"}'),
    ('{"user":{"id":"7","name":"bo"},"level":"info","msg":"nested-miss"}'),
    ('{"user":{"profile":{"id":"42"}},"level":"warn","msg":"deeper-miss"}'),
    ('{"user_id":"42","level":"error","msg":"flat-hit"}');
