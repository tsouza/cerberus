[
  [{"msg": "oops", "severity": "error", "ts": "2025-01-01"}, {"detected_level": "unknown", "job": "api", "level": "error"}, "1970-01-01T00:00:00Z", {}],
  [{"msg": "retry", "severity": "error", "ts": "2025-01-01"}, {"detected_level": "unknown", "job": "api", "level": "error"}, "1970-01-01T00:00:00Z", {}]
]
