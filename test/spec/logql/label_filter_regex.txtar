-- seed --
CREATE TABLE otel_logs (
    LogAttributes Map(String, String) DEFAULT map(),
    Body String,
    ResourceAttributes Map(String, String) DEFAULT map(
        'job', 'api',
        'env', if(Body = 'r1', 'prod', if(Body = 'r2', 'stg', 'dev'))
    ),
    SeverityNumber UInt8 DEFAULT 0,
    SeverityText LowCardinality(String) DEFAULT '',
    Timestamp DateTime64(9) DEFAULT 0
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES ('r1'), ('r2'), ('r3-dev');
-- expected_rows --
[
  ["r1", {"detected_level": "unknown", "env": "prod", "job": "api"}, "1970-01-01T00:00:00Z", {}],
  ["r2", {"detected_level": "unknown", "env": "stg", "job": "api"}, "1970-01-01T00:00:00Z", {}]
]
-- chplan --
Project [Body AS Line, FnMapMerge(ResourceAttributes, FnMapFilter((k, v) -> (v != ""), FnMap("detected_level", _logql_detected_level))) AS Attributes, Timestamp AS TimeUnix, FnToJSONString(FnMapFilter((k, v) -> (v != ""), LogAttributes)) AS Metadata] oneScopeRows
  Project [Body, LogAttributes, ResourceAttributes, Timestamp, FnMultiIf((FnLower(_logql_level_source) = ""), "unknown", ((FnLower(_logql_level_source) = "trace") OR (FnLower(_logql_level_source) = "trc")), "trace", ((FnLower(_logql_level_source) = "debug") OR (FnLower(_logql_level_source) = "dbg")), "debug", (((FnLower(_logql_level_source) = "info") OR (FnLower(_logql_level_source) = "inf")) OR (FnLower(_logql_level_source) = "information")), "info", (((FnLower(_logql_level_source) = "warn") OR (FnLower(_logql_level_source) = "wrn")) OR (FnLower(_logql_level_source) = "warning")), "warn", ((FnLower(_logql_level_source) = "error") OR (FnLower(_logql_level_source) = "err")), "error", (FnLower(_logql_level_source) = "critical"), "critical", (FnLower(_logql_level_source) = "fatal"), "fatal", _logql_level_source) AS _logql_detected_level]
    Project [Body, LogAttributes, ResourceAttributes, Timestamp, FnMultiIf((LogAttributes["detected_level"] != ""), LogAttributes["detected_level"], (LogAttributes["level"] != ""), LogAttributes["level"], (LogAttributes["log.level"] != ""), LogAttributes["log.level"], (LogAttributes["severity"] != ""), LogAttributes["severity"], (LogAttributes["severity_text"] != ""), LogAttributes["severity_text"], FnMultiIf((SeverityText != ""), SeverityText, FnMultiIf((SeverityNumber <= 0), "", (SeverityNumber <= 4), "trace", (SeverityNumber <= 8), "debug", (SeverityNumber <= 12), "info", (SeverityNumber <= 16), "warn", (SeverityNumber <= 20), "error", (SeverityNumber <= 24), "fatal", ""))) AS _logql_level_source]
      Filter predicate=((ResourceAttributes["job"] = "api") AND (FnIf(FnMapContainsKey(LogAttributes, "env"), LogAttributes["env"], ResourceAttributes["env"]) =~ "prod|stg"))
        Scan(otel_logs)
