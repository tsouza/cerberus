-- query.logql --
{job="api"} | level="error" |= "timeout"
-- args --
[0] string = "job"
[1] string = "api"
[2] string = "level"
[3] string = "level"
[4] string = "level"
[5] string = "error"
[6] string = "timeout"
-- sql --
SELECT * FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?) AND (if(mapContains(`LogAttributes`, ?), `LogAttributes`[?], `ResourceAttributes`[?]) = ?) AND (position(`Body`, ?) > 0)
-- seed --
CREATE TABLE otel_logs (
    LogAttributes Map(String, String) MATERIALIZED map(),
    Body String,
    ResourceAttributes Map(String, String) MATERIALIZED map(
        'job', 'api',
        'level', if(Body LIKE 'i%', 'info', 'error')
    )
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES
    ('e1-timeout reading upstream'),
    ('e2-timeout opening db'),
    ('e3-no-match-here'),
    ('i1-timeout but info level'),
    ('i2-info quiet');
-- expected_rows --
[
  ["e1-timeout reading upstream"],
  ["e2-timeout opening db"]
]
-- chplan --
Filter predicate=(((ResourceAttributes["job"] = "api") AND (FnIf(FnMapContainsKey(LogAttributes, "level"), LogAttributes["level"], ResourceAttributes["level"]) = "error")) AND lineContent(Body, "timeout", substr))
  Scan(otel_logs)
