) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES
    ('ts=2026-01-01 latency=200ms msg="fast"'),
    ('ts=2026-01-01 latency=1s msg="slow"'),
    ('ts=2026-01-01 latency=2s msg="very_slow"');
