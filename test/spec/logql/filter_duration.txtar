  ["ts=2026-01-01 latency=2s msg=\"very_slow\"", {"detected_level": "unknown", "job": "api", "latency": "2s", "msg": "very_slow", "ts": "2026-01-01"}, "1970-01-01T00:00:00Z", {}]
