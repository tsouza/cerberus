[
  ["", {"host": "api-77", "service": "svc-77"}, "2026-01-01T00:00:01Z", 1],
  ["", {"host": "web-", "service": "svc-"}, "2026-01-01T00:00:01Z", 1],
  ["", {"host": "web-alpha", "service": "svc-alpha"}, "2026-01-01T00:00:01Z", 1]
]
