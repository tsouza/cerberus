# Range-mode `and` over two UNAGGREGATED LogQL arms. Each arm is a bare
# `rate({...}[1m])`, so the arm's outermost plan node is the canonical
# Sample Project the LogQL lowering stacks on the matrix RangeWindow —
# it exposes MetricName / Attributes / TimeUnix / Value and re-aliases
# the grid anchor (`anchor_ts`) to TimeUnix. The set op's arm projection
# must therefore read TimeUnix, NOT the logs table's own `Timestamp`
# column, which that scope no longer exposes. The `-- sql --` golden is
# the load-bearing assertion: real ClickHouse rejects the wrong
# identifier with code 47 while chDB resolves it leniently.
#
# Both arms select the same series, so they share one signature
# ({job="api", env="prod", detected_level="unknown"}); the line filters
# split the samples so the arms cover DIFFERENT step anchors.
#
# Window [00:00:00, 00:03:00] step 1m; each `[1m]` range is half-open
# (`t - 1m < sample <= t`), so the anchors each arm produces are:
#
#   left  (|= "a", samples 00:00:00 / 00:00:30 / 00:00:45) -> 00:00, 00:01
#   right (|= "b", samples 00:01:00 / 00:01:30)            -> 00:01, 00:02
#
# The shared 00:01 anchor covers TWO left samples (00:00:30, 00:00:45)
# but only ONE right sample (00:01:00), so the arms disagree on value
# there: left 2/60, right 1/60. That asymmetry is deliberate — it makes
# the assertion discriminating about WHICH arm's value survives.
#
# `and` keeps the left anchors the right arm also produces — 00:01
# alone — carrying the LEFT arm's value (2/60 = 0.0333…).
-- query.logql --
rate({job="api"} |= "a" [1m]) and rate({job="api"} |= "b" [1m])
-- start --
2026-01-01T00:00:00Z
-- end --
2026-01-01T00:03:00Z
-- step --
1m
-- seed --
CREATE TABLE otel_logs (
    Timestamp DateTime64(9),
    Body String,
    SeverityText LowCardinality(String) DEFAULT '',
    SeverityNumber UInt8 DEFAULT 0,
    ResourceAttributes Map(String, String),
    ServiceName String DEFAULT '',
    LogAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_logs (Timestamp, Body, ResourceAttributes) VALUES
    (toDateTime64('2026-01-01 00:00:00', 9), 'a1', map('job', 'api', 'env', 'prod')),
    (toDateTime64('2026-01-01 00:00:30', 9), 'a2', map('job', 'api', 'env', 'prod')),
    (toDateTime64('2026-01-01 00:00:45', 9), 'a3', map('job', 'api', 'env', 'prod')),
    (toDateTime64('2026-01-01 00:01:00', 9), 'b1', map('job', 'api', 'env', 'prod')),
    (toDateTime64('2026-01-01 00:01:30', 9), 'b2', map('job', 'api', 'env', 'prod'));
-- expected_rows --
[
  ["", {"detected_level": "unknown", "env": "prod", "job": "api"}, "2026-01-01T00:01:00Z", 0.03333333333333333]
]
