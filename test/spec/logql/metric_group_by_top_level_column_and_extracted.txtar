-- query.logql --
sum by (TraceId, category) (count_over_time({job="api"} | json [5m]))
-- seed --
CREATE TABLE otel_logs (
    Timestamp DateTime64(9),
    Body String,
    TraceId String DEFAULT '',
    SeverityText LowCardinality(String) DEFAULT '',
    SeverityNumber UInt8 DEFAULT 0,
    ResourceAttributes Map(String, String),
    LogAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_logs (Timestamp, Body, TraceId, SeverityText, ResourceAttributes) VALUES
    (toDateTime64('2025-12-31 23:58:00', 9), '{"msg":"a","category":"auth"}', 'tr1', 'INFO', map('job', 'api')),
    (toDateTime64('2026-01-01 00:00:00', 9), '{"msg":"c","category":"db"}', 'tr1', 'INFO', map('job', 'api'));
