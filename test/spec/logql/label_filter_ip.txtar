-- query.logql --
{job="api"} | logfmt | addr = ip("192.168.0.0/16")
-- seed --
CREATE TABLE otel_logs (
    Body String,
    ResourceAttributes Map(String, String) MATERIALIZED map('job', 'api')
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES
    ('addr=192.168.1.5 msg=a'),
    ('addr=10.0.0.1 msg=b'),
    ('addr=not-an-ip msg=c'),
    ('msg=d');
