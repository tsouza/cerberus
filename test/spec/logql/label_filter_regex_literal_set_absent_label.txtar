# A label-filter matcher whose regex is a set of literals renders as IN
# (NOT IN when negated) over the set, with an absent label reading as '':
# `region=~"eu|"` selects the line with no region, and `zone!~"a|b"` keeps
# it. An escaped dot is a literal, and a case-insensitive alternative keeps
# match().

-- query.logql --
{job="api"} | region=~"eu|" | zone!~"a|b" | host=~"h\\.1|(?i)H2"
-- seed --
CREATE TABLE otel_logs (
    LogAttributes Map(String, String),
    Body String,
    ResourceAttributes Map(String, String) MATERIALIZED map('job', 'api')
) ENGINE = Memory;
INSERT INTO otel_logs (LogAttributes, Body) VALUES
    (map('region', 'eu', 'zone', 'c', 'host', 'h.1'), 'eu-c-h.1'),
    (map('host', 'h2'), 'none-h2'),
    (map('region', 'us', 'host', 'h.1'), 'us-h.1'),
    (map('region', 'eu', 'zone', 'a', 'host', 'h.1'), 'eu-a-h.1'),
    (map('region', 'eu', 'host', 'hx1'), 'eu-hx1'),
    (map('host', 'H2'), 'none-H2');
-- expected_rows --
-- sql --
SELECT * FROM `otel_logs` WHERE (`ResourceAttributes`[?] = ?) AND match(if(mapContains(`LogAttributes`, ?), `LogAttributes`[?], `ResourceAttributes`[?]), ?) AND NOT match(if(mapContains(`LogAttributes`, ?), `LogAttributes`[?], `ResourceAttributes`[?]), ?) AND match(if(mapContains(`LogAttributes`, ?), `LogAttributes`[?], `ResourceAttributes`[?]), ?)
-- args --
[0] string = "job"
[1] string = "api"
[2] string = "region"
[3] string = "region"
[4] string = "region"
[5] string = "^(?:eu|)$"
[6] string = "zone"
[7] string = "zone"
[8] string = "zone"
[9] string = "^(?:a|b)$"
[10] string = "host"
[11] string = "host"
[12] string = "host"
[13] string = "^(?:h\\.1|(?i)H2)$"
-- args_optimized --
[0] string = "job"
[1] string = "api"
[2] string = "region"
[3] string = "region"
[4] string = "region"
[5] string = "^(?:eu|)$"
[6] string = "zone"
[7] string = "zone"
[8] string = "zone"
[9] string = "^(?:a|b)$"
[10] string = "host"
[11] string = "host"
[12] string = "host"
[13] string = "^(?:h\\.1|(?i)H2)$"
-- chplan --
Filter predicate=((((ResourceAttributes["job"] = "api") AND (FnIf(FnMapContainsKey(LogAttributes, "region"), LogAttributes["region"], ResourceAttributes["region"]) =~ "eu|")) AND (FnIf(FnMapContainsKey(LogAttributes, "zone"), LogAttributes["zone"], ResourceAttributes["zone"]) !~ "a|b")) AND (FnIf(FnMapContainsKey(LogAttributes, "host"), LogAttributes["host"], ResourceAttributes["host"]) =~ "h\\.1|(?i)H2"))
  Scan(otel_logs)
-- settings --
enable_analyzer=1
enabled_opts=aggregation_in_order,condition_cache,exp_histogram_two_level,join_spill,lazy_materialization,native_histogram_legacy_analyzer,result_cache,trace_id_bitmap_filter
log_comment=cerb:filter
max_bytes_before_external_group_by=536870912
max_bytes_before_external_sort=536870912
use_query_condition_cache=1
