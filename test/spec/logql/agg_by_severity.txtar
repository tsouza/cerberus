[
  ["", {"SeverityText": "DEBUG"}, "2026-01-01T00:00:01Z", 0.01],
  ["", {"SeverityText": "ERROR"}, "2026-01-01T00:00:01Z", 0.01],
  ["", {"SeverityText": "INFO"}, "2026-01-01T00:00:01Z", 0.01],
  ["", {"SeverityText": "WARN"}, "2026-01-01T00:00:01Z", 0.01]
]
-- chplan --
Project ["" AS MetricName, FnMap("SeverityText", gkey_0) AS Attributes, FnNow64(9) AS TimeUnix, Value AS Value]
  Aggregate groupBy=[ResourceAttributes["SeverityText"] AS gkey_0] funcs=[FnSum(Value) AS Value] dropEmptyOnNoGroup
    RangeWindow func=log_rate range=5m0s step=0s ts=Timestamp value=Value groupBy=[ResourceAttributes]
      Project [FnMapSort(FnMapMerge(ResourceAttributes, FnMapFilter((k, v) -> (v != ""), FnMap("detected_level", _logql_detected_level, "SeverityText", FnToString(SeverityText))))) AS ResourceAttributes, Timestamp, 1 AS Value]
        Project [ResourceAttributes, SeverityText, Timestamp, FnMultiIf((FnLower(_logql_level_source) = ""), "unknown", ((FnLower(_logql_level_source) = "trace") OR (FnLower(_logql_level_source) = "trc")), "trace", ((FnLower(_logql_level_source) = "debug") OR (FnLower(_logql_level_source) = "dbg")), "debug", (((FnLower(_logql_level_source) = "info") OR (FnLower(_logql_level_source) = "inf")) OR (FnLower(_logql_level_source) = "information")), "info", (((FnLower(_logql_level_source) = "warn") OR (FnLower(_logql_level_source) = "wrn")) OR (FnLower(_logql_level_source) = "warning")), "warn", ((FnLower(_logql_level_source) = "error") OR (FnLower(_logql_level_source) = "err")), "error", (FnLower(_logql_level_source) = "critical"), "critical", (FnLower(_logql_level_source) = "fatal"), "fatal", _logql_level_source) AS _logql_detected_level]
          Project [ResourceAttributes, SeverityText, Timestamp, FnMultiIf((LogAttributes["detected_level"] != ""), LogAttributes["detected_level"], (LogAttributes["level"] != ""), LogAttributes["level"], (LogAttributes["log.level"] != ""), LogAttributes["log.level"], (LogAttributes["severity"] != ""), LogAttributes["severity"], (LogAttributes["severity_text"] != ""), LogAttributes["severity_text"], FnMultiIf((SeverityText != ""), SeverityText, FnMultiIf((SeverityNumber <= 0), "", (SeverityNumber <= 4), "trace", (SeverityNumber <= 8), "debug", (SeverityNumber <= 12), "info", (SeverityNumber <= 16), "warn", (SeverityNumber <= 20), "error", (SeverityNumber <= 24), "fatal", ""))) AS _logql_level_source]
            Filter predicate=(ResourceAttributes["job"] = "api")
              Scan(otel_logs)
-- parity_exempt --
reason: structured-metadata-unobservable
detail: seed populates SeverityText (INFO), which upstream's in-process querier discards before the pipeline runs, so `sum by (SeverityText) (rate({job="api"}[5m]))` would be answered over different data on the two sides
