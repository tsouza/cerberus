# Range-mode `unless` over two aggregated LogQL arms that share one
# signature ({env="prod"}) but carry samples at DIFFERENT step anchors.
# Set-op matching is per evaluation timestamp, so the arms match anchor
# by anchor rather than once for the whole window.
#
# Window [00:00:00, 00:03:00] step 1m; each `[1m]` range is half-open
# (`t - 1m < sample <= t`), so the anchors each arm produces are:
#
#   left  (job="api", samples 00:00:00 / 00:00:30) -> 00:00, 00:01
#   right (job="db",  samples 00:01:00 / 00:01:30) -> 00:01, 00:02
#
# `unless` keeps left anchors the right arm does NOT produce: 00:00
# alone.
-- query.logql --
sum by (env) (count_over_time({job="api"}[1m])) unless sum by (env) (count_over_time({job="db"}[1m]))
-- start --
2026-01-01T00:00:00Z
-- end --
2026-01-01T00:03:00Z
-- step --
1m
-- seed --
CREATE TABLE otel_logs (
    Timestamp DateTime64(9),
    Body String,
    SeverityText LowCardinality(String) DEFAULT '',
    SeverityNumber UInt8 DEFAULT 0,
    ResourceAttributes Map(String, String),
    ServiceName String DEFAULT '',
    LogAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_logs (Timestamp, Body, ResourceAttributes) VALUES
    (toDateTime64('2026-01-01 00:00:00', 9), 'a1', map('job', 'api', 'env', 'prod')),
    (toDateTime64('2026-01-01 00:00:30', 9), 'a2', map('job', 'api', 'env', 'prod')),
    (toDateTime64('2026-01-01 00:01:00', 9), 'd1', map('job', 'db', 'env', 'prod')),
    (toDateTime64('2026-01-01 00:01:30', 9), 'd2', map('job', 'db', 'env', 'prod'));
-- expected_rows --
[
  ["", {"env": "prod"}, "2026-01-01T00:00:00Z", 1]
]
