Filter predicate=((((ResourceAttributes["job"] = "api") AND lineContent(Body, "error", substr)) AND (FnIf(FnMapContainsKey(LogAttributes, "env"), LogAttributes["env"], ResourceAttributes["env"]) = "prod")) AND (FnIf(FnMapContainsKey(LogAttributes, "severity"), LogAttributes["severity"], ResourceAttributes["severity"]) = "high"))
  Scan(otel_logs)
