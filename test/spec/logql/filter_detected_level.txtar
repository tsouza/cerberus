-- seed --
CREATE TABLE otel_logs (
    Body String,
    SeverityText LowCardinality(String) MATERIALIZED multiIf(
        Body = 'line-warn', 'WARN',
        Body = 'line-info', 'INFO',
        Body = 'line-debug', 'DEBUG',
        Body = 'line-fatal', 'FATAL',
        'ERROR'),
    SeverityNumber UInt8 MATERIALIZED 0,
    ResourceAttributes Map(String, String) MATERIALIZED map('job', 'api'),
    LogAttributes Map(String, String) MATERIALIZED map(),
    Timestamp DateTime64(9) DEFAULT 0
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES
    ('line-err'),
    ('line-warn'),
    ('line-info'),
    ('line-debug'),
    ('line-fatal');
-- expected_rows --
[
  ["line-err", {"detected_level": "error", "job": "api"}, "1970-01-01T00:00:00Z", {}]
]
