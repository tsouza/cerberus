        Filter predicate=(_logql_unwrap_source != "")
          Project [Timestamp, _logql_labels_0, _logql_level_source, FnIf(FnMapContainsKey(_logql_labels_0, "latency"), _logql_labels_0["latency"], LogAttributes["latency"]) AS _logql_unwrap_source]
            Project [LogAttributes, Timestamp, _logql_level_source, FnMapMerge(ResourceAttributes, FnMapApply((k, v) -> FnTuple(FnIf(FnMapContainsKey(ResourceAttributes, k), FnConcat(k, "_extracted"), k), v), FnCast(FnArrayReverse(FnArrayFold((__json_seen, __json_entry) -> FnIf(FnArrayHas(FnArrayMap(__json_seen_entry -> FnTupleElement(__json_seen_entry, 1), __json_seen), FnTupleElement(__json_entry, 1)), __json_seen, FnArrayPushBack(__json_seen, __json_entry)), FnArrayReverse(FnCast(FnExtractKeyValuePairs(Body, "=", " ", "\""), "Array(Tuple(String,String))")), FnCast(FnArray(), "Array(Tuple(String,String))"))), "Map(String,String)"))) AS _logql_labels_0]
              Project [Body, LogAttributes, ResourceAttributes, Timestamp, FnMultiIf((LogAttributes["detected_level"] != ""), LogAttributes["detected_level"], (LogAttributes["level"] != ""), LogAttributes["level"], (LogAttributes["log.level"] != ""), LogAttributes["log.level"], (LogAttributes["severity"] != ""), LogAttributes["severity"], (LogAttributes["severity_text"] != ""), LogAttributes["severity_text"], FnMultiIf((SeverityText != ""), SeverityText, FnMultiIf((SeverityNumber <= 0), "", (SeverityNumber <= 4), "trace", (SeverityNumber <= 8), "debug", (SeverityNumber <= 12), "info", (SeverityNumber <= 16), "warn", (SeverityNumber <= 20), "error", (SeverityNumber <= 24), "fatal", ""))) AS _logql_level_source]
                Filter predicate=(ResourceAttributes["job"] = "api")
