-- seed --
CREATE TABLE otel_logs (
    LogAttributes Map(String, String),
    Timestamp DateTime64(9),
    Body String,
    SeverityText LowCardinality(String) DEFAULT '',
    SeverityNumber UInt8 DEFAULT 0,
    ResourceAttributes Map(String, String)
) ENGINE = Memory;
INSERT INTO otel_logs (Timestamp, Body, ResourceAttributes) VALUES
    (toDateTime64('2025-12-31 23:58:00', 9), 'latency=1.5 msg=ok', map('job', 'api')),
    (toDateTime64('2025-12-31 23:59:00', 9), 'latency=2.5 msg=ok', map('job', 'api')),
    (toDateTime64('2026-01-01 00:00:00', 9), 'latency=3.5 msg=ok', map('job', 'api'));
-- expected_rows --
[
  [{"detected_level": "unknown", "job": "api", "msg": "ok"}, 7.5]
]

-- parity_exempt --
reason: structured-metadata-unobservable
detail: `sum_over_time({job="api"} | logfmt | unwrap latency [5m])` answers with the synthesised `detected_level` label, which upstream produces at ingestion and its in-process querier never runs
