-- query.logql --
{service_name="clickhouse"} | env="prod"
-- seed --
CREATE TABLE otel_logs (
    ServiceName LowCardinality(String) DEFAULT 'clickhouse',
    Body String,
    ResourceAttributes Map(String, String) MATERIALIZED map(
        'service_name', 'clickhouse',
        'env', 'staging'
    ),
    LogAttributes Map(String, String) MATERIALIZED map(
        'env', if(Body LIKE 'p%', 'prod', 'dev')
    )
) ENGINE = Memory;
INSERT INTO otel_logs (Body) VALUES ('p1'), ('p2'), ('d1');
-- expected_rows --
[
  ["clickhouse", "p1"],
  ["clickhouse", "p2"]
]
-- chplan --
Filter predicate=((FnCoalesce(FnNullIf(ServiceName, ""), FnIf(FnMapContainsKey(ResourceAttributes, "service_name"), ResourceAttributes["service_name"], FnIf(FnMapContainsKey(ResourceAttributes, "service.name"), ResourceAttributes["service.name"], ResourceAttributes["service/name"]))) = "clickhouse") AND (FnIf(FnMapContainsKey(LogAttributes, "env"), LogAttributes["env"], ResourceAttributes["env"]) = "prod"))
  Scan(otel_logs)
-- sql --
SELECT * FROM `otel_logs` WHERE (coalesce(nullIf(`ServiceName`, ?), if(mapContains(`ResourceAttributes`, ?), `ResourceAttributes`[?], if(mapContains(`ResourceAttributes`, ?), `ResourceAttributes`[?], `ResourceAttributes`[?]))) = ?) AND (if(mapContains(`LogAttributes`, ?), `LogAttributes`[?], `ResourceAttributes`[?]) = ?)
