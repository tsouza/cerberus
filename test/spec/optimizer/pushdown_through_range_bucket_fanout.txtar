-- optimized --
SELECT anchor_ts AS `anchor_ts`, `Attributes`, argMax(`BucketCounts`, `TimeUnix`) AS `BucketCounts`, argMax(`ExplicitBounds`, `TimeUnix`) AS `ExplicitBounds` FROM (SELECT *, arrayJoin(arrayMap(i -> toDateTime64('1970-01-01 00:21:40.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 300000000000, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 300000000000, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT * REPLACE (mapSort(`Attributes`) AS `Attributes`) FROM (SELECT `Attributes`, `BucketCounts`, `ExplicitBounds`, `MetricName`, `TimeUnix` FROM `otel_metrics_histogram` WHERE (`MetricName` = ?))) WHERE `TimeUnix` > toDateTime64('1970-01-01 00:16:40.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('1970-01-01 00:21:40.000000000', 9)) GROUP BY anchor_ts, `Attributes`
-- unoptimized --
SELECT anchor_ts AS `anchor_ts`, `Attributes`, argMax(`BucketCounts`, `TimeUnix`) AS `BucketCounts`, argMax(`ExplicitBounds`, `TimeUnix`) AS `ExplicitBounds` FROM (SELECT *, arrayJoin(arrayMap(i -> toDateTime64('1970-01-01 00:21:40.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 300000000000, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 300000000000, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT * REPLACE (mapSort(`Attributes`) AS `Attributes`) FROM (SELECT * FROM `otel_metrics_histogram` PREWHERE (`MetricName` = ?))) WHERE `TimeUnix` > toDateTime64('1970-01-01 00:16:40.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('1970-01-01 00:21:40.000000000', 9)) GROUP BY anchor_ts, `Attributes`
-- chplan_optimized --
RangeBucketFanout step=30s lookback=5m0s groupBy=[Attributes] funcs=[argMax(BucketCounts, TimeUnix) AS BucketCounts, argMax(ExplicitBounds, TimeUnix) AS ExplicitBounds] start=1970-01-01T00:16:40Z end=1970-01-01T00:21:40Z
  Filter predicate=(MetricName = "http_request_duration_seconds")
    Scan(otel_metrics_histogram, columns=[Attributes, BucketCounts, ExplicitBounds, MetricName, TimeUnix])
-- chplan_unoptimized --
RangeBucketFanout step=30s lookback=5m0s groupBy=[Attributes] funcs=[argMax(BucketCounts, TimeUnix) AS BucketCounts, argMax(ExplicitBounds, TimeUnix) AS ExplicitBounds] start=1970-01-01T00:16:40Z end=1970-01-01T00:21:40Z
  Filter predicate=(MetricName = "http_request_duration_seconds")
    Scan(otel_metrics_histogram)
