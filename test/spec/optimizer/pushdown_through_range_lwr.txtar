-- optimized --
SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, anchor_ts AS `TimeUnix`, lwr_value AS `Value` FROM (SELECT `MetricName`, `Attributes`, `anchor_ts`, argMax(`Value`, `TimeUnix`) AS lwr_value FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, arrayJoin(arrayMap(i -> toDateTime64('1970-01-01 00:21:40.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 300000000000, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 300000000000, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT `Attributes`, `MetricName`, `TimeUnix`, `Value` FROM `otel_metrics_gauge` WHERE (`MetricName` = ?)) WHERE `TimeUnix` > toDateTime64('1970-01-01 00:16:40.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('1970-01-01 00:21:40.000000000', 9)) GROUP BY `MetricName`, `Attributes`, `anchor_ts`)
-- unoptimized --
SELECT `MetricName` AS `MetricName`, `Attributes` AS `Attributes`, anchor_ts AS `TimeUnix`, lwr_value AS `Value` FROM (SELECT `MetricName`, `Attributes`, `anchor_ts`, argMax(`Value`, `TimeUnix`) AS lwr_value FROM (SELECT `MetricName`, `Attributes`, `TimeUnix`, `Value`, arrayJoin(arrayMap(i -> toDateTime64('1970-01-01 00:21:40.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 300000000000, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 300000000000, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `TimeUnix`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) < 0) + 1)))) AS anchor_ts FROM (SELECT * FROM `otel_metrics_gauge` PREWHERE (`MetricName` = ?)) WHERE `TimeUnix` > toDateTime64('1970-01-01 00:16:40.000000000', 9) - toIntervalNanosecond(300000000000) AND `TimeUnix` <= toDateTime64('1970-01-01 00:21:40.000000000', 9)) GROUP BY `MetricName`, `Attributes`, `anchor_ts`)
-- chplan_optimized --
RangeLWR step=30s lookback=5m0s ts=TimeUnix value=Value start=1970-01-01T00:16:40Z end=1970-01-01T00:21:40Z
  Filter predicate=(MetricName = "http_requests_total")
    Scan(otel_metrics_gauge, columns=[Attributes, MetricName, TimeUnix, Value])
