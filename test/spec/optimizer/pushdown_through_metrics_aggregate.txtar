-- optimized --
SELECT `span.kind`, `anchor_ts`, toFloat64(avg(`metric_arg`)) AS `Value` FROM (SELECT `SpanKind` AS `span.kind`, `Duration` AS `metric_arg`, arrayJoin(arrayMap(i -> toDateTime64('1970-01-01 00:21:40.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `Timestamp`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 60000000000, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `Timestamp`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 60000000000, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', `Timestamp`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `Timestamp`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT `Duration`, `SpanKind`, `SpanName` FROM `otel_traces` WHERE (`SpanName` = ?)) WHERE `Timestamp` > toDateTime64('1970-01-01 00:16:40.000000000', 9) - toIntervalNanosecond(60000000000) AND `Timestamp` <= toDateTime64('1970-01-01 00:21:40.000000000', 9)) GROUP BY `span.kind`, `anchor_ts`
-- unoptimized --
SELECT `span.kind`, `anchor_ts`, toFloat64(avg(`metric_arg`)) AS `Value` FROM (SELECT `SpanKind` AS `span.kind`, `Duration` AS `metric_arg`, arrayJoin(arrayMap(i -> toDateTime64('1970-01-01 00:21:40.000000000', 9) - toIntervalNanosecond(i * 30000000000), range(greatest(0, intDiv(dateDiff('nanosecond', `Timestamp`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 60000000000, toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `Timestamp`, toDateTime64('1970-01-01 00:21:40.000000000', 9)) - 60000000000, toInt64(30000000000)) < 0) + 1), least(11, intDiv(dateDiff('nanosecond', `Timestamp`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) - (modulo(dateDiff('nanosecond', `Timestamp`, toDateTime64('1970-01-01 00:21:40.000000000', 9)), toInt64(30000000000)) < 0) + 1)))) AS `anchor_ts` FROM (SELECT * FROM `otel_traces` WHERE (`SpanName` = ?)) WHERE `Timestamp` > toDateTime64('1970-01-01 00:16:40.000000000', 9) - toIntervalNanosecond(60000000000) AND `Timestamp` <= toDateTime64('1970-01-01 00:21:40.000000000', 9)) GROUP BY `span.kind`, `anchor_ts`
-- chplan_optimized --
RangeWindow func=avg_over_time range=1m0s step=30s ts=Timestamp start=1970-01-01T00:16:40Z end=1970-01-01T00:21:40Z
  MetricsAggregate op=avg_over_time attr=Duration groupBy=[SpanKind AS span.kind] valueAlias=Value
    Filter predicate=(SpanName = "GET /api")
      Scan(otel_traces, columns=[Duration, SpanKind, SpanName])
-- chplan_unoptimized --
RangeWindow func=avg_over_time range=1m0s step=30s ts=Timestamp start=1970-01-01T00:16:40Z end=1970-01-01T00:21:40Z
  MetricsAggregate op=avg_over_time attr=Duration groupBy=[SpanKind AS span.kind] valueAlias=Value
    Filter predicate=(SpanName = "GET /api")
      Scan(otel_traces)
