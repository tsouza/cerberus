ds`, `MetricName`, `le_bucket_key` FROM `otel_metrics_histogram` WHERE (`MetricName` = ?))))))))
-- chplan_optimized --
HistogramQuantile phi=0.9 groupBy=[le_bucket_key AS le_bucket_key]
  Filter predicate=(MetricName = "http_request_duration_seconds")
    Scan(otel_metrics_histogram, columns=[BucketCounts, ExplicitBounds, MetricName, le_bucket_key])
-- chplan_unoptimized --
HistogramQuantile phi=0.9 groupBy=[le_bucket_key AS le_bucket_key]
  Filter predicate=(MetricName = "http_request_duration_seconds")
    Scan(otel_metrics_histogram, columns=[BucketCounts, ExplicitBounds, MetricName, le_bucket_key])
