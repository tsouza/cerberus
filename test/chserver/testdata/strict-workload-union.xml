<!-- system.all_query_log over this server's current and rotated query_log
     tables, and a workload name that resolves to no defined WORKLOAD refused
     with RESOURCE_ACCESS_DENIED rather than run unscheduled. -->
<clickhouse>
    <throw_on_unknown_workload>true</throw_on_unknown_workload>
    <create_union_system_log_tables>
        <merge_rotated_tables>1</merge_rotated_tables>
    </create_union_system_log_tables>
</clickhouse>
