    {
      "head": "promql",
      "site": "internal/promql/lower.go:buildAggFunc#a6e9df79",
      "message": "promql: aggregation op %s is not yet supported",
      "class": "internal",
      "rationale": "defensive fallback: every PromQL aggregator the parser emits (sum/avg/count/min/max/group/stddev/stdvar/topk/bottomk/count_values/quantile/limitk/limit_ratio) is dispatched by lowerAggregate or handled in buildAggFunc's switch, so no wire-reachable query reaches this branch. It guards against a future parser op landing unlowered.",
      "evidence": {
        "guard": [
          "past exhaustive switch a.Op over [case parser.SUM, parser.COUNT, parser.AVG, parser.MIN, parser.MAX, parser.STDDEV, parser.STDVAR; case parser.GROUP; case parser.QUANTILE; case parser.COUNT_VALUES]"
        ],
        "callers": [
          "lowerAggregate"
        ],
        "caller_dispatch": [
          "aggregateGroupBy",
          "buildAggFunc",
          "groupKeyAliases",
          "lower",
          "lowerCountValues",
          "lowerLimitK",
          "lowerLimitRatio",
          "lowerTopK",
          "wrapAggregateForSample",
          "wrapQuantilePhiGuard"
        ]
      }
    },
