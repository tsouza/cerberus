{
  "title": "OTel / service overview",
  "uid": "otel-services",
  "panels": [
    {
      "id": 1,
      "title": "Request rate by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate({__name__=\"http.server.request.count\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Database latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=\"db.client.operation.duration_bucket\"}[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Exporter queue headroom",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A", "expr": "otel:http_server_request_duration:p95" }]
    }
  ]
}
