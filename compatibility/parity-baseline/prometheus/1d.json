{
  "schema_version": 1,
  "head": "prometheus",
  "bucket": "1d",
  "cases": [
    "absent_over_time(demo_memory_usage_bytes[5m] offset 1m)",
    "ceil(avg_over_time({__name__=~\"demo_disk_usage_bytes|demo_disk_total_bytes\"}[15s]))",
    "ceil(avg_over_time({__name__=~\"demo_disk_usage_bytes|demo_disk_total_bytes\"}[5m]))",
    "changes(demo_gauge_with_nan_run[1s])",
    "count by() (demo_memory_usage_bytes)",
    "demo_memory_usage_bytes",
    "demo_memory_usage_bytes * time()",
    "demo_memory_usage_bytes + time()",
    "first_over_time(demo_memory_usage_bytes[10m:1m])",
    "label_join(rate(demo_cpu_usage_seconds_total[1m]), \"mode\", \"-\")",
    "last_over_time(demo_memory_usage_bytes[10m:1m] @ start())",
    "max(demo_memory_usage_bytes)",
    "max_over_time(sort(demo_memory_usage_bytes)[5m:1m])",
    "quantile(0.9, demo_latency_exp_hist)",
    "quantile_over_time(0.75, demo_memory_usage_bytes[1m])",
    "rate(demo_cpu_usage_seconds_total[15s]) or rate(demo_http_requests_total[15s])",
    "resets(demo_cpu_usage_seconds_total[15m])",
    "stddev_over_time(demo_memory_usage_bytes[5m] offset 1m)",
    "stdvar by(instance, type) (demo_memory_usage_bytes)",
    "sum by(instance, type) (demo_memory_usage_bytes)",
    "time() / time()"
  ]
}
