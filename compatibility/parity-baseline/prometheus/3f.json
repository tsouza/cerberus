    "increase(demo_cpu_usage_seconds_total[15s] offset 5m)",
    "log10(-demo_memory_usage_bytes)",
    "max_over_time(demo_memory_usage_bytes[15m])",
    "quantile_over_time(0.1, demo_memory_usage_bytes[1h])",
    "time() % time()"
  ]
}
