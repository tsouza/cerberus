{
  "schema_version": 1,
  "head": "prometheus",
  "bucket": "3f",
  "cases": [
    "(1 * 2 + 4 / 6 - (10%7)^2) / demo_memory_usage_bytes",
    "2 * avg_over_time({__name__=~\"demo_disk_usage_bytes|demo_disk_total_bytes\"}[5m])",
    "demo_memory_usage_bytes / time()",
    "histogram_quantile(0.5, demo_latency_exp_hist)",
